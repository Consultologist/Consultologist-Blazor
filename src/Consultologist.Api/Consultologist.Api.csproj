<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AzureFunctionsVersion>v4</AzureFunctionsVersion>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);OPENAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- #450: the format is its own assembly; Scriban arrives through it. -->
    <ProjectReference Include="..\Consultologist.PackageFormat\Consultologist.PackageFormat.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Data.Tables" />
    <PackageReference Include="Azure.Storage.Blobs" />
    <PackageReference Include="Azure.Identity" Aliases="AzureIdentity" />
    <PackageReference Include="Azure.AI.Extensions.OpenAI" />
    <PackageReference Include="Azure.AI.Projects" />
    <PackageReference Include="Azure.AI.Projects.Agents" />
    <PackageReference Include="Azure.AI.DocumentIntelligence" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="Microsoft.ApplicationInsights.WorkerService" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.ApplicationInsights" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.DurableTask" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Timer" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="PDFsharp-MigraDoc" />
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="PdfPig" />
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundle the attested agent manifests so startup can verify the deployed
         agent version matches git (docs/customizable-workflow/provenance.md). -->
    <None Include="..\..\external\consultologist-agents\agents\*.yaml" Link="agents\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The output-contract catalog and its schema files ride along: schema-id keyed
         agent selection, attested per entry (output-contract-catalog.md). -->
    <None Include="..\..\external\consultologist-agents\agents\output-contracts.json" Link="agents\output-contracts.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\external\consultologist-agents\agents\schemas\*.json" Link="agents\schemas\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- #449: the format registry version this engine was built against, so the
         deployed app can attest it beside its commit (GET /api/Public/Engine). -->
    <None Include="..\..\external\consultologist-package-format\spec-versions.json" Link="package-format\spec-versions.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- #400: the provenance contract version this engine's records conform to. -->
    <None Include="..\..\external\consultologist-provenance\provenance-versions.json" Link="provenance\provenance-versions.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Consultologist.Api.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- #159: PDFsharp's Core build resolves no system fonts on Linux — the
         PDF renderer embeds Liberation Sans (SIL OFL; LICENSE alongside). -->
    <EmbeddedResource Include="Fonts\LiberationSans-Regular.ttf" />
    <EmbeddedResource Include="Fonts\LiberationSans-Bold.ttf" />
    <EmbeddedResource Include="Fonts\LiberationSans-Italic.ttf" />
    <EmbeddedResource Include="Fonts\LiberationSans-BoldItalic.ttf" />
  </ItemGroup>

</Project>
