@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@inject IOperatorEndpointService OperatorService
@inject IJSRuntime JS
@attribute [Authorize]

@page "/"
<PageTitle>Usage - Consultologist Admin</PageTitle>

@* #553/#733: a first slice, not a console — usage per user and per
   organisation from the derived store, for accounts on the operator
   allowlist. The server gate is the real one; a signed-in non-operator
   meets the named state, never a broken page. Numbers, ids and stored
   display names only; rows link nowhere. *@
<section class="page-header">
    <div class="section-eyebrow">Operators</div>
    <h1 class="page-title">Usage</h1>
    <p class="page-description">
        Consults and tokens per user and per organisation, from the derived
        usage store — never job records. This deployment's figures only.
    </p>
</section>

<section class="content-card operators-usage-card">
    <div class="form-stack">
        @if (accessDenied)
        {
            <p class="operators-denied">This page is for operators — your account is not on the allowlist.</p>
        }
        else
        {
            @if (usageError != null)
            {
                <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false" Class="operators-message">@usageError</FluentMessageBar>
            }

            <div class="action-row">
                <select class="node-field__input operators-window"
                        value="@window"
                        @onchange="OnWindowChangedAsync"
                        aria-label="Usage window">
                    <option value="7">Last 7 days</option>
                    <option value="30">Last 30 days</option>
                    <option value="90">Last 90 days</option>
                    <option value="custom">Custom range</option>
                </select>
                @if (window == "custom")
                {
                    <input type="date" class="node-field__input operators-from" value="@fromInput"
                           @onchange="args => fromInput = args.Value?.ToString() ?? string.Empty" aria-label="From" />
                    <input type="date" class="node-field__input operators-to" value="@toInput"
                           @onchange="args => toInput = args.Value?.ToString() ?? string.Empty" aria-label="To" />
                    <FluentButton Appearance="Appearance.Accent" Class="operators-apply"
                                  Disabled="@(string.IsNullOrWhiteSpace(fromInput) || string.IsNullOrWhiteSpace(toInput))"
                                  @onclick="LoadAsync">
                        Apply
                    </FluentButton>
                }
            </div>

            @if (loading)
            {
                <LoadingState>Loading usage&hellip;</LoadingState>
            }
            else if (usage is { } usageData)
            {
                @if (usageData.Rows.Count == 0)
                {
                    <p class="operators-empty muted-text">No usage in this window.</p>
                }
                else
                {
                    var groups = OperatorUsageRollup.Groups(usageData.Rows, sortKey, sortDescending);

                    @* #732: the window as graphs, above the per-org tables — an
                       aggregate daily series (days densified over the window),
                       and a per-organisation comparison. Days may be absent when
                       the API predates the field; then only the per-org charts show. *@
                    var days = usageData.Days ?? Array.Empty<OperatorUsageDayResponse>();
                    var denseDays = UsageSeries.DenseDays(usageData.From, usageData.To,
                        days.Select(day => new UsageSeries.DayPoint(day.Day, day.ConsultsCompleted, day.TokensIn, day.TokensOut)));
                    var dailyConsults = denseDays
                        .Select(day => new UsageChartGeometry.Category(day.Day,
                            new[] { new UsageChartGeometry.CategorySegment("consults", day.ConsultsCompleted) }))
                        .ToList();
                    var dailyTokens = denseDays
                        .Select(day => new UsageChartGeometry.Category(day.Day, new[]
                        {
                            new UsageChartGeometry.CategorySegment("tokens-in", day.TokensIn),
                            new UsageChartGeometry.CategorySegment("tokens-out", day.TokensOut)
                        }))
                        .ToList();
                    var orgConsults = groups
                        .Select(group => new UsageChartGeometry.Category(group.Label,
                            new[] { new UsageChartGeometry.CategorySegment("consults", group.ConsultsCompleted) }))
                        .ToList();
                    var orgTokens = groups
                        .Select(group => new UsageChartGeometry.Category(group.Label, new[]
                        {
                            new UsageChartGeometry.CategorySegment("tokens-in", group.TokensIn),
                            new UsageChartGeometry.CategorySegment("tokens-out", group.TokensOut)
                        }))
                        .ToList();

                    @* #743: the per-day charts switch bars↔lines; the per-org
                       charts are categorical and stay bars. *@
                    @if (days.Count > 0)
                    {
                        <div class="usage-charts__toolbar">
                            <UsageChartModeToggle Mode="_chartMode" ModeChanged="OnChartModeChangedAsync" />
                        </div>
                    }
                    <div class="operators-charts">
                        @if (days.Count > 0)
                        {
                            <UsageBarChart Title="Consults per day" Unit="consults"
                                           Categories="dailyConsults" Mode="_chartMode"
                                           Legend="@(new[] { ("consults", "Consults") })" />
                            <UsageBarChart Title="Tokens per day" Unit="tokens"
                                           Categories="dailyTokens" Mode="_chartMode"
                                           Legend="@(new[] { ("tokens-in", "Tokens in"), ("tokens-out", "Tokens out") })" />
                        }
                        <UsageBarChart Title="Consults by organisation" Unit="consults"
                                       Categories="orgConsults"
                                       Legend="@(new[] { ("consults", "Consults") })" />
                        <UsageBarChart Title="Tokens by organisation" Unit="tokens"
                                       Categories="orgTokens"
                                       Legend="@(new[] { ("tokens-in", "Tokens in"), ("tokens-out", "Tokens out") })" />
                    </div>

                    @foreach (var group in groups)
                    {
                        <div class="operators-org">
                            <h2 class="panel-title operators-org__label">@group.Label</h2>
                            <p class="operators-org__totals muted-text">
                                @($"{group.ConsultsCompleted:N0} consults · {group.TokensIn:N0} in · {group.TokensOut:N0} out tokens")
                            </p>
                            <div class="operators__scroll">
                                <table class="operators__table">
                                    <thead>
                                        <tr>
                                            <th><button type="button" class="operators-sort operators-sort--name" @onclick='() => ToggleSort(OperatorUsageRollup.SortByName)'>Account@(SortMark(OperatorUsageRollup.SortByName))</button></th>
                                            <th><button type="button" class="operators-sort operators-sort--consults" @onclick='() => ToggleSort(OperatorUsageRollup.SortByConsults)'>Consults@(SortMark(OperatorUsageRollup.SortByConsults))</button></th>
                                            <th><button type="button" class="operators-sort operators-sort--tokens" @onclick='() => ToggleSort(OperatorUsageRollup.SortByTokens)'>Tokens@(SortMark(OperatorUsageRollup.SortByTokens))</button></th>
                                            <th>In</th>
                                            <th>Out</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in group.Rows)
                                        {
                                            <tr class="operators__row">
                                                <td>@(string.IsNullOrEmpty(row.DisplayName) ? row.AppUserId : row.DisplayName) <span class="muted-text operators__id">@row.AppUserId[..Math.Min(8, row.AppUserId.Length)]…</span></td>
                                                <td>@row.ConsultsCompleted.ToString("N0")</td>
                                                <td>@(((long)row.TokensIn + row.TokensOut).ToString("N0"))</td>
                                                <td>@row.TokensIn.ToString("N0")</td>
                                                <td>@row.TokensOut.ToString("N0")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                }
            }
        }
    </div>
</section>

@code {
    private OperatorUsageResponse? usage;
    private bool loading;
    private string window = "30";
    private string fromInput = string.Empty;
    private string toInput = string.Empty;
    private string? usageError;
    private bool accessDenied;
    private string sortKey = OperatorUsageRollup.SortByConsults;
    private bool sortDescending = true;

    // #743: the per-day chart style, remembered per viewer.
    private UsageChartMode _chartMode = UsageChartMode.Bar;
    private const string ChartModeStorageKey = "consultologist-usage-chart-mode";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // Read the remembered chart style once; localStorage may be unavailable
        // (private window, blocked site data), so a failure just keeps bars.
        try
        {
            var saved = await JS.InvokeAsync<string?>("localStorage.getItem", ChartModeStorageKey);
            if (saved == UsageChartMode.Line.ToString() && _chartMode != UsageChartMode.Line)
            {
                _chartMode = UsageChartMode.Line;
                StateHasChanged();
            }
        }
        catch
        {
            // keep the default
        }
    }

    private async Task OnChartModeChangedAsync(UsageChartMode mode)
    {
        _chartMode = mode;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", ChartModeStorageKey, mode.ToString());
        }
        catch
        {
            // a remembered preference is a convenience, not a requirement
        }
    }

    private async Task LoadAsync()
    {
        usageError = null;

        string from, to;
        if (window == "custom")
        {
            if (string.IsNullOrWhiteSpace(fromInput) || string.IsNullOrWhiteSpace(toInput))
            {
                return;
            }

            from = fromInput;
            to = toInput;
        }
        else
        {
            var windowDays = int.Parse(window, System.Globalization.CultureInfo.InvariantCulture);
            var today = DateOnly.FromDateTime(DateTime.UtcNow);
            to = today.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
            from = today.AddDays(-(windowDays - 1)).ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
        }

        loading = true;
        try
        {
            usage = await OperatorService.GetUsageAsync(from, to);
        }
        catch (OperatorAccessException)
        {
            accessDenied = true;
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            usageError = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task OnWindowChangedAsync(ChangeEventArgs args)
    {
        window = args.Value?.ToString() ?? "30";

        if (window != "custom")
        {
            await LoadAsync();
        }
    }

    private void ToggleSort(string key)
    {
        if (sortKey == key)
        {
            sortDescending = !sortDescending;
        }
        else
        {
            sortKey = key;
            sortDescending = key != OperatorUsageRollup.SortByName;
        }
    }

    private string SortMark(string key) =>
        sortKey == key ? (sortDescending ? " ↓" : " ↑") : string.Empty;
}
