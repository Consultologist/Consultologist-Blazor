@inherits DisclosureRow31<Disclosure31>
@using System.Text.Json
@using Consultologist.Web.Services.AI
@using Consultologist.Web.Services.Provenance.V31
@*
    #1509 (Task 19; part 09 § 6.4 "Checks", part 08 § 6): one check row, its line always shown: its title (an item by its
    name, else by position), its key, its status as stored, the production item it is aligned with (a link) and its
    stateReason (a skipped check's reason). Opened, its four lines: checks (what it ran on, with that output's hash),
    reads (its other inputs, each linking to its row), result (pass or fail, passed of total, its failWith when failed,
    uncovered and untested while retained, then their hashes and sizes with A12-002) and effect (the stored word). A line with
    nothing to say is not drawn. Its text is fetched when it is first opened, once.
*@
<li class="history31-check" id="row-@Node.Key" tabindex="-1" data-kind="@Node.Kind" @ref="Element">
    <div class="history31-check__line">
        <button type="button" class="history31-check__toggle" aria-expanded="@(IsOpen ? "true" : "false")" aria-controls="@ControlsId"
                @onclick="() => View.Toggle(Node.Key)">
            <span class="history31-check__title">@Title</span>
        </button>
        <code class="history31-check__key">@Node.Key</code>
        <span class="history31-check__status">@Node.Status</span>
        @if (Row?.Text("alignedWith") is { Length: > 0 } aligned)
        {
            <span class="history31-check__aligned">beside <RowLink31 Key="@aligned" Class="history31-check__aligned-link">@AlignedTitle(aligned)</RowLink31></span>
        }
        @if (Row?.Text("stateReason") is { Length: > 0 } reason)
        {
            <span class="history31-check__reason">@HistorySentences31.StateReason(reason)</span>
        }
    </div>
    @if (IsOpen)
    {
        <div class="history31-check__body" id="@BodyId">
            @if (Row is { } row)
            {
                <dl class="history31-check__lines">
                    @if (CheckedOf(row) is { } ran)
                    {
                        <dt>checks</dt>
                        <dd class="history31-check__checked">
                            <RowLink31 Key="@ran.Ref">@ran.Ref</RowLink31> <code class="hash-text">@ran.Hash</code>
                        </dd>
                    }
                    @if (ReadsOf(row) is { Count: > 0 } reads)
                    {
                        <dt>reads</dt>
                        <dd class="history31-check__reads">
                            <ul>
                                @foreach (var read in reads)
                                {
                                    <li class="history31-check__read">
                                        @if (RowOf(read.Path) is { } target)
                                        {
                                            <RowLink31 Key="@target">@read.Path</RowLink31>
                                        }
                                        else
                                        {
                                            <code>@read.Path</code>
                                        }
                                        <code class="hash-text">@read.Hash</code>
                                    </li>
                                }
                            </ul>
                        </dd>
                    }
                    @if (HasResult(row))
                    {
                        <dt>result</dt>
                        <dd class="history31-check__result">
                            @if (row.Flag("pass") is { } pass)
                            {
                                <span class="history31-check__verdict">@(pass ? "pass" : "fail")</span>
                            }
                            @if (row.Int("passed") is { } passed && row.Int("total") is { } total)
                            {
                                <span class="history31-check__counts">@passed of @total</span>
                            }
                            @if (row.Flag("pass") == false && row.Text("failWith") is { Length: > 0 } failWith)
                            {
                                <span class="history31-check__fail-with">@failWith</span>
                            }
                            @foreach (var list in Lists(row))
                            {
                                <div class="history31-check__list" data-list="@list.Name">
                                    @if (list.Items is { } items)
                                    {
                                        <span class="history31-check__list-name">@list.Name</span>
                                        <ul>
                                            @foreach (var item in items)
                                            {
                                                <li>@item</li>
                                            }
                                        </ul>
                                    }
                                    else
                                    {
                                        <span class="history31-check__list-name">@list.Name</span>
                                        <code class="hash-text">@list.Hash</code>
                                        @if (list.Size is { } size)
                                        {
                                            <span class="history31-check__list-size">@size</span>
                                        }
                                    }
                                </div>
                            }
                            @if (Fetched is { TextDeleted: true } && Lists(row).Any(l => l.Hash is not null))
                            {
                                <p class="history31-check__dropped">@HistorySentences31.TextDeleted</p>
                            }
                            @if (FetchFailed && Lists(row).Any(l => l.Hash is not null))
                            {
                                <p class="history31-check__unavailable">@HistorySentences31.RecordNotAvailable</p>
                            }
                        </dd>
                    }
                    @if (row.Text("effect") is { Length: > 0 } effect)
                    {
                        <dt>effect</dt>
                        <dd class="history31-check__effect">@effect</dd>
                    }
                </dl>
            }
            @if (Node.Decisions.Count > 0)
            {
                <ul class="history31-decisions">
                    @foreach (var decision in Node.Decisions)
                    {
                        <Decision31 @key="decision.Key" Decision="decision" />
                    }
                </ul>
            }
            @if (Node.Children.Count > 0)
            {
                <ul class="history31-check__children">
                    @foreach (var child in Node.Children)
                    {
                        <CheckRow31 @key="child.Key" Node="child" View="View" />
                    }
                </ul>
            }
        </div>
    }
</li>

@code {
    /// <summary>An item retitled by the name its retained text holds, once fetched; any other row as the tree names it.</summary>
    private string Title =>
        Node.IsItem && Row is { } row ? NodeTree31.ItemTitle(row, RetainedName(Fetched), Node.LoopLabel) : Node.Title;

    private string? _alignedName;

    /// <summary>The aligned production item's retained name, from the same fetch Nodes makes for that row (<see cref="RowText31"/>).</summary>
    protected override async Task OnOpenedAsync()
    {
        if (Row?.Text("alignedWith") is not { Length: > 0 } aligned)
        {
            return;
        }

        try
        {
            _alignedName = RetainedName(await View.Texts.Get(aligned));
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception)
        {
            // not read: the item is named by its position, as before it was opened
        }
    }

    /// <summary>The production item named as Nodes names it: its own name, else the retained name, else its position.</summary>
    private string AlignedTitle(string key) =>
        View.Record.Find(key) is { } row
            ? NodeTree31.ItemTitle(row, _alignedName, View.Record.ParentOf(key)?.Text("label"))
            : key;

    /// <summary>The key of the node, check or deliverable row a read's path names (the path itself or its longest leading part at a <c>.</c>); null when it names none.</summary>
    private string? RowOf(string path)
    {
        var at = path;
        while (at.Length > 0)
        {
            if (View.Record.Find(at) is { Section: "node" or "check" or "deliverable" })
            {
                return at;
            }

            var cut = at.LastIndexOf('.');
            at = cut > 0 ? at[..cut] : "";
        }

        return null;
    }

    private static (string Ref, string Hash)? CheckedOf(Row31 row) =>
        row.Object("checked") is { } ran && Str(ran, "ref") is { Length: > 0 } reference ? (reference, Str(ran, "hash") ?? "") : null;

    private static List<(string Path, string Hash)> ReadsOf(Row31 row) =>
        row.List("reads").Where(read => Str(read, "path") is not null).Select(read => (Str(read, "path")!, Str(read, "hash") ?? "")).ToList();

    private static bool HasResult(Row31 row) =>
        row.Flag("pass") is not null || (row.Int("passed") is not null && row.Int("total") is not null)
        || row.Text("uncoveredHash") is not null || row.Text("untestedHash") is not null;

    /// <summary>
    /// <c>uncovered</c> and <c>untested</c>: their items while the retained text gives them, else the row's hash and size
    /// (A12-002 says why); a list the row holds no hash for was null and is not shown.
    /// </summary>
    private IEnumerable<(string Name, IReadOnlyList<string>? Items, string? Hash, int? Size)> Lists(Row31 row)
    {
        foreach (var name in new[] { "uncovered", "untested" })
        {
            var hash = row.Text(name + "Hash");
            if (hash is null)
            {
                continue;
            }

            if (Retained(Fetched, name) is { } items)
            {
                yield return (name, items, null, null);
            }
            else
            {
                yield return (name, null, hash, row.Int(name + "Size"));
            }
        }
    }

    private static IReadOnlyList<string>? Retained(RecordRowText? fetched, string name) =>
        fetched is { TextDeleted: false, Text: { ValueKind: JsonValueKind.Object } text }
        && text.TryGetProperty(name, out var list) && list.ValueKind == JsonValueKind.Array
            ? list.EnumerateArray().Select(item => item.ValueKind == JsonValueKind.String ? item.GetString()! : item.GetRawText()).ToList()
            : null;

    private static string? RetainedName(RecordRowText? fetched) =>
        fetched is { TextDeleted: false, Text: { ValueKind: JsonValueKind.Object } text }
        && text.TryGetProperty("itemName", out var name) && name.ValueKind == JsonValueKind.String
            ? name.GetString()
            : null;

    private static string? Str(JsonElement element, string name) =>
        element.ValueKind == JsonValueKind.Object && element.TryGetProperty(name, out var value) && value.ValueKind == JsonValueKind.String
            ? value.GetString()
            : null;
}
