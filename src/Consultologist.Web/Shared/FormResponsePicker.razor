@* #540: "Load from a form response…" — the form-level sibling of the
   per-slot PreviousRunPicker (#510's inline-disclosure idiom; no dialog
   infrastructure exists). Held responses newest first; a discarded one is
   listed and not choosable, saying "values deleted MMM d, yyyy" (spike
   § 4.2's exact wording). Choosing fetches the values and hands them to
   the page, which coerces by each declaration and fills the editable
   controls — misfits are named there, not filled. *@
@using Consultologist.Web.Services.Forms
@inject IFormsIntakeEndpointService FormsService

<span class="form-picker" @onclick:stopPropagation="true">
    @* Wrapper span carries the preventDefault the slot label needs; FluentButton's
       OnClick can't (this picker lives inside the input's <label>). *@
    @* #893: a FluentMenu flyout (keyboard nav + Escape/Tab dismissal + focus for free).
       UseMenuService="false" renders it inline; Open is driven from the trigger so it
       stays bUnit-driveable. The wrapper span keeps the slot-label preventDefault. *@
    <span @onclick:preventDefault="true" @onclick:stopPropagation="true">
        <FluentButton Id="@triggerId"
                      Appearance="Appearance.Stealth"
                      Class="form-picker__trigger"
                      aria-expanded="@(open ? "true" : "false")"
                      Disabled="@Disabled"
                      IconStart="@(new Icons.Regular.Size20.DocumentText())"
                      OnClick="ToggleAsync">Load from a form response…</FluentButton>
        <FluentMenu Anchor="@triggerId" @bind-Open="open" UseMenuService="false" Anchored="true"
                    aria-label="Held form responses" Class="form-picker__panel">
            @if (loading)
            {
                <FluentMenuItem Disabled="true"><SkeletonText Lines="3" /></FluentMenuItem>
            }
            else if (error != null)
            {
                <FluentMenuItem Disabled="true" Class="form-picker__error">@error</FluentMenuItem>
            }
            else if (rows.Count == 0)
            {
                <FluentMenuItem Disabled="true" class="muted-text">No held responses.</FluentMenuItem>
            }
            else
            {
                @foreach (var row in rows)
                {
                    <FluentMenuItem Class="@($"form-picker__choose form-picker__response{(row.DeletedAtUtc != null ? " form-picker__response--deleted" : "")}")"
                                    Disabled="@(row.DeletedAtUtc != null || choosing)"
                                    OnClick="() => ChooseAsync(row)">
                        <span class="form-picker__row">
                            <span class="form-picker__ids">@row.FormId · @row.ResponseId</span>
                            <span class="muted-text">
                                @row.SubmittedAtUtc.ToString("MMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture)
                                @if (row.DeletedAtUtc is { } deleted)
                                {
                                    <text> · values deleted @deleted.ToString("MMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture)</text>
                                }
                            </span>
                        </span>
                    </FluentMenuItem>
                }
            }
        </FluentMenu>
    </span>
</span>

@code {
    [Parameter] public bool Disabled { get; set; }

    [Parameter] public EventCallback<FormResponseValues> OnChosen { get; set; }

    private bool open;
    private readonly string triggerId = Identifier.NewId();
    private bool loading;
    private bool choosing;
    private string? error;
    private IReadOnlyList<FormResponseListRow> rows = Array.Empty<FormResponseListRow>();

    private async Task ToggleAsync()
    {
        open = !open;
        if (open)
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        loading = true;
        error = null;
        try
        {
            var listed = await FormsService.ListResponsesAsync();
            rows = listed.OrderByDescending(row => row.SubmittedAtUtc).ToList();
        }
        catch (Microsoft.AspNetCore.Components.WebAssembly.Authentication.AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            error = $"Could not list your form responses: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task ChooseAsync(FormResponseListRow row)
    {
        choosing = true;
        error = null;
        try
        {
            var values = await FormsService.GetResponseAsync(row.FormId, row.ResponseId);
            open = false;
            await OnChosen.InvokeAsync(values);
        }
        catch (Microsoft.AspNetCore.Components.WebAssembly.Authentication.AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            error = $"Could not load that response: {ex.Message}";
        }
        finally
        {
            choosing = false;
        }
    }
}
