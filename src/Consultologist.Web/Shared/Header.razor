@using Microsoft.AspNetCore.Components.Authorization
@using Consultologist.Web.Services.Accounts
@inject IAccountEndpointService AccountService

<FluentDesignTheme @ref="@_theme" Mode="@_themeMode" StorageName="consultologist-clinical-theme" />

<FluentHeader Class="app-header">
    <FluentStack Class="app-header__inner"
                 Orientation="Orientation.Horizontal"
                 VerticalAlignment="VerticalAlignment.Center"
                 Width="100%">
        <a class="brand-lockup" href="/">
            <img src="icon-192.png" alt="" />
            <span class="brand-name">Consultologist</span>
        </a>
        <nav class="top-nav" aria-label="Workspace navigation">
            <FluentNavLink Href="/" Match="NavLinkMatch.All">Home</FluentNavLink>
            <AuthorizeView>
                <Authorized>
                    <FluentNavLink Href="consults">Consults</FluentNavLink>
                    <FluentNavLink Href="history">History</FluentNavLink>
                    <FluentNavLink Href="templates">Workflow</FluentNavLink>
                    <FluentNavLink Href="profile">Profile</FluentNavLink>
                    @* #553: shown on Account/Me's IsOperator — the nav's
                       fact; the server gate is the real one, and any failure
                       here just means no link. *@
                    @if (_isOperator)
                    {
                        <FluentNavLink Href="operators">Operators</FluentNavLink>
                    }
                </Authorized>
            </AuthorizeView>
        </nav>
        <FluentSpacer />
        <FluentStack Class="app-header__actions"
                     Orientation="Orientation.Horizontal"
                     HorizontalGap="12"
                     VerticalAlignment="VerticalAlignment.Center">
            <FluentButton IconStart="@_themeIcon"
                          Appearance="Appearance.Stealth"
                          Title="Toggle theme"
                          OnClick="@ToggleTheme" />
            <LoginDisplay />
        </FluentStack>
    </FluentStack>
</FluentHeader>

@code {
    private FluentDesignTheme? _theme;
    private DesignThemeModes _themeMode = DesignThemeModes.System;
    private bool _isOperator;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // #553: one Me read to decide the Operators link. Deliberately no
        // redirect on a token problem — the header must never bounce the
        // whole app; a failure just means no link.
        if (AuthenticationStateTask == null)
        {
            return;
        }

        var state = await AuthenticationStateTask;
        if (state.User.Identity?.IsAuthenticated != true)
        {
            return;
        }

        try
        {
            var me = await AccountService.GetCurrentAccountAsync();
            _isOperator = me.IsOperator;
        }
        catch
        {
            _isOperator = false;
        }
    }

    private Icon _themeIcon => _themeMode == DesignThemeModes.Dark
        ? new Icons.Regular.Size20.WeatherSunny()
        : new Icons.Regular.Size20.WeatherMoon();

    private void ToggleTheme()
    {
        _themeMode = _themeMode == DesignThemeModes.Dark
            ? DesignThemeModes.Light
            : DesignThemeModes.Dark;
    }
}
