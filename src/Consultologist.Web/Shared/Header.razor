@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using System.Security.Claims
@inject NavigationManager Navigation

<FluentDesignTheme @ref="@_theme" @bind-Mode="_themeMode" CustomColor="#0078d4" OnLoaded="OnThemeLoaded" StorageName="consultologist-clinical-theme" />

<FluentHeader Class="app-header">
    <FluentStack Class="app-header__inner"
                 Orientation="Orientation.Horizontal"
                 VerticalAlignment="VerticalAlignment.Center"
                 Width="100%">
        <a class="brand-lockup" href="/">
            <img src="icon-192.png" alt="" />
            <span class="brand-name">Consultologist</span>
        </a>
        <nav class="top-nav" aria-label="Workspace navigation">
            @* #766: Home is signed-out only — a signed-in clinician's landing is
               the Create page (`/` redirects there), so Home would just bounce.
               Order across both audiences: Home | Create | History | Editor |
               Help | Profile, with Home shown only signed-out and the workspace
               links only signed-in; Help is public and sits between them. *@
            <AuthorizeView>
                <NotAuthorized>
                    <FluentNavLink Href="/" Match="NavLinkMatch.All">Home</FluentNavLink>
                </NotAuthorized>
            </AuthorizeView>
            <AuthorizeView>
                <Authorized>
                    <FluentNavLink Href="create">Create</FluentNavLink>
                    <FluentNavLink Href="history">History</FluentNavLink>
                    <FluentNavLink Href="editor">Editor</FluentNavLink>
                    @* #733: the Operators link moved to the standalone admin
                       app (its own origin), so the clinician bundle no longer
                       ships an admin route or the Me read that gated the link. *@
                </Authorized>
            </AuthorizeView>
            @* #685: public — the verifiability/help story is for signed-out visitors too. *@
            <FluentNavLink Href="help">Help</FluentNavLink>
            <AuthorizeView>
                <Authorized>
                    <FluentNavLink Href="profile">Profile</FluentNavLink>
                </Authorized>
            </AuthorizeView>
        </nav>
        <FluentSpacer />
        <FluentStack Class="app-header__actions"
                     Orientation="Orientation.Horizontal"
                     HorizontalGap="12"
                     VerticalAlignment="VerticalAlignment.Center">
            <AuthorizeView>
                <Authorized>
                    @* #884: the Microsoft 365-style account flyout — identity, the
                       theme choice, Profile, and Sign out, in one avatar menu. *@
                    @* FluentProfileMenu's HeaderButton/FooterLink render in separate
                       header/footer regions, right-aligned and floating at the popover
                       corners — misaligned with the body. Drive the whole flyout through
                       ChildContent instead so it is one coherent, left-aligned stack:
                       persona card, theme, then Profile + Sign out as full-width rows. *@
                    <FluentProfileMenu Class="account-flyout"
                                       PopoverClass="account-flyout__popover"
                                       FullName="@context.User.Identity?.Name">
                        <div class="account-flyout__body">
                            @{
                                var name = context.User.Identity?.Name;
                                var email = context.User.FindFirst("preferred_username")?.Value
                                    ?? context.User.FindFirst(ClaimTypes.Email)?.Value;
                            }
                            @* ChildContent REPLACES FluentProfileMenu's default persona
                               card, so reproduce it — avatar (initials) + name + email. *@
                            <FluentPersona Class="account-flyout__persona"
                                           Initials="@InitialsOf(name)">
                                <div class="account-flyout__identity">
                                    <strong>@name</strong>
                                    @if (!string.IsNullOrWhiteSpace(email))
                                    {
                                        <span class="muted-text">@email</span>
                                    }
                                </div>
                            </FluentPersona>
                            <FluentDivider Class="account-flyout__divider" />
                            @* Wrap the radio group so its label + options stay one
                               flex item (the component emits them as siblings, so the
                               body gap would otherwise wedge between label and radios). *@
                            <div class="account-flyout__theme">
                                <FluentRadioGroup Name="account-theme" Label="Theme"
                                                  @bind-Value="_themeMode"
                                                  Orientation="Orientation.Vertical">
                                    <FluentRadio Value="@DesignThemeModes.System">System</FluentRadio>
                                    <FluentRadio Value="@DesignThemeModes.Light">Light</FluentRadio>
                                    <FluentRadio Value="@DesignThemeModes.Dark">Dark</FluentRadio>
                                </FluentRadioGroup>
                            </div>
                            <FluentDivider Class="account-flyout__divider" />
                            <div class="account-flyout__actions">
                                <FluentButton Appearance="Appearance.Stealth"
                                              Class="account-flyout__action"
                                              IconStart="@(new Icons.Regular.Size20.Person())"
                                              OnClick="@GoToProfile">Profile</FluentButton>
                                <FluentButton Appearance="Appearance.Stealth"
                                              Class="account-flyout__action"
                                              IconStart="@(new Icons.Regular.Size20.SignOut())"
                                              OnClick="@BeginLogout">Sign out</FluentButton>
                            </div>
                        </div>
                    </FluentProfileMenu>
                </Authorized>
                <NotAuthorized>
                    @* Public pages keep a standalone theme toggle + a Log in button. *@
                    <FluentButton IconStart="@_themeIcon"
                                  Appearance="Appearance.Stealth"
                                  Title="@($"Theme: {_themeMode}")"
                                  aria-label="@($"Theme: {_themeMode}. Activate to change.")"
                                  OnClick="@ToggleTheme" />
                    <FluentButton Appearance="Appearance.Accent" @onclick="@BeginLogin">Log in</FluentButton>
                </NotAuthorized>
            </AuthorizeView>
        </FluentStack>
    </FluentStack>
</FluentHeader>

@code {
    private FluentDesignTheme? _theme;
    private DesignThemeModes _themeMode = DesignThemeModes.System;

    // #690: the icon shows the CURRENT mode (the tooltip names it), so it is
    // correct after a reload once OnThemeLoaded has seeded _themeMode from the
    // persisted theme — not the stale System default.
    private Icon _themeIcon => _themeMode switch
    {
        DesignThemeModes.Dark => new Icons.Regular.Size20.WeatherMoon(),
        DesignThemeModes.Light => new Icons.Regular.Size20.WeatherSunny(),
        _ => new Icons.Regular.Size20.Desktop(),
    };

    // #690: seed the field from what FluentDesignTheme actually loaded/applied
    // (from StorageName), so the icon and the cycle start from the real theme.
    private void OnThemeLoaded(LoadedEventArgs e)
    {
        _themeMode = e.Mode;
        StateHasChanged();
    }

    // #690: a three-way cycle so a user can return to follow-the-OS System.
    // Still used by the signed-out standalone toggle; signed-in users pick the
    // mode directly in the account flyout's theme radio group.
    private void ToggleTheme() => _themeMode = _themeMode switch
    {
        DesignThemeModes.System => DesignThemeModes.Light,
        DesignThemeModes.Light => DesignThemeModes.Dark,
        DesignThemeModes.Dark => DesignThemeModes.System,
        _ => DesignThemeModes.System,
    };

    // #884: login/logout/profile moved here from the retired LoginDisplay so the
    // account flyout owns them.
    // #896: the avatar initials for the account flyout's persona card
    // (FluentProfileMenu's own initials helper isn't public in 4.13.1).
    private static string InitialsOf(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "?";
        }

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var first = parts[0][0];
        var last = parts.Length > 1 ? parts[^1][0] : '\0';
        return last == '\0'
            ? char.ToUpperInvariant(first).ToString()
            : $"{char.ToUpperInvariant(first)}{char.ToUpperInvariant(last)}";
    }

    private void BeginLogin() => Navigation.NavigateToLogin("authentication/login");

    private void BeginLogout() => Navigation.NavigateToLogout("authentication/logout");

    private void GoToProfile() => Navigation.NavigateTo("profile");
}
