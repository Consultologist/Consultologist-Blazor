@* #510: a previous run's deliverable into an input slot. An inline
   disclosure like the package picker — no dialog infrastructure exists.
   Every button cancels the click's default action: the picker sits inside
   the slot's <label>, and when a click's target is removed by the re-render
   it causes (choosing replaces the picker with the chip), the browser no
   longer sees an interactive target and runs the label's activation — a
   synthetic click on the first labelable control, which is the chip's
   Remove button. preventDefault cancels that; bUnit has no browser to
   show it, so it is pinned by this note.
   Lists the account's completed runs, newest first; a run whose produced
   text the retention sweep deleted is listed and not choosable, saying so
   in words (tell the user early). *@
@using Consultologist.Web.Services.Accounts
@using Consultologist.Web.Services.AI
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@inject IAccountEndpointService AccountService
@inject IAIEndpointService AIService

<span class="run-picker" @onclick:stopPropagation="true">
    @* FluentButton's OnClick can't carry @onclick:preventDefault, which the slot
       label needs (this picker lives inside the input's <label>); the wrapper
       span intercepts the bubbling click so the label isn't activated. *@
    @* #893: a FluentMenu flyout. The two-level run→deliverable interaction stays an
       expand-in-place accordion inside the one menu (runs keep the menu open with
       KeepOpen; choosing a deliverable closes it) — a cleaner fit than a side-submenu
       for the lazy per-run load + "Load more". Open is driven from the trigger so it
       stays bUnit-driveable; the wrapper span keeps the slot-label preventDefault. *@
    <span @onclick:preventDefault="true" @onclick:stopPropagation="true">
        <FluentButton Id="@triggerId"
                      Appearance="Appearance.Stealth"
                      Class="run-picker__trigger"
                      aria-expanded="@(isOpen ? "true" : "false")"
                      Disabled="@Disabled"
                      IconStart="@(new Icons.Regular.Size20.History())"
                      OnClick="ToggleAsync">Load from a previous run&hellip;</FluentButton>
        <FluentMenu Anchor="@triggerId" @bind-Open="isOpen" UseMenuService="false" Anchored="true"
                    aria-label="Previous runs" Class="run-picker__panel">
            @if (isLoading)
            {
                <FluentMenuItem Disabled="true"><SkeletonText Lines="3" /></FluentMenuItem>
            }
            else if (error != null)
            {
                <FluentMenuItem Disabled="true" Class="run-picker__error">@error</FluentMenuItem>
            }
            else if (runs.Count == 0)
            {
                <FluentMenuItem Disabled="true" class="muted-text">No completed runs yet.</FluentMenuItem>
            }
            else
            {
                @foreach (var run in runs)
                {
                    var current = run;
                    <FluentMenuItem Class="@($"run-picker__run-toggle run-picker__run{(current.TextDroppedAtUtc != null ? " run-picker__run--deleted" : "")}")"
                                    Disabled="@(current.TextDroppedAtUtc != null)"
                                    KeepOpen="true"
                                    aria-expanded="@(expanded == current.JobId ? "true" : "false")"
                                    OnClick="() => ExpandAsync(current.JobId)">
                        <span class="run-picker__run-date">@RunDate(current)</span>
                        @if (details.TryGetValue(current.JobId, out var known) && known?.PackageTitle is { Length: > 0 } title)
                        {
                            <span class="muted-text">@title</span>
                        }
                        @if (current.TextDroppedAtUtc is { } dropped)
                        {
                            <span class="run-picker__deleted">text deleted @dropped.ToLocalTime().ToString("MMM d, yyyy")</span>
                        }
                    </FluentMenuItem>
                    @if (expanded == current.JobId)
                    {
                        @if (!details.TryGetValue(current.JobId, out var detail))
                        {
                            <FluentMenuItem Disabled="true"><SkeletonText Lines="2" /></FluentMenuItem>
                        }
                        else if (detail?.AssembledDocuments is not { Count: > 0 })
                        {
                            <FluentMenuItem Disabled="true" class="muted-text">This run lists no deliverables.</FluentMenuItem>
                        }
                        else
                        {
                            @foreach (var document in detail.AssembledDocuments)
                            {
                                var chosen = document;
                                <FluentMenuItem Class="run-picker__deliverable"
                                                Disabled="@(chosen.Text == null)"
                                                OnClick="() => ChooseAsync(current, detail, chosen)">
                                    @chosen.Label
                                    @if (chosen.Text == null)
                                    {
                                        <span class="run-picker__deleted">text deleted</span>
                                    }
                                </FluentMenuItem>
                            }
                        }
                    }
                }
                @if (continuationToken != null)
                {
                    <FluentMenuItem Class="run-picker__more" KeepOpen="true" OnClick="LoadMoreAsync">Load more</FluentMenuItem>
                }
            }
        </FluentMenu>
    </span>
</span>

@code {
    [Parameter] public bool Disabled { get; set; }

    /// <summary>The chosen deliverable; the slot decides whether it replaces or joins.</summary>
    [Parameter] public EventCallback<LoadedDeliverable> OnChosen { get; set; }

    private bool isOpen;
    private readonly string triggerId = Identifier.NewId();
    private bool isLoading;
    private string? error;
    private string? expanded;
    private string? continuationToken;
    private readonly List<AccountJobSummaryResponse> runs = new();
    private readonly Dictionary<string, ConsultGenerationJobResponse?> details = new(StringComparer.Ordinal);

    private static string RunDate(AccountJobSummaryResponse run) =>
        (run.CompletedAtUtc ?? run.CreatedAtUtc).ToLocalTime().ToString("MMM d, yyyy h:mm tt");

    private async Task ToggleAsync()
    {
        isOpen = !isOpen;
        if (isOpen && runs.Count == 0 && error == null)
        {
            await LoadAsync(null);
        }
    }

    private Task LoadMoreAsync() => LoadAsync(continuationToken);

    private async Task LoadAsync(string? token)
    {
        isLoading = true;
        try
        {
            var page = await AccountService.GetJobsAsync(20, token);
            // Only a completed run has deliverables to copy; the rest are not
            // listed rather than listed and refused.
            runs.AddRange((page?.Jobs ?? Array.Empty<AccountJobSummaryResponse>())
                .Where(job => string.Equals(job.Status, "Completed", StringComparison.Ordinal)));
            continuationToken = page?.ContinuationToken;
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            error = $"Could not list your runs: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ExpandAsync(string jobId)
    {
        expanded = expanded == jobId ? null : jobId;
        if (expanded == null || details.ContainsKey(jobId))
        {
            return;
        }

        try
        {
            details[jobId] = await AIService.GetConsultGenerationJobAsync(jobId);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch
        {
            details[jobId] = null;
        }
    }

    private async Task ChooseAsync(AccountJobSummaryResponse run, ConsultGenerationJobResponse detail, ConsultGenerationResultDocumentResponse document)
    {
        if (document.Text == null)
        {
            return;
        }

        // #874: reset the expanded run too, not just the open flag — a mixed
        // array<text> slot keeps this picker mounted across a choice (it no
        // longer swaps render branches), so the next open should start fresh
        // rather than reopening on the run just chosen.
        isOpen = false;
        expanded = null;
        await OnChosen.InvokeAsync(new LoadedDeliverable(run.JobId, document.ResultId, document.Label, run.CompletedAtUtc ?? detail.CompletedAtUtc, document.Text));
    }
}
