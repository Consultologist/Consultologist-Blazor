@* #642: the run, drawn live — one overlay for History and the run rail.
   The diagram text is rebuilt from the Detail parameter on every render;
   the pages' polls replace that record in place, so a status change
   recolours the graph and an unchanged tick is a byte-identical no-op the
   renderer's change guard skips. The backdrop click and the × both close.
   #686: it's the app's only modal, so it carries dialog semantics — a
   labelled role="dialog", Escape-to-close, and focus moved in on open,
   trapped while up, and restored to the trigger on close (the last three
   via consultologistDialog, since a virtual DOM has no real focus).
   #1510 (D12): a second way in, a storage 12 job's run diagram (Diagram31, RunDiagram31's text and anchors) in place
   of a 5–30 Detail; the legend is the same, since its classes are RunDagDiagram's colours. A linked box (a call, on
   History) is handed to OnCall with its anchor: the page closes the dialog and shows the row. *@
@using Consultologist.PackageFormat.V31.Diagram
@using Consultologist.Web.Services.AI
@using Consultologist.Web.Services.Provenance
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="run-dag-overlay" @onclick="() => OnClose.InvokeAsync()" @onkeydown="OnKeyDown">
    <div class="run-dag-panel" @ref="_panel" @onclick:stopPropagation="true"
         role="dialog" aria-modal="true" aria-labelledby="run-dag-title" tabindex="-1">
        <div class="run-dag-panel__header">
            <span class="run-dag-panel__title" id="run-dag-title">Run diagram</span>
            <span class="run-dag-legend muted-text">
                <span class="run-dag-legend__ranNot">yet to run</span> ·
                <span class="run-dag-legend__skipped">skipped</span> ·
                <span class="run-dag-legend__done">completed</span> ·
                <span class="run-dag-legend__failed">failed</span> ·
                <span class="run-dag-legend__running">running</span>
            </span>
            <FluentButton Appearance="Appearance.Stealth" Class="run-dag-close" aria-label="Close run diagram"
                          IconStart="@(new Icons.Regular.Size20.Dismiss())"
                          OnClick="@(() => OnClose.InvokeAsync())" />
        </div>
        <WorkflowDagView Diagram="@(Diagram31?.Mermaid ?? RunDagDiagram.Build(Detail!))" Anchors="@Diagram31?.Anchors" OnAnchor="FollowAsync" />
    </div>
</div>

@code {
    /// <summary>A storage 2–11 job: its run diagram is <see cref="RunDagDiagram.Build"/>'s. Unused when <see cref="Diagram31"/> is given.</summary>
    [Parameter] public ConsultGenerationJobResponse? Detail { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>A storage 12 job's run diagram (<c>RunDiagram31.Build</c>), drawn as given.</summary>
    [Parameter] public DiagramText? Diagram31 { get; set; }

    /// <summary>A linked box of <see cref="Diagram31"/> was followed, with its anchor (<c>row-&lt;key&gt;</c>).</summary>
    [Parameter] public EventCallback<string> OnCall { get; set; }

    private ElementReference _panel;

    // Escape closes, via the same callback the backdrop and × use.
    private async Task OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            await OnClose.InvokeAsync();
        }
    }

    // A linked box: focus goes back to the trigger now (deactivate's second call, on disposal, finds nothing to
    // restore), so the row the page shows next keeps focus whichever renders first.
    private async Task FollowAsync(string anchor)
    {
        await JS.InvokeVoidAsync("consultologistDialog.deactivate");
        await OnCall.InvokeAsync(anchor);
    }

    // The parent renders this under an @if, so a fresh instance's first render
    // is the dialog opening — the moment to take focus.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("consultologistDialog.activate", _panel);
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("consultologistDialog.deactivate");
        }
        catch (JSDisconnectedException)
        {
            // The runtime is already gone; nothing to restore focus to.
        }
    }
}
