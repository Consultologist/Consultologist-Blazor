@* The package pin selector (#134): one grouped dropdown over the repo-owned
   public packages and the caller's fork versions. Selecting pins immediately
   (the generic account-settings PUT); the pin resolver validates shape and
   access on every read, so a stale or bad option can never take effect. *@
@using Consultologist.Web.Services.Accounts
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@inject IWorkflowEndpointService WorkflowService
@inject IAccountEndpointService AccountService

<span class="package-picker">
    @* #453: one chip per tag declared by any listed version; pressing one
       narrows every group to the versions that carry it. The selected ref
       always stays listed, so the control never shows something it is not. *@
    @if (allTags.Count > 0)
    {
        <span class="package-picker__tags" role="group" aria-label="Filter packages by tag">
            @foreach (var tag in allTags)
            {
                var isActive = string.Equals(tag, activeTag, StringComparison.OrdinalIgnoreCase);
                <button type="button"
                        class="package-picker__tag @(isActive ? "package-picker__tag--active" : "")"
                        aria-pressed="@(isActive ? "true" : "false")"
                        disabled="@Disabled"
                        @onclick="() => ToggleTag(tag)">@tag</button>
            }
        </span>
    }
    <select value="@selectedRef"
            @onchange="OnSelectionChangedAsync"
            disabled="@(Disabled || isPinning || groups.Count == 0)"
            aria-label="Workflow package">
        @if (groups.Count == 0)
        {
            <option value="@selectedRef" selected="true">@selectedRef</option>
        }
        @foreach (var group in VisibleGroups)
        {
            <optgroup label="@group.Label">
                @foreach (var option in group.Options)
                {
                    <option value="@option.Value"
                            disabled="@option.Disabled"
                            selected="@(option.Value == selectedRef)">@option.Label</option>
                }
            </optgroup>
        }
    </select>
    @if (pinError != null)
    {
        <span class="package-picker__error">@pinError</span>
    }
</span>

@code {
    private const string PinSettingKey = "consult.workflowPackage";
    private const string DefaultRef = "general@latest";

    // The oldest format the engine still runs; older registry history stays
    // listed but unselectable. Unknown spec = selectable — the pin resolver
    // remains the runtime authority.
    //
    // Mirrored by hand because Consultologist.Web references no project: the
    // client assembly cannot see WorkflowPackageStore.SupportedSpecVersions.
    // internal so SpecVersionMirrorTests can prove the mirror still matches —
    // the test project references both, which is why nothing here needs a fetch.
    internal const int MinSupportedSpecVersion = 5;

    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback OnPinned { get; set; }

    /// <summary>
    /// #411: false makes this a chooser rather than the pin control — selecting
    /// raises OnPinned with the ref and writes nothing. Templates uses that,
    /// because editing a package stopped meaning running it. Consults keeps the
    /// default, which is where choosing what your consults run belongs.
    /// </summary>
    [Parameter] public bool WritesPin { get; set; } = true;

    /// <summary>
    /// What to show when this is not the pin control. Ignored when WritesPin,
    /// where the pin setting is the selection by definition.
    /// </summary>
    [Parameter] public string? Selected { get; set; }

    /// <summary>The ref just chosen. Empty for the pin-writing caller, which re-reads the server.</summary>
    [Parameter] public EventCallback<string> OnSelected { get; set; }

    // #453: Tags is the version's declared set (null for @latest and for
    // versions below 9, which have none to declare).
    private sealed record PickerOption(string Value, string Label, bool Disabled = false, IReadOnlyList<string>? Tags = null);
    private sealed record PickerGroup(string Label, List<PickerOption> Options);

    private List<PickerGroup> groups = new();
    private List<string> allTags = new();
    private string? activeTag;
    private string selectedRef = DefaultRef;
    private bool isPinning;
    private string? pinError;

    /// <summary>
    /// The chooser's selection arrives as a parameter and can change without the
    /// component being rebuilt. OnInitializedAsync runs once, so reading it only
    /// there left the display on whatever it was first told — correct only while
    /// the caller happened to force a new instance.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (!WritesPin && !string.IsNullOrWhiteSpace(Selected))
        {
            selectedRef = Selected!.Trim();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Selection = the raw pin setting, not Current's resolved ref — a
        // floating @latest pin must display as @latest. No/unreadable setting
        // means the default pin.
        if (!WritesPin)
        {
            // The caller owns the selection; reading the pin here would show
            // what the consults run, which is the thing this mode separates.
            selectedRef = string.IsNullOrWhiteSpace(Selected) ? selectedRef : Selected!.Trim();
        }
        else
        {
            try
            {
                var setting = await AccountService.GetSettingAsync(PinSettingKey);
                if (!string.IsNullOrWhiteSpace(setting?.Value))
                {
                    selectedRef = setting!.Value.Trim();
                }
            }
            catch (AccessTokenNotAvailableException exception)
            {
                exception.Redirect();
                return;
            }
            catch
            {
                // The default stands; the options below still render.
            }
        }

        var built = new List<PickerGroup>();

        var chain = await WorkflowService.GetPublicChainAsync();
        foreach (var package in chain?.Packages ?? Enumerable.Empty<PublicPackageView>())
        {
            if (!string.IsNullOrWhiteSpace(package.Name))
            {
                built.Add(BuildGroup(package.Name!, package));
            }
        }

        var mine = await WorkflowService.GetMyPackagesAsync();
        if (mine is { Versions.Count: > 0 } && !string.IsNullOrWhiteSpace(mine.Name))
        {
            built.Add(BuildGroup($"My fork ({mine.Name})", mine));
        }

        // A pin outside the listings (pruned version, listing outage) still
        // has to render as what it is.
        if (built.SelectMany(group => group.Options).All(option => option.Value != selectedRef))
        {
            built.Insert(0, new PickerGroup(WritesPin ? "Current pin" : "Current selection",
                new List<PickerOption> { new(selectedRef, selectedRef) }));
        }

        groups = built;
        // Distinct ignoring case, first-seen casing, sorted the same way.
        allTags = built
            .SelectMany(group => group.Options)
            .SelectMany(option => option.Tags ?? Array.Empty<string>())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(tag => tag, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    /// <summary>
    /// #453: the groups as the active tag leaves them. A version is listed when
    /// it carries the tag, or is the selection (the control must keep showing
    /// what is pinned); a group's @latest stays while any of its versions
    /// does, since that is what it follows; an emptied group is dropped.
    /// </summary>
    private IEnumerable<PickerGroup> VisibleGroups
    {
        get
        {
            if (activeTag is null)
            {
                return groups;
            }

            var visible = new List<PickerGroup>();

            foreach (var group in groups)
            {
                var matching = group.Options
                    .Where(option => option.Value == selectedRef || Carries(option, activeTag))
                    .ToList();
                var anyVersionMatches = group.Options.Any(option => Carries(option, activeTag));

                if (anyVersionMatches)
                {
                    var latest = group.Options.FirstOrDefault(option => option.Value.EndsWith("@latest", StringComparison.Ordinal));
                    if (latest != null && !matching.Contains(latest))
                    {
                        matching.Insert(0, latest);
                    }
                }

                if (matching.Count > 0)
                {
                    visible.Add(new PickerGroup(group.Label, matching));
                }
            }

            return visible;
        }
    }

    private static bool Carries(PickerOption option, string tag) =>
        option.Tags?.Any(declared => string.Equals(declared, tag, StringComparison.OrdinalIgnoreCase)) == true;

    private void ToggleTag(string tag) =>
        activeTag = string.Equals(tag, activeTag, StringComparison.OrdinalIgnoreCase) ? null : tag;

    private static PickerGroup BuildGroup(string label, PublicPackageView package)
    {
        var options = new List<PickerOption>
        {
            new($"{package.Name}@latest", "latest — follows updates")
        };

        // Registry listings are CalVer-ascending; the dropdown reads newest first.
        foreach (var version in (package.Versions ?? new List<string>()).AsEnumerable().Reverse())
        {
            var spec = package.SpecVersions?.GetValueOrDefault(version);
            var unsupported = spec is int value && value < MinSupportedSpecVersion;
            // v9 § 4 (#432): a titled version reads as its title with the
            // version beside it; the group label keeps the name, so the ref is
            // always in view. Untitled versions read as they did.
            var title = package.Titles?.GetValueOrDefault(version);

            options.Add(new(
                $"{package.Name}@{version}",
                unsupported ? $"{version} — unsupported (spec {spec})"
                    : !string.IsNullOrWhiteSpace(title) ? $"{title} — {version}"
                    : version,
                unsupported,
                // #453: what the version declares, for the filter.
                package.Tags?.GetValueOrDefault(version)));
        }

        return new PickerGroup(label, options);
    }

    private async Task OnSelectionChangedAsync(ChangeEventArgs args)
    {
        var newRef = args.Value?.ToString();

        if (string.IsNullOrWhiteSpace(newRef) || newRef == selectedRef)
        {
            return;
        }

        if (!WritesPin)
        {
            // No network, so no isPinning window and nothing to fail: the
            // parent decides what to do with the choice.
            selectedRef = newRef;
            await OnSelected.InvokeAsync(newRef);
            return;
        }

        isPinning = true;
        pinError = null;

        try
        {
            await AccountService.SaveSettingAsync(PinSettingKey, newRef, "text/plain");
            selectedRef = newRef;
            await OnPinned.InvokeAsync();
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            pinError = $"Could not switch package: {ex.Message}";
        }
        finally
        {
            isPinning = false;
        }
    }
}
