@* The node cards, shared by the Graph pane (all nodes) and the sidebar's
   single-node panes (Only set). Read-only by default; with Editable set, the
   node's own fields (label, forEach, output contract, failIfEmpty) become
   inputs (#117), each binding row becomes a source dropdown (+ renderer for
   node sources, #138), rows come from the host's effective model (declared +
   pending-added variables, #140), and each card offers a "+ variable" form.
   The server validator remains the authority on publish. *@
@using Consultologist.Web.Services.Workflow

@foreach (var node in (Only == null ? Nodes : Nodes.Where(n => n.Id == Only)))
{
    <article class="template-section">
        <div class="template-section__header">
            <div>
                <h3 class="panel-title">
                    @node.Label
                    @if (node.IsResult)
                    {
                        <span class="muted-text"> — deliverable</span>
                    }
                </h3>
                <p class="muted-text">
                    @node.Id
                    @if (node.Prompt != null)
                    {
                        <span> · prompt: @node.Prompt</span>
                    }
                    @if (node.ForEach != null)
                    {
                        <span> · for each @node.ForEach item</span>
                    }
                    @if (node.Aggregate != null)
                    {
                        <span> · aggregator</span>
                    }
                    @if (node.IsClassifier)
                    {
                        <span> · classifier</span>
                    }
                    @if (node.IsCheck)
                    {
                        <span> · check</span>
                    }
                    @if (node.IsTemplate)
                    {
                        <span> · template</span>
                    }
                    @if (NodeModified?.Invoke(node.Id) == true)
                    {
                        <span class="binding-row__pending" title="Pending change"> ●</span>
                    }
                </p>
            </div>
            @if (Editable && !node.IsResult && OnNodeRemoved.HasDelegate)
            {
                <button type="button" class="add-variable__submit" @onclick="() => OnNodeRemoved.InvokeAsync(node.Id)">
                    Remove node
                </button>
            }
        </div>
        @if (Editable)
        {
            <div class="node-fields">
                <label class="node-field">
                    <span>label</span>
                    <input class="binding-row__select node-field__input"
                           value="@node.Label"
                           @onchange="args => EmitNodeChangeAsync(node, label: args.Value?.ToString() ?? string.Empty)"
                           aria-label="Node label" />
                </label>
                @if (node.IsClassifier)
                {
                    @* v10 (#498): the values a classifier may answer — the enum
                       input's chips. No forEach and no output: a classification is
                       one answer under the classification contract, implied by
                       the kind. Fewer than two is refused at the desk, not here. *@
                    <label class="node-field node-field--wide">
                        <span>values</span>
                        <span class="node-values" data-values-for="@node.Id">
                            @foreach (var value in node.Values ?? Array.Empty<string>())
                            {
                                var declaredValue = value;
                                <span class="input-field__chip" data-node-value="@declaredValue">
                                    @declaredValue
                                    <button type="button" class="aggregate-row__button" title="Remove value"
                                            aria-label="Remove value @declaredValue"
                                            @onclick="() => EmitValuesAsync(node, (node.Values ?? Array.Empty<string>()).Where(v => v != declaredValue).ToList())">×</button>
                                </span>
                            }
                            <input class="node-field__input" placeholder="in_scope"
                                   @onchange="args => AddValueAsync(node, args.Value?.ToString())"
                                   aria-label="@($"Add a value to node {node.Id}")" />
                        </span>
                    </label>
                    @if (valuesError is { } valuesProblem)
                    {
                        <span class="editor-warning">@valuesProblem</span>
                    }
                }
                @if (node.IsCheck)
                {
                    @* v12 § 13 (#621): the check's four members. The op is the
                       closed set's one entry — shown, not edited; the operands
                       are selects over the output-declaring nodes (the
                       concept-list contract itself is the server's word). *@
                    <label class="node-field">
                        <span>op</span>
                        <input class="binding-row__select node-field__input" value="@(node.Op ?? string.Empty)" disabled
                               aria-label="@($"Op for check {node.Id}")" />
                    </label>
                    <label class="node-field">
                        <span>of</span>
                        <FluentSelect TOption="string" class="binding-row__select node-check-of"
                                      Value="@(node.Of ?? string.Empty)"
                                      ValueChanged="@(v => EmitNodeChangeAsync(node, checkOf: v))"
                                      aria-label="@($"Of for check {node.Id}")">
                            <FluentOption TOption="string" Value="">choose…</FluentOption>
                            @foreach (var (operandRef, operandLabel) in CheckOperandOptions)
                            {
                                <FluentOption TOption="string" Value="@operandRef">@operandLabel</FluentOption>
                            }
                        </FluentSelect>
                    </label>
                    <label class="node-field">
                        <span>in</span>
                        <FluentSelect TOption="string" class="binding-row__select node-check-in"
                                      Value="@(node.In ?? string.Empty)"
                                      ValueChanged="@(v => EmitNodeChangeAsync(node, checkIn: v))"
                                      aria-label="@($"In for check {node.Id}")">
                            <FluentOption TOption="string" Value="">choose…</FluentOption>
                            @foreach (var (operandRef, operandLabel) in CheckOperandOptions)
                            {
                                <FluentOption TOption="string" Value="@operandRef">@operandLabel</FluentOption>
                            }
                        </FluentSelect>
                    </label>
                    <label class="node-field node-field--wide">
                        <span>fail with</span>
                        <input class="binding-row__select node-field__input node-check-failwith"
                               value="@(node.FailWith ?? string.Empty)"
                               @onchange="args => EmitNodeChangeAsync(node, failWith: args.Value?.ToString())"
                               aria-label="@($"FailWith for check {node.Id}")" />
                    </label>
                }
                @if (node.Aggregate == null && !node.IsClassifier && !node.IsCheck)
                {
                    @if (AllowPromptChange)
                    {
                        <label class="node-field">
                            <span>prompt</span>
                            <FluentSelect TOption="string" class="binding-row__select"
                                          Value="@(node.Prompt ?? string.Empty)"
                                          ValueChanged="@(v => EmitNodeChangeAsync(node, prompt: v))"
                                          aria-label="Node prompt">
                                @if (node.Prompt != null && !PromptOptions.Contains(node.Prompt))
                                {
                                    <FluentOption TOption="string" Value="@node.Prompt">@node.Prompt</FluentOption>
                                }
                                @foreach (var promptId in PromptOptions)
                                {
                                    <FluentOption TOption="string" Value="@promptId">@promptId</FluentOption>
                                }
                            </FluentSelect>
                        </label>
                    }
                    <label class="node-field">
                        <span>for each</span>
                        <FluentSelect TOption="string" class="binding-row__select"
                                      Value="@(node.ForEach ?? string.Empty)"
                                      ValueChanged="@(v => EmitNodeChangeAsync(node, forEach: v))"
                                      aria-label="Node forEach collection">
                            <FluentOption TOption="string" Value="">— runs once —</FluentOption>
                            @if (node.ForEach != null && !ForEachOptions(Collections, ArrayInputs).Contains(node.ForEach))
                            {
                                <FluentOption TOption="string" Value="@node.ForEach">@node.ForEach</FluentOption>
                            }
                            @foreach (var option in ForEachOptions(Collections, ArrayInputs))
                            {
                                <FluentOption TOption="string" Value="@option">@option</FluentOption>
                            }
                        </FluentSelect>
                    </label>
                    <label class="node-field">
                        <span>output</span>
                        <FluentSelect TOption="string" class="binding-row__select"
                                      Value="@(node.OutputSchema ?? string.Empty)"
                                      ValueChanged="@(v => EmitNodeChangeAsync(node, outputSchema: v))"
                                      aria-label="Node output contract">
                            @* #825/#827: the empty (no-contract) row and the offered
                               contracts are kind-filtered — "— rendered —" for a template
                               (no model), answer-only contracts excluded from it. *@
                            @foreach (var (value, label) in NodeOutputOptions(node.IsTemplate, ContractOptions))
                            {
                                <FluentOption TOption="string" Value="@value">@label</FluentOption>
                            }
                            @if (node.OutputSchema != null && !ContractOptions.Contains(node.OutputSchema))
                            {
                                @* A carried/invalid current value stays visible so it is changeable. *@
                                <FluentOption TOption="string" Value="@node.OutputSchema">@node.OutputSchema</FluentOption>
                            }
                        </FluentSelect>
                    </label>
                    @if (node.IsTemplate)
                    {
                        <p class="muted-text node-field--wide">The template renders this; a contract here validates the render, it does not call a model.</p>
                    }
                    @if (node.OutputSchema != null)
                    {
                        <label class="node-field node-field--wide">
                            <span>fail if empty</span>
                            <input class="binding-row__select node-field__input"
                                   value="@(node.FailIfEmpty ?? string.Empty)"
                                   placeholder="optional — error shown when the output is empty"
                                   @onchange="args => EmitNodeChangeAsync(node, failIfEmpty: args.Value?.ToString())"
                                   aria-label="Node fail-if-empty message" />
                        </label>
                    }
                }
                @if (OfferReproducible && !node.IsCheck && !node.IsTemplate)
                {
                    @* v11 #564 (record § 6): any node may claim it — the
                       classifier and extraction stages are the intended cases,
                       so this sits outside the prompt-only guard. *@
                    <label class="node-field node-field--reproducible">
                        <input type="checkbox"
                               checked="@node.Reproducible"
                               @onchange="args => EmitReproducibleAsync(node, args.Value is bool isChecked && isChecked)"
                               aria-label="@($"Reproducible for node {node.Id}")" />
                        <span>reproducible — same input, same output (the rerun verdict reads this)</span>
                    </label>
                }
            </div>
        }
        @if (node.Aggregate != null)
        {
            @* Deterministic aggregation: sources in declared order (v6) — the
               order is the assembled document's order. *@
            @if (Editable && OnAggregateChanged.HasDelegate)
            {
                <ul class="binding-list">
                    @for (var i = 0; i < node.Aggregate.Count; i++)
                    {
                        var index = i;
                        var currentNode = node;
                        <li class="binding-row">
                            <span class="muted-text">@(index + 1).</span>
                            <code>@node.Aggregate[index]</code>
                            <button type="button" class="aggregate-row__button" title="Move up"
                                    aria-label="Move source @(index + 1) up"
                                    disabled="@(index == 0)"
                                    @onclick="() => MoveAggregateSourceAsync(currentNode, index, -1)">↑</button>
                            <button type="button" class="aggregate-row__button" title="Move down"
                                    aria-label="Move source @(index + 1) down"
                                    disabled="@(index == node.Aggregate.Count - 1)"
                                    @onclick="() => MoveAggregateSourceAsync(currentNode, index, +1)">↓</button>
                            <button type="button" class="aggregate-row__button" title="Remove source"
                                    aria-label="Remove source @(index + 1)"
                                    disabled="@(node.Aggregate.Count == 1)"
                                    @onclick="() => RemoveAggregateSourceAsync(currentNode, index)">×</button>
                        </li>
                    }
                </ul>
                <div class="add-variable__form">
                    @* Action-select: Value is pinned to "" so a re-render resets it to the
                       prompt after each pick appends a source. *@
                    <FluentSelect TOption="string" class="binding-row__select"
                                  Value=""
                                  ValueChanged="@(v => AppendAggregateSourceAsync(node, v))"
                                  aria-label="Add aggregate source">
                        <FluentOption TOption="string" Value="">+ add source…</FluentOption>
                        @foreach (var candidate in Nodes.Where(other => other.Id != node.Id && !node.Aggregate.Contains($"node:{other.Id}")))
                        {
                            <FluentOption TOption="string" Value="@($"node:{candidate.Id}")">node:@candidate.Id</FluentOption>
                        }
                    </FluentSelect>
                </div>
            }
            else
            {
                <ul class="binding-list">
                    @foreach (var sourceRef in node.Aggregate)
                    {
                        <li class="binding-row muted-text">
                            <code>@sourceRef</code>
                            <span aria-hidden="true">→</span>
                            <span>collected in order</span>
                        </li>
                    }
                </ul>
            }
        }
        else
        {
        <ul class="binding-list">
            @foreach (var row in Rows(node))
            {
                var modified = row.IsNew || row.From != row.OriginalFrom || row.As != row.OriginalAs;

                <li class="binding-row @(Editable ? null : "muted-text")">
                    <code class="binding-row__variable">@row.Variable</code>
                    <span aria-hidden="true">←</span>
                    @if (Editable)
                    {
                        <BindingSourceEditor Node="@node"
                                             Row="@row"
                                             Nodes="@Nodes"
                                             Scalars="@Scalars"
                                             Inputs="@Inputs"
                                             OnChanged="@OnBindingChanged" />
                        @if (modified)
                        {
                            <span class="binding-row__pending" title="Pending change">●</span>
                        }
                        @if (row.IsNew && row.From.Length == 0)
                        {
                            <span class="muted-text binding-row__hint">new — choose source</span>
                        }
                    }
                    else
                    {
                        <code>@(row.As is null ? row.From : $"{row.From} (as {row.As})")</code>
                    }
                </li>
            }
        </ul>
        }
        @if (Editable && node.Prompt != null && OnVariableAdded.HasDelegate)
        {
            var form = FormFor(node.Id);
            <details class="add-variable">
                <summary>+ variable</summary>
                <div class="add-variable__form">
                    <input class="binding-row__select"
                           placeholder="variable_name"
                           value="@form.Name"
                           @onchange="args => SetFormName(node.Id, args)"
                           aria-label="New variable name" />
                    <FluentSelect TOption="string" class="binding-row__select"
                                  Value="@form.Source"
                                  ValueChanged="@(v => SetFormSource(node.Id, v))"
                                  aria-label="New variable source">
                        <FluentOption TOption="string" Value="">choose source…</FluentOption>
                        @foreach (var option in BindingSourceEditor.SourceOptions(Nodes, Scalars, node, string.Empty, Inputs))
                        {
                            <FluentOption TOption="string" Value="@option">@option</FluentOption>
                        }
                    </FluentSelect>
                    <button type="button" class="add-variable__submit" @onclick="() => SubmitAddVariableAsync(node)">Add</button>
                </div>
                @if (form.Error != null)
                {
                    <p class="add-variable__error">@form.Error</p>
                }
            </details>
        }
    </article>
}

@foreach (var removedNode in (Only == null ? RemovedNodes : RemovedNodes.Where(n => n.Id == Only)))
{
    <article class="template-section template-section--removed">
        <div class="template-section__header">
            <div>
                <h3 class="panel-title"><span class="node-strike">@removedNode.Label</span> <span class="muted-text">— removed</span></h3>
                <p class="muted-text">@removedNode.Id · its prompt is removed with it</p>
            </div>
            <button type="button" class="add-variable__submit" @onclick="() => OnNodeRestored.InvokeAsync(removedNode.Id)">
                Restore
            </button>
        </div>
    </article>
}

@code {
    /// <summary>One effective binding row: current values plus the manifest's originals (null for pending-added variables).</summary>
    public sealed record BindingRow(string Variable, string From, string? As, string? OriginalFrom, string? OriginalAs, bool IsNew);

    public sealed record BindingChange(string NodeId, string Variable, string From, string? As);

    public sealed record VariableAdd(string NodeId, string Variable, string From, string? As);

    /// <summary>The node's full effective field tuple after one field changed (#117/#170).</summary>
    public sealed record NodeChange(string NodeId, string Label, string? ForEach, string? OutputSchema, string? FailIfEmpty, string? Prompt = null, IReadOnlyList<string>? Values = null,
        // v11 #564: the reproducibility claim — the effective value always
        // rides the tuple (never null-means-unchanged), so later edits to
        // other fields can never clobber it.
        bool Reproducible = false,
        // v12 § 13 (#621): the check's editable members — effective values on
        // every emission, the Reproducible rule, so no edit clobbers another.
        string? Of = null, string? In = null, string? FailWith = null);

    /// <summary>An aggregator's full effective ordered source list after one change (#117).</summary>
    public sealed record AggregateChange(string NodeId, List<string> Sources);

    [Parameter] public IReadOnlyList<WorkflowManifestReader.NodeView> Nodes { get; set; } = Array.Empty<WorkflowManifestReader.NodeView>();
    [Parameter] public bool Editable { get; set; }
    [Parameter] public IReadOnlyList<string> Scalars { get; set; } = Array.Empty<string>();

    /// <summary>The package's declared input ids (v7); empty means the frozen consult_draft slot.</summary>
    [Parameter] public IReadOnlyList<string> Inputs { get; set; } = Array.Empty<string>();
    [Parameter] public IReadOnlyList<string> Collections { get; set; } = Array.Empty<string>();

    /// <summary>v9 (#429): the declared inputs a node may fan — arrays only. Empty below 9.</summary>
    [Parameter] public IReadOnlyList<string> ArrayInputs { get; set; } = Array.Empty<string>();
    [Parameter] public IReadOnlyList<string> ContractOptions { get; set; } = Array.Empty<string>();
    [Parameter] public IReadOnlyList<string> PromptOptions { get; set; } = Array.Empty<string>();

    /// <summary>v11 #564: whether the reproducible toggle renders — the page gates it at specVersion 11.</summary>
    [Parameter] public bool OfferReproducible { get; set; }

    // v12 § 13 (#621): the operand choices a check's of/in may name —
    // (node:<id>, "<id> — <schema>") pairs, built by the page.
    [Parameter] public IReadOnlyList<(string Ref, string Label)> CheckOperandOptions { get; set; } = Array.Empty<(string, string)>();
    [Parameter] public bool AllowPromptChange { get; set; }
    [Parameter] public string? Only { get; set; }
    [Parameter] public Func<string, bool>? NodeModified { get; set; }
    [Parameter] public IReadOnlyList<WorkflowManifestReader.NodeView> RemovedNodes { get; set; } = Array.Empty<WorkflowManifestReader.NodeView>();
    [Parameter] public EventCallback<string> OnNodeRemoved { get; set; }
    [Parameter] public EventCallback<string> OnNodeRestored { get; set; }
    [Parameter] public Func<WorkflowManifestReader.NodeView, IReadOnlyList<BindingRow>>? RowsFor { get; set; }
    [Parameter] public Func<WorkflowManifestReader.NodeView, string, string?>? ValidateVariableName { get; set; }
    [Parameter] public EventCallback<BindingChange> OnBindingChanged { get; set; }
    [Parameter] public EventCallback<VariableAdd> OnVariableAdded { get; set; }
    [Parameter] public EventCallback<NodeChange> OnNodeChanged { get; set; }
    [Parameter] public EventCallback<AggregateChange> OnAggregateChanged { get; set; }

    private async Task MoveAggregateSourceAsync(WorkflowManifestReader.NodeView node, int index, int delta)
    {
        var sources = node.Aggregate!.ToList();
        (sources[index], sources[index + delta]) = (sources[index + delta], sources[index]);
        await OnAggregateChanged.InvokeAsync(new AggregateChange(node.Id, sources));
    }

    private async Task RemoveAggregateSourceAsync(WorkflowManifestReader.NodeView node, int index)
    {
        var sources = node.Aggregate!.ToList();
        sources.RemoveAt(index);
        await OnAggregateChanged.InvokeAsync(new AggregateChange(node.Id, sources));
    }

    private async Task AppendAggregateSourceAsync(WorkflowManifestReader.NodeView node, string? sourceRef)
    {
        if (string.IsNullOrEmpty(sourceRef) || node.Aggregate!.Contains(sourceRef))
        {
            return;
        }

        var sources = node.Aggregate!.ToList();
        sources.Add(sourceRef);
        await OnAggregateChanged.InvokeAsync(new AggregateChange(node.Id, sources));
    }

    /// <summary>What a node may fan: every data collection, then every array input (v9 § 5).</summary>
    internal static IReadOnlyList<string> ForEachOptions(IReadOnlyList<string> collections, IReadOnlyList<string> arrayInputs) =>
        collections.Select(collectionId => $"data:{collectionId}")
            .Concat(arrayInputs.Select(inputId => $"{WorkflowInputFans.Prefix}{inputId}"))
            .ToList();

    /// <summary>
    /// #827: the output-contract options for a node kind — the empty
    /// (no-contract) row plus the offered contracts, filtered per kind. A
    /// template renders its output (no model), so the empty row reads
    /// "— rendered —" and answer-only contracts (a model answers them from a
    /// value set) are excluded; a prompt reads "prose (text)" and is offered
    /// every contract. The engine's template refusal is the authority
    /// (WorkflowPackageValidator.DeclaresClassification); this mirrors it.
    /// </summary>
    internal static IReadOnlyList<(string Value, string Label)> NodeOutputOptions(bool isTemplate, IReadOnlyList<string> contracts)
    {
        var options = new List<(string Value, string Label)> { (string.Empty, isTemplate ? "— rendered —" : "prose (text)") };

        foreach (var id in contracts)
        {
            if (isTemplate && WorkflowOutputContracts.AnswerOnly.Contains(id))
            {
                continue;
            }

            options.Add((id, id));
        }

        return options;
    }

    // Each field edit emits the node's complete effective tuple; the host
    // compares it against the manifest original (self-removing edits, like
    // binding rows). Selecting a value equal to the current one still emits —
    // harmlessly resolving to "no change" host-side.
    private string? valuesError;

    /// <summary>v10 (#498): a classifier's next value — snake_case, not yet declared.</summary>
    private async Task AddValueAsync(WorkflowManifestReader.NodeView node, string? value)
    {
        var candidate = (value ?? string.Empty).Trim();

        if (!System.Text.RegularExpressions.Regex.IsMatch(candidate, "^[a-z][a-z0-9_]*$"))
        {
            valuesError = $"Value '{candidate}' must be snake_case (a lowercase letter, then lowercase letters, digits, or underscores).";
            return;
        }

        if (node.Values?.Contains(candidate, StringComparer.Ordinal) == true)
        {
            valuesError = $"Classifier '{node.Id}' already declares '{candidate}'.";
            return;
        }

        valuesError = null;
        await EmitValuesAsync(node, (node.Values ?? Array.Empty<string>()).Append(candidate).ToList());
    }

    private Task EmitReproducibleAsync(WorkflowManifestReader.NodeView node, bool reproducible) =>
        OnNodeChanged.InvokeAsync(new NodeChange(node.Id, node.Label, node.ForEach, node.OutputSchema, node.FailIfEmpty, node.Prompt, node.Values, reproducible, node.Of, node.In, node.FailWith));

    private Task EmitValuesAsync(WorkflowManifestReader.NodeView node, List<string> values) =>
        OnNodeChanged.InvokeAsync(new NodeChange(node.Id, node.Label, node.ForEach, node.OutputSchema, node.FailIfEmpty, node.Prompt, values, node.Reproducible, node.Of, node.In, node.FailWith));

    private async Task EmitNodeChangeAsync(
        WorkflowManifestReader.NodeView node,
        string? label = null,
        string? forEach = null,
        string? outputSchema = null,
        string? failIfEmpty = null,
        string? prompt = null,
        string? checkOf = null,
        string? checkIn = null,
        string? failWith = null)
    {
        var effectiveLabel = label ?? node.Label;
        var effectiveForEach = forEach != null ? (forEach.Length == 0 ? null : forEach) : node.ForEach;
        var effectiveSchema = outputSchema != null ? (outputSchema.Length == 0 ? null : outputSchema) : node.OutputSchema;
        var effectiveFailIfEmpty = failIfEmpty != null
            ? (failIfEmpty.Length == 0 ? null : failIfEmpty)
            : node.FailIfEmpty;
        var effectivePrompt = string.IsNullOrEmpty(prompt) ? node.Prompt : prompt;

        // Dropping the contract drops its empty-output message too.
        if (effectiveSchema is null)
        {
            effectiveFailIfEmpty = null;
        }

        var effectiveOf = checkOf != null ? (checkOf.Length == 0 ? null : checkOf) : node.Of;
        var effectiveIn = checkIn != null ? (checkIn.Length == 0 ? null : checkIn) : node.In;
        var effectiveFailWith = failWith != null ? (failWith.Length == 0 ? null : failWith) : node.FailWith;

        // #572: the effective values ride every emission, the Reproducible
        // rule — a null here let a label edit clobber a pending values edit.
        await OnNodeChanged.InvokeAsync(new NodeChange(node.Id, effectiveLabel, effectiveForEach, effectiveSchema, effectiveFailIfEmpty, effectivePrompt, node.Values, Reproducible: node.Reproducible, Of: effectiveOf, In: effectiveIn, FailWith: effectiveFailWith));
    }

    private sealed class AddForm
    {
        public string? Name { get; set; }
        public string Source { get; set; } = string.Empty;
        public string? Error { get; set; }
    }

    private readonly Dictionary<string, AddForm> addForms = new(StringComparer.Ordinal);

    private AddForm FormFor(string nodeId)
    {
        if (!addForms.TryGetValue(nodeId, out var form))
        {
            addForms[nodeId] = form = new AddForm();
        }

        return form;
    }

    private IReadOnlyList<BindingRow> Rows(WorkflowManifestReader.NodeView node) =>
        RowsFor?.Invoke(node)
            ?? node.Bindings.Select(b => new BindingRow(b.Variable, b.From, b.As, b.From, b.As, false)).ToList();

    private void SetFormName(string nodeId, ChangeEventArgs args) =>
        FormFor(nodeId).Name = args.Value?.ToString();

    // #902: FluentSelect's ValueChanged hands us the chosen string directly.
    private void SetFormSource(string nodeId, string? value) =>
        FormFor(nodeId).Source = value ?? string.Empty;

    private async Task SubmitAddVariableAsync(WorkflowManifestReader.NodeView node)
    {
        var form = FormFor(node.Id);
        var name = form.Name?.Trim() ?? string.Empty;
        form.Error = ValidateVariableName?.Invoke(node, name);

        if (form.Error != null)
        {
            return;
        }

        await OnVariableAdded.InvokeAsync(new VariableAdd(node.Id, name, form.Source, null));
        addForms.Remove(node.Id);
    }
}
