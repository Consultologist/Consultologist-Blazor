@* The node cards, shared by the Graph pane (all nodes) and the sidebar's
   single-node panes (Only set). Read-only by default; with Editable set, the
   node's own fields (label, forEach, output contract, failIfEmpty) become
   inputs (#117), each binding row becomes a source dropdown (+ renderer for
   node sources, #138), rows come from the host's effective model (declared +
   pending-added variables, #140), and each card offers a "+ variable" form.
   The server validator remains the authority on publish. *@
@using Consultologist.Web.Services.Workflow
@using System.Text.Json
@using PF = Consultologist.PackageFormat

@foreach (var node in (Only == null ? Nodes : Nodes.Where(n => n.Id == Only)))
{
    <article class="template-section">
        @* #948: the node pane owns a single header (via ShowHeader=false); the Graph
           pane keeps this one. *@
        @if (ShowHeader)
        {
            <div class="template-section__header">
                <div>
                    <h3 class="panel-title">
                        @node.Label
                        @if (node.IsResult)
                        {
                            <span class="muted-text"> — deliverable</span>
                        }
                    </h3>
                    <p class="muted-text">
                        @node.Id
                        @if (node.Prompt != null)
                        {
                            <span> · prompt: @node.Prompt</span>
                        }
                        @if (node.ForEach != null)
                        {
                            <span> · for each @node.ForEach item</span>
                        }
                        @if (At26 && node.IsLoop)
                        {
                            <span> · loop over @(node.Collection ?? node.For)</span>
                        }
                        @if (At26 && LoopOf?.Invoke(node.Id) is { } inLoop)
                        {
                            <span> · in loop '@inLoop'</span>
                        }
                        @if (node.Aggregate != null)
                        {
                            <span> · aggregator</span>
                        }
                        @if (node.IsClassifier)
                        {
                            <span> · classifier</span>
                        }
                        @if (node.IsCheck)
                        {
                            <span> · check</span>
                        }
                        @if (node.IsTemplate)
                        {
                            <span> · template</span>
                        }
                        @if (At25 && node.Format != null)
                        {
                            <span> · @FormatLabel(node.Format)</span>
                        }
                        @if (NodeModified?.Invoke(node.Id) == true)
                        {
                            <span class="binding-row__pending" title="Pending change"> ●</span>
                        }
                    </p>
                </div>
                @if (Editable && !node.IsResult && OnNodeRemoved.HasDelegate)
                {
                    <FluentButton Appearance="Appearance.Stealth" Class="add-variable__submit" IconStart="@(new Icons.Regular.Size20.Dismiss())" @onclick="() => OnNodeRemoved.InvokeAsync(node.Id)">
                        Remove node
                    </FluentButton>
                }
            </div>
        }
        @* #948: each field group is a self-guarded fragment, composed either flat
           (the Graph pane, exact original order) or into labeled sections (the node
           pane, Sectioned=true). Single-sourced — the inputs/handlers live once. *@
        @{
                RenderFragment labelField =
                    @<label class="node-field">
                        <span>label</span>
                        <input class="binding-row__select node-field__input"
                               value="@node.Label"
                               @onchange="args => EmitNodeChangeAsync(node, label: args.Value?.ToString() ?? string.Empty)"
                               aria-label="Node label" />
                    </label>;

                RenderFragment valuesField =
                    @<text>
                        @if (!At25 && node.IsClassifier)
                        {
                            @* v10 (#498): the values a classifier may answer — the enum input's chips. *@
                            <label class="node-field node-field--wide">
                                <span>values</span>
                                <span class="node-values" data-values-for="@node.Id">
                                    @foreach (var value in node.Values ?? Array.Empty<string>())
                                    {
                                        var declaredValue = value;
                                        <span class="input-field__chip" data-node-value="@declaredValue">
                                            @declaredValue
                                            <span @onclick:preventDefault="true" @onclick:stopPropagation="true">
                                                <FluentButton Appearance="Appearance.Stealth" Class="aggregate-row__button" Title="Remove value"
                                                              aria-label="@($"Remove value {declaredValue}")"
                                                              IconStart="@(new Icons.Regular.Size20.Dismiss())"
                                                              @onclick="() => EmitValuesAsync(node, (node.Values ?? Array.Empty<string>()).Where(v => v != declaredValue).ToList())" />
                                            </span>
                                        </span>
                                    }
                                    <input class="node-field__input" placeholder="in_scope"
                                           @onchange="args => AddValueAsync(node, args.Value?.ToString())"
                                           aria-label="@($"Add a value to node {node.Id}")" />
                                </span>
                            </label>
                            @if (valuesError is { } valuesProblem)
                            {
                                <span class="editor-warning">@valuesProblem</span>
                            }
                        }
                    </text>;

                RenderFragment checkFields =
                    @<text>
                        @if (!At25 && node.IsCheck)
                        {
                            @* v12 § 13 (#621): the check's four members — op is read-only. *@
                            <label class="node-field">
                                <span>op</span>
                                <input class="binding-row__select node-field__input" value="@(node.Op ?? string.Empty)" disabled
                                       aria-label="@($"Op for check {node.Id}")" />
                            </label>
                            <label class="node-field">
                                <span>of</span>
                                <FluentSelect TOption="string" class="binding-row__select node-check-of"
                                              Value="@(node.Of ?? string.Empty)"
                                              ValueChanged="@(v => EmitNodeChangeAsync(node, checkOf: v))"
                                              aria-label="@($"Of for check {node.Id}")">
                                    <FluentOption TOption="string" Value="">choose…</FluentOption>
                                    @foreach (var (operandRef, operandLabel) in CheckOperandOptions)
                                    {
                                        <FluentOption TOption="string" Value="@operandRef">@operandLabel</FluentOption>
                                    }
                                </FluentSelect>
                            </label>
                            <label class="node-field">
                                <span>in</span>
                                <FluentSelect TOption="string" class="binding-row__select node-check-in"
                                              Value="@(node.In ?? string.Empty)"
                                              ValueChanged="@(v => EmitNodeChangeAsync(node, checkIn: v))"
                                              aria-label="@($"In for check {node.Id}")">
                                    <FluentOption TOption="string" Value="">choose…</FluentOption>
                                    @foreach (var (operandRef, operandLabel) in CheckOperandOptions)
                                    {
                                        <FluentOption TOption="string" Value="@operandRef">@operandLabel</FluentOption>
                                    }
                                </FluentSelect>
                            </label>
                            <label class="node-field node-field--wide">
                                <span>fail with</span>
                                <input class="binding-row__select node-field__input node-check-failwith"
                                       value="@(node.FailWith ?? string.Empty)"
                                       @onchange="args => EmitNodeChangeAsync(node, failWith: args.Value?.ToString())"
                                       aria-label="@($"FailWith for check {node.Id}")" />
                            </label>
                        }
                    </text>;

                RenderFragment promptField =
                    @<text>
                        @if (TakesPrompt(node) && AllowPromptChange)
                        {
                            <label class="node-field">
                                <span>prompt</span>
                                <FluentSelect TOption="string" class="binding-row__select"
                                              Value="@(node.Prompt ?? string.Empty)"
                                              ValueChanged="@(v => EmitNodeChangeAsync(node, prompt: v))"
                                              aria-label="Node prompt">
                                    @if (At25 && node.Prompt == null)
                                    {
                                        @* v25: explicit init — a node re-picked onto a prompted format names its prompt here. *@
                                        <FluentOption TOption="string" Value="">choose…</FluentOption>
                                    }
                                    @if (node.Prompt != null && !PromptOptions.Contains(node.Prompt))
                                    {
                                        <FluentOption TOption="string" Value="@node.Prompt">@node.Prompt</FluentOption>
                                    }
                                    @foreach (var promptId in PromptOptions)
                                    {
                                        <FluentOption TOption="string" Value="@promptId">@promptId</FluentOption>
                                    }
                                </FluentSelect>
                            </label>
                        }
                    </text>;

                RenderFragment forEachField =
                    @<text>
                        @if (At26)
                        {
                            @* v26 (#1160, design § 12): a node is placed INSIDE a loop, not given a
                               fan key — "in [sections ▾]" replaces the for-each select; moving a node
                               between loops is this picker. A loop never sits in another loop at 26. *@
                            @if (!node.IsLoop && node.Aggregate == null && !IsComputed(node))
                            {
                                <label class="node-field">
                                    <span>in</span>
                                    <FluentSelect TOption="string" class="binding-row__select node-in-loop"
                                                  Value="@(LoopOf?.Invoke(node.Id) ?? string.Empty)"
                                                  ValueChanged="@(v => EmitLoopChangeAsync(node, v))"
                                                  aria-label="Node loop">
                                        <FluentOption TOption="string" Value="">— not in a loop —</FluentOption>
                                        @foreach (var loop in Loops)
                                        {
                                            <FluentOption TOption="string" Value="@loop.Id">@loop.Label (@(loop.Collection ?? loop.For))</FluentOption>
                                        }
                                    </FluentSelect>
                                </label>
                            }
                        }
                        else if (At25 ? node.Aggregate == null && !IsComputed(node) : node.Aggregate == null && !node.IsClassifier && !node.IsCheck)
                        {
                            <label class="node-field">
                                <span>for each</span>
                                <FluentSelect TOption="string" class="binding-row__select"
                                              Value="@(node.ForEach ?? string.Empty)"
                                              ValueChanged="@(v => EmitNodeChangeAsync(node, forEach: v))"
                                              aria-label="Node forEach collection">
                                    <FluentOption TOption="string" Value="">— runs once —</FluentOption>
                                    @if (node.ForEach != null && !ForEachOptions(Collections, ArrayInputs, At25).Contains(node.ForEach))
                                    {
                                        <FluentOption TOption="string" Value="@node.ForEach">@node.ForEach</FluentOption>
                                    }
                                    @foreach (var option in ForEachOptions(Collections, ArrayInputs, At25))
                                    {
                                        <FluentOption TOption="string" Value="@option">@option</FluentOption>
                                    }
                                </FluentSelect>
                            </label>
                        }
                    </text>;

                RenderFragment formatField =
                    @<text>
                        @if (At25 && node.Aggregate == null)
                        {
                            @* v25 (C1 #1007, design § 3): the format replaces kind, output.schema, values and
                               the check's members. Explicit init: "choose…" until the author picks; a re-pick
                               resets the parameters and the policy, which belong to the old format. *@
                            <label class="node-field">
                                <span>format</span>
                                <FluentSelect TOption="string" class="binding-row__select node-format"
                                              Value="@(node.Format ?? string.Empty)"
                                              ValueChanged="@(v => EmitFormatAsync(node, v))"
                                              aria-label="Node format">
                                    <FluentOption TOption="string" Value="">choose…</FluentOption>
                                    @if (node.Format != null && FormatOptions.All(f => f.Id != node.Format))
                                    {
                                        <FluentOption TOption="string" Value="@node.Format">@node.Format</FluentOption>
                                    }
                                    @foreach (var format in FormatOptions)
                                    {
                                        <FluentOption TOption="string" Value="@format.Id">@format.Id — @format.Producer</FluentOption>
                                    }
                                </FluentSelect>
                            </label>
                            @if (!string.IsNullOrEmpty(node.Format) && OnOpenFormat.HasDelegate)
                            {
                                var openFormatId = node.Format;
                                <FluentButton Appearance="Appearance.Lightweight" Class="binding-row__source node-format__open"
                                              Title="@($"format '{openFormatId}' — its pane")"
                                              aria-label="@($"Open format {openFormatId}")"
                                              @onclick="() => OnOpenFormat.InvokeAsync(openFormatId)">open</FluentButton>
                            }
                            @if (FormatOf(node) is { Description: { Length: > 0 } formatDescription })
                            {
                                <p class="muted-text node-field--wide node-format__description">@formatDescription</p>
                            }
                        }
                    </text>;

                RenderFragment parametersField =
                    @<text>
                        @if (At25 && node.Aggregate == null && FormatOf(node) is { Parameters: { Count: > 0 } formatParameters })
                        {
                            @* v25: the format's declared parameters as fields, each writing the node's with. *@
                            @foreach (var parameter in formatParameters)
                            {
                                var parameterName = parameter.Name;
                                @if (parameter.Kind == PF.WorkflowFormatParameterKinds.Values)
                                {
                                    <label class="node-field node-field--wide">
                                        <span>@parameterName</span>
                                        <span class="node-values" data-values-for="@node.Id">
                                            @foreach (var value in WithStrings(node, parameterName))
                                            {
                                                var declaredValue = value;
                                                <span class="input-field__chip" data-node-value="@declaredValue">
                                                    @declaredValue
                                                    <span @onclick:preventDefault="true" @onclick:stopPropagation="true">
                                                        <FluentButton Appearance="Appearance.Stealth" Class="aggregate-row__button" Title="Remove value"
                                                                      aria-label="@($"Remove value {declaredValue}")"
                                                                      IconStart="@(new Icons.Regular.Size20.Dismiss())"
                                                                      @onclick="() => EmitWithStringsAsync(node, parameterName, WithStrings(node, parameterName).Where(v => v != declaredValue).ToList())" />
                                                    </span>
                                                </span>
                                            }
                                            <input class="node-field__input" placeholder="in_scope"
                                                   @onchange="args => AddWithValueAsync(node, parameterName, args.Value?.ToString())"
                                                   aria-label="@($"Add a value to node {node.Id}")" />
                                        </span>
                                    </label>
                                    @if (valuesError is { } valuesProblem)
                                    {
                                        <span class="editor-warning">@valuesProblem</span>
                                    }
                                }
                                else if (parameter.Kind == PF.WorkflowFormatParameterKinds.Node)
                                {
                                    var operands = NodeOperandOptions?.Invoke(parameter.Format) ?? Array.Empty<(string, string)>();
                                    var current = WithString(node, parameterName) ?? string.Empty;
                                    <label class="node-field">
                                        <span>@parameterName@(parameter.Format != null ? $" — a {parameter.Format} node" : "")</span>
                                        <FluentSelect TOption="string" class="binding-row__select node-with" data-with="@parameterName"
                                                      Value="@current"
                                                      ValueChanged="@(v => EmitWithStringAsync(node, parameterName, v))"
                                                      aria-label="@($"{parameterName} for node {node.Id}")">
                                            <FluentOption TOption="string" Value="">choose…</FluentOption>
                                            @if (current.Length > 0 && operands.All(o => o.Ref != current))
                                            {
                                                <FluentOption TOption="string" Value="@current">@current</FluentOption>
                                            }
                                            @foreach (var (operandRef, operandLabel) in operands)
                                            {
                                                <FluentOption TOption="string" Value="@operandRef">@operandLabel</FluentOption>
                                            }
                                        </FluentSelect>
                                    </label>
                                }
                                else
                                {
                                    <label class="node-field node-field--wide">
                                        <span>@parameterName</span>
                                        <input class="binding-row__select node-field__input node-with" data-with="@parameterName"
                                               value="@(WithString(node, parameterName) ?? string.Empty)"
                                               @onchange="args => EmitWithStringAsync(node, parameterName, args.Value?.ToString())"
                                               aria-label="@($"{parameterName} for node {node.Id}")" />
                                    </label>
                                }
                            }
                        }
                    </text>;

                RenderFragment onInvalidField =
                    @<text>
                        @if (At25 && node.Aggregate == null && FormatOf(node) is { Validatable: true })
                        {
                            @* v25 (design § 3.4): the policy when the reply fails the format's validation.
                               retry is accepted by the format but reserved — it runs as fail until its rung. *@
                            <label class="node-field">
                                <span>on invalid</span>
                                <FluentSelect TOption="string" class="binding-row__select node-on-invalid"
                                              Value="@(node.OnInvalid ?? string.Empty)"
                                              ValueChanged="@(v => EmitNodeChangeAsync(node, onInvalid: v))"
                                              aria-label="Node on-invalid policy">
                                    <FluentOption TOption="string" Value="">choose…</FluentOption>
                                    @foreach (var policy in PF.WorkflowOnInvalid.All)
                                    {
                                        <FluentOption TOption="string" Value="@policy">@OnInvalidLabel(policy)</FluentOption>
                                    }
                                </FluentSelect>
                            </label>
                        }
                    </text>;

                RenderFragment outputField =
                    @<text>
                        @if (!At25 && node.Aggregate == null && !node.IsClassifier && !node.IsCheck)
                        {
                            <label class="node-field">
                                <span>output</span>
                                <FluentSelect TOption="string" class="binding-row__select"
                                              Value="@(node.OutputSchema ?? string.Empty)"
                                              ValueChanged="@(v => EmitNodeChangeAsync(node, outputSchema: v))"
                                              aria-label="Node output contract">
                                    @* #825/#827: the empty (no-contract) row and the offered contracts are kind-filtered. *@
                                    @foreach (var (value, label) in NodeOutputOptions(node.IsTemplate, ContractOptions))
                                    {
                                        <FluentOption TOption="string" Value="@value">@label</FluentOption>
                                    }
                                    @if (node.OutputSchema != null && !ContractOptions.Contains(node.OutputSchema))
                                    {
                                        <FluentOption TOption="string" Value="@node.OutputSchema">@node.OutputSchema</FluentOption>
                                    }
                                </FluentSelect>
                            </label>
                            @if (node.IsTemplate)
                            {
                                <p class="muted-text node-field--wide">The template renders this; a contract here validates the render, it does not call a model.</p>
                            }
                        }
                    </text>;

                RenderFragment failIfEmptyField =
                    @<text>
                        @if (At25 ? node.Aggregate == null && FormatOf(node) is { JudgesReply: true } : node.Aggregate == null && !node.IsClassifier && !node.IsCheck && node.OutputSchema != null)
                        {
                            <label class="node-field node-field--wide">
                                <span>fail if empty</span>
                                <input class="binding-row__select node-field__input"
                                       value="@(node.FailIfEmpty ?? string.Empty)"
                                       placeholder="optional — error shown when the output is empty"
                                       @onchange="args => EmitNodeChangeAsync(node, failIfEmpty: args.Value?.ToString())"
                                       aria-label="Node fail-if-empty message" />
                            </label>
                        }
                    </text>;

                RenderFragment reproducibleField =
                    @<text>
                        @if (OfferReproducible && !node.IsCheck && !node.IsTemplate)
                        {
                            @* v11 #564 (record § 6): any node may claim it. *@
                            <label class="node-field node-field--reproducible">
                                <input type="checkbox"
                                       checked="@node.Reproducible"
                                       @onchange="args => EmitReproducibleAsync(node, args.Value is bool isChecked && isChecked)"
                                       aria-label="@($"Reproducible for node {node.Id}")" />
                                <span>reproducible — same input, same output (the rerun verdict reads this)</span>
                            </label>
                        }
                    </text>;
        }
        @if (Editable)
        {
            @if (Sectioned)
            {
                <div class="node-section">
                    <span class="node-section__head">Identity</span>
                    <div class="node-fields">@labelField@forEachField@formatField@outputField</div>
                </div>
                @if (TakesPrompt(node) && AllowPromptChange)
                {
                    <div class="node-section">
                        <span class="node-section__head">Prompt</span>
                        <div class="node-fields">@promptField</div>
                    </div>
                }
                <div class="node-section">
                    <span class="node-section__head">Options</span>
                    <div class="node-fields">@reproducibleField@failIfEmptyField@valuesField@checkFields@parametersField@onInvalidField</div>
                    @OptionsExtra
                </div>
            }
            else
            {
                <div class="node-fields">@labelField@valuesField@checkFields@formatField@parametersField@onInvalidField@promptField@forEachField@outputField@failIfEmptyField@reproducibleField</div>
            }
        }
        @{
            @* #948: the bindings/aggregate list + the "+ variable" form — one fragment,
               rendered flat (Graph) or inside the "Inputs" section (node pane). *@
            RenderFragment inputsFragment =
                @<text>
                    @if (node.Aggregate != null)
                    {
                        @* Deterministic aggregation: sources in declared order (v6). *@
                        @if (Editable && OnAggregateChanged.HasDelegate)
                        {
                            <ul class="binding-list">
                                @for (var i = 0; i < node.Aggregate.Count; i++)
                                {
                                    var index = i;
                                    var currentNode = node;
                                    <li class="binding-row">
                                        <span class="muted-text">@(index + 1).</span>
                                        <code>@node.Aggregate[index]</code>
                                        <FluentButton Appearance="Appearance.Stealth" Class="aggregate-row__button" Title="Move up"
                                                      aria-label="@($"Move source {index + 1} up")"
                                                      Disabled="@(index == 0)"
                                                      IconStart="@(new Icons.Regular.Size20.ArrowUp())"
                                                      @onclick="() => MoveAggregateSourceAsync(currentNode, index, -1)" />
                                        <FluentButton Appearance="Appearance.Stealth" Class="aggregate-row__button" Title="Move down"
                                                      aria-label="@($"Move source {index + 1} down")"
                                                      Disabled="@(index == node.Aggregate.Count - 1)"
                                                      IconStart="@(new Icons.Regular.Size20.ArrowDown())"
                                                      @onclick="() => MoveAggregateSourceAsync(currentNode, index, +1)" />
                                        <FluentButton Appearance="Appearance.Stealth" Class="aggregate-row__button" Title="Remove source"
                                                      aria-label="@($"Remove source {index + 1}")"
                                                      Disabled="@(node.Aggregate.Count == 1)"
                                                      IconStart="@(new Icons.Regular.Size20.Dismiss())"
                                                      @onclick="() => RemoveAggregateSourceAsync(currentNode, index)" />
                                    </li>
                                }
                            </ul>
                            <div class="add-variable__form">
                                @* #1136: a pick is an action — OneShotSelect runs it once and rests. *@
                                <OneShotSelect
                                               AriaLabel="Add aggregate source"
                                               Resting="+ add source…"
                                               Choices="@(Nodes.Where(other => other.Id != node.Id && !node.Aggregate.Any(s => Consultologist.PackageFormat.TemplateObjectReference.NodeIdOf(s) == other.Id))
                                                              .Select(candidate => new OneShotChoice(AggregateRef(candidate.Id), AggregateRef(candidate.Id))).ToList())"
                                               OnPick="@(v => AppendAggregateSourceAsync(node, v))" />
                            </div>
                        }
                        else
                        {
                            <ul class="binding-list">
                                @foreach (var sourceRef in node.Aggregate)
                                {
                                    <li class="binding-row muted-text">
                                        <code>@sourceRef</code>
                                        <span aria-hidden="true">→</span>
                                        <span>collected in order</span>
                                    </li>
                                }
                            </ul>
                        }
                    }
                    else
                    {
                        <ul class="binding-list">
                            @foreach (var row in Rows(node))
                            {
                                var modified = row.IsNew || row.From != row.OriginalFrom || row.As != row.OriginalAs;

                                <li class="binding-row @(Editable ? null : "muted-text")">
                                    <code class="binding-row__variable">@row.Variable</code>
                                    <span aria-hidden="true">←</span>
                                    @if (Editable)
                                    {
                                        <BindingSourceEditor Node="@node"
                                                             Row="@row"
                                                             Nodes="@Nodes"
                                                             Scalars="@Scalars"
                                                             Inputs="@Inputs"
                                                             OnChanged="@OnBindingChanged" />
                                        @if (modified)
                                        {
                                            <span class="binding-row__pending" title="Pending change">●</span>
                                        }
                                        @if (row.IsNew && row.From.Length == 0)
                                        {
                                            <span class="muted-text binding-row__hint">new — choose source</span>
                                        }
                                    }
                                    else
                                    {
                                        <code>@(row.As is null ? row.From : $"{row.From} (as {row.As})")</code>
                                    }
                                </li>
                            }
                        </ul>
                    }
                    @if (Editable && node.Prompt != null && OnVariableAdded.HasDelegate)
                    {
                        var form = FormFor(node.Id);
                        <details class="add-variable">
                            <summary>+ variable</summary>
                            <div class="add-variable__form">
                                <input class="binding-row__select"
                                       placeholder="variable_name"
                                       value="@form.Name"
                                       @onchange="args => SetFormName(node.Id, args)"
                                       aria-label="New variable name" />
                                <FluentSelect TOption="string" class="binding-row__select"
                                              Value="@form.Source"
                                              ValueChanged="@(v => SetFormSource(node.Id, v))"
                                              aria-label="New variable source">
                                    <FluentOption TOption="string" Value="">choose source…</FluentOption>
                                    @foreach (var option in BindingSourceEditor.SourceOptions(Nodes, Scalars, node, string.Empty, Inputs))
                                    {
                                        <FluentOption TOption="string" Value="@option">@option</FluentOption>
                                    }
                                </FluentSelect>
                                <FluentButton Appearance="Appearance.Stealth" Class="add-variable__submit" IconStart="@(new Icons.Regular.Size20.Add())" @onclick="() => SubmitAddVariableAsync(node)">Add</FluentButton>
                            </div>
                            @if (form.Error != null)
                            {
                                <p class="add-variable__error">@form.Error</p>
                            }
                        </details>
                    }
                </text>;
        }
        @* v25 (C4 #1010): bindings are retired — a prompted node's reads are derived by
           the walk and listed by the host's ReadsSection in the Inputs section's place; an
           aggregator keeps its ordered sources (the same fragment, headed "Sources"). *@
        @if (Sectioned)
        {
            @if (At25 && node.Aggregate == null)
            {
                @ReadsSection
            }
            else
            {
                <div class="node-section">
                    <span class="node-section__head">@(At25 ? "Sources" : "Inputs")</span>
                    @inputsFragment
                </div>
            }
        }
        else if (!At25 || node.Aggregate != null)
        {
            @inputsFragment
        }
    </article>
}

@foreach (var removedNode in (Only == null ? RemovedNodes : RemovedNodes.Where(n => n.Id == Only)))
{
    <article class="template-section template-section--removed">
        <div class="template-section__header">
            <div>
                <h3 class="panel-title"><span class="node-strike">@removedNode.Label</span> <span class="muted-text">— removed</span></h3>
                <p class="muted-text">@removedNode.Id · its prompt is removed with it</p>
            </div>
            <FluentButton Appearance="Appearance.Stealth" Class="add-variable__submit" IconStart="@(new Icons.Regular.Size20.ArrowUndo())" @onclick="() => OnNodeRestored.InvokeAsync(removedNode.Id)">
                Restore
            </FluentButton>
        </div>
    </article>
}

@code {
    /// <summary>One effective binding row: current values plus the manifest's originals (null for pending-added variables).</summary>
    public sealed record BindingRow(string Variable, string From, string? As, string? OriginalFrom, string? OriginalAs, bool IsNew);

    public sealed record BindingChange(string NodeId, string Variable, string From, string? As);

    public sealed record VariableAdd(string NodeId, string Variable, string From, string? As);

    /// <summary>The node's full effective field tuple after one field changed (#117/#170).</summary>
    public sealed record NodeChange(string NodeId, string Label, string? ForEach, string? OutputSchema, string? FailIfEmpty, string? Prompt = null, IReadOnlyList<string>? Values = null,
        // v11 #564: the reproducibility claim — the effective value always
        // rides the tuple (never null-means-unchanged), so later edits to
        // other fields can never clobber it.
        bool Reproducible = false,
        // v12 § 13 (#621): the check's editable members — effective values on
        // every emission, the Reproducible rule, so no edit clobbers another.
        string? Of = null, string? In = null, string? FailWith = null,
        // v25 (C1 #1007): the format, its parameters and the invalid-reply policy —
        // effective values on every emission, the same rule; null on every ≤24 node.
        string? Format = null, IReadOnlyDictionary<string, JsonElement>? With = null, string? OnInvalid = null);

    /// <summary>
    /// v25 (C1 #1007): one format the picker offers — a catalogue entry or a package
    /// format — with the facts the fields need: its producer and type, whether the
    /// engine validates the reply (an object or enum shape), whether there is a reply
    /// to judge empty (an agent writes it), and its declared parameters in order.
    /// </summary>
    /// <summary>One format the picker offers. <paramref name="OutputMacros"/> (C3 #1009): whether a node on
    /// it may carry a macro instance or an inline macro — the format's outputMacros flag.</summary>
    public sealed record FormatOption(string Id, string Producer, string Type, string? Description, IReadOnlyList<FormatParameter> Parameters, bool OutputMacros = false)
    {
        public bool Validatable => Type is "object" or "enum";

        public bool JudgesReply => Producer is PF.WorkflowFormatProducers.Attested or PF.WorkflowFormatProducers.Custom;

        public bool Computed => Producer == PF.WorkflowFormatProducers.Computed;
    }

    public sealed record FormatParameter(string Name, string Kind, string? Format);

    /// <summary>An aggregator's full effective ordered source list after one change (#117).</summary>
    public sealed record AggregateChange(string NodeId, List<string> Sources);

    [Parameter] public IReadOnlyList<WorkflowManifestReader.NodeView> Nodes { get; set; } = Array.Empty<WorkflowManifestReader.NodeView>();

    /// <summary>#1037: at 25 an aggregate source is spelled node.&lt;id&gt; (the object spelling); below, node:&lt;id&gt;.</summary>
    [Parameter] public bool ObjectSpelling { get; set; }

    private string AggregateRef(string id) => ObjectSpelling ? Consultologist.PackageFormat.TemplateObjectReference.Node(id) : $"node:{id}";
    [Parameter] public bool Editable { get; set; }
    [Parameter] public IReadOnlyList<string> Scalars { get; set; } = Array.Empty<string>();

    /// <summary>The package's declared input ids (v7); empty means the frozen consult_draft input.</summary>
    [Parameter] public IReadOnlyList<string> Inputs { get; set; } = Array.Empty<string>();
    [Parameter] public IReadOnlyList<string> Collections { get; set; } = Array.Empty<string>();

    /// <summary>v9 (#429): the declared inputs a node may fan — arrays only. Empty below 9.</summary>
    [Parameter] public IReadOnlyList<string> ArrayInputs { get; set; } = Array.Empty<string>();
    [Parameter] public IReadOnlyList<string> ContractOptions { get; set; } = Array.Empty<string>();
    [Parameter] public IReadOnlyList<string> PromptOptions { get; set; } = Array.Empty<string>();

    /// <summary>v11 #564: whether the reproducible toggle renders — the page gates it at specVersion 11.</summary>
    [Parameter] public bool OfferReproducible { get; set; }

    // v12 § 13 (#621): the operand choices a check's of/in may name —
    // (node:<id>, "<id> — <schema>") pairs, built by the page.
    [Parameter] public IReadOnlyList<(string Ref, string Label)> CheckOperandOptions { get; set; } = Array.Empty<(string, string)>();

    // v25 (C1 #1007): the formats the picker offers — empty below 25, which is the
    // gate for every 25 field — and the node operands a node-kind parameter may name
    // (node.<id>), filtered by the page to the parameter's required format.
    [Parameter] public IReadOnlyList<FormatOption> FormatOptions { get; set; } = Array.Empty<FormatOption>();
    [Parameter] public Func<string?, IReadOnlyList<(string Ref, string Label)>>? NodeOperandOptions { get; set; }

    private bool At25 => FormatOptions.Count > 0;

    private FormatOption? FormatOf(WorkflowManifestReader.NodeView node) =>
        node.Format == null ? null : FormatOptions.FirstOrDefault(f => f.Id == node.Format);

    private string FormatLabel(string formatId) =>
        FormatOptions.FirstOrDefault(f => f.Id == formatId) is { } format ? $"{format.Id} · {format.Producer}" : formatId;

    private bool IsComputed(WorkflowManifestReader.NodeView node) => FormatOf(node)?.Computed == true;

    /// <summary>Whether the node drives a prompt: below 25 every non-aggregator but a check; at 25 every non-aggregator whose format is not computed.</summary>
    private bool TakesPrompt(WorkflowManifestReader.NodeView node) =>
        At25 ? node.Aggregate == null && !IsComputed(node)
             : node.Aggregate == null && !node.IsClassifier && !node.IsCheck;

    internal static string OnInvalidLabel(string policy) =>
        policy == PF.WorkflowOnInvalid.Retry ? $"{policy} — reserved: runs as fail until its rung" : policy;

    private static string? WithString(WorkflowManifestReader.NodeView node, string name) =>
        node.With != null && node.With.TryGetValue(name, out var value) && value.ValueKind == JsonValueKind.String ? value.GetString() : null;

    private static IReadOnlyList<string> WithStrings(WorkflowManifestReader.NodeView node, string name) =>
        node.With != null && node.With.TryGetValue(name, out var value) && value.ValueKind == JsonValueKind.Array
            ? value.EnumerateArray().Where(v => v.ValueKind == JsonValueKind.String).Select(v => v.GetString()!).ToList()
            : Array.Empty<string>();

    private static IReadOnlyDictionary<string, JsonElement>? WithSet(IReadOnlyDictionary<string, JsonElement>? with, string name, JsonElement? value)
    {
        var next = with == null ? new Dictionary<string, JsonElement>(StringComparer.Ordinal) : new Dictionary<string, JsonElement>(with, StringComparer.Ordinal);
        if (value is { } element)
        {
            next[name] = element;
        }
        else
        {
            next.Remove(name);
        }

        return next.Count == 0 ? null : next;
    }

    private Task EmitFormatAsync(WorkflowManifestReader.NodeView node, string? format)
    {
        var next = string.IsNullOrEmpty(format) ? null : format;
        if (next == node.Format)
        {
            return Task.CompletedTask;
        }

        // A re-pick resets with and onInvalid — they belong to the old format.
        return OnNodeChanged.InvokeAsync(new NodeChange(node.Id, node.Label, node.ForEach, node.OutputSchema, node.FailIfEmpty, node.Prompt, node.Values, node.Reproducible, node.Of, node.In, node.FailWith,
            Format: next, With: null, OnInvalid: null));
    }

    private Task EmitWithStringAsync(WorkflowManifestReader.NodeView node, string name, string? value)
    {
        var trimmed = value?.Trim();
        var with = WithSet(node.With, name, string.IsNullOrEmpty(trimmed) ? null : JsonSerializer.SerializeToElement(trimmed));
        return OnNodeChanged.InvokeAsync(new NodeChange(node.Id, node.Label, node.ForEach, node.OutputSchema, node.FailIfEmpty, node.Prompt, node.Values, node.Reproducible, node.Of, node.In, node.FailWith,
            node.Format, with, node.OnInvalid));
    }

    private Task EmitWithStringsAsync(WorkflowManifestReader.NodeView node, string name, List<string> values)
    {
        var with = WithSet(node.With, name, JsonSerializer.SerializeToElement(values));
        return OnNodeChanged.InvokeAsync(new NodeChange(node.Id, node.Label, node.ForEach, node.OutputSchema, node.FailIfEmpty, node.Prompt, node.Values, node.Reproducible, node.Of, node.In, node.FailWith,
            node.Format, with, node.OnInvalid));
    }

    /// <summary>v25: a values parameter's next value — snake_case, not yet declared (the v10 classifier rule).</summary>
    private async Task AddWithValueAsync(WorkflowManifestReader.NodeView node, string name, string? value)
    {
        var candidate = (value ?? string.Empty).Trim();

        if (!System.Text.RegularExpressions.Regex.IsMatch(candidate, "^[a-z][a-z0-9_]*$"))
        {
            valuesError = $"Value '{candidate}' must be snake_case (a lowercase letter, then lowercase letters, digits, or underscores).";
            return;
        }

        var current = WithStrings(node, name);
        if (current.Contains(candidate, StringComparer.Ordinal))
        {
            valuesError = $"Node '{node.Id}' already declares '{candidate}'.";
            return;
        }

        valuesError = null;
        await EmitWithStringsAsync(node, name, current.Append(candidate).ToList());
    }
    [Parameter] public bool AllowPromptChange { get; set; }
    [Parameter] public string? Only { get; set; }

    // #948: the node pane owns a single header and lays the fields out in labeled
    // sections; the Graph pane passes neither, so it renders the flat card as before.
    [Parameter] public bool ShowHeader { get; set; } = true;
    [Parameter] public bool Sectioned { get; set; }
    [Parameter] public RenderFragment? OptionsExtra { get; set; }

    /// <summary>v25 (C4 #1010): the host's derived Reads section, rendered in the Inputs section's place for a prompted node at 25.</summary>
    [Parameter] public RenderFragment? ReadsSection { get; set; }
    [Parameter] public Func<string, bool>? NodeModified { get; set; }
    [Parameter] public IReadOnlyList<WorkflowManifestReader.NodeView> RemovedNodes { get; set; } = Array.Empty<WorkflowManifestReader.NodeView>();
    [Parameter] public EventCallback<string> OnNodeRemoved { get; set; }
    [Parameter] public EventCallback<string> OnNodeRestored { get; set; }
    [Parameter] public Func<WorkflowManifestReader.NodeView, IReadOnlyList<BindingRow>>? RowsFor { get; set; }
    [Parameter] public Func<WorkflowManifestReader.NodeView, string, string?>? ValidateVariableName { get; set; }
    [Parameter] public EventCallback<BindingChange> OnBindingChanged { get; set; }
    [Parameter] public EventCallback<VariableAdd> OnVariableAdded { get; set; }
    [Parameter] public EventCallback<NodeChange> OnNodeChanged { get; set; }
    [Parameter] public EventCallback<AggregateChange> OnAggregateChanged { get; set; }
    /// <summary>#1097: the "open" link beside the format picker — the format's own pane (package or catalogue).</summary>
    [Parameter] public EventCallback<string> OnOpenFormat { get; set; }

    /// <summary>v26 (#1160): the package is at 26 — the in-loop picker replaces the for-each select.</summary>
    [Parameter] public bool At26 { get; set; }

    /// <summary>v26 (#1160): the loops a node may be placed in.</summary>
    [Parameter] public IReadOnlyList<WorkflowManifestReader.NodeView> Loops { get; set; } = Array.Empty<WorkflowManifestReader.NodeView>();

    /// <summary>v26 (#1160): the loop a node runs inside (its id), or null.</summary>
    [Parameter] public Func<string, string?>? LoopOf { get; set; }

    /// <summary>v26 (#1160): a node moved into a loop (or out of every loop: null).</summary>
    [Parameter] public EventCallback<LoopPlacement> OnLoopChanged { get; set; }

    /// <summary>v26 (#1160): a node's placement in a loop — the loop id, or null for none.</summary>
    public sealed record LoopPlacement(string NodeId, string? LoopId);

    private Task EmitLoopChangeAsync(WorkflowManifestReader.NodeView node, string? loopId) =>
        OnLoopChanged.InvokeAsync(new LoopPlacement(node.Id, string.IsNullOrEmpty(loopId) ? null : loopId));

    private async Task MoveAggregateSourceAsync(WorkflowManifestReader.NodeView node, int index, int delta)
    {
        var sources = node.Aggregate!.ToList();
        (sources[index], sources[index + delta]) = (sources[index + delta], sources[index]);
        await OnAggregateChanged.InvokeAsync(new AggregateChange(node.Id, sources));
    }

    private async Task RemoveAggregateSourceAsync(WorkflowManifestReader.NodeView node, int index)
    {
        var sources = node.Aggregate!.ToList();
        sources.RemoveAt(index);
        await OnAggregateChanged.InvokeAsync(new AggregateChange(node.Id, sources));
    }

    private async Task AppendAggregateSourceAsync(WorkflowManifestReader.NodeView node, string? sourceRef)
    {
        if (string.IsNullOrEmpty(sourceRef) || node.Aggregate!.Contains(sourceRef))
        {
            return;
        }

        var sources = node.Aggregate!.ToList();
        sources.Add(sourceRef);
        await OnAggregateChanged.InvokeAsync(new AggregateChange(node.Id, sources));
    }

    /// <summary>What a node may fan: every data collection (a snippet folder at 25, spelled
    /// snippet.&lt;folder&gt; — #1008), then every array input (v9 § 5; input.&lt;id&gt; at 25 — #1039,
    /// the ≤24 input: spelling is refused there).</summary>
    internal static IReadOnlyList<string> ForEachOptions(IReadOnlyList<string> collections, IReadOnlyList<string> arrayInputs, bool at25 = false) =>
        collections.Select(collectionId => at25 ? $"{PF.WorkflowFanSources.SnippetPrefix}{collectionId}" : $"data:{collectionId}")
            .Concat(arrayInputs.Select(inputId => at25 ? PF.TemplateObjectReference.Input(inputId) : $"{WorkflowInputFans.Prefix}{inputId}"))
            .ToList();

    /// <summary>
    /// #827: the output-contract options for a node kind — the empty
    /// (no-contract) row plus the offered contracts, filtered per kind. A
    /// template renders its output (no model), so the empty row reads
    /// "— rendered —" and answer-only contracts (a model answers them from a
    /// value set) are excluded; a prompt reads "prose (text)" and is offered
    /// every contract. The engine's template refusal is the authority
    /// (WorkflowPackageValidator.DeclaresClassification); this mirrors it.
    /// </summary>
    internal static IReadOnlyList<(string Value, string Label)> NodeOutputOptions(bool isTemplate, IReadOnlyList<string> contracts)
    {
        var options = new List<(string Value, string Label)> { (string.Empty, isTemplate ? "— rendered —" : "prose (text)") };

        foreach (var id in contracts)
        {
            if (isTemplate && WorkflowOutputContracts.AnswerOnly.Contains(id))
            {
                continue;
            }

            options.Add((id, id));
        }

        return options;
    }

    // Each field edit emits the node's complete effective tuple; the host
    // compares it against the manifest original (self-removing edits, like
    // binding rows). Selecting a value equal to the current one still emits —
    // harmlessly resolving to "no change" host-side.
    private string? valuesError;

    /// <summary>v10 (#498): a classifier's next value — snake_case, not yet declared.</summary>
    private async Task AddValueAsync(WorkflowManifestReader.NodeView node, string? value)
    {
        var candidate = (value ?? string.Empty).Trim();

        if (!System.Text.RegularExpressions.Regex.IsMatch(candidate, "^[a-z][a-z0-9_]*$"))
        {
            valuesError = $"Value '{candidate}' must be snake_case (a lowercase letter, then lowercase letters, digits, or underscores).";
            return;
        }

        if (node.Values?.Contains(candidate, StringComparer.Ordinal) == true)
        {
            valuesError = $"Classifier '{node.Id}' already declares '{candidate}'.";
            return;
        }

        valuesError = null;
        await EmitValuesAsync(node, (node.Values ?? Array.Empty<string>()).Append(candidate).ToList());
    }

    private Task EmitReproducibleAsync(WorkflowManifestReader.NodeView node, bool reproducible) =>
        OnNodeChanged.InvokeAsync(new NodeChange(node.Id, node.Label, node.ForEach, node.OutputSchema, node.FailIfEmpty, node.Prompt, node.Values, reproducible, node.Of, node.In, node.FailWith, node.Format, node.With, node.OnInvalid));

    private Task EmitValuesAsync(WorkflowManifestReader.NodeView node, List<string> values) =>
        OnNodeChanged.InvokeAsync(new NodeChange(node.Id, node.Label, node.ForEach, node.OutputSchema, node.FailIfEmpty, node.Prompt, values, node.Reproducible, node.Of, node.In, node.FailWith, node.Format, node.With, node.OnInvalid));

    private async Task EmitNodeChangeAsync(
        WorkflowManifestReader.NodeView node,
        string? label = null,
        string? forEach = null,
        string? outputSchema = null,
        string? failIfEmpty = null,
        string? prompt = null,
        string? checkOf = null,
        string? checkIn = null,
        string? failWith = null,
        string? onInvalid = null)
    {
        var effectiveLabel = label ?? node.Label;
        var effectiveForEach = forEach != null ? (forEach.Length == 0 ? null : forEach) : node.ForEach;
        var effectiveSchema = outputSchema != null ? (outputSchema.Length == 0 ? null : outputSchema) : node.OutputSchema;
        var effectiveFailIfEmpty = failIfEmpty != null
            ? (failIfEmpty.Length == 0 ? null : failIfEmpty)
            : node.FailIfEmpty;
        var effectivePrompt = string.IsNullOrEmpty(prompt) ? node.Prompt : prompt;

        // Dropping the contract drops its empty-output message too (≤24; at 25
        // failIfEmpty rides the format, which the pane gates itself).
        if (effectiveSchema is null && !At25)
        {
            effectiveFailIfEmpty = null;
        }

        var effectiveOf = checkOf != null ? (checkOf.Length == 0 ? null : checkOf) : node.Of;
        var effectiveIn = checkIn != null ? (checkIn.Length == 0 ? null : checkIn) : node.In;
        var effectiveFailWith = failWith != null ? (failWith.Length == 0 ? null : failWith) : node.FailWith;
        var effectiveOnInvalid = onInvalid != null ? (onInvalid.Length == 0 ? null : onInvalid) : node.OnInvalid;

        // #572: the effective values ride every emission, the Reproducible
        // rule — a null here let a label edit clobber a pending values edit.
        await OnNodeChanged.InvokeAsync(new NodeChange(node.Id, effectiveLabel, effectiveForEach, effectiveSchema, effectiveFailIfEmpty, effectivePrompt, node.Values, Reproducible: node.Reproducible, Of: effectiveOf, In: effectiveIn, FailWith: effectiveFailWith,
            Format: node.Format, With: node.With, OnInvalid: effectiveOnInvalid));
    }

    private sealed class AddForm
    {
        public string? Name { get; set; }
        public string Source { get; set; } = string.Empty;
        public string? Error { get; set; }
    }

    private readonly Dictionary<string, AddForm> addForms = new(StringComparer.Ordinal);

    private AddForm FormFor(string nodeId)
    {
        if (!addForms.TryGetValue(nodeId, out var form))
        {
            addForms[nodeId] = form = new AddForm();
        }

        return form;
    }

    private IReadOnlyList<BindingRow> Rows(WorkflowManifestReader.NodeView node) =>
        RowsFor?.Invoke(node)
            ?? node.Bindings.Select(b => new BindingRow(b.Variable, b.From, b.As, b.From, b.As, false)).ToList();

    private void SetFormName(string nodeId, ChangeEventArgs args) =>
        FormFor(nodeId).Name = args.Value?.ToString();

    // #902: FluentSelect's ValueChanged hands us the chosen string directly.
    private void SetFormSource(string nodeId, string? value) =>
        FormFor(nodeId).Source = value ?? string.Empty;

    private async Task SubmitAddVariableAsync(WorkflowManifestReader.NodeView node)
    {
        var form = FormFor(node.Id);
        var name = form.Name?.Trim() ?? string.Empty;
        form.Error = ValidateVariableName?.Invoke(node, name);

        if (form.Error != null)
        {
            return;
        }

        await OnVariableAdded.InvokeAsync(new VariableAdd(node.Id, name, form.Source, null));
        addForms.Remove(node.Id);
    }
}
