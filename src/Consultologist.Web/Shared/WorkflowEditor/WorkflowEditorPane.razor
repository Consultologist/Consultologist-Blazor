@* The detail pane of the master–detail editor (#110): one selected text,
   editor and live preview side by side on wide screens. *@

@* #949: ShowHeader=false lets the pane be embedded headerless (the node pane's
   inline prompt editor owns its own header). Default true — every other pane
   keeps its header. *@
@if (ShowHeader)
{
    <div class="pane-header">
        <div>
            <h3 class="panel-title">@Title</h3>
            @{
                // #946: the identity strip — id (unless it is already the title) and file,
                // read-only and greyed, so every pane names itself the same way.
                var showId = !string.IsNullOrEmpty(IdentityId) && IdentityId != Title;
                var showFile = !string.IsNullOrEmpty(IdentityFile);
            }
            @if (showId || showFile)
            {
                <p class="pane-identity muted-text">
                    @if (showId)
                    {
                        <span class="pane-identity__item">id <code>@IdentityId</code></span>
                    }
                    @if (showId && showFile)
                    {
                        <span class="pane-identity__sep"> · </span>
                    }
                    @if (showFile)
                    {
                        <span class="pane-identity__item">file <code>@IdentityFile</code></span>
                    }
                    @IdentityAction
                </p>
            }
            @if (!string.IsNullOrEmpty(Subtitle) || Modified)
            {
                <p class="muted-text">
                    @Subtitle
                    @if (Modified)
                    {
                        <strong> — edited</strong>
                    }
                </p>
            }
        </div>
        @if (HeaderActions != null)
        {
            <div class="pane-header__actions">@HeaderActions</div>
        }
    </div>
}

@ChildContent

@* v25 (C4 #1010): the host's controls that belong to the text itself — the
   insert-reference palette and the template's reads line — sit right above the editor. *@
@if (EditorExtra != null)
{
    <div class="pane-editor-extra">@EditorExtra</div>
}

<div class="pane-split">
    <label class="input-field pane-editor">
        <span>@EditLabel</span>
        <FluentTextArea Value="@Text"
                        ValueChanged="@(async (string? value) => await TextChanged.InvokeAsync(value ?? string.Empty))"
                        Rows="18" />
    </label>
    <div class="pane-preview">
        @* #837: a raw prompt is sent verbatim (no Scriban), so preview it
           verbatim too — Markdown rendering would misrepresent what runs.
           #1095: a host that renders its text itself passes Preview, which
           takes the Markdown preview's place; every other pane keeps it. *@
        @if (Raw)
        {
            <span class="muted-text">Plain text (verbatim)</span>
            <pre class="plain-preview">@Text</pre>
        }
        else if (Preview != null)
        {
            @Preview
        }
        else
        {
            <span class="muted-text">Preview</span>
            <div class="markdown-preview">
                @((MarkupString)MarkdownPreview.Render(Text))
            </div>
        }
    </div>
</div>

@* #1073: what belongs under the editor — a pane's "how this works" expander. *@
@if (Footer != null)
{
    <div class="pane-footer">@Footer</div>
}

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    // #949: false renders the pane without its header (ChildContent + the
    // editor/preview split still render), so it can be embedded under a pane
    // that already owns a header. Default true — every existing user is unchanged.
    [Parameter] public bool ShowHeader { get; set; } = true;
    [Parameter] public string Subtitle { get; set; } = string.Empty;
    // #946: the read-only identity strip — the id (shown only when it is not already
    // the title) and the file path, so every pane surfaces its metadata uniformly.
    [Parameter] public string? IdentityId { get; set; }
    [Parameter] public string? IdentityFile { get; set; }

    /// <summary>#1267: an action beside the identity line — "rename the file to match" when the file is not named after its id.</summary>
    [Parameter] public RenderFragment? IdentityAction { get; set; }
    [Parameter] public string EditLabel { get; set; } = "Content";
    [Parameter] public string Text { get; set; } = string.Empty;
    [Parameter] public bool Modified { get; set; }
    // #837: when true, the preview shows the text verbatim instead of rendering
    // Markdown — for a raw (plain-text) prompt. Defaults false, so every other
    // pane keeps the Markdown preview.
    [Parameter] public bool Raw { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? HeaderActions { get; set; }

    /// <summary>v25 (C4 #1010): controls rendered above the editor — the host's insert-reference palette and reads line.</summary>
    [Parameter] public RenderFragment? EditorExtra { get; set; }

    /// <summary>#1073: rendered after the editor/preview split — the pane's "how this works" expander, or nothing.</summary>
    [Parameter] public RenderFragment? Footer { get; set; }

    /// <summary>#1095: when set (and the text is not Raw), rendered in the Markdown preview's place — the host's rendered preview, bringing its own label, controls and text. Null keeps the Markdown preview.</summary>
    [Parameter] public RenderFragment? Preview { get; set; }
    [Parameter] public EventCallback<string> TextChanged { get; set; }
}
