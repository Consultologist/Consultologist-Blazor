@* One binding's source + renderer selects — the shared editing primitive
   behind the Graph node cards and the prompt pane's variable rows (#140).
   The server validator remains the authority on publish. *@
@using Consultologist.Web.Services.Workflow

<FluentSelect TOption="string" class="binding-row__select"
              Value="@Row.From"
              ValueChanged="OnSourceChangedAsync"
              aria-label="@($"Source for {Row.Variable}")">
    @if (Row.From.Length == 0)
    {
        <FluentOption TOption="string" Value="">choose source…</FluentOption>
    }
    @foreach (var option in SourceOptions(Nodes, Scalars, Node, Row.From, Inputs))
    {
        <FluentOption TOption="string" Value="@option">@option</FluentOption>
    }
</FluentSelect>
@if (Row.From.StartsWith("node:", StringComparison.Ordinal))
{
    var targetHasOutput = TargetHasOutput(Nodes, Row.From);
    <span class="muted-text">render as</span>
    <FluentSelect TOption="string" class="binding-row__select"
                  Value="@(Row.As ?? NoRenderer)"
                  ValueChanged="OnRendererChangedAsync"
                  aria-label="@($"Renderer for {Row.Variable}")">
        <FluentOption TOption="string" Value="@NoRenderer">plain</FluentOption>
        <FluentOption TOption="string" Value="concept-bullets" Disabled="@(!targetHasOutput && Row.As != "concept-bullets")">concept-bullets</FluentOption>
        <FluentOption TOption="string" Value="concept-context" Disabled="@(!targetHasOutput && Row.As != "concept-context")">concept-context</FluentOption>
    </FluentSelect>
}

@code {
    internal const string NoRenderer = "__plain__";

    [Parameter] public WorkflowManifestReader.NodeView Node { get; set; } = default!;
    [Parameter] public WorkflowNodeSummary.BindingRow Row { get; set; } = default!;
    [Parameter] public IReadOnlyList<WorkflowManifestReader.NodeView> Nodes { get; set; } = Array.Empty<WorkflowManifestReader.NodeView>();
    [Parameter] public IReadOnlyList<string> Scalars { get; set; } = Array.Empty<string>();

    /// <summary>
    /// The package's declared input ids (specVersion 7). Empty falls back to
    /// the frozen consult_draft slot, which is v5/v6's whole vocabulary.
    /// </summary>
    [Parameter] public IReadOnlyList<string> Inputs { get; set; } = Array.Empty<string>();
    [Parameter] public EventCallback<WorkflowNodeSummary.BindingChange> OnChanged { get; set; }

    // The valid source space for one node; a nonempty current value is always
    // included so an unrecognized source still displays truthfully — which is
    // also what shows a binding left pointing at a removed input slot.
    internal static IEnumerable<string> SourceOptions(
        IReadOnlyList<WorkflowManifestReader.NodeView> nodes,
        IReadOnlyList<string> scalars,
        WorkflowManifestReader.NodeView node,
        string current,
        IReadOnlyList<string>? inputs = null)
    {
        var options = inputs is { Count: > 0 }
            ? inputs.Select(id => $"input:{id}").ToList()
            : new List<string> { "input:consult_draft" };

        options.AddRange(nodes.Where(other => other.Id != node.Id).Select(other => $"node:{other.Id}"));

        if (node.ForEach != null)
        {
            // A data fan's items carry name and content; an input fan's carry
            // id, name and value (v9 § 5) — the server refuses the other set.
            options.AddRange(WorkflowInputFans.IsInputFan(node.ForEach)
                ? WorkflowInputFans.ItemFields.Select(field => $"item:{field}")
                : new[] { "item:name", "item:content" });
        }

        options.AddRange(scalars.Select(scalar => $"data:{scalar}"));

        if (current.Length > 0 && !options.Contains(current))
        {
            options.Insert(0, current);
        }

        return options;
    }

    internal static bool TargetHasOutput(IReadOnlyList<WorkflowManifestReader.NodeView> nodes, string from) =>
        nodes.FirstOrDefault(node => $"node:{node.Id}" == from)?.HasOutput == true;

    // #902: FluentSelect's ValueChanged hands us the chosen string directly
    // (not a ChangeEventArgs like the old native <select>).
    private async Task OnSourceChangedAsync(string? from)
    {
        if (string.IsNullOrWhiteSpace(from))
        {
            return;
        }

        // A renderer only makes sense on a node source; keep it when the new
        // source is one, otherwise drop it.
        var renderer = from.StartsWith("node:", StringComparison.Ordinal) ? Row.As : null;

        await OnChanged.InvokeAsync(new WorkflowNodeSummary.BindingChange(Node.Id, Row.Variable, from, renderer));
    }

    private async Task OnRendererChangedAsync(string? value)
    {
        var renderer = string.IsNullOrWhiteSpace(value) || value == NoRenderer ? null : value;

        await OnChanged.InvokeAsync(new WorkflowNodeSummary.BindingChange(Node.Id, Row.Variable, Row.From, renderer));
    }
}
