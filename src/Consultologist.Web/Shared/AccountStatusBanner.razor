@inject IAccountEndpointService AccountService

<AuthorizeView>
    <Authorized>
        @if (message != null)
        {
            <div class="account-status-banner">
                <FluentMessageBar Intent="@intent" AllowDismiss="false">
                    @message
                    @if (actionHref != null)
                    {
                        <FluentAnchor Href="@actionHref" Appearance="Appearance.Hypertext">@actionText</FluentAnchor>
                    }
                </FluentMessageBar>
            </div>
        }
    </Authorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private string? message;
    private MessageIntent intent = MessageIntent.Warning;
    private string? actionHref;
    private string? actionText;

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask == null)
        {
            return;
        }

        var authState = await AuthenticationStateTask;

        if (authState.User.Identity?.IsAuthenticated != true)
        {
            return;
        }

        try
        {
            var account = await AccountService.GetCurrentAccountAsync();

            // #679: every non-Active state carries a next step, not just a nag.
            switch (account.Status)
            {
                case "Active":
                    message = null;
                    break;
                case "Disabled":
                    intent = MessageIntent.Error;
                    message = "This account has been disabled.";
                    actionHref = "mailto:hello@consultologist.ai";
                    actionText = "Contact support";
                    break;
                default: // Pending / Unverified — awaiting activation.
                    intent = MessageIntent.Warning;
                    message = "Your account is awaiting activation. Protected workflows stay unavailable until it is activated.";
                    actionHref = "profile";
                    actionText = "Go to your profile to activate";
                    break;
            }
        }
        catch
        {
            // The banner is advisory only — never surface its own failures.
        }
    }
}
