@inherits LayoutComponentBase

<FluentLayout Class="app-shell">
    @* #688: the first focusable element, so a keyboard user can jump the header
       nav and land in the content instead of tabbing it on every page. The href
       is the no-JS fallback; once interactive the click moves focus into main
       (focusing the tabindex=-1 landmark also scrolls it into view), because
       otherwise keyboard focus is left stranded on the link (#707).

       #766: preventDefault the click. A bare "#main-content" href resolves
       against <base href="/">, so Blazor's intercepted navigation went to the
       root route (`/#main-content`) — a no-op only on the home page, and a full
       route change (losing the focus move) on every other page. Suppressing the
       navigation makes the skip-link land focus on whatever page it is used. *@
    <a class="skip-link" href="#main-content" @onclick="FocusMainAsync" @onclick:preventDefault="true">Skip to main content</a>
	<Header />
    <main class="content" id="main-content" tabindex="-1" @ref="_main">
        <div class="content-shell">
            <UpdateBanner />
            <AccountStatusBanner />
            @Body
        </div>
    </main>
    <Footer />
</FluentLayout>

@code {
    private ElementReference _main;

    private async Task FocusMainAsync() => await _main.FocusAsync();
}
