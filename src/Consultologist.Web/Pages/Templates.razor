@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using System.Text.Json
@inject IWorkflowEndpointService WorkflowService
@inject IAccountEndpointService AccountService
@inject IJSRuntime JS
@inject WorkflowEditorSession EditorSession
@attribute [Authorize]

@page "/templates"

<PageTitle>Workflow</PageTitle>

<section class="page-header">
    <div class="page-header__content">
        <span class="section-eyebrow">Workflow</span>
        <h1 class="page-title">Your consult workflow, editable.</h1>
        <p class="page-description">
            Edit any package's prompt and section-standard texts — choosing one here changes what you
            are editing, not what your consults run. Publishing creates a new immutable version of
            your own package, with full provenance, and your consults start using it immediately.
        </p>
    </div>
</section>

<AuthorizeView>
    <Authorized>
        @if (isLoading)
        {
            <section class="content-card">
                <div class="loading-state">
                    <FluentProgressRing />
                    <span>Loading workflow package...</span>
                </div>
            </section>
        }
        else if (!string.IsNullOrWhiteSpace(loadError))
        {
            <section class="content-card">
                <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false">@loadError</FluentMessageBar>
                @* Escape hatch: a pin to an unloadable package must stay
                   correctable from here — the picker loads independently. *@
                <p class="editor-load-error__switch">
                    Switch to another package:
                    <WorkflowPackagePicker OnPinned="OnPackagePinnedAsync" />
                </p>
            </section>
        }
        else if (content != null)
        {
            <div class="editor-bar">
                <div class="editor-bar__info">
                    <span>Editing</span>
                    @* #411: a chooser, not the pin control. Selecting here used
                       to write consult.workflowPackage, so looking at a package
                       pointed your consults at it. Consults owns that now. *@
                    <WorkflowPackagePicker @key="content.Ref"
                                           Disabled="@isPublishing"
                                           WritesPin="false"
                                           Selected="@editingRef"
                                           OnSelected="OnPackageSelectedAsync" />
                    @if (LoadedTitle is { Length: > 0 } loadedTitle)
                    {
                        <span class="editor-bar__title">@loadedTitle</span>
                    }
                    @if (WorkflowManifestReader.ReadDerivedFrom(content.Manifest) is { } parentRef)
                    {
                        <span class="muted-text">derived from <code>@parentRef</code></span>
                    }
                    @* Only when they disagree. Editing your own fork while your
                       consults run it is the ordinary case, and a line that
                       shows every visit is one nobody reads. *@
                    @if (PinnedElsewhere is { } pinnedRef)
                    {
                        <span class="muted-text editor-bar__pin">your consults run <code>@pinnedRef</code></span>
                    }
                </div>
                <div class="editor-bar__actions">
                    @* #347: the migration. Shown only while the fork is below the
                       newest format — upward only, by construction rather than by
                       a refusal. It stages a pending change and publishes like any
                       other edit, which is why a bump with nothing else changed is
                       possible: PendingCount opens the button beside it. *@
                    @if (OffersRunnableUpgrade)
                    {
                        <FluentButton Appearance="Appearance.Outline"
                                      Disabled="@isPublishing"
                                      @onclick="() => UpgradeSpecVersionTo(RunnableSpecVersion)">
                            Upgrade to specVersion @RunnableSpecVersion
                        </FluentButton>
                    }
                    @if (OffersNewestUpgrade)
                    {
                        <FluentButton Appearance="Appearance.Outline"
                                      Disabled="@isPublishing"
                                      @onclick="() => UpgradeSpecVersionTo(NewestSpecVersion)">
                            Upgrade to specVersion @NewestSpecVersion
                        </FluentButton>
                    }
                    @* #447: two publishes, said explicitly. A package of my own
                       takes a new version; anything can become a new package of
                       my own, named by a slug; a package that is not mine can
                       only become a new one. An account with no package yet
                       publishes its first without naming it — the derived name. *@
                    @if (EditingOwnPackage)
                    {
                        <FluentButton Appearance="Appearance.Accent"
                                      Disabled="@(PendingCount == 0 || isPublishing)"
                                      @onclick="() => PublishAsync(content.Name, null)">
                            @if (isPublishing)
                            {
                                <FluentProgressRing style="width: 16px; height: 16px;" />
                                <span>Publishing&hellip;</span>
                            }
                            else
                            {
                                <span>Publish new version@(PendingSummary())</span>
                            }
                        </FluentButton>
                    }
                    @if (HasNoPackagesYet)
                    {
                        <FluentButton Appearance="Appearance.Accent"
                                      Disabled="@(PendingCount == 0 || isPublishing)"
                                      @onclick="() => PublishAsync(null, null)">
                            @if (isPublishing)
                            {
                                <FluentProgressRing style="width: 16px; height: 16px;" />
                                <span>Publishing&hellip;</span>
                            }
                            else
                            {
                                <span>Publish as your package@(PendingSummary())</span>
                            }
                        </FluentButton>
                    }
                    else if (!newPackageOpen)
                    {
                        <FluentButton Appearance="@(EditingOwnPackage ? Appearance.Outline : Appearance.Accent)"
                                      Disabled="@(PendingCount == 0 || isPublishing)"
                                      @onclick="() => newPackageOpen = true">
                            Publish as a new package&hellip;
                        </FluentButton>
                    }
                    else
                    {
                        <span class="editor-bar__new-package">
                            @* #448: a slug or a folder path — the path is the identity. *@
                            <input class="node-field__input"
                                   maxlength="@WorkflowPackageNames.MaxPathLength"
                                   value="@newPackageSlug"
                                   placeholder="folder/name"
                                   disabled="@isPublishing"
                                   @oninput="args => newPackageSlug = args.Value?.ToString() ?? string.Empty"
                                   aria-label="New package path" />
                            <FluentButton Appearance="Appearance.Accent"
                                          Disabled="@(PendingCount == 0 || isPublishing || !WorkflowPackageNames.IsValidPath(newPackageSlug.Trim()))"
                                          @onclick="() => PublishAsync(null, newPackageSlug.Trim())">
                                @if (isPublishing)
                                {
                                    <FluentProgressRing style="width: 16px; height: 16px;" />
                                    <span>Publishing&hellip;</span>
                                }
                                else
                                {
                                    <span>Publish as new package</span>
                                }
                            </FluentButton>
                            <FluentButton Appearance="Appearance.Outline" Disabled="@isPublishing" @onclick="() => newPackageOpen = false">Cancel</FluentButton>
                        </span>
                    }
                    <FluentButton Appearance="Appearance.Outline"
                                  Disabled="@(PendingCount == 0 || isPublishing)"
                                  @onclick="DiscardAsync">
                        Discard
                    </FluentButton>
                    <FluentButton Appearance="Appearance.Outline"
                                  Disabled="@isPublishing"
                                  @onclick="RevertToDefaultAsync">
                        Revert to default
                    </FluentButton>
                </div>
            </div>

            @* #411: the editor's package selector is also the consult pin, so a
               person who picks somebody else's package to look at is already
               editing against it — and publishing turns that into a version of
               THEIR package carrying this content. Said here because it was not
               said anywhere, and it cost three accidental publishes in one day. *@
            @if (!EditingOwnPackage)
            {
                <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">
                    <strong>You are editing <code>@content.Ref</code>, which is not your package.</strong>
                    <ul>
                        <li>Publishing creates a <strong>new package of your own</strong> from this content — not a new version of <code>@content.Name</code>.</li>
                        <li>Any customisation your packages already carry is not in this content, and will not be in what you publish.</li>
                        @if (WorkflowManifestReader.ReadTitle(content.Manifest) != null
                            || WorkflowManifestReader.ReadDescription(content.Manifest) != null
                            || WorkflowManifestReader.ReadTags(content.Manifest) is { Count: > 0 })
                        {
                            @* #432/#453: a fork across names starts with no title and
                               no tags. Said here, before the publish, not discovered
                               after it. *@
                            <li>Its title, description and tags are not carried over: your version starts with no title and no tags, and shows as its ref until you name it in the Package pane after publishing.</li>
                        }
                        <li>Your consults switch to the published version immediately.</li>
                    </ul>
                </FluentMessageBar>
            }

            @if (!string.IsNullOrWhiteSpace(selectionNotice))
            {
                <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">@selectionNotice</FluentMessageBar>
            }

            @* #429 (v9 § 10), back for v10 (#492): a format the registry accepts
               before the engine runs it. A deferred state gets a visible name and
               an up-front notification — never a silent hold. *@
            @if (NotYetRunnable)
            {
                <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">
                    specVersion @EffectiveSpecVersion is publishable but not yet runnable: consults pinned to a specVersion @EffectiveSpecVersion package will refuse to start until the engine runs it (#500).
                </FluentMessageBar>
            }
            @if (!string.IsNullOrWhiteSpace(publishSuccess))
            {
                <FluentMessageBar Intent="MessageIntent.Success" AllowDismiss="false">@publishSuccess</FluentMessageBar>
            }

            @* The publish succeeded and the version is immutable, so a warning
               here is about what to do next, not about what to fix now. *@
            @if (publishWarnings.Count > 0)
            {
                <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">
                    <strong>Published, with something worth checking.</strong>
                    <ul>
                        @foreach (var warning in publishWarnings)
                        {
                            <li>@warning</li>
                        }
                    </ul>
                </FluentMessageBar>
            }

            @if (publishErrors.Count > 0)
            {
                <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false">
                    <strong>Publish rejected — nothing was saved.</strong>
                    <ul>
                        @foreach (var error in publishErrors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </FluentMessageBar>
            }

            <div class="editor-layout">
                <nav class="editor-nav" aria-label="Package contents">
                    <span class="editor-nav__group">Prompts</span>
                    @foreach (var prompt in EffectivePrompts)
                    {
                        <button type="button"
                                class="editor-nav__item @(selectedKey == prompt.File ? "editor-nav__item--selected" : "")"
                                @onclick="() => Select(prompt.File)">
                            <span class="editor-nav__dot">@(edits.ContainsKey(prompt.File) || HasVariableEdits(prompt.Id) || AddedNodeForPromptFile(prompt.File) != null || AddedPromptForFile(prompt.File) != null ? "●" : "")</span>
                            <span>@prompt.Id</span>
                        </button>
                        @if (AddedPromptForFile(prompt.File) is { } pendingPrompt)
                        {
                            <div class="editor-nav__item editor-nav__item--nested">
                                <span class="editor-nav__dot"></span>
                                <button type="button" class="editor-nav__restore" @onclick="() => RemoveAddedPromptAsync(pendingPrompt)">(remove)</button>
                            </div>
                        }
                    }
                    <button type="button"
                            class="editor-nav__item editor-nav__add @(selectedKey == AddPromptKey ? "editor-nav__item--selected" : "")"
                            @onclick="() => Select(AddPromptKey)">
                        <span class="editor-nav__dot"></span>
                        <span>+ Prompt</span>
                    </button>
                    <span class="editor-nav__group">Data</span>
                    @foreach (var collection in EffectiveCollections)
                    {
                        <details class="editor-nav__folder" open>
                            <summary class="editor-nav__item editor-nav__folder-summary">
                                <span class="editor-nav__chevron" aria-hidden="true">&#x203A;</span>
                                <span class="editor-nav__dot">@(CollectionHasPending(collection) ? "●" : "")</span>
                                <span>@collection.Id (@CollectionCount(collection))</span>
                            </summary>
                            @foreach (var item in collection.Items)
                            {
                                @if (removedFiles.Contains(item.File))
                                {
                                    <div class="editor-nav__item editor-nav__item--nested editor-nav__item--removed">
                                        <span class="editor-nav__dot"></span>
                                        <span class="editor-nav__strike">@item.Name</span>
                                        <button type="button" class="editor-nav__restore" @onclick="() => RestoreItem(item.File)">(restore)</button>
                                    </div>
                                }
                                else
                                {
                                    <button type="button"
                                            class="editor-nav__item editor-nav__item--nested @(selectedKey == item.File ? "editor-nav__item--selected" : "")"
                                            @onclick="() => Select(item.File)">
                                        <span class="editor-nav__dot">@(edits.ContainsKey(item.File) ? "●" : "")</span>
                                        <span>@item.Name</span>
                                    </button>
                                }
                            }
                            @foreach (var added in addedItems.Where(a => a.Collection == collection.Id))
                            {
                                <button type="button"
                                        class="editor-nav__item editor-nav__item--nested @(selectedKey == added.Key ? "editor-nav__item--selected" : "")"
                                        @onclick="() => Select(added.Key)">
                                    <span class="editor-nav__dot">●</span>
                                    <span>@added.Name</span>
                                </button>
                            }
                            <button type="button"
                                    class="editor-nav__item editor-nav__item--nested editor-nav__add @(selectedKey == NewKeyFor(collection.Id) ? "editor-nav__item--selected" : "")"
                                    @onclick="() => Select(NewKeyFor(collection.Id))">
                                <span class="editor-nav__dot"></span>
                                <span>+ Add item</span>
                            </button>
                            @if (addedCollections.Contains(collection.Id))
                            {
                                <div class="editor-nav__item editor-nav__item--nested">
                                    <span class="editor-nav__dot"></span>
                                    <button type="button" class="editor-nav__restore" @onclick="() => RemoveCollectionAsync(collection.Id)">(remove folder)</button>
                                </div>
                            }
                            @if (CollectionIsUnused(collection.Id))
                            {
                                <div class="editor-nav__item editor-nav__item--nested">
                                    <span class="editor-nav__dot"></span>
                                    <span class="muted-text">not used by any workflow node yet</span>
                                </div>
                            }
                        </details>
                    }
                    <button type="button"
                            class="editor-nav__item editor-nav__add @(selectedKey == AddCollectionKey ? "editor-nav__item--selected" : "")"
                            @onclick="() => Select(AddCollectionKey)">
                        <span class="editor-nav__dot"></span>
                        <span>+ Data folder</span>
                    </button>
                    @* A value has no items, so it sits flat in the same Data
                       group rather than as a folder with nothing inside. *@
                    @foreach (var scalar in EffectiveScalars)
                    {
                        @if (ScalarIsRemoved(scalar))
                        {
                            <div class="editor-nav__item editor-nav__value editor-nav__item--removed">
                                <span class="editor-nav__dot"></span>
                                <span class="editor-nav__strike">@scalar.Id</span>
                                <button type="button" class="editor-nav__restore" @onclick="() => RestoreScalarAsync(scalar.Id)">(restore)</button>
                            </div>
                        }
                        else
                        {
                            <button type="button"
                                    class="editor-nav__item editor-nav__value @(selectedKey == scalar.Path ? "editor-nav__item--selected" : "")"
                                    @onclick="() => Select(scalar.Path)">
                                <span class="editor-nav__dot">@(ScalarHasPending(scalar) ? "●" : "")</span>
                                <span>@scalar.Id</span>
                            </button>
                            @if (ScalarIsUnused(scalar.Id))
                            {
                                <div class="editor-nav__item editor-nav__item--nested">
                                    <span class="editor-nav__dot"></span>
                                    <span class="muted-text">not bound by any workflow node yet</span>
                                </div>
                            }
                        }
                    }
                    <button type="button"
                            class="editor-nav__item editor-nav__add @(selectedKey == AddScalarKey ? "editor-nav__item--selected" : "")"
                            @onclick="() => Select(AddScalarKey)">
                        <span class="editor-nav__dot"></span>
                        <span>+ Data value</span>
                    </button>
                    <span class="editor-nav__group">Workflow</span>
                    @if (EffectiveSpecVersion >= 9)
                    {
                        @* #432: the package's own pane arrives with v9. *@
                        <button type="button"
                                class="editor-nav__item @(selectedKey == PackageKey ? "editor-nav__item--selected" : "")"
                                @onclick="() => Select(PackageKey)">
                            <span class="editor-nav__dot">@(titleEdit != null || descriptionEdit != null || tagsEdit != null ? "●" : "")</span>
                            <span>Package</span>
                        </button>
                    }
                    @if (IsV7)
                    {
                        @* Declared sections are v7-only: v5/v6 have a frozen
                           single input and a string result, neither authored. *@
                        <button type="button"
                                class="editor-nav__item @(selectedKey == InputsKey ? "editor-nav__item--selected" : "")"
                                @onclick="() => Select(InputsKey)">
                            <span class="editor-nav__dot">@(inputsEdit != null ? "●" : "")</span>
                            <span>Inputs</span>
                        </button>
                        <button type="button"
                                class="editor-nav__item @(selectedKey == ResultsKey ? "editor-nav__item--selected" : "")"
                                @onclick="() => Select(ResultsKey)">
                            <span class="editor-nav__dot">@(resultsEdit != null ? "●" : "")</span>
                            <span>Documents</span>
                        </button>
                    }
                    <button type="button"
                            class="editor-nav__item @(selectedKey == GraphKey ? "editor-nav__item--selected" : "")"
                            @onclick="() => Select(GraphKey)">
                        <span class="editor-nav__dot">@(bindingEdits.Count > 0 || nodeEdits.Count > 0 ? "●" : "")</span>
                        <span>Graph</span>
                    </button>
                    @foreach (var navNode in EffectiveNodes)
                    {
                        <button type="button"
                                class="editor-nav__item editor-nav__item--nested @(selectedKey == NodeKeyFor(navNode.Id) ? "editor-nav__item--selected" : "")"
                                @onclick="() => Select(NodeKeyFor(navNode.Id))">
                            <span class="editor-nav__dot">@(NodeHasPending(navNode) ? "●" : "")</span>
                            <span>@navNode.Label</span>
                        </button>
                    }
                    @foreach (var removedNode in RemovedNodes)
                    {
                        <div class="editor-nav__item editor-nav__item--nested editor-nav__item--removed">
                            <span class="editor-nav__dot"></span>
                            <span class="editor-nav__strike">@removedNode.Label</span>
                            <button type="button" class="editor-nav__restore" @onclick="() => RestoreNodeAsync(removedNode.Id)">(restore)</button>
                        </div>
                    }
                    <button type="button"
                            class="editor-nav__item editor-nav__item--nested editor-nav__add @(selectedKey == AddNodeKey ? "editor-nav__item--selected" : "")"
                            @onclick="() => Select(AddNodeKey)">
                        <span class="editor-nav__dot"></span>
                        <span>+ Node</span>
                    </button>
                </nav>

                <section class="content-card editor-pane">
                    @if (selectedKey != null && selectedKey.StartsWith(NewKeyPrefix, StringComparison.Ordinal))
                    {
                        var newCollection = selectedKey[NewKeyPrefix.Length..];
                        <div class="pane-header">
                            <div>
                                <h3 class="panel-title">New @newCollection item</h3>
                                <p class="muted-text">Adds a generated section to every future consult.</p>
                            </div>
                        </div>
                        @if (newItemError != null)
                        {
                            <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false">@newItemError</FluentMessageBar>
                        }
                        <div class="new-item-fields">
                            <label class="input-field">
                                <span>id (lowercase, letters/digits/-/_)</span>
                                <FluentTextField @bind-Value="newItemId" Placeholder="ros" />
                            </label>
                            <label class="input-field">
                                <span>name</span>
                                <FluentTextField @bind-Value="newItemName" Placeholder="Review of Systems" />
                            </label>
                        </div>
                        <div class="pane-split">
                            <label class="input-field pane-editor">
                                <span>Standard</span>
                                <FluentTextArea @bind-Value="newItemContent" Rows="14" />
                            </label>
                            <div class="pane-preview">
                                <span class="muted-text">Preview</span>
                                <div class="markdown-preview">
                                    @((MarkupString)MarkdownPreview.Render(newItemContent ?? string.Empty))
                                </div>
                            </div>
                        </div>
                        <div class="action-row">
                            <FluentButton Appearance="Appearance.Accent" @onclick="() => AddItemAsync(newCollection)">
                                Add to @newCollection
                            </FluentButton>
                        </div>
                    }
                    else if (selectedKey == AddCollectionKey)
                    {
                        <div class="pane-header">
                            <div>
                                <h3 class="panel-title">New data folder</h3>
                                <p class="muted-text">
                                    A new collection of items beside the existing folders. Add at least one
                                    item before publishing; workflow nodes can be connected to it in a later
                                    graph edit.
                                </p>
                            </div>
                        </div>
                        @if (newCollectionError != null)
                        {
                            <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false">@newCollectionError</FluentMessageBar>
                        }
                        <div class="new-item-fields">
                            <label class="input-field">
                                <span>folder id (lowercase, digits, hyphens)</span>
                                <FluentTextField @bind-Value="newCollectionId" Placeholder="guidelines" />
                            </label>
                        </div>
                        <div class="action-row">
                            <FluentButton Appearance="Appearance.Accent" @onclick="AddCollectionAsync">
                                Create folder
                            </FluentButton>
                        </div>
                    }
                    else if (selectedKey == AddScalarKey)
                    {
                        <div class="pane-header">
                            <div>
                                <h3 class="panel-title">New data value</h3>
                                <p class="muted-text">
                                    A single piece of text the package owns — a specialty, a note type — that
                                    prompts read as <code>data:&lt;id&gt;</code>. Unlike a folder it has no items;
                                    it is one value, the same for every consult this package runs.
                                </p>
                            </div>
                        </div>
                        @if (newScalarError != null)
                        {
                            <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false">@newScalarError</FluentMessageBar>
                        }
                        <div class="new-item-fields">
                            <label class="input-field">
                                <span>value id (lowercase, digits, underscores, hyphens)</span>
                                <FluentTextField @bind-Value="newScalarId" Placeholder="specialty" />
                            </label>
                        </div>
                        <div class="action-row">
                            <FluentButton Appearance="Appearance.Accent" @onclick="AddScalarAsync">
                                Create value
                            </FluentButton>
                        </div>
                    }
                    else if (SelectedScalar() is { } scalar)
                    {
                        <WorkflowEditorPane Title="@scalar.Id"
                                            Subtitle="@(addedScalars.ContainsKey(scalar.Id) ? $"{scalar.Path} — new, unpublished" : scalar.Path)"
                                            EditLabel="Value"
                                            Text="@GetText(scalar.Path)"
                                            Modified="@ScalarHasPending(scalar)"
                                            TextChanged="@(value => OnTextChangedAsync(scalar.Path, value))">
                            <HeaderActions>
                                @{ var holders = NodesBinding(scalar.Id); }
                                <FluentButton Appearance="Appearance.Outline"
                                              Disabled="@(holders.Count > 0)"
                                              @onclick="() => RemoveScalarAsync(scalar.Id)">
                                    Remove
                                </FluentButton>
                            </HeaderActions>
                            <ChildContent>
                                @* Said before the button is reached for, not after
                                   it is pressed: deleting a bound value produces a
                                   package the server refuses to publish. *@
                                @if (NodesBinding(scalar.Id) is { Count: > 0 } bindingNodes)
                                {
                                    <p class="muted-text">
                                        Bound by @(bindingNodes.Count == 1 ? "node" : "nodes")
                                        @(string.Join(", ", bindingNodes.Select(id => $"'{id}'"))) —
                                        rebind or remove @(bindingNodes.Count == 1 ? "that node" : "those nodes")
                                        first to delete this value.
                                    </p>
                                }
                                <p class="muted-text">
                                    Bound as <code>data:@scalar.Id</code>. Inserted into prompts exactly as
                                    typed — a trailing newline becomes a line break mid-sentence.
                                </p>
                            </ChildContent>
                        </WorkflowEditorPane>
                    }
                    else if (SelectedAdded() is { } addedItem)
                    {
                        <WorkflowEditorPane Title="@addedItem.Name"
                                            Subtitle="@($"{AddedPath(addedItem)} — new, unpublished")"
                                            EditLabel="Standard"
                                            Text="@addedItem.Content"
                                            Modified="true"
                                            TextChanged="@(async value => { addedItem.Content = value; await PendingChangedAsync(); })">
                            <HeaderActions>
                                <FluentButton Appearance="Appearance.Outline" @onclick="() => RemoveAddedAsync(addedItem)">
                                    Remove
                                </FluentButton>
                            </HeaderActions>
                            <ChildContent>
                                <p class="muted-text">Adds a generated section to every future consult.</p>
                            </ChildContent>
                        </WorkflowEditorPane>
                    }
                    else if (selectedKey == PackageKey)
                    {
                        <div class="pane-header">
                            <div>
                                <h3 class="panel-title">Package</h3>
                                <p class="muted-text">
                                    What this package is called and what it is for. Every place that names a
                                    package — the picker, the consult setup line, a job's history — shows the
                                    title when there is one and the ref <code>@content.Ref</code> when there is not.
                                </p>
                            </div>
                        </div>
                        <label class="package-field">
                            <span>Title</span>
                            <input class="node-field__input"
                                   maxlength="@WorkflowPackageMetadata.MaxTitleLength"
                                   value="@(EffectiveTitle ?? string.Empty)"
                                   placeholder="@content.Ref"
                                   disabled="@(!EditingOwnPackage)"
                                   @onchange="args => OnTitleChangedAsync(args.Value?.ToString())"
                                   aria-label="Package title" />
                            <span class="muted-text">
                                @(string.IsNullOrEmpty(EffectiveTitle)
                                    ? $"Shown as {content.Ref} until a title is given."
                                    : $"{EffectiveTitle.Length}/{WorkflowPackageMetadata.MaxTitleLength} characters")
                            </span>
                        </label>
                        <label class="package-field">
                            <span>Description</span>
                            <textarea class="node-field__input"
                                      rows="4"
                                      maxlength="@WorkflowPackageMetadata.MaxDescriptionLength"
                                      value="@(EffectiveDescription ?? string.Empty)"
                                      disabled="@(!EditingOwnPackage)"
                                      @onchange="args => OnDescriptionChangedAsync(args.Value?.ToString())"
                                      aria-label="Package description"></textarea>
                            <span class="muted-text">
                                @(string.IsNullOrEmpty(EffectiveDescription)
                                    ? "No description."
                                    : $"{EffectiveDescription.Length}/{WorkflowPackageMetadata.MaxDescriptionLength} characters")
                            </span>
                        </label>
                        @* #453: the labels the package is found by. Required at 9
                           — the empty set is a stated answer, shown as such — and
                           never suggested. Order is the author's: the buttons move
                           a tag, nothing sorts. *@
                        <div class="package-field">
                            <span>Tags</span>
                            @if (EffectiveTags.Count == 0)
                            {
                                <span class="muted-text">No tags.</span>
                            }
                            else
                            {
                                <ul class="package-tags" aria-label="Package tags">
                                    @for (var i = 0; i < EffectiveTags.Count; i++)
                                    {
                                        var index = i;
                                        var tag = EffectiveTags[index];
                                        <li class="package-tag">
                                            <span class="package-tag__text">@tag</span>
                                            <button type="button" class="package-tag__button" disabled="@(!EditingOwnPackage || index == 0)"
                                                    title="Move earlier" aria-label="Move tag @tag earlier"
                                                    @onclick="() => MoveTagAsync(index, -1)">◀</button>
                                            <button type="button" class="package-tag__button" disabled="@(!EditingOwnPackage || index == EffectiveTags.Count - 1)"
                                                    title="Move later" aria-label="Move tag @tag later"
                                                    @onclick="() => MoveTagAsync(index, 1)">▶</button>
                                            <button type="button" class="package-tag__button" disabled="@(!EditingOwnPackage)"
                                                    title="Remove" aria-label="Remove tag @tag"
                                                    @onclick="() => RemoveTagAsync(index)">✕</button>
                                        </li>
                                    }
                                </ul>
                            }
                            <div class="package-tags__add">
                                <input class="node-field__input"
                                       maxlength="@WorkflowPackageMetadata.MaxTagLength"
                                       value="@newTag"
                                       placeholder="Add a tag"
                                       disabled="@(!EditingOwnPackage || EffectiveTags.Count >= WorkflowPackageMetadata.MaxTags)"
                                       @oninput="args => newTag = args.Value?.ToString() ?? string.Empty"
                                       @onkeydown="OnNewTagKeyDownAsync"
                                       aria-label="New tag" />
                                <button type="button" class="node-field__button"
                                        disabled="@(!EditingOwnPackage || string.IsNullOrWhiteSpace(newTag) || EffectiveTags.Count >= WorkflowPackageMetadata.MaxTags)"
                                        @onclick="AddTagAsync">Add tag</button>
                            </div>
                            <span class="muted-text">
                                @(newTagProblem ?? $"{EffectiveTags.Count}/{WorkflowPackageMetadata.MaxTags} tags; each at most {WorkflowPackageMetadata.MaxTagLength} characters, distinct ignoring case.")
                            </span>
                        </div>
                        @if (!EditingOwnPackage)
                        {
                            @* The server clears all three on a fork across names, so the
                               fields do not accept what it would strip. *@
                            <p class="muted-text">A fork starts with no title and no tags. Publish your version first, then name it here.</p>
                        }
                    }
                    else if (selectedKey == InputsKey)
                    {
                        <div class="pane-header">
                            <div>
                                <h3 class="panel-title">Declared inputs</h3>
                                <p class="muted-text">
                                    The fields a clinician fills before a run. Nodes bind them as
                                    <code>input:&lt;id&gt;</code>; renaming one re-points every binding that used it.
                                    An object declares its fields here; an array says what its entries are.
                                </p>
                            </div>
                        </div>

                        <ul class="declared-list">
                            @foreach (var input in EffectiveInputs)
                            {
                                var slot = input;
                                <li class="declared-row">
                                    <input class="node-field__input declared-row__id"
                                           value="@slot.Id"
                                           @onchange="args => RenameInputAsync(slot, args.Value?.ToString())"
                                           aria-label="@($"Id for input {slot.Id}")" />
                                    <input class="node-field__input"
                                           value="@slot.Label"
                                           @onchange="args => RelabelInputAsync(slot, args.Value?.ToString())"
                                           aria-label="@($"Label for input {slot.Id}")" />
                                    <label class="declared-row__required">
                                        <input type="checkbox"
                                               checked="@slot.Required"
                                               @onchange="args => SetInputRequiredAsync(slot, args.Value is true)"
                                               aria-label="@($"Required for input {slot.Id}")" />
                                        required
                                    </label>
                                    @* v8: the declared type decides the intake control and
                                       what a condition can read. v9 (#429): a number, an
                                       object of fields, an array of elements. *@
                                    <select class="node-field__input declared-row__type"
                                            value="@WorkflowInputTypes.Of(slot)"
                                            @onchange="args => RetypeInputAsync(slot, args.Value?.ToString())"
                                            aria-label="@($"Type for input {slot.Id}")">
                                        @* A type the vocabulary does not know is shown as
                                           itself rather than as "text". *@
                                        @if (!WorkflowInputTypes.All.Contains(WorkflowInputTypes.Of(slot)))
                                        {
                                            <option value="@WorkflowInputTypes.Of(slot)">@WorkflowInputTypes.Of(slot)</option>
                                        }
                                        @foreach (var type in WorkflowInputTypes.All)
                                        {
                                            <option value="@type">@type</option>
                                        }
                                    </select>
                                    @if (WorkflowInputTypes.Of(slot) == WorkflowInputTypes.Array)
                                    {
                                        @* Explicit initialisation: an array says what its
                                           entries are, or the desk refuses the publish. *@
                                        <select class="node-field__input declared-row__items"
                                                value="@(slot.Items?.Type ?? string.Empty)"
                                                @onchange="args => SetInputItemsAsync(slot, args.Value?.ToString())"
                                                aria-label="@($"Items for input {slot.Id}")">
                                            @if (slot.Items is null)
                                            {
                                                <option value="">entries of…</option>
                                            }
                                            else if (!WorkflowInputTypes.ElementTypesFor(EffectiveSpecVersion).Contains(slot.Items.Type))
                                            {
                                                <option value="@slot.Items.Type">@slot.Items.Type</option>
                                            }
                                            @foreach (var element in WorkflowInputTypes.ElementTypesFor(EffectiveSpecVersion))
                                            {
                                                <option value="@element">@element</option>
                                            }
                                        </select>
                                        @if (slot.Items?.Type == WorkflowInputTypes.Array)
                                        {
                                            @* v10 (#498): an array of arrays says what the inner
                                               entries are — a scalar; deeper is authored elsewhere. *@
                                            <select class="node-field__input declared-row__inner-items"
                                                    value="@(slot.Items.Items?.Type ?? string.Empty)"
                                                    @onchange="args => SetInputInnerItemsAsync(slot, args.Value?.ToString())"
                                                    aria-label="@($"Inner items for input {slot.Id}")">
                                                @if (slot.Items.Items is null)
                                                {
                                                    <option value="">entries of entries of…</option>
                                                }
                                                @foreach (var element in WorkflowInputTypes.Scalars)
                                                {
                                                    <option value="@element">@element</option>
                                                }
                                            </select>
                                        }
                                    }
                                    <button type="button" class="aggregate-row__button" title="Remove input"
                                            disabled="@(EffectiveInputs.Count == 1 || ConditionLock(slot) != null)"
                                            @onclick="() => RemoveInputAsync(slot)">×</button>
                                </li>

                                @if (WorkflowInputTypes.DeclaresValues(slot))
                                {
                                    <li class="declared-row__values">
                                        @foreach (var value in slot.Values ?? Array.Empty<string>())
                                        {
                                            var declaredValue = value;
                                            <span class="input-field__chip" data-enum-value="@declaredValue">
                                                @declaredValue
                                                <button type="button" class="aggregate-row__button" title="Remove value"
                                                        @onclick="() => RemoveEnumValueAsync(slot, declaredValue)">×</button>
                                            </span>
                                        }
                                        <input class="node-field__input" placeholder="follow_up"
                                               @onchange="args => AddEnumValueAsync(slot, args.Value?.ToString())"
                                               aria-label="@($"Add a value to {slot.Id}")" />
                                    </li>
                                }

                                @if (WorkflowInputTypes.DeclaresObject(slot))
                                {
                                    @FieldsEditor(new FieldsScope(slot.Id, slot.Fields ?? Array.Empty<WorkflowManifestReader.FieldView>()))
                                }

                                @if (ConditionLock(slot) is { } lockedBy)
                                {
                                    <li class="declared-row__note"><span class="muted-text">@lockedBy</span></li>
                                }
                            }
                        </ul>
                        <div class="add-variable__form">
                            <input class="node-field__input" placeholder="prior_notes"
                                   value="@newInputId"
                                   @onchange="args => newInputId = args.Value?.ToString() ?? string.Empty"
                                   aria-label="New input id" />
                            <button type="button" class="variable-chips__add" @onclick="AddInputAsync">+ Input</button>
                        </div>
                        @if (!string.IsNullOrEmpty(declaredError))
                        {
                            <p class="editor-warning">@declaredError</p>
                        }
                    }
                    else if (selectedKey == ResultsKey)
                    {
                        <div class="pane-header">
                            <div>
                                <h3 class="panel-title">Documents</h3>
                                <p class="muted-text">
                                    Each deliverable this package produces. Every one names its own aggregator
                                    node, and its id becomes the delivered file's name.
                                </p>
                            </div>
                        </div>

                        @if (EffectiveResults.Count == 0)
                        {
                            <p class="muted-text">
                                This package uses the single-document form (<code>@(EffectiveResultRef ?? "—")</code>).
                            </p>
                            <button type="button" class="variable-chips__add" @onclick="ConvertToResultsListAsync">
                                Convert to a document list
                            </button>
                        }
                        else
                        {
                            <ul class="declared-list">
                                @foreach (var result in EffectiveResults)
                                {
                                    var deliverable = result;
                                    <li class="declared-row">
                                        <input class="node-field__input declared-row__id"
                                               value="@deliverable.Id"
                                               @onchange="args => RenameResultAsync(deliverable, args.Value?.ToString())"
                                               aria-label="@($"Id for document {deliverable.Id}")" />
                                        <input class="node-field__input"
                                               value="@deliverable.Label"
                                               @onchange="args => RelabelResultAsync(deliverable, args.Value?.ToString())"
                                               aria-label="@($"Label for document {deliverable.Id}")" />
                                        <select class="binding-row__select"
                                                value="@deliverable.Node"
                                                @onchange="args => RepointResultAsync(deliverable, args.Value?.ToString())"
                                                aria-label="@($"Node for document {deliverable.Id}")">
                                            @foreach (var candidate in DeliverableCandidates)
                                            {
                                                <option value="@($"node:{candidate.Id}")">@candidate.Label</option>
                                            }
                                        </select>
                                        <button type="button" class="aggregate-row__button" title="Remove document"
                                                disabled="@(EffectiveResults.Count == 1)"
                                                @onclick="() => RemoveResultAsync(deliverable)">×</button>
                                    </li>

                                    @* v8: when this document is produced. Three controls
                                       rather than a text field — the literal follows the
                                       chosen operand's type, which is what makes the closed
                                       grammar authorable instead of a string to get wrong.
                                       v9 (#429): the operand may be a path into an object
                                       or the count of an array, and a number or a date may
                                       be ordered. *@
                                    <li class="declared-row__when" data-when-for="@deliverable.Id">
                                        @if (ConditionOperands.Count == 0)
                                        {
                                            <span class="muted-text">
                                                @(EffectiveSpecVersion >= 9
                                                    ? "Always produced. Declare an enum, boolean, number, date, object or array input to make it conditional."
                                                    : "Always produced. Declare an enum or boolean input to make it conditional.")
                                            </span>
                                        }
                                        else
                                        {
                                            var operandKey = WorkflowResultConditionText.OperandOf(deliverable.When);
                                            var operand = ConditionOperands.FirstOrDefault(candidate => candidate.Key == operandKey);
                                            <select class="node-field__input"
                                                    value="@(operandKey ?? string.Empty)"
                                                    @onchange="args => SetResultConditionAsync(deliverable, args.Value?.ToString())"
                                                    aria-label="@($"Condition operand for {deliverable.Id}")">
                                                <option value="">always produced</option>
                                                @if (operandKey != null && operand is null)
                                                {
                                                    @* A loaded condition naming something not offered
                                                       here — shown as itself, never rewritten. *@
                                                    <option value="@operandKey">when @operandKey</option>
                                                }
                                                @foreach (var candidate in ConditionOperands)
                                                {
                                                    <option value="@candidate.Key">when @candidate.Key</option>
                                                }
                                            </select>

                                            @if (operand is { } tested)
                                            {
                                                @if (tested.Type == WorkflowInputTypes.Array)
                                                {
                                                    <span class="muted-text declared-row__literal">has entries</span>
                                                }
                                                else
                                                {
                                                    <select class="node-field__input"
                                                            value="@(WorkflowResultConditionText.OperatorOf(deliverable.When) ?? "==")"
                                                            @onchange="args => SetConditionOperatorAsync(deliverable, tested.Key, args.Value?.ToString())"
                                                            aria-label="@($"Condition operator for {deliverable.Id}")">
                                                        @foreach (var symbol in OperatorsFor(tested.Type))
                                                        {
                                                            <option value="@symbol">@OperatorWord(symbol)</option>
                                                        }
                                                    </select>
                                                    @if (tested.Type == WorkflowInputTypes.Boolean)
                                                    {
                                                        <select class="node-field__input declared-row__literal"
                                                                value="@(WorkflowResultConditionText.LiteralOf(deliverable.When) ?? string.Empty)"
                                                                @onchange="args => SetResultConditionAsync(deliverable, tested.Key, null, args.Value?.ToString())"
                                                                aria-label="@($"Condition value for {deliverable.Id}")">
                                                            <option value="true">true</option>
                                                            <option value="false">false</option>
                                                        </select>
                                                    }
                                                    else if (tested.Type == WorkflowInputTypes.Enum)
                                                    {
                                                        <select class="node-field__input declared-row__literal"
                                                                value="@(WorkflowResultConditionText.LiteralOf(deliverable.When) ?? string.Empty)"
                                                                @onchange="args => SetResultConditionAsync(deliverable, tested.Key, null, args.Value?.ToString())"
                                                                aria-label="@($"Condition value for {deliverable.Id}")">
                                                            @foreach (var option in tested.Values ?? Array.Empty<string>())
                                                            {
                                                                <option value="@option">@option</option>
                                                            }
                                                        </select>
                                                    }
                                                    else if (tested.Type == WorkflowInputTypes.Date)
                                                    {
                                                        <input type="date"
                                                               class="node-field__input declared-row__literal"
                                                               value="@(WorkflowResultConditionText.LiteralOf(deliverable.When) ?? string.Empty)"
                                                               @onchange="args => SetResultConditionAsync(deliverable, tested.Key, null, args.Value?.ToString())"
                                                               aria-label="@($"Condition value for {deliverable.Id}")" />
                                                    }
                                                    else
                                                    {
                                                        @* A number as spelled, or a count as a whole number. *@
                                                        <input type="text"
                                                               inputmode="@(tested.Type == CountType ? "numeric" : "decimal")"
                                                               class="node-field__input declared-row__literal"
                                                               value="@(WorkflowResultConditionText.LiteralOf(deliverable.When) ?? string.Empty)"
                                                               @onchange="args => SetResultConditionAsync(deliverable, tested.Key, null, args.Value?.ToString())"
                                                               aria-label="@($"Condition value for {deliverable.Id}")" />
                                                    }
                                                }
                                            }
                                        }
                                    </li>
                                }
                            </ul>
                            <div class="add-variable__form">
                                <input class="node-field__input" placeholder="patient_letter"
                                       value="@newResultId"
                                       @onchange="args => newResultId = args.Value?.ToString() ?? string.Empty"
                                       aria-label="New document id" />
                                <button type="button" class="variable-chips__add" @onclick="AddResultAsync">+ Document</button>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(declaredError))
                        {
                            <p class="editor-warning">@declaredError</p>
                        }
                    }
                    else if (selectedKey == GraphKey)
                    {
                        <div class="pane-header">
                            <div>
                                <h3 class="panel-title">Workflow graph</h3>
                                <p class="muted-text">
                                    Node structure and output contracts are fixed in this editor; prompt
                                    bindings and variables are editable below. Refresh redraws the graph —
                                    pending edits included, highlighted in blue.
                                </p>
                            </div>
                            <button type="button" class="variable-chips__add"
                                    disabled="@isDiagramRefreshing"
                                    @onclick="RefreshDiagramAsync">@(isDiagramRefreshing ? "Refreshing…" : "Refresh")</button>
                        </div>
                        @if (diagramIncludesPending)
                        {
                            <p class="muted-text">Showing pending edits — blue new or changed, dashed red removed.</p>
                        }
                        else if (HasManifestEdits && diagramText != null)
                        {
                            <p class="muted-text">Pending edits not shown — Refresh to preview them.</p>
                        }
                        <WorkflowDagView Diagram="@diagramText" />
                        @if (UnreachableNodeLabels() is { Count: > 0 } unreachable)
                        {
                            <p class="muted-text">
                                ⚠ Not feeding the deliverable yet (publish will fail):
                                @string.Join(", ", unreachable) — connect them through bindings or an aggregator.
                            </p>
                        }
                        <div class="pane-header">
                            <h2 class="panel-title">Node details</h2>
                            <div class="result-selector">
                                <label class="node-field">
                                    <span>deliverable</span>
                                    <select class="binding-row__select"
                                            value="@(EffectiveResultRef ?? string.Empty)"
                                            @onchange="OnResultChangedAsync"
                                            aria-label="Deliverable node">
                                        @foreach (var candidate in DeliverableCandidates)
                                        {
                                            <option value="@($"node:{candidate.Id}")">@candidate.Label</option>
                                        }
                                    </select>
                                    @if (resultEdit != null)
                                    {
                                        <span class="binding-row__pending" title="Pending change">●</span>
                                    }
                                </label>
                                <button type="button" class="variable-chips__add" @onclick="() => Select(AddNodeKey)">+ Node</button>
                            </div>
                        </div>
                        <WorkflowNodeSummary Inputs="@DeclaredInputIds"
                                             Nodes="@EffectiveNodes"
                                             Editable="true"
                                             Scalars="@ScalarIds"
                                             Collections="@CollectionIds"
                                             ArrayInputs="@ArrayInputIds"
                                             ContractOptions="@ContractOptions"
                                             PromptOptions="@EffectivePrompts.Select(p => p.Id).ToList()"
                                             AllowPromptChange="@(EffectiveSpecVersion >= 6)"
                                             NodeModified="@(id => nodeEdits.ContainsKey(id) || aggregateEdits.ContainsKey(id))"
                                             RemovedNodes="@RemovedNodes"
                                             RowsFor="@RowsFor"
                                             ValidateVariableName="@ValidateVariableNameForNode"
                                             OnBindingChanged="OnBindingChangedAsync"
                                             OnVariableAdded="OnVariableAddedAsync"
                                             OnNodeChanged="OnNodeChangedAsync"
                                             OnAggregateChanged="OnAggregateChangedAsync"
                                             OnNodeRemoved="RemoveNodeAsync"
                                             OnNodeRestored="RestoreNodeAsync" />
                    }
                    else if (selectedKey == AddPromptKey)
                    {
                        <div class="pane-header">
                            <div>
                                <h3 class="panel-title">New prompt</h3>
                                <p class="muted-text">
                                    A standalone prompt draft. Publish stays blocked until some node uses
                                    it — point a node at it with the prompt selector, or choose it when
                                    creating a node.
                                </p>
                            </div>
                        </div>
                        @if (newPromptError != null)
                        {
                            <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false">@newPromptError</FluentMessageBar>
                        }
                        <div class="new-item-fields">
                            <label class="input-field">
                                <span>id (lowercase, letters/digits/-/_)</span>
                                <FluentTextField @bind-Value="newPromptId" Placeholder="summarize-item" />
                            </label>
                        </div>
                        <div class="action-row">
                            <FluentButton Appearance="Appearance.Accent" @onclick="AddPromptAsync">
                                Create prompt
                            </FluentButton>
                        </div>
                    }
                    else if (selectedKey == AddNodeKey)
                    {
                        <div class="pane-header">
                            <div>
                                <h3 class="panel-title">New node</h3>
                                <p class="muted-text">
                                    @(newNodeKind == "aggregator"
                                        ? "A deterministic aggregator: collects other nodes' outputs in order, no prompt."
                                        : "Creates the node and its prompt together (they are one-to-one). The prompt's text is written under Prompts; variables and bindings follow on the node's card.")
                                </p>
                            </div>
                        </div>
                        @if (newNodeError != null)
                        {
                            <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false">@newNodeError</FluentMessageBar>
                        }
                        <div class="new-item-fields">
                            <label class="input-field">
                                <span>kind</span>
                                <select class="binding-row__select" @bind="newNodeKind">
                                    <option value="prompt">prompt node</option>
                                    @if (EffectiveSpecVersion >= 6)
                                    {
                                        <option value="aggregator">aggregator</option>
                                    }
                                </select>
                            </label>
                            <label class="input-field">
                                <span>id (lowercase, letters/digits/-/_)@(newNodePrompt.Length > 0 ? " — optional, defaults to the prompt's name" : "")</span>
                                <FluentTextField @bind-Value="newNodeId" Placeholder="@(newNodePrompt.Length > 0 ? newNodePrompt : "summarize-guidelines")" />
                            </label>
                            <label class="input-field">
                                <span>label@(newNodePrompt.Length > 0 ? " — optional, defaults to the prompt's name" : "")</span>
                                <FluentTextField @bind-Value="newNodeLabel" Placeholder="Summarizing guidelines" />
                            </label>
                            @if (newNodeKind != "aggregator")
                            {
                                @if (EffectiveSpecVersion >= 6)
                                {
                                    <label class="input-field">
                                        <span>prompt</span>
                                        <select class="binding-row__select" @bind="newNodePrompt">
                                            <option value="">new prompt (named after the node)</option>
                                            @foreach (var existingPrompt in EffectivePrompts)
                                            {
                                                <option value="@existingPrompt.Id">@existingPrompt.Id</option>
                                            }
                                        </select>
                                    </label>
                                }
                                <label class="input-field">
                                    <span>for each</span>
                                    <select class="binding-row__select" @bind="newNodeForEach" aria-label="New node forEach">
                                        <option value="">— runs once —</option>
                                        @foreach (var option in WorkflowNodeSummary.ForEachOptions(CollectionIds, ArrayInputIds))
                                        {
                                            <option value="@option">@option</option>
                                        }
                                    </select>
                                </label>
                                <label class="input-field">
                                    <span>output</span>
                                    <select class="binding-row__select" @bind="newNodeOutput">
                                        <option value="">prose (text)</option>
                                        @foreach (var contract in ContractOptions)
                                        {
                                            <option value="@contract">@contract</option>
                                        }
                                    </select>
                                </label>
                            }
                        </div>
                        <div class="action-row">
                            <FluentButton Appearance="Appearance.Accent" @onclick="AddNodeAsync">
                                Create node
                            </FluentButton>
                        </div>
                    }
                    else if (SelectedNode() is { } selectedNode)
                    {
                        <div class="pane-header">
                            <div>
                                <h3 class="panel-title">@selectedNode.Label</h3>
                                <p class="muted-text">One workflow node — the same card as the Graph pane's Node details.</p>
                            </div>
                        </div>
                        <WorkflowNodeSummary Inputs="@DeclaredInputIds"
                                             Nodes="@EffectiveNodes"
                                             Only="@selectedNode.Id"
                                             Editable="true"
                                             Scalars="@ScalarIds"
                                             Collections="@CollectionIds"
                                             ArrayInputs="@ArrayInputIds"
                                             ContractOptions="@ContractOptions"
                                             PromptOptions="@EffectivePrompts.Select(p => p.Id).ToList()"
                                             AllowPromptChange="@(EffectiveSpecVersion >= 6)"
                                             NodeModified="@(id => nodeEdits.ContainsKey(id) || aggregateEdits.ContainsKey(id))"
                                             RowsFor="@RowsFor"
                                             ValidateVariableName="@ValidateVariableNameForNode"
                                             OnBindingChanged="OnBindingChangedAsync"
                                             OnVariableAdded="OnVariableAddedAsync"
                                             OnNodeChanged="OnNodeChangedAsync"
                                             OnAggregateChanged="OnAggregateChangedAsync"
                                             OnNodeRemoved="RemoveNodeAsync" />
                    }
                    else if (SelectedStandard() is { } standard)
                    {
                        <WorkflowEditorPane Title="@standard.Name"
                                            Subtitle="@standard.File"
                                            EditLabel="Standard"
                                            Text="@GetText(standard.File)"
                                            Modified="@edits.ContainsKey(standard.File)"
                                            TextChanged="@(value => OnTextChangedAsync(standard.File, value))">
                            <HeaderActions>
                                <FluentButton Appearance="Appearance.Outline" @onclick="() => RemoveItemAsync(standard.File)">
                                    Remove
                                </FluentButton>
                            </HeaderActions>
                            <ChildContent>
                                <p class="muted-text">
                                    Standards guide organization and tone only. Patient facts still come from the draft consult.
                                </p>
                            </ChildContent>
                        </WorkflowEditorPane>
                    }
                    else if (SelectedPrompt() is { } prompt)
                    {
                        <WorkflowEditorPane Title="@prompt.Id"
                                            Subtitle="@prompt.File"
                                            EditLabel="Prompt text"
                                            Text="@GetText(prompt.File)"
                                            Modified="@(edits.ContainsKey(prompt.File) || AddedNodeForPromptFile(prompt.File) != null || AddedPromptForFile(prompt.File) != null)"
                                            TextChanged="@(value => OnTextChangedAsync(prompt.File, value))">
                            <div class="prompt-variables">
                                <span class="muted-text">Variables</span>
                                <ul class="prompt-variables__list">
                                    @{ var usingNodes = NodesUsingPrompt(prompt.Id).ToList(); }
                                    @foreach (var variable in prompt.Variables.Concat(AddedVariables(prompt.Id)))
                                    {
                                        var isRemoved = IsRemovedVariable(prompt.Id, variable);
                                        var usedInText = VariableUsedInText(prompt, variable);

                                        <li class="prompt-variable-row @(isRemoved ? "prompt-variable-row--removed" : null)">
                                            <code class="prompt-variable-row__name">@variable</code>
                                            @if (isRemoved)
                                            {
                                                <button type="button" class="variable-chips__add" title="Restore variable"
                                                        @onclick="() => RestoreVariableAsync(prompt, variable)">Restore</button>
                                            }
                                            else
                                            {
                                                <span aria-hidden="true">←</span>
                                                <span class="prompt-variable-row__sources">
                                                    @foreach (var usingNode in usingNodes)
                                                    {
                                                        var row = RowFor(usingNode, variable);
                                                        <span class="prompt-variable-row__source">
                                                            @if (usingNodes.Count > 1)
                                                            {
                                                                <span class="muted-text">@usingNode.Id:</span>
                                                            }
                                                            <BindingSourceEditor Node="@usingNode"
                                                                                 Row="@row"
                                                                                 Nodes="@nodes"
                                                                                 Scalars="@ScalarIds"
                                                                                 Inputs="@DeclaredInputIds"
                                                                                 OnChanged="OnBindingChangedAsync" />
                                                            @if (RowModified(row))
                                                            {
                                                                <span class="binding-pending" title="Pending change">●</span>
                                                            }
                                                        </span>
                                                    }
                                                </span>
                                                <button type="button" class="variable-chips__add"
                                                        title="@(usedInText ? "Still used in the template text — remove the placeholder first" : "Remove variable")"
                                                        disabled="@usedInText"
                                                        @onclick="() => RemoveVariableAsync(prompt, variable)">Remove</button>
                                            }
                                        </li>
                                    }
                                    <li class="prompt-variable-row prompt-variable-row--add">
                                        <input class="variable-chips__input" placeholder="new_variable" @bind="newVariableName" aria-label="New variable name" />
                                        <span aria-hidden="true">←</span>
                                        <select class="prompt-variable-row__select" @bind="newVariableSource" aria-label="New variable source">
                                            <option value="">choose source…</option>
                                            @foreach (var option in FirstUsingNodeOptions(prompt))
                                            {
                                                <option value="@option">@option</option>
                                            }
                                        </select>
                                        <button type="button" class="variable-chips__add" @onclick="() => AddVariableFromPromptAsync(prompt)">Add</button>
                                    </li>
                                </ul>
                            </div>
                            @if (newVariableError != null)
                            {
                                <p class="variable-chips__error">@newVariableError</p>
                            }
                            <p class="muted-text">
                                Declared placeholders are usable in the text; a new variable's source can be
                                set here or in Graph — publish waits until every variable has one.
                                @if (prompt.Prelude != null)
                                {
                                    <span> · shared prelude: @prompt.Prelude (read-only)</span>
                                }
                            </p>
                        </WorkflowEditorPane>
                    }
                    else
                    {
                        <p class="muted-text">Select a standard or prompt to edit.</p>
                    }
                </section>
            </div>
        }
    </Authorized>
</AuthorizeView>

@code {
  /// <summary>
  /// v9: an object's fields — each with its own id, label, requiredness and
  /// type. v10 (#498): a field may be an object or an array, and then this
  /// fragment draws itself again beneath it, to any depth; the owner is the
  /// path the sentences and the aria-labels spell ("patient.contact"). Their
  /// own classes, so the input rows' positions do not move.
  /// </summary>
  private RenderFragment<FieldsScope> FieldsEditor => scope =>
    @<text>
      <li class="declared-row__fields" data-fields-for="@scope.Owner">
          <ul class="declared-list">
              @foreach (var declared in scope.Fields)
              {
                  var member = declared;
                  var owner = scope.Owner;
                  var path = $"{owner}.{member.Id}";
                  <li class="declared-field" data-field="@path">
                      <input class="node-field__input declared-field__id"
                             value="@member.Id"
                             @onchange="args => RenameFieldAsync(owner, member, args.Value?.ToString())"
                             aria-label="@($"Id for field {path}")" />
                      <input class="node-field__input declared-field__label"
                             value="@member.Label"
                             @onchange="args => RelabelFieldAsync(owner, member, args.Value?.ToString())"
                             aria-label="@($"Label for field {path}")" />
                      <label class="declared-row__required">
                          <input type="checkbox"
                                 checked="@member.Required"
                                 @onchange="args => SetFieldRequiredAsync(owner, member, args.Value is true)"
                                 aria-label="@($"Required for field {path}")" />
                          required
                      </label>
                      <select class="node-field__input declared-field__type"
                              value="@WorkflowInputTypes.Of(member)"
                              @onchange="args => RetypeFieldAsync(owner, member, args.Value?.ToString())"
                              aria-label="@($"Type for field {path}")">
                          @if (!WorkflowInputTypes.ScalarsFor(EffectiveSpecVersion).Contains(WorkflowInputTypes.Of(member)))
                          {
                              <option value="@WorkflowInputTypes.Of(member)">@WorkflowInputTypes.Of(member)</option>
                          }
                          @foreach (var fieldType in WorkflowInputTypes.ScalarsFor(EffectiveSpecVersion))
                          {
                              <option value="@fieldType">@fieldType</option>
                          }
                      </select>
                      @if (WorkflowInputTypes.Of(member) == WorkflowInputTypes.Array)
                      {
                          <select class="node-field__input declared-field__items"
                                  value="@(member.Items?.Type ?? string.Empty)"
                                  @onchange="args => SetFieldItemsAsync(owner, member, args.Value?.ToString())"
                                  aria-label="@($"Items for field {path}")">
                              @if (member.Items is null)
                              {
                                  <option value="">entries of…</option>
                              }
                              else if (!WorkflowInputTypes.ElementTypesFor(EffectiveSpecVersion).Contains(member.Items.Type))
                              {
                                  <option value="@member.Items.Type">@member.Items.Type</option>
                              }
                              @foreach (var element in WorkflowInputTypes.ElementTypesFor(EffectiveSpecVersion))
                              {
                                  <option value="@element">@element</option>
                              }
                          </select>
                          @if (member.Items?.Type == WorkflowInputTypes.Array)
                          {
                              <select class="node-field__input declared-field__inner-items"
                                      value="@(member.Items.Items?.Type ?? string.Empty)"
                                      @onchange="args => SetFieldInnerItemsAsync(owner, member, args.Value?.ToString())"
                                      aria-label="@($"Inner items for field {path}")">
                                  @if (member.Items.Items is null)
                                  {
                                      <option value="">entries of entries of…</option>
                                  }
                                  @foreach (var element in WorkflowInputTypes.Scalars)
                                  {
                                      <option value="@element">@element</option>
                                  }
                              </select>
                          }
                      }
                      <button type="button" class="aggregate-row__button" title="Remove field"
                              disabled="@(FieldLock(owner, member) != null)"
                              @onclick="() => RemoveFieldAsync(owner, member)">×</button>
                  </li>
                  @if (WorkflowInputTypes.DeclaresValues(member))
                  {
                      <li class="declared-field__values" data-values-for="@path">
                          @foreach (var value in member.Values ?? Array.Empty<string>())
                          {
                              var declaredValue = value;
                              <span class="input-field__chip" data-field-enum-value="@declaredValue">
                                  @declaredValue
                                  <button type="button" class="aggregate-row__button" title="Remove value"
                                          @onclick="() => RemoveFieldValueAsync(owner, member, declaredValue)">×</button>
                              </span>
                          }
                          <input class="node-field__input" placeholder="female"
                                 @onchange="args => AddFieldValueAsync(owner, member, args.Value?.ToString())"
                                 aria-label="@($"Add a value to {path}")" />
                      </li>
                  }
                  @if (WorkflowInputTypes.DeclaresObject(member))
                  {
                      @FieldsEditor(new FieldsScope(path, member.Fields ?? Array.Empty<WorkflowManifestReader.FieldView>()))
                  }
                  @if (FieldLock(owner, member) is { } fieldLockedBy)
                  {
                      <li class="declared-row__note"><span class="muted-text">@fieldLockedBy</span></li>
                  }
              }
          </ul>
          <div class="add-variable__form">
              <input class="node-field__input" placeholder="age"
                     value="@NewFieldId(scope.Owner)"
                     @onchange="args => newFieldIds[scope.Owner] = args.Value?.ToString() ?? string.Empty"
                     aria-label="@($"New field id for {scope.Owner}")" />
              <button type="button" class="variable-chips__add" @onclick="() => AddFieldAsync(scope.Owner, scope.Fields)">+ Field</button>
          </div>
      </li>
    </text>;

  /// <summary>Where a fields editor draws: the owner's path and the fields it holds.</summary>
  private sealed record FieldsScope(string Owner, IReadOnlyList<WorkflowManifestReader.FieldView> Fields);

    private const string DraftKeyPrefix = "workflow-editor-draft:";
    private const string GraphKey = "graph";
    private const string InputsKey = "inputs";
    // #432: the package's own pane — its title and description (v9 § 4).
    private const string PackageKey = "package";
    private const string ResultsKey = "results";
    private const string NewKeyPrefix = "new:";
    private const string AddCollectionKey = "add-collection";
    private const string AddScalarKey = "add-scalar";
    private const string NodeKeyPrefix = "node:";
    private const string AddNodeKey = "add-node";
    private const string AddPromptKey = "add-prompt";

    // Membership changes (#115): pending until publish, mirrored to the draft.
    private sealed class AddedItem
    {
        public string Key { get; } = Guid.NewGuid().ToString("N")[..8];
        public string Collection { get; set; } = string.Empty;
        public string Id { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string Content { get; set; } = string.Empty;
    }

    private readonly List<AddedItem> addedItems = new();
    private readonly HashSet<string> removedFiles = new(StringComparer.Ordinal);

    // New collections (#154): pending folder ids; items arrive through the
    // same added-items flow, keyed by the folder id.
    private readonly List<string> addedCollections = new();

    // New single-value data entries (#309): id → pending text. A value is one
    // file, so unlike a collection it needs nowhere for items to arrive — the
    // text lives here until publish, the way a pending prompt's does.
    private readonly Dictionary<string, string> addedScalars = new(StringComparer.Ordinal);

    private string? newScalarId;
    private string? newScalarError;

    private string? newItemId;
    private string? newItemName;
    private string? newItemContent;
    private string? newItemError;
    private string? newCollectionId;
    private string? newCollectionError;

    private static readonly System.Text.RegularExpressions.Regex ItemIdPattern =
        new("^[a-z0-9][a-z0-9_-]*$", System.Text.RegularExpressions.RegexOptions.Compiled);

    // Stricter than item ids: the server's data-path rule allows no
    // underscore in the directory segment.
    private static readonly System.Text.RegularExpressions.Regex CollectionIdPattern =
        new("^[a-z0-9][a-z0-9-]*$", System.Text.RegularExpressions.RegexOptions.Compiled);

    /// <summary>
    /// One kind of unpublished change (#326). The editor used to name each of
    /// these by hand in nine places, and missing one compiled: a pending value
    /// once reached the uploaded files but never the data map, and #322 shipped
    /// because two lists disagreed about the same question.
    ///
    /// <c>AffectsManifest</c> is a predicate rather than a flag on purpose. The
    /// no-change guard ignores text edits and added items entirely, and reacts
    /// to removals only through the values among them — a flag would force
    /// recomposition of a manifest that should ride through untouched.
    /// </summary>
    private sealed record PendingKind(
        string Name,
        Func<int> Count,
        Action Clear,
        Func<string> Fragment,
        Func<bool> AffectsManifest);

    /// <summary>
    /// #347: the specVersion this publish should carry, when the author has
    /// asked to migrate. Null means "whatever the loaded manifest says", which
    /// is what every publish did before — the editor never wrote this field, so
    /// a fork inherited its spec version from whatever was pinned when it was
    /// forked, forever.
    /// </summary>
    private int? specVersionBump;

    // #432: the title and description as edited — null means unchanged, an
    // empty string means cleared. Never trimmed: "   " is a value the desk
    // refuses in the server's words, not a clearing.
    private string? titleEdit;
    private string? descriptionEdit;
    // #453: the tags as edited; null means unchanged. Never null once edited —
    // an empty list is the stated empty set, which v9 requires and accepts.
    private List<string>? tagsEdit;
    private string newTag = string.Empty;
    private string? newTagProblem;

    private string? LoadedTitle => content == null ? null : WorkflowManifestReader.ReadTitle(content.Manifest);
    private string? LoadedDescription => content == null ? null : WorkflowManifestReader.ReadDescription(content.Manifest);
    private IReadOnlyList<string> LoadedTags => content == null ? Array.Empty<string>() : WorkflowManifestReader.ReadTags(content.Manifest) ?? Array.Empty<string>();
    private string? EffectiveTitle => titleEdit ?? LoadedTitle;
    private string? EffectiveDescription => descriptionEdit ?? LoadedDescription;
    private IReadOnlyList<string> EffectiveTags => tagsEdit ?? LoadedTags;

    /// <summary>
    /// Mirrors WorkflowPackageValidator.AcceptedSpecVersions' maximum — the
    /// newest format the registry will PUBLISH. The client has no endpoint for
    /// it, and WorkflowPackagePicker already mirrors the floor the same way —
    /// both by hand, because Consultologist.Web references no project and so
    /// cannot see the engine's constant. internal so SpecVersionMirrorTests
    /// can prove the mirror still matches. Not necessarily runnable: see
    /// RunnableSpecVersion.
    /// </summary>
    internal const int NewestSpecVersion = 10;

    /// <summary>
    /// Mirrors WorkflowPackageStore.SupportedSpecVersions' maximum — the
    /// newest format the engine will RUN. Below NewestSpecVersion while a
    /// format is publishable but not yet executable (v10 § 10, #492), which
    /// the editor says up front rather than letting an author publish into
    /// silence: the not-yet-runnable notice, its publish-success sentence
    /// and the second Upgrade button (#429's pattern) are back with the gap
    /// and retire again when the engine runs ten.
    /// </summary>
    internal const int RunnableSpecVersion = 9;

    /// <summary>The version this publish will carry: the bump, or what is loaded.</summary>
    /// <summary>
    /// The version this publish WILL carry. Almost every affordance wants this
    /// one: the editor composes a manifest the server validates against the
    /// version being published, not the version that was loaded.
    /// </summary>
    private int EffectiveSpecVersion => specVersionBump ?? LoadedSpecVersion;

    /// <summary>
    /// The version that was loaded. Named rather than spelled `content?.SpecVersion`
    /// inline, because it read as the obvious choice at ten sites where it was
    /// the wrong one (#404), and because the two readings differ exactly when
    /// the Upgrade button has been pressed — which is the case #347 added.
    ///
    /// Correct only where the question is about what is already published.
    /// </summary>
    private int LoadedSpecVersion => content?.SpecVersion ?? 0;

    /// <summary>
    /// Whether the loaded package is the account's own fork. False means the
    /// editor is holding repo-owned content — legitimate, and how a fork is
    /// started or restarted, but it makes Publish mean something other than
    /// "save my work" (#411).
    /// </summary>
    // #447 considered asking the account's listed set instead of the prefix,
    // and found it dead: a foreign account package cannot be loaded here (the
    // server refuses it), so for any content this editor can hold, "has the
    // prefix" and "is mine" coincide — a mutant using the prefix alone passed
    // every test. The set (mine) decides only whether the account has any
    // package yet.
    private bool EditingOwnPackage => WorkflowPackageNames.IsAccountPackage(content?.Name);

    /// <summary>
    /// #447: an account with no package yet publishes its first without naming
    /// it — the derived name, as every publish did before. The same when the
    /// listing is unknown: the server holds the rules, and the legacy publish
    /// is the one it always accepted.
    /// </summary>
    private bool HasNoPackagesYet => mine is null or { Count: 0 } && !EditingOwnPackage;

    private IReadOnlyList<PublicPackageView>? mine;
    private bool newPackageOpen;
    private string newPackageSlug = string.Empty;

    /// <summary>
    /// The ref this editor is holding. Since #411 it is NOT the consult pin:
    /// choosing a package here changes what you are looking at and nothing
    /// else. Null means "whatever is pinned", which is the sensible landing.
    /// </summary>
    private string? editingRef;

    /// <summary>The pin, read once per load, so the two can be compared.</summary>
    private string? pinnedRef;

    /// <summary>
    /// Why the editor is not holding what was asked for. Deliberately not
    /// loadError, which renders INSTEAD of the editor — the whole point of the
    /// fallback is that there is something to show.
    /// </summary>
    private string? selectionNotice;

    /// <summary>
    /// The pinned package when it is not what is loaded, else null. Compared on
    /// the RESOLVED ref, so a `general@latest` pin sitting on the version the
    /// editor happens to hold reads as agreement rather than as a difference.
    /// </summary>
    private string? PinnedElsewhere =>
        pinnedRef != null && content != null && !string.Equals(pinnedRef, content.Ref, StringComparison.Ordinal)
            ? pinnedRef
            : null;

    private const string EditingRefKey = "workflow-editor-package";

    /// <summary>Mirrors WorkflowPackagePinResolver.PackagePinSettingKey.</summary>
    private const string WorkflowPackagePinSettingKey = "consult.workflowPackage";

    /// <summary>
    /// #347: stage the migration. It is a pending change like any other, so the
    /// existing publish guard opens on it — a version bump with nothing else
    /// changed is a legitimate publish, and the one that proves a migration.
    /// </summary>
    private async Task UpgradeSpecVersionTo(int target)
    {
        if (!CanUpgradeTo(target))
        {
            return;
        }

        specVersionBump = target;
        await PendingChangedAsync();
    }

    private bool CanUpgradeTo(int target) =>
        // Loaded on purpose, and one of only two sites that want it: the
        // question is whether the package as published has anywhere to go up
        // to. The pending side is the specVersionBump == null clause, which is
        // what hides the buttons once one has been pressed.
        content != null && specVersionBump == null && LoadedSpecVersion < target && target <= NewestSpecVersion;

    // #429: one button per rung while the ceilings differ (#492 reopened
    // the gap: 10 is publishable, 9 is the newest that runs).
    private bool OffersRunnableUpgrade => CanUpgradeTo(RunnableSpecVersion);

    private bool OffersNewestUpgrade => RunnableSpecVersion < NewestSpecVersion && CanUpgradeTo(NewestSpecVersion);

    /// <summary>A staged bump past the runnable ceiling, or a loaded package already past it.</summary>
    private bool NotYetRunnable => EffectiveSpecVersion > RunnableSpecVersion;

    private IReadOnlyList<PendingKind>? pendingKinds;

    // Lazy because an instance field initializer cannot capture `this`.
    private IReadOnlyList<PendingKind> PendingKinds => pendingKinds ??= BuildPendingKinds();

    // Order is PendingSummary's reading order; PendingCount is a sum and does
    // not care. A new kind of pending change belongs here and nowhere else —
    // TemplatesPendingStateTests fails if one is missing.
    private IReadOnlyList<PendingKind> BuildPendingKinds()
    {
        static string Plural(int n, string word) => $"{word}{(n == 1 ? "" : "s")}";

        return new List<PendingKind>
        {
            new("edits", () => edits.Count, edits.Clear,
                () => $"{edits.Count} edited", () => false),
            new("addedCollections", () => addedCollections.Count, addedCollections.Clear,
                () => $"+{addedCollections.Count} {Plural(addedCollections.Count, "folder")}", () => addedCollections.Count > 0),
            new("addedScalars", () => addedScalars.Count, addedScalars.Clear,
                () => $"+{addedScalars.Count} {Plural(addedScalars.Count, "value")}", () => addedScalars.Count > 0),
            new("addedItems", () => addedItems.Count, addedItems.Clear,
                () => $"+{addedItems.Count}", () => false),

            // Removing a file touches the manifest only when the file is a
            // single-value data entry, which also owns a data-map key (#321).
            new("removedFiles", () => removedFiles.Count, removedFiles.Clear,
                () => $"−{removedFiles.Count}", () => RemovedScalarIds.Any()),

            new("bindingEdits", () => bindingEdits.Count, bindingEdits.Clear,
                () => $"{bindingEdits.Count} rebound", () => bindingEdits.Count > 0),
            new("nodeEdits", () => nodeEdits.Count, nodeEdits.Clear,
                () => $"{nodeEdits.Count} {Plural(nodeEdits.Count, "node")}", () => nodeEdits.Count > 0),
            new("addedNodes", () => addedNodes.Count, addedNodes.Clear,
                () => $"+{addedNodes.Count} {Plural(addedNodes.Count, "node")}", () => addedNodes.Count > 0),
            new("removedNodeIds", () => removedNodeIds.Count, removedNodeIds.Clear,
                () => $"−{removedNodeIds.Count} {Plural(removedNodeIds.Count, "node")}", () => removedNodeIds.Count > 0),
            new("aggregateEdits", () => aggregateEdits.Count, aggregateEdits.Clear,
                () => $"{aggregateEdits.Count} aggregate", () => aggregateEdits.Count > 0),
            new("addedPrompts", () => addedPrompts.Count, addedPrompts.Clear,
                () => $"+{addedPrompts.Count} {Plural(addedPrompts.Count, "prompt")}", () => addedPrompts.Count > 0),

            new("resultEdit", () => resultEdit != null ? 1 : 0, () => resultEdit = null,
                () => "deliverable", () => resultEdit != null),
            new("inputsEdit", () => inputsEdit != null ? 1 : 0, () => inputsEdit = null,
                () => "inputs", () => inputsEdit != null),
            new("resultsEdit", () => resultsEdit != null ? 1 : 0, () => resultsEdit = null,
                () => "documents", () => resultsEdit != null),
            // #432: the package's title and description.
            new("titleEdit", () => titleEdit != null ? 1 : 0, () => titleEdit = null,
                () => "title", () => titleEdit != null),
            new("descriptionEdit", () => descriptionEdit != null ? 1 : 0, () => descriptionEdit = null,
                () => "description", () => descriptionEdit != null),
            // #453: the tags, as a set — one pending change however many moved.
            new("tagsEdit", () => tagsEdit != null ? 1 : 0, () => tagsEdit = null,
                () => "tags", () => tagsEdit != null),

            new("variableAdds", () => VariableAddCount, variableAdds.Clear,
                () => $"+{VariableAddCount} var", () => VariableAddCount > 0),
            new("variableRemovals", () => VariableRemovalCount, variableRemovals.Clear,
                () => $"−{VariableRemovalCount} var", () => VariableRemovalCount > 0),

            // #347: the one pending change that is legitimately publishable
            // alone. Registering it here is what makes that work — PendingCount
            // becomes 1, so the publish guard opens without being touched.
            new("specVersionBump", () => specVersionBump != null ? 1 : 0, () => specVersionBump = null,
                () => $"specVersion {specVersionBump}", () => specVersionBump != null),
        };
    }

    private int PendingCount => PendingKinds.Sum(kind => kind.Count());

    private string PendingSummary()
    {
        var parts = PendingKinds.Where(kind => kind.Count() > 0).Select(kind => kind.Fragment()).ToList();

        return parts.Count == 0 ? string.Empty : $" ({string.Join(" · ", parts)})";
    }

    private static string NewKeyFor(string collectionId) => NewKeyPrefix + collectionId;

    /// <summary>
    /// Whether a remembered pane is still one the nav offers. The session keeps
    /// the open pane across page switches (#207's shape), so this decides what
    /// survives the trip — and it has to answer for the *whole* key space, not
    /// just published files.
    ///
    /// It used to ask content.Files.ContainsKey, which kept two of the eleven
    /// pane kinds: a published file and a published node. Everything else — the
    /// declaration panes, the "+" forms, and anything pending — read as stale
    /// and fell back to Graph, which was most visible when the pane you were
    /// mid-way through creating vanished.
    ///
    /// Effective, not published, for the same reason ScalarIsUnused is (#321):
    /// a pending node's pane is real, and a pending removal's is not. Runs
    /// after RestoreDraftAsync, so pending state is loaded by the time it is
    /// asked.
    ///
    /// EveryNavPane_SurvivesLeavingAndReturning walks the rendered nav and
    /// holds this to it, so a new kind of pane fails there rather than silently
    /// dropping people on Graph.
    /// </summary>
    private bool PaneStillExists(string key) =>
        key is GraphKey or InputsKey or ResultsKey
            or AddCollectionKey or AddScalarKey or AddNodeKey or AddPromptKey
        || (key == PackageKey && EffectiveSpecVersion >= 9)
        || (key.StartsWith(NewKeyPrefix, StringComparison.Ordinal)
            && EffectiveCollections.Any(c => NewKeyFor(c.Id) == key))
        || (key.StartsWith(NodeKeyPrefix, StringComparison.Ordinal)
            && EffectiveNodes.Any(n => NodeKeyFor(n.Id) == key))
        || content!.Files.ContainsKey(key)
        || EffectiveScalars.Any(scalar => scalar.Path == key)
        || EffectivePrompts.Any(prompt => prompt.File == key)
        || addedItems.Any(added => added.Key == key);

    private string AddedPath(AddedItem item) => $"data/{item.Collection}/{item.Id}.md";

    private AddedItem? SelectedAdded() => addedItems.FirstOrDefault(a => a.Key == selectedKey);

    // One lookup for both, because a value's key is its path either way.
    private WorkflowManifestReader.ScalarView? SelectedScalar() =>
        EffectiveScalars.FirstOrDefault(scalar => scalar.Path == selectedKey);

    private bool CollectionHasPending(WorkflowManifestReader.CollectionView collection) =>
        collection.Items.Any(item => edits.ContainsKey(item.File) || removedFiles.Contains(item.File))
        || addedItems.Any(a => a.Collection == collection.Id)
        || addedCollections.Contains(collection.Id);

    // The loaded collections plus one synthetic view per pending folder, so
    // the sidebar and index composition treat both alike.
    private IEnumerable<WorkflowManifestReader.CollectionView> EffectiveCollections =>
        collections.Concat(addedCollections.Select(id => new WorkflowManifestReader.CollectionView(
            id, $"data/{id}/", Array.Empty<WorkflowManifestReader.DataItemView>())));

    private bool CollectionIsUnused(string collectionId) =>
        !nodes.Any(n => n.ForEach == $"data:{collectionId}");

    // Single-value data entries (#309). A value's key IS its path, derived the
    // same way whether pending or published, so selection needs no second
    // scheme — the standards pane already selects by file.
    private static string ScalarPath(string id) => $"data/{id}.txt";

    // The loaded values plus one synthetic view per pending value, so the
    // sidebar and the composition treat both alike.
    private IEnumerable<WorkflowManifestReader.ScalarView> EffectiveScalars =>
        scalarEntries.Concat(addedScalars.Keys.Select(id =>
            new WorkflowManifestReader.ScalarView(id, ScalarPath(id))));

    private bool ScalarHasPending(WorkflowManifestReader.ScalarView scalar) =>
        edits.ContainsKey(scalar.Path) || addedScalars.ContainsKey(scalar.Id);

    // The nodes holding a value. The single answer to "is this value bound?" —
    // the hint, the delete guard and the refusal message all read it, because
    // two predicates answering one question is what shipped #322.
    //
    // Effective, not published (#321): this gates deletion, so reading the
    // manifest alone is wrong in both directions — a pending rebind onto the
    // value would let it be deleted into a package the server then rejects,
    // and a pending node removal would refuse a value nothing will bind.
    // EffectiveNodes + RowsFor is the same idiom DeclaredSectionErrors and
    // CascadeInputRename use for input: refs.
    private IReadOnlyList<string> NodesBinding(string scalarId) =>
        EffectiveNodes.Where(n => RowsFor(n).Any(row => row.From == $"data:{scalarId}"))
            .Select(n => n.Id)
            .ToList();

    // A collection is unused when nothing forEaches it; a value when nothing
    // binds it. Different edge kinds, same question.
    private bool ScalarIsUnused(string scalarId) => NodesBinding(scalarId).Count == 0;

    // Published values marked for deletion. Derived from removedFiles rather
    // than tracked separately, so PendingCount, Discard, Load and the draft
    // carry it already (#326: nine hand-maintained lists, not ten).
    private IEnumerable<string> RemovedScalarIds =>
        scalarEntries.Where(s => removedFiles.Contains(s.Path)).Select(s => s.Id);

    private bool ScalarIsRemoved(WorkflowManifestReader.ScalarView scalar) =>
        removedFiles.Contains(scalar.Path);

    /// <summary>
    /// Every id the data map holds or is about to: folders and values,
    /// published and pending. One map cannot carry two entries under one key,
    /// so both new-entry forms ask this rather than each naming the four
    /// sources (#326) — two lists answering one question is #322's shape.
    ///
    /// A pending-removed value still counts, deliberately: it exists until the
    /// deletion publishes (#321).
    /// </summary>
    private IEnumerable<string> DataEntryIds =>
        EffectiveCollections.Select(c => c.Id).Concat(EffectiveScalars.Select(s => s.Id));

    private async Task AddScalarAsync()
    {
        var id = newScalarId?.Trim() ?? string.Empty;

        // ItemIdPattern, not CollectionIdPattern: the no-underscore rule
        // belongs to the directory segment, and a value is a file. note_type
        // is published and running, so forbidding '_' here would refuse an id
        // that already exists.
        if (!ItemIdPattern.IsMatch(id))
        {
            newScalarError = "The value id must be lowercase letters, digits, '_' or '-', starting with a letter or digit.";
            return;
        }

        if (DataEntryIds.Contains(id, StringComparer.Ordinal))
        {
            newScalarError = $"A data entry named '{id}' already exists.";
            return;
        }

        addedScalars[id] = string.Empty;
        newScalarId = null;
        newScalarError = null;
        selectedKey = ScalarPath(id);
        await PendingChangedAsync();
    }

    // A pending value un-adds; a published one is marked removed, which takes
    // its file away at publish and its data-map entry in ComposeManifest
    // (#321). Both halves or neither: a data entry naming a file that is gone
    // fails the resolver.
    private async Task RemoveScalarAsync(string scalarId)
    {
        // The button is already disabled while a node binds it; this is the
        // same check standing behind it, so no path deletes a bound value.
        if (!ScalarIsUnused(scalarId))
        {
            return;
        }

        var path = ScalarPath(scalarId);

        if (!addedScalars.Remove(scalarId))
        {
            removedFiles.Add(path);
        }

        edits.Remove(path);

        if (selectedKey == path)
        {
            selectedKey = collections.SelectMany(c => c.Items).FirstOrDefault(i => !removedFiles.Contains(i.File))?.File ?? GraphKey;
        }

        await PendingChangedAsync();
    }

    // Reversible until publish, the same deal a removed item file gets.
    private async Task RestoreScalarAsync(string scalarId)
    {
        removedFiles.Remove(ScalarPath(scalarId));
        await PendingChangedAsync();
    }

    private async Task AddCollectionAsync()
    {
        var id = newCollectionId?.Trim() ?? string.Empty;

        if (!CollectionIdPattern.IsMatch(id))
        {
            newCollectionError = "The folder id must be lowercase letters, digits or '-', starting with a letter or digit.";
            return;
        }

        if (DataEntryIds.Contains(id, StringComparer.Ordinal))
        {
            newCollectionError = $"A data entry named '{id}' already exists.";
            return;
        }

        addedCollections.Add(id);
        newCollectionId = null;
        newCollectionError = null;
        // Land on the folder's "+ Add item" pane — the first item is the next step.
        selectedKey = NewKeyFor(id);
        await PendingChangedAsync();
    }

    private async Task RemoveCollectionAsync(string collectionId)
    {
        var itsItemKeys = addedItems.Where(a => a.Collection == collectionId).Select(a => a.Key).ToHashSet(StringComparer.Ordinal);
        addedCollections.Remove(collectionId);
        addedItems.RemoveAll(a => a.Collection == collectionId);

        if (selectedKey == NewKeyFor(collectionId) || (selectedKey != null && itsItemKeys.Contains(selectedKey)))
        {
            selectedKey = collections.SelectMany(c => c.Items).FirstOrDefault(i => !removedFiles.Contains(i.File))?.File ?? GraphKey;
        }

        await PendingChangedAsync();
    }

    private string CollectionCount(WorkflowManifestReader.CollectionView collection)
    {
        var added = addedItems.Count(a => a.Collection == collection.Id);
        var removed = collection.Items.Count(item => removedFiles.Contains(item.File));
        var text = collection.Items.Count.ToString();
        if (added > 0) text += $" + {added}";
        if (removed > 0) text += $" − {removed}";
        return text;
    }

    private async Task AddItemAsync(string collectionId)
    {
        var id = newItemId?.Trim() ?? string.Empty;
        var name = newItemName?.Trim() ?? string.Empty;

        if (!ItemIdPattern.IsMatch(id))
        {
            newItemError = "The id must be lowercase letters, digits, '-' or '_', starting with a letter or digit.";
            return;
        }

        var collection = collections.FirstOrDefault(c => c.Id == collectionId);
        var existingIds = (collection?.Items.Select(i => i.Id) ?? Enumerable.Empty<string>())
            .Concat(addedItems.Where(a => a.Collection == collectionId).Select(a => a.Id));

        if (existingIds.Contains(id, StringComparer.Ordinal))
        {
            newItemError = $"An item with id '{id}' already exists in {collectionId}.";
            return;
        }

        if (string.IsNullOrWhiteSpace(name))
        {
            newItemError = "A display name is required.";
            return;
        }

        var added = new AddedItem { Collection = collectionId, Id = id, Name = name, Content = newItemContent ?? string.Empty };
        addedItems.Add(added);
        newItemId = newItemName = newItemContent = null;
        newItemError = null;
        selectedKey = added.Key;
        await PendingChangedAsync();
    }

    private async Task RemoveItemAsync(string file)
    {
        removedFiles.Add(file);
        edits.Remove(file);

        if (selectedKey == file)
        {
            selectedKey = collections.SelectMany(c => c.Items).FirstOrDefault(i => !removedFiles.Contains(i.File))?.File
                ?? prompts.FirstOrDefault()?.File
                ?? GraphKey;
        }

        await PendingChangedAsync();
    }

    private async Task RestoreItem(string file)
    {
        removedFiles.Remove(file);
        await PendingChangedAsync();
    }

    private async Task RemoveAddedAsync(AddedItem item)
    {
        addedItems.Remove(item);

        if (selectedKey == item.Key)
        {
            selectedKey = collections.SelectMany(c => c.Items).FirstOrDefault(i => !removedFiles.Contains(i.File))?.File ?? GraphKey;
        }

        await PendingChangedAsync();
    }

    private WorkflowPackageContentResponse? content;
    private IReadOnlyList<WorkflowManifestReader.PromptView> prompts = Array.Empty<WorkflowManifestReader.PromptView>();
    private IReadOnlyList<WorkflowManifestReader.NodeView> nodes = Array.Empty<WorkflowManifestReader.NodeView>();
    private IReadOnlyList<WorkflowManifestReader.CollectionView> collections = Array.Empty<WorkflowManifestReader.CollectionView>();

    // Path -> edited text, only where it differs from the loaded package;
    // mirrored to localStorage so drafts survive refresh on this browser.
    private readonly Dictionary<string, string> edits = new(StringComparer.Ordinal);

    // Pending rebinds (#138), keyed nodeId + '\n' + variable. An edit equal to
    // the loaded manifest's value removes itself.
    private readonly Dictionary<string, (string From, string? As)> bindingEdits = new(StringComparer.Ordinal);
    // Published only. Named for it because the difference matters: the draft
    // restore asks "is this id in the loaded package?" and must not see
    // pending ones, while everything an author picks from must (#309).
    private IReadOnlyList<string> publishedScalarIds = Array.Empty<string>();

    // The same entries with their paths (#308). The id list above is what the
    // binding picker needs; editing a value needs the file it points at.
    private IReadOnlyList<WorkflowManifestReader.ScalarView> scalarEntries =
        Array.Empty<WorkflowManifestReader.ScalarView>();

    // Pending node-field edits (#117), keyed by node id. Each entry is the
    // node's complete effective tuple; one equal to the manifest removes
    // itself, like binding rows.
    private readonly Dictionary<string, WorkflowNodeSummary.NodeChange> nodeEdits = new(StringComparer.Ordinal);
    private IReadOnlyList<string> schemaIds = Array.Empty<string>();

    // Pending new nodes (#117): a prompt node carries its 1:1 prompt's text —
    // a prompt is only publishable referenced by exactly one node, so node and
    // prompt are born and die together. An aggregator (Aggregate non-null) has
    // no prompt at all.
    private sealed class AddedNode
    {
        public string Id { get; set; } = string.Empty;
        public string Label { get; set; } = string.Empty;
        public string? ForEach { get; set; }
        public string? OutputSchema { get; set; }
        public string? FailIfEmpty { get; set; }
        public string PromptText { get; set; } = string.Empty;
        public List<string>? Aggregate { get; set; }

        // A node born onto an existing prompt (#170) instead of minting its
        // own; null = fresh prompt named after the node.
        public string? PromptRef { get; set; }
    }

    // Standalone pending prompts (#170): publishable only once some node
    // points at them (the orphan rule).
    private sealed class AddedPrompt
    {
        public string Id { get; set; } = string.Empty;
        public string Text { get; set; } = string.Empty;
    }

    private readonly List<AddedPrompt> addedPrompts = new();
    private string? newPromptId;
    private string? newPromptError;

    private static string AddedStandalonePromptFile(string promptId) => $"prompts/{promptId}.md";

    private AddedPrompt? AddedPromptForFile(string path) =>
        addedPrompts.FirstOrDefault(p => AddedStandalonePromptFile(p.Id) == path);

    // Pending aggregator source lists (#117), keyed by node id — the full
    // ordered list; one equal to the manifest removes itself.
    private readonly Dictionary<string, List<string>> aggregateEdits = new(StringComparer.Ordinal);

    // Pending deliverable selection ("node:x"); null when unchanged.
    private string? resultEdit;

    private readonly List<AddedNode> addedNodes = new();
    private readonly HashSet<string> removedNodeIds = new(StringComparer.Ordinal);
    private string? newNodeId;
    private string? newNodeLabel;
    private string newNodeForEach = string.Empty;
    private string newNodeOutput = string.Empty;
    private string newNodeKind = "prompt";
    private string newNodePrompt = string.Empty;
    private string? newNodeError;

    private static string AddedPromptFile(string nodeId) => $"prompts/{nodeId}.md";

    private AddedNode? AddedNodeForPromptFile(string path) =>
        addedNodes.FirstOrDefault(a => AddedPromptFile(a.Id) == path);

    private WorkflowManifestReader.NodeView AddedNodeView(AddedNode added) => new(
        added.Id,
        added.Label,
        added.Aggregate != null ? null : added.PromptRef ?? added.Id,
        added.ForEach,
        Array.Empty<WorkflowManifestReader.BindingView>(),
        IsResult: DeliverableRootIds.Contains(added.Id),
        HasOutput: added.OutputSchema != null,
        Aggregate: added.Aggregate,
        OutputSchema: added.OutputSchema,
        FailIfEmpty: added.FailIfEmpty);

    // Pending v7 declarations, each the whole list when dirty (the
    // aggregate-source idiom) and null when unchanged.
    private List<WorkflowManifestReader.InputView>? inputsEdit;
    private List<WorkflowManifestReader.ResultView>? resultsEdit;
    private string newInputId = string.Empty;
    private string newResultId = string.Empty;
    private string? declaredError;

    // Declared ids are snake_case, letter-first — the server's
    // WorkflowDeclaredIds grammar, mirrored so the editor can refuse early.
    private static readonly System.Text.RegularExpressions.Regex DeclaredIdPattern =
        new("^[a-z][a-z0-9_]*$", System.Text.RegularExpressions.RegexOptions.Compiled);

    // What binding source lists offer. Empty for v5/v6, where the editor falls
    // back to the frozen consult_draft slot.
    private IReadOnlyList<string> DeclaredInputIds =>
        EffectiveInputs.Select(input => input.Id).ToList();

    // v9 (#429): what a node may fan — the declared arrays, from 9. Empty
    // below, so a v8 publish cannot be composed with an input fan.
    private IReadOnlyList<string> ArrayInputIds =>
        EffectiveSpecVersion >= 9
            ? EffectiveInputs.Where(input => WorkflowInputTypes.Of(input) == WorkflowInputTypes.Array).Select(input => input.Id).ToList()
            : Array.Empty<string>();

    private IReadOnlyList<WorkflowManifestReader.InputView> EffectiveInputs =>
        inputsEdit ?? (content != null && IsV7
            ? WorkflowManifestReader.ReadInputs(content.Manifest)
            : Array.Empty<WorkflowManifestReader.InputView>());

    private List<WorkflowManifestReader.InputView> MutableInputs() =>
        inputsEdit ??= EffectiveInputs.ToList();

    private List<WorkflowManifestReader.ResultView> MutableResults() =>
        resultsEdit ??= EffectiveResults.ToList();

    private async Task CommitDeclarationAsync()
    {
        declaredError = null;
        await PendingChangedAsync();
    }

    // The author-facing half of the server's v7 rules, checked before publish
    // so a rejected package is caught at the desk rather than after minting a
    // version. The server remains the authority; these messages mirror its
    // wording so the two read as one voice.
    private IReadOnlyList<string> DeclaredSectionErrors()
    {
        var errors = new List<string>();

        if (!IsV7)
        {
            return errors;
        }

        var inputs = EffectiveInputs;

        if (inputs.Count == 0)
        {
            errors.Add("inputs is required in specVersion 7.");
        }

        // #347: the editor offers the v8 controls whatever the package is, so a
        // v7 fork can compose a manifest the registry refuses. It knew that when
        // the field was typed; saying so here beats a rejection after the fact,
        // and names the way out rather than only the problem.
        if (EffectiveSpecVersion < 8)
        {
            var typed = inputs
                .Where(input => !WorkflowInputTypes.RequiresV9(input)
                    && (input.Type != null || input.Values is { Count: > 0 }))
                .Select(input => $"'{input.Id}'")
                .ToList();

            if (typed.Count > 0)
            {
                errors.Add(
                    $"Input {string.Join(", ", typed)} declares a type or values, which requires specVersion 8. "
                    + $"Use \"Upgrade to specVersion {RunnableSpecVersion}\" and publish.");
            }

            var conditional = EffectiveResults
                .Where(result => !string.IsNullOrWhiteSpace(result.When)
                    && !WorkflowResultConditionText.IsV9Form(result.When))
                .Select(result => $"'{result.Id}'")
                .ToList();

            if (conditional.Count > 0)
            {
                errors.Add(
                    $"Document {string.Join(", ", conditional)} declares when, which requires specVersion 8. "
                    + $"Use \"Upgrade to specVersion {RunnableSpecVersion}\" and publish.");
            }
        }

        // #429: the v9 shapes, named the same way. The editor offers them only
        // at 9, but a draft, a fork or a typed value can still carry one.
        if (EffectiveSpecVersion < 9)
        {
            // A v9 form wants the rung that runs, not the newest publishable one.
            var upgrade = $"Use \"Upgrade to specVersion {RunnableSpecVersion}\" and publish.";

            errors.AddRange(inputs
                .Where(WorkflowInputTypes.RequiresV9)
                .Select(input => $"Input '{input.Id}' declares a type that requires specVersion 9. {upgrade}"));

            errors.AddRange(EffectiveResults
                .Where(result => WorkflowResultConditionText.IsV9Form(result.When) && !WorkflowResultConditionText.IsV10Form(result.When))
                .Select(result => $"Document '{result.Id}' declares a condition form that requires specVersion 9. {upgrade}"));

            errors.AddRange(EffectiveNodes
                .Where(node => WorkflowInputFans.IsInputFan(node.ForEach))
                .Select(node => $"Node '{node.Id}' fans an input, which requires specVersion 9. {upgrade}"));
        }
        else
        {
            if (EffectiveSpecVersion < 10)
            {
                // v10 (#498): structure below one level wants the newest rung.
                errors.AddRange(inputs
                    .Where(WorkflowInputTypes.RequiresV10)
                    .Select(input => $"Input '{input.Id}' declares structure deeper than one level, which requires specVersion 10. "
                        + $"Use \"Upgrade to specVersion {NewestSpecVersion}\" and publish."));
            }

            // The shapes a v9 declaration must finish before it can publish
            // (explicit initialisation: an array starts with no entry type, an
            // object with no fields). The server refuses these too; said here
            // first, beside the control.
            errors.AddRange(inputs
                .Where(input => WorkflowInputTypes.Of(input) == WorkflowInputTypes.Array && input.Items is null)
                .Select(input => $"Input '{input.Id}' is an array and must declare what its entries are."));

            errors.AddRange(inputs
                .Where(input => WorkflowInputTypes.DeclaresObject(input) && input.Fields is not { Count: > 0 })
                .Select(input => $"Input '{input.Id}' is an object and must declare at least one field."));

            errors.AddRange(inputs
                .Where(input => input.Items?.Type == WorkflowInputTypes.Array && input.Items.Items is null)
                .Select(input => $"Input '{input.Id}' is an array of arrays and must declare what the inner entries are."));

            errors.AddRange(FieldTreeErrors(inputs));
        }

        foreach (var duplicate in inputs.GroupBy(input => input.Id).Where(group => group.Count() > 1))
        {
            errors.Add($"Duplicate input id '{duplicate.Key}'.");
        }

        errors.AddRange(inputs
            .Where(input => string.IsNullOrWhiteSpace(input.Label))
            .Select(input => $"Input '{input.Id}' has no label."));

        // A binding left pointing at a slot that no longer exists is the
        // failure mode renaming was built to avoid; catch the manual case too.
        var declared = inputs.Select(input => input.Id).ToHashSet(StringComparer.Ordinal);

        foreach (var node in EffectiveNodes)
        {
            foreach (var row in RowsFor(node).Where(row => row.From.StartsWith("input:", StringComparison.Ordinal)))
            {
                var id = row.From["input:".Length..];

                if (!declared.Contains(id))
                {
                    errors.Add($"Node '{node.Id}' binds '{row.Variable}' to undeclared input '{id}'.");
                }
            }
        }

        // #350: an enum below two values is reachable several ways — retyping
        // to enum starts at none, and removing gets there one click at a time.
        // Checked here rather than refused at the click because the in-progress
        // state is legitimate; what is not legitimate is publishing it.
        errors.AddRange(inputs
            .Where(input => WorkflowInputTypes.DeclaresValues(input)
                && (input.Values?.Count ?? 0) < 2)
            .Select(input => $"Input '{input.Id}' declares {input.Values?.Count ?? 0} enum "
                + $"value{((input.Values?.Count ?? 0) == 1 ? string.Empty : "s")}; an enum needs at least two."));

        var results = EffectiveResults;

        // The condition's twin of the binding check above: whatever path left
        // it inconsistent, it is caught at the desk rather than after minting
        // a version.
        foreach (var conditioned in results.Where(result => !string.IsNullOrWhiteSpace(result.When)))
        {
            // v10 (#494): an expression is the server's to judge — the desk
            // names the version it needs below 10 and otherwise steps aside.
            if (WorkflowResultConditionText.IsV10Form(conditioned.When))
            {
                if (EffectiveSpecVersion < 10)
                {
                    errors.Add($"Document '{conditioned.Id}' declares a condition expression that requires specVersion 10. Use \"Upgrade to specVersion {NewestSpecVersion}\" and publish.");
                }

                continue;
            }

            var testedId = WorkflowResultConditionText.InputOf(conditioned.When);
            var tested = inputs.FirstOrDefault(input => input.Id == testedId);

            if (tested == null)
            {
                errors.Add($"Result '{conditioned.Id}' condition reads undeclared input '{testedId}'.");
                continue;
            }

            var literal = WorkflowResultConditionText.LiteralOf(conditioned.When);

            if (EffectiveSpecVersion < 9)
            {
                if (WorkflowInputTypes.Of(tested) == WorkflowInputTypes.Enum
                    && literal != null
                    && tested.Values?.Contains(literal, StringComparer.Ordinal) != true)
                {
                    errors.Add(
                        $"Result '{conditioned.Id}' condition compares '{tested.Id}' to '{literal}', which it does not declare.");
                }

                continue;
            }

            if (V9ConditionComplaint(conditioned, tested) is { } complaint)
            {
                errors.Add(complaint);
            }
        }

        foreach (var duplicate in results.GroupBy(result => result.Id).Where(group => group.Count() > 1))
        {
            errors.Add($"Duplicate result id '{duplicate.Key}'.");
        }

        errors.AddRange(results
            .Where(result => string.IsNullOrWhiteSpace(result.Label))
            .Select(result => $"Result '{result.Id}' has no label."));

        foreach (var shared in results.GroupBy(result => result.Node).Where(group => group.Count() > 1))
        {
            var owners = shared.Select(result => $"'{result.Id}'").ToList();
            errors.Add($"Results {string.Join(" and ", owners)} share node '{shared.Key}': each deliverable needs its own aggregator.");
        }

        var aggregatorIds = EffectiveNodes
            .Where(node => node.Aggregate != null)
            .Select(node => $"node:{node.Id}")
            .ToHashSet(StringComparer.Ordinal);

        errors.AddRange(results
            .Where(result => !aggregatorIds.Contains(result.Node))
            .Select(result => $"Result '{result.Id}' must reference an aggregator node ('{result.Node}' is not one)."));

        return errors;
    }

    /// <summary>
    /// The desk's mirror of the server's v9 condition closure (#427): the
    /// operand is resolved to a type — the input's, one field's, or a count —
    /// and the operator and literal are held to it, in the server's words.
    /// Null when the condition is sound.
    /// </summary>
    private static string? V9ConditionComplaint(
        WorkflowManifestReader.ResultView result,
        WorkflowManifestReader.InputView tested)
    {
        var prefix = $"Result '{result.Id}' condition";
        var when = result.When;
        var operand = WorkflowResultConditionText.OperandOf(when) ?? tested.Id;
        var op = WorkflowResultConditionText.OperatorOf(when);
        var literal = WorkflowResultConditionText.LiteralOf(when);
        var inputType = WorkflowInputTypes.Of(tested);
        string type;
        IReadOnlyList<string>? values;

        if (WorkflowResultConditionText.IsCount(when))
        {
            if (inputType != WorkflowInputTypes.Array)
            {
                return $"{prefix} counts '{tested.Id}', which is a {inputType}; only an array has a count.";
            }

            type = CountType;
            values = null;
        }
        else if (WorkflowResultConditionText.FieldOf(when) is { } fieldId)
        {
            if (inputType != WorkflowInputTypes.Object)
            {
                return $"{prefix} reads field '{fieldId}' of '{tested.Id}', which is a {inputType}, not an object.";
            }

            var field = tested.Fields?.FirstOrDefault(f => f.Id == fieldId);

            if (field is null)
            {
                return $"{prefix} reads field '{fieldId}' of '{tested.Id}', which it does not declare.";
            }

            type = WorkflowInputTypes.Of(field);
            values = field.Values;
        }
        else
        {
            type = inputType;
            values = tested.Values;
        }

        if (op is null)
        {
            return type switch
            {
                WorkflowInputTypes.Boolean or WorkflowInputTypes.Array => null,
                CountType => $"{prefix} '{operand}' needs a comparison; write count({tested.Id}) > 0.",
                WorkflowInputTypes.Enum => $"{prefix} '{operand}' tests an enum for truth; compare it to one of its values instead.",
                _ => $"{prefix} '{operand}' tests a {type} for truth; only a boolean or an array can be tested bare."
            };
        }

        if (string.IsNullOrEmpty(literal))
        {
            return $"{prefix} compares against nothing; write a value after the operator.";
        }

        if (type == WorkflowInputTypes.Text)
        {
            return $"{prefix} reads '{operand}', which is a text: a text input cannot be tested.";
        }

        if (type is WorkflowInputTypes.Object or WorkflowInputTypes.Array)
        {
            return $"{prefix} compares '{operand}', which is an {type}; compare one of its fields, or its count, instead.";
        }

        if (WorkflowResultConditionText.IsOrdered(when) && type is not (WorkflowInputTypes.Number or WorkflowInputTypes.Date or CountType))
        {
            return $"{prefix} compares '{operand}' with {op}, which is a {type}; ordering operators apply to a number or a date.";
        }

        return type switch
        {
            WorkflowInputTypes.Boolean when literal is not ("true" or "false") =>
                $"{prefix} compares boolean '{operand}' to '{literal}'; use true or false.",
            WorkflowInputTypes.Enum when values?.Contains(literal, StringComparer.Ordinal) != true =>
                $"{prefix} compares '{operand}' to '{literal}', which it does not declare.",
            WorkflowInputTypes.Number when !Consultologist.Web.Services.AI.ConsultInputValue.TryParseNumber(literal, out _) =>
                $"{prefix} compares '{operand}' to '{literal}', which is not a plain decimal.",
            WorkflowInputTypes.Date when !DateOnly.TryParseExact(literal, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out _) =>
                $"{prefix} compares '{operand}' to '{literal}', which is not a date written YYYY-MM-DD.",
            CountType when !int.TryParse(literal, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out _) =>
                $"{prefix} compares '{operand}' to '{literal}', which is not a whole number.",
            _ => null
        };
    }

    /// <summary>The pseudo-type of count(x): a whole number, ordered.</summary>
    private const string CountType = "count";

    // ----- #432: the package's title and description --------------------------

    private static void WriteMetadata(System.Text.Json.Nodes.JsonNode root, string camelKey, string? edit)
    {
        if (edit is null)
        {
            return;
        }

        var pascalKey = char.ToUpperInvariant(camelKey[0]) + camelKey[1..];

        // A clearing removes the key in whichever casing it was read.
        if (edit.Length == 0)
        {
            root.AsObject().Remove(camelKey);
            root.AsObject().Remove(pascalKey);
            return;
        }

        root[root[pascalKey] is not null ? pascalKey : camelKey] = edit;
    }

    private async Task OnTitleChangedAsync(string? value)
    {
        var title = value ?? string.Empty;
        titleEdit = string.Equals(title, LoadedTitle ?? string.Empty, StringComparison.Ordinal) ? null : title;
        await PendingChangedAsync();
    }

    private async Task OnDescriptionChangedAsync(string? value)
    {
        var description = value ?? string.Empty;
        descriptionEdit = string.Equals(description, LoadedDescription ?? string.Empty, StringComparison.Ordinal) ? null : description;
        await PendingChangedAsync();
    }

    // ----- #453: tags ---------------------------------------------------------

    /// <summary>
    /// The pane's own check on a tag about to be added, in the server's words
    /// where it has them. Trimmed first: the input box is where whitespace
    /// arrives, and trimming here is what keeps "trimmed" a rule the desk
    /// never has to report. Returns null when the tag may be added.
    /// </summary>
    private string? ProblemWith(string candidate)
    {
        if (string.IsNullOrWhiteSpace(candidate))
        {
            return "A tag must not be empty.";
        }

        if (candidate.Contains('\n') || candidate.Contains('\r'))
        {
            return "A tag must be a single line.";
        }

        if (candidate.Length > WorkflowPackageMetadata.MaxTagLength)
        {
            return $"A tag must be at most {WorkflowPackageMetadata.MaxTagLength} characters.";
        }

        if (EffectiveTags.Count >= WorkflowPackageMetadata.MaxTags)
        {
            return $"At most {WorkflowPackageMetadata.MaxTags} tags.";
        }

        if (EffectiveTags.Any(existing => string.Equals(existing, candidate, StringComparison.OrdinalIgnoreCase)))
        {
            return "That tag is already declared (tags are distinct ignoring case).";
        }

        return null;
    }

    private async Task AddTagAsync()
    {
        var candidate = newTag.Trim();
        newTagProblem = ProblemWith(candidate);

        if (newTagProblem != null)
        {
            return;
        }

        var tags = EffectiveTags.ToList();
        tags.Add(candidate);
        newTag = string.Empty;
        await SetTagsAsync(tags);
    }

    private async Task OnNewTagKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await AddTagAsync();
        }
    }

    private async Task RemoveTagAsync(int index)
    {
        var tags = EffectiveTags.ToList();
        tags.RemoveAt(index);
        newTagProblem = null;
        await SetTagsAsync(tags);
    }

    private async Task MoveTagAsync(int index, int by)
    {
        var target = index + by;
        if (target < 0 || target >= EffectiveTags.Count)
        {
            return;
        }

        var tags = EffectiveTags.ToList();
        (tags[index], tags[target]) = (tags[target], tags[index]);
        await SetTagsAsync(tags);
    }

    /// <summary>Back to the loaded set is no pending change, as with the title.</summary>
    private async Task SetTagsAsync(List<string> tags)
    {
        tagsEdit = tags.SequenceEqual(LoadedTags, StringComparer.Ordinal) ? null : tags;
        await PendingChangedAsync();
    }

    /// <summary>
    /// The desk's mirror of the server's metadata closure (v9 § 4): below 9 a
    /// title is named as needing the version, the way a typed input is; at 9
    /// the five sentences are the server's. An empty string is a clearing and
    /// never an error; a whitespace-only one is a value, and is refused.
    /// </summary>
    private IReadOnlyList<string> PackageMetadataErrors()
    {
        var errors = new List<string>();
        var title = EffectiveTitle;
        var description = EffectiveDescription;

        if (EffectiveSpecVersion < 9)
        {
            // A v9 form wants the rung that runs, not the newest publishable one.
            var upgrade = $"Use \"Upgrade to specVersion {RunnableSpecVersion}\" and publish.";

            if (!string.IsNullOrEmpty(title))
            {
                errors.Add($"The package declares a title, which requires specVersion 9. {upgrade}");
            }

            if (!string.IsNullOrEmpty(description))
            {
                errors.Add($"The package declares a description, which requires specVersion 9. {upgrade}");
            }

            // #453: only an EDIT is named — a v8 package has no tags to
            // declare, and a v9 draft restored onto one is the #429 posture.
            if (tagsEdit is { Count: > 0 })
            {
                errors.Add($"The package declares tags, which requires specVersion 9. {upgrade}");
            }

            return errors;
        }

        if (!string.IsNullOrEmpty(title))
        {
            if (string.IsNullOrWhiteSpace(title))
            {
                errors.Add("title must not be empty.");
            }
            else
            {
                if (title.Contains('\n') || title.Contains('\r'))
                {
                    errors.Add("title must be a single line.");
                }

                if (title.Length > WorkflowPackageMetadata.MaxTitleLength)
                {
                    errors.Add($"title must be at most {WorkflowPackageMetadata.MaxTitleLength} characters.");
                }
            }
        }

        if (!string.IsNullOrEmpty(description))
        {
            if (string.IsNullOrWhiteSpace(description))
            {
                errors.Add("description must not be empty.");
            }
            else if (description.Length > WorkflowPackageMetadata.MaxDescriptionLength)
            {
                errors.Add($"description must be at most {WorkflowPackageMetadata.MaxDescriptionLength} characters.");
            }
        }

        // #453: the server's sentences, by position. The pane refuses each of
        // these at the Add button, so this catches a restored draft, not a
        // keystroke.
        var tags = EffectiveTags;
        if (tags.Count > WorkflowPackageMetadata.MaxTags)
        {
            errors.Add($"tags must declare at most {WorkflowPackageMetadata.MaxTags} tags.");
        }

        for (var i = 0; i < tags.Count; i++)
        {
            if (string.IsNullOrWhiteSpace(tags[i]))
            {
                errors.Add($"tags[{i}] must not be empty.");
                continue;
            }

            if (tags[i].Contains('\n') || tags[i].Contains('\r'))
            {
                errors.Add($"tags[{i}] must be a single line.");
            }

            if (!string.Equals(tags[i], tags[i].Trim(), StringComparison.Ordinal))
            {
                errors.Add($"tags[{i}] must not begin or end with whitespace.");
            }

            if (tags[i].Length > WorkflowPackageMetadata.MaxTagLength)
            {
                errors.Add($"tags[{i}] must be at most {WorkflowPackageMetadata.MaxTagLength} characters.");
            }

            for (var j = 0; j < i; j++)
            {
                if (!string.IsNullOrWhiteSpace(tags[j]) && string.Equals(tags[j].Trim(), tags[i].Trim(), StringComparison.OrdinalIgnoreCase))
                {
                    errors.Add($"tags[{i}] repeats tags[{j}]; tags are distinct ignoring case.");
                    break;
                }
            }
        }

        return errors;
    }

    private async Task AddInputAsync()
    {
        var id = newInputId.Trim();

        if (!DeclaredIdPattern.IsMatch(id))
        {
            declaredError = $"Input id '{id}' must be snake_case (a lowercase letter, then lowercase letters, digits, or underscores).";
            return;
        }

        if (EffectiveInputs.Any(input => input.Id == id))
        {
            declaredError = $"Duplicate input id '{id}'.";
            return;
        }

        MutableInputs().Add(new WorkflowManifestReader.InputView(id, id, true));
        newInputId = string.Empty;
        await CommitDeclarationAsync();
    }

    /// <summary>
    /// The deliverables whose condition reads this input. Returned rather than
    /// a bool so a refusal can name them — the same shape NodesBinding uses for
    /// a bound data value (#321).
    /// </summary>
    private IReadOnlyList<string> ResultsConditionedOn(string inputId) =>
        EffectiveResults
            .Where(result => !string.IsNullOrWhiteSpace(result.When)
                && WorkflowResultConditionText.ReadsInput(result.When!, inputId))
            .Select(result => result.Label)
            .ToList();

    /// <summary>
    /// A condition's operand is typed by the declaration it reads — bare, by
    /// path, or by count (#314, #427) — so retyping an input a condition reads,
    /// or removing it, would compose a package the validator rejects. Refused
    /// here rather than at publish, naming the document that depends on it.
    /// </summary>
    private string? ConditionLock(WorkflowManifestReader.InputView input)
    {
        var dependents = ResultsConditionedOn(input.Id);

        return dependents.Count == 0
            ? null
            : $"Input '{input.Id}' is tested by {string.Join(", ", dependents.Select(d => $"'{d}'"))}; change that document's condition first.";
    }

    private async Task RemoveInputAsync(WorkflowManifestReader.InputView input)
    {
        if (ConditionLock(input) is { } locked)
        {
            declaredError = locked;
            return;
        }

        var inputs = MutableInputs();
        inputs.RemoveAll(existing => existing.Id == input.Id);
        await CommitDeclarationAsync();
    }

    // Renaming a slot re-points every binding that read it: leaving them on the
    // old id would publish a package the validator rejects as an undeclared
    // input, and the author would have to find each one by hand.
    private async Task RenameInputAsync(WorkflowManifestReader.InputView input, string? value)
    {
        var id = (value ?? string.Empty).Trim();

        if (id == input.Id)
        {
            return;
        }

        if (!DeclaredIdPattern.IsMatch(id))
        {
            declaredError = $"Input id '{id}' must be snake_case (a lowercase letter, then lowercase letters, digits, or underscores).";
            return;
        }

        if (EffectiveInputs.Any(existing => existing.Id == id))
        {
            declaredError = $"Duplicate input id '{id}'.";
            return;
        }

        var inputs = MutableInputs();
        var index = inputs.FindIndex(existing => existing.Id == input.Id);

        if (index < 0)
        {
            return;
        }

        inputs[index] = inputs[index] with { Id = id };
        CascadeInputRename(input.Id, id);
        await CommitDeclarationAsync();
    }

    private void CascadeInputRename(string oldId, string newId)
    {
        foreach (var node in EffectiveNodes)
        {
            foreach (var row in RowsFor(node))
            {
                if (row.From == $"input:{oldId}")
                {
                    bindingEdits[$"{node.Id}\n{row.Variable}"] = ($"input:{newId}", row.As);
                }
            }
        }

        // #350: a condition names its input the same way a binding does, so a
        // rename has to reach both. Only touched when a condition actually
        // reads the old id — MutableResults() would otherwise mark the
        // documents pending for a rename that has nothing to do with them.
        if (!EffectiveResults.Any(result => WorkflowResultConditionText.ReadsInput(result.When, oldId)))
        {
            return;
        }

        var results = MutableResults();

        for (var index = 0; index < results.Count; index++)
        {
            if (!WorkflowResultConditionText.ReadsInput(results[index].When, oldId))
            {
                continue;
            }

            // #427: carried as written, so a v9 form the editor cannot yet
            // compose (a field, a count, an ordering) survives the rename.
            results[index] = results[index] with
            {
                When = WorkflowResultConditionText.Rename(results[index].When!, newId)
            };
        }
    }

    /// <summary>
    /// Retyping a slot. Leaving enum/boolean while a condition reads it is
    /// refused for the same reason removal is: only those two can be tested.
    /// </summary>
    private async Task RetypeInputAsync(WorkflowManifestReader.InputView input, string? value)
    {
        var type = string.IsNullOrWhiteSpace(value) ? WorkflowInputTypes.Text : value!.Trim();

        if (type == WorkflowInputTypes.Of(input))
        {
            return;
        }

        // #429: a condition's operand is typed by the declaration — a path, a
        // count, an ordering each want a particular type — so any retype under
        // a condition is refused, naming the document.
        if (ConditionLock(input) is { } locked)
        {
            declaredError = locked;
            return;
        }

        var inputs = MutableInputs();
        var index = inputs.FindIndex(existing => existing.Id == input.Id);

        if (index >= 0)
        {
            // v9 (#429): items belong to an array, fields to an object or an
            // array of objects, values to an enum or an array of enums. Kept
            // across a retype that still wants them, cleared otherwise.
            var keepsItems = type == WorkflowInputTypes.Array;
            var elementType = keepsItems ? inputs[index].Items?.Type : null;
            var keepsFields = type == WorkflowInputTypes.Object || elementType == WorkflowInputTypes.Object;
            var keepsValues = type == WorkflowInputTypes.Enum || elementType == WorkflowInputTypes.Enum;

            inputs[index] = inputs[index] with
            {
                // text is the default, so it is written as absence rather than
                // as the word — a v7 declaration stays byte-identical.
                Type = type == WorkflowInputTypes.Text ? null : type,
                Values = keepsValues ? inputs[index].Values ?? new List<string>() : null,
                // An array starts with no entry type (explicit initialisation);
                // an object starts with no fields, which the desk refuses.
                Items = keepsItems ? inputs[index].Items : null,
                Fields = keepsFields ? inputs[index].Fields ?? new List<WorkflowManifestReader.FieldView>() : null
            };
            declaredError = null;
        }

        await CommitDeclarationAsync();
    }

    private async Task AddEnumValueAsync(WorkflowManifestReader.InputView input, string? value)
    {
        var candidate = (value ?? string.Empty).Trim();

        if (!DeclaredIdPattern.IsMatch(candidate))
        {
            declaredError = $"Value '{candidate}' must be snake_case (a lowercase letter, then lowercase letters, digits, or underscores).";
            return;
        }

        var inputs = MutableInputs();
        var index = inputs.FindIndex(existing => existing.Id == input.Id);

        if (index >= 0)
        {
            var values = (inputs[index].Values ?? Array.Empty<string>()).ToList();

            if (values.Contains(candidate, StringComparer.Ordinal))
            {
                declaredError = $"Input '{input.Id}' already declares '{candidate}'.";
                return;
            }

            values.Add(candidate);
            inputs[index] = inputs[index] with { Values = values };
            declaredError = null;
        }

        await CommitDeclarationAsync();
    }

    /// <summary>
    /// The deliverables whose condition compares this input to this value
    /// (#350). Removing it would leave the condition naming a value the input
    /// no longer declares — the value-side twin of <see cref="ConditionLock"/>,
    /// which already refuses removing or retyping the input itself.
    /// </summary>
    private IReadOnlyList<string> ResultsComparedTo(string inputId, string value) =>
        EffectiveResults
            .Where(result => WorkflowResultConditionText.ReadsInput(result.When, inputId)
                && WorkflowResultConditionText.LiteralOf(result.When) == value)
            .Select(result => result.Label)
            .ToList();

    private async Task RemoveEnumValueAsync(WorkflowManifestReader.InputView input, string value)
    {
        if (ResultsComparedTo(input.Id, value) is { Count: > 0 } dependents)
        {
            declaredError =
                $"Value '{value}' is what {string.Join(", ", dependents.Select(d => $"'{d}'"))} tests for; "
                + "change that document's condition first.";
            return;
        }

        var inputs = MutableInputs();
        var index = inputs.FindIndex(existing => existing.Id == input.Id);

        if (index >= 0)
        {
            var values = (inputs[index].Values ?? Array.Empty<string>()).Where(v => v != value).ToList();
            inputs[index] = inputs[index] with { Values = values };
        }

        await CommitDeclarationAsync();
    }

    // ----- #429: an array's element type and an object's fields ------------

    private readonly Dictionary<string, string> newFieldIds = new(StringComparer.Ordinal);

    private string NewFieldId(string owner) => newFieldIds.GetValueOrDefault(owner, string.Empty);

    /// <summary>v10 (#498): a field's owner is a path — the input, or a field below it ("patient.contact").</summary>
    private static string InputIdOf(string owner) => owner.Split('.')[0];

    /// <summary>The field's path below its input, as the sentences spell it: "contact.phone".</summary>
    private static string FieldPathOf(string owner, string fieldId)
    {
        var below = owner.IndexOf('.');
        return below < 0 ? fieldId : $"{owner[(below + 1)..]}.{fieldId}";
    }

    /// <summary>One declaration, changed in place; false when the id is gone.</summary>
    private bool UpdateInput(string inputId, Func<WorkflowManifestReader.InputView, WorkflowManifestReader.InputView> change)
    {
        var inputs = MutableInputs();
        var index = inputs.FindIndex(existing => existing.Id == inputId);

        if (index < 0)
        {
            return false;
        }

        inputs[index] = change(inputs[index]);
        return true;
    }

    /// <summary>One field under an owner path, changed in place — walking the tree to any depth (v10, #498).</summary>
    private bool UpdateField(string owner, string fieldId, Func<WorkflowManifestReader.FieldView, WorkflowManifestReader.FieldView> change) =>
        UpdateFields(owner, fields => fields.Select(field => field.Id == fieldId ? change(field) : field).ToList());

    /// <summary>The fields list under an owner path, replaced whole.</summary>
    private bool UpdateFields(string owner, Func<IReadOnlyList<WorkflowManifestReader.FieldView>, List<WorkflowManifestReader.FieldView>> change)
    {
        var segments = owner.Split('.');
        return UpdateInput(segments[0], input => input with { Fields = Rewrite(input.Fields, 1) });

        List<WorkflowManifestReader.FieldView> Rewrite(IReadOnlyList<WorkflowManifestReader.FieldView>? fields, int depth)
        {
            var present = fields ?? Array.Empty<WorkflowManifestReader.FieldView>();
            return depth == segments.Length
                ? change(present)
                : present.Select(field => field.Id == segments[depth] ? field with { Fields = Rewrite(field.Fields, depth + 1) } : field).ToList();
        }
    }

    private async Task SetInputInnerItemsAsync(WorkflowManifestReader.InputView input, string? value)
    {
        var inner = string.IsNullOrWhiteSpace(value) ? null : value!.Trim();
        UpdateInput(input.Id, existing => existing with
        {
            Items = new WorkflowManifestReader.ElementView(WorkflowInputTypes.Array, inner is null ? null : new WorkflowManifestReader.ElementView(inner))
        });
        declaredError = null;
        await CommitDeclarationAsync();
    }

    /// <summary>v10 (#498): an array field says what its entries are — the input's rule, one level down.</summary>
    private async Task SetFieldItemsAsync(string owner, WorkflowManifestReader.FieldView field, string? value)
    {
        var items = string.IsNullOrWhiteSpace(value) ? null : value!.Trim();
        UpdateField(owner, field.Id, existing => existing with
        {
            Items = items is null ? null : new WorkflowManifestReader.ElementView(items),
            Fields = items == WorkflowInputTypes.Object ? existing.Fields ?? new List<WorkflowManifestReader.FieldView>() : null,
            Values = items == WorkflowInputTypes.Enum ? existing.Values ?? new List<string>() : null
        });
        declaredError = null;
        await CommitDeclarationAsync();
    }

    private async Task SetFieldInnerItemsAsync(string owner, WorkflowManifestReader.FieldView field, string? value)
    {
        var inner = string.IsNullOrWhiteSpace(value) ? null : value!.Trim();
        UpdateField(owner, field.Id, existing => existing with
        {
            Items = new WorkflowManifestReader.ElementView(WorkflowInputTypes.Array, inner is null ? null : new WorkflowManifestReader.ElementView(inner))
        });
        declaredError = null;
        await CommitDeclarationAsync();
    }

    private async Task SetInputItemsAsync(WorkflowManifestReader.InputView input, string? value)
    {
        var items = string.IsNullOrWhiteSpace(value) ? null : value!.Trim();

        if (ConditionLock(input) is { } locked)
        {
            declaredError = locked;
            return;
        }

        // Fields belong to an array of objects, values to an array of enums;
        // kept across a change that still wants them, cleared otherwise.
        UpdateInput(input.Id, existing => existing with
        {
            Items = items is null ? null : new WorkflowManifestReader.ElementView(items),
            Fields = items == WorkflowInputTypes.Object ? existing.Fields ?? new List<WorkflowManifestReader.FieldView>() : null,
            Values = items == WorkflowInputTypes.Enum ? existing.Values ?? new List<string>() : null
        });
        declaredError = null;
        await CommitDeclarationAsync();
    }

    private async Task AddFieldAsync(string owner, IReadOnlyList<WorkflowManifestReader.FieldView> fields)
    {
        var id = NewFieldId(owner).Trim();

        if (!DeclaredIdPattern.IsMatch(id))
        {
            declaredError = $"Field id '{id}' must be snake_case (a lowercase letter, then lowercase letters, digits, or underscores).";
            return;
        }

        if (fields.Any(field => field.Id == id))
        {
            declaredError = $"Input '{InputIdOf(owner)}' declares duplicate field id '{FieldPathOf(owner, id)}'.";
            return;
        }

        // Text by default, as an input is; required until said otherwise.
        UpdateFields(owner, existing => existing.Append(new WorkflowManifestReader.FieldView(id, id, true)).ToList());
        newFieldIds.Remove(owner);
        declaredError = null;
        await CommitDeclarationAsync();
    }

    private async Task RenameFieldAsync(string owner, WorkflowManifestReader.FieldView field, string? value)
    {
        var id = (value ?? string.Empty).Trim();

        if (id == field.Id)
        {
            return;
        }

        if (!DeclaredIdPattern.IsMatch(id))
        {
            declaredError = $"Field id '{id}' must be snake_case (a lowercase letter, then lowercase letters, digits, or underscores).";
            return;
        }

        if (SiblingsOf(owner).Any(existing => existing.Id == id))
        {
            declaredError = $"Input '{InputIdOf(owner)}' declares duplicate field id '{FieldPathOf(owner, id)}'.";
            return;
        }

        UpdateField(owner, field.Id, existing => existing with { Id = id });
        if (!owner.Contains('.'))
        {
            CascadeFieldRename(owner, field.Id, id);
        }
        declaredError = null;
        await CommitDeclarationAsync();
    }

    /// <summary>
    /// A condition names a field the way a binding names an input, so a rename
    /// has to reach it. Touched only when a condition actually reads the old
    /// field — MutableResults() would otherwise mark the documents pending for
    /// a rename that has nothing to do with them.
    /// </summary>
    private void CascadeFieldRename(string inputId, string oldField, string newField)
    {
        if (!EffectiveResults.Any(result =>
            WorkflowResultConditionText.ReadsInput(result.When, inputId)
            && WorkflowResultConditionText.FieldOf(result.When) == oldField))
        {
            return;
        }

        var results = MutableResults();

        for (var index = 0; index < results.Count; index++)
        {
            if (results[index].When is { } when)
            {
                results[index] = results[index] with
                {
                    When = WorkflowResultConditionText.RenameField(when, inputId, oldField, newField)
                };
            }
        }
    }

    private async Task RelabelFieldAsync(string owner, WorkflowManifestReader.FieldView field, string? value)
    {
        var label = (value ?? string.Empty).Trim();

        if (label.Length == 0)
        {
            declaredError = $"Input '{InputIdOf(owner)}' field '{FieldPathOf(owner, field.Id)}' has no label.";
            return;
        }

        UpdateField(owner, field.Id, existing => existing with { Label = label });
        await CommitDeclarationAsync();
    }

    private async Task SetFieldRequiredAsync(string owner, WorkflowManifestReader.FieldView field, bool required)
    {
        UpdateField(owner, field.Id, existing => existing with { Required = required });
        await CommitDeclarationAsync();
    }

    private async Task RetypeFieldAsync(string owner, WorkflowManifestReader.FieldView field, string? value)
    {
        var type = string.IsNullOrWhiteSpace(value) ? WorkflowInputTypes.Text : value!.Trim();

        if (type == WorkflowInputTypes.Of(field))
        {
            return;
        }

        if (FieldLock(owner, field) is { } locked)
        {
            declaredError = locked;
            return;
        }

        // v10 (#498): a field that becomes structure starts empty, as an
        // input does (explicit initialisation); one that stops carries none.
        UpdateField(owner, field.Id, existing => existing with
        {
            Type = type == WorkflowInputTypes.Text ? null : type,
            Values = type == WorkflowInputTypes.Enum ? existing.Values ?? new List<string>() : null,
            Items = null,
            Fields = type == WorkflowInputTypes.Object ? existing.Fields ?? new List<WorkflowManifestReader.FieldView>() : null
        });
        declaredError = null;
        await CommitDeclarationAsync();
    }

    private async Task RemoveFieldAsync(string owner, WorkflowManifestReader.FieldView field)
    {
        if (FieldLock(owner, field) is { } locked)
        {
            declaredError = locked;
            return;
        }

        UpdateFields(owner, existing => existing.Where(f => f.Id != field.Id).ToList());
        await CommitDeclarationAsync();
    }

    private async Task AddFieldValueAsync(string owner, WorkflowManifestReader.FieldView field, string? value)
    {
        var candidate = (value ?? string.Empty).Trim();

        if (!DeclaredIdPattern.IsMatch(candidate))
        {
            declaredError = $"Value '{candidate}' must be snake_case (a lowercase letter, then lowercase letters, digits, or underscores).";
            return;
        }

        if (field.Values?.Contains(candidate, StringComparer.Ordinal) == true)
        {
            declaredError = $"Field '{owner}.{field.Id}' already declares '{candidate}'.";
            return;
        }

        UpdateField(owner, field.Id, existing => existing with
        {
            Values = (existing.Values ?? Array.Empty<string>()).Append(candidate).ToList()
        });
        declaredError = null;
        await CommitDeclarationAsync();
    }

    private async Task RemoveFieldValueAsync(string owner, WorkflowManifestReader.FieldView field, string value)
    {
        // A condition reads a top-level field by path; deeper is the builder's (step (g) PR 3).
        var dependents = owner.Contains('.') ? new List<string>() : EffectiveResults
            .Where(result => WorkflowResultConditionText.ReadsInput(result.When, owner)
                && WorkflowResultConditionText.FieldOf(result.When) == field.Id
                && WorkflowResultConditionText.LiteralOf(result.When) == value)
            .Select(result => result.Label)
            .ToList();

        if (dependents.Count > 0)
        {
            declaredError =
                $"Value '{value}' is what {string.Join(", ", dependents.Select(d => $"'{d}'"))} tests for; "
                + "change that document's condition first.";
            return;
        }

        UpdateField(owner, field.Id, existing => existing with
        {
            Values = (existing.Values ?? Array.Empty<string>()).Where(v => v != value).ToList()
        });
        await CommitDeclarationAsync();
    }

    /// <summary>
    /// A field a condition reads by path cannot be retyped or removed — the
    /// field's twin of <see cref="ConditionLock"/>.
    /// </summary>
    private string? FieldLock(string owner, WorkflowManifestReader.FieldView field)
    {
        var dependents = owner.Contains('.') ? new List<string>() : EffectiveResults
            .Where(result => WorkflowResultConditionText.ReadsInput(result.When, owner)
                && WorkflowResultConditionText.FieldOf(result.When) == field.Id)
            .Select(result => result.Label)
            .ToList();

        return dependents.Count == 0
            ? null
            : $"Field '{owner}.{field.Id}' is tested by {string.Join(", ", dependents.Select(d => $"'{d}'"))}; change that document's condition first.";
    }

    /// <summary>The fields beside a field under an owner path.</summary>
    private IReadOnlyList<WorkflowManifestReader.FieldView> SiblingsOf(string owner)
    {
        var segments = owner.Split('.');
        IReadOnlyList<WorkflowManifestReader.FieldView>? fields = EffectiveInputs.FirstOrDefault(candidate => candidate.Id == segments[0])?.Fields;
        for (var depth = 1; depth < segments.Length && fields != null; depth++)
        {
            fields = fields.FirstOrDefault(field => field.Id == segments[depth])?.Fields;
        }

        return fields ?? Array.Empty<WorkflowManifestReader.FieldView>();
    }

    /// <summary>
    /// The shapes a field must finish before it can publish — v9's rules at
    /// every level of the tree (v10, #498), the path spelled in the sentence.
    /// </summary>
    private static IEnumerable<string> FieldTreeErrors(IReadOnlyList<WorkflowManifestReader.InputView> inputs)
    {
        foreach (var input in inputs.Where(input => input.Fields is { Count: > 0 }))
        {
            foreach (var error in Errors(input.Id, string.Empty, input.Fields!))
            {
                yield return error;
            }
        }

        static IEnumerable<string> Errors(string inputId, string prefix, IReadOnlyList<WorkflowManifestReader.FieldView> fields)
        {
            foreach (var group in fields.GroupBy(field => field.Id).Where(group => group.Count() > 1))
            {
                yield return $"Input '{inputId}' declares duplicate field id '{prefix}{group.Key}'.";
            }

            foreach (var field in fields)
            {
                var path = $"{prefix}{field.Id}";
                var count = field.Values?.Count ?? 0;
                if (string.IsNullOrWhiteSpace(field.Label))
                {
                    yield return $"Input '{inputId}' field '{path}' has no label.";
                }

                if (WorkflowInputTypes.DeclaresValues(field) && count < 2)
                {
                    yield return $"Input '{inputId}' field '{path}' declares {count} enum value{(count == 1 ? string.Empty : "s")}; an enum needs at least two.";
                }

                if (WorkflowInputTypes.Of(field) == WorkflowInputTypes.Array && field.Items is null)
                {
                    yield return $"Input '{inputId}' field '{path}' is an array and must declare what its entries are.";
                }

                if (field.Items?.Type == WorkflowInputTypes.Array && field.Items.Items is null)
                {
                    yield return $"Input '{inputId}' field '{path}' is an array of arrays and must declare what the inner entries are.";
                }

                if (WorkflowInputTypes.DeclaresObject(field) && field.Fields is not { Count: > 0 })
                {
                    yield return $"Input '{inputId}' field '{path}' is an object and must declare at least one field.";
                }

                if (field.Fields is { Count: > 0 })
                {
                    foreach (var error in Errors(inputId, $"{path}.", field.Fields))
                    {
                        yield return error;
                    }
                }
            }
        }
    }

    /// <summary>
    /// One thing a condition may read (#314, #427): its key as the grammar
    /// spells it, the type its literal follows, and an enum's values.
    /// </summary>
    private sealed record ConditionOperand(string Key, string Type, IReadOnlyList<string>? Values);

    /// <summary>
    /// What a condition may read, in declaration order: an enum or a boolean;
    /// from 9, a number or a date, each testable field of an object (text is
    /// never testable, and an array's element fields are not read by path),
    /// and an array's count or its bare "has entries". Below 9 exactly the v8
    /// list, so no v9 form can be composed into a v8 publish.
    /// </summary>
    private IReadOnlyList<ConditionOperand> ConditionOperands
    {
        get
        {
            var v9 = EffectiveSpecVersion >= 9;
            var operands = new List<ConditionOperand>();

            foreach (var input in EffectiveInputs)
            {
                var type = WorkflowInputTypes.Of(input);

                switch (type)
                {
                    case WorkflowInputTypes.Enum or WorkflowInputTypes.Boolean:
                        operands.Add(new ConditionOperand(input.Id, type, input.Values));
                        break;
                    case WorkflowInputTypes.Number or WorkflowInputTypes.Date when v9:
                        operands.Add(new ConditionOperand(input.Id, type, null));
                        break;
                    case WorkflowInputTypes.Object when v9:
                        // 'field' is a keyword inside a property accessor (C# 14).
                        foreach (var member in input.Fields ?? Array.Empty<WorkflowManifestReader.FieldView>())
                        {
                            var fieldType = WorkflowInputTypes.Of(member);

                            if (fieldType is WorkflowInputTypes.Enum or WorkflowInputTypes.Boolean or WorkflowInputTypes.Number or WorkflowInputTypes.Date)
                            {
                                operands.Add(new ConditionOperand($"{input.Id}.{member.Id}", fieldType, member.Values));
                            }
                        }

                        break;
                    case WorkflowInputTypes.Array when v9:
                        operands.Add(new ConditionOperand($"count({input.Id})", CountType, null));
                        operands.Add(new ConditionOperand(input.Id, WorkflowInputTypes.Array, null));
                        break;
                }
            }

            return operands;
        }
    }

    /// <summary>Equality for every operand; ordering for a number, a date or a count.</summary>
    private static IReadOnlyList<string> OperatorsFor(string type) =>
        type is WorkflowInputTypes.Number or WorkflowInputTypes.Date or CountType
            ? new[] { "==", "!=", ">", "<", ">=", "<=" }
            : new[] { "==", "!=" };

    /// <summary>How the select reads each operator; the condition is composed from the symbol.</summary>
    private static string OperatorWord(string symbol) => symbol switch
    {
        "==" => "is",
        "!=" => "is not",
        ">" => "is more than",
        "<" => "is less than",
        ">=" => "is at least",
        "<=" => "is at most",
        _ => symbol
    };

    /// <summary>
    /// The deliverable's condition, composed from the three controls. An empty
    /// operand clears it — an unconditional deliverable always fires.
    /// </summary>
    private async Task SetResultConditionAsync(
        WorkflowManifestReader.ResultView result,
        string? operandKey,
        string? op = null,
        string? literal = null)
    {
        var results = MutableResults();
        var index = results.FindIndex(existing => existing.Id == result.Id);

        if (index < 0)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(operandKey))
        {
            results[index] = results[index] with { When = null };
            await CommitDeclarationAsync();
            return;
        }

        var key = operandKey!.Trim();
        var operand = ConditionOperands.FirstOrDefault(candidate => candidate.Key == key);

        if (operand is null)
        {
            // A loaded condition naming something not offered: left as written.
            return;
        }

        if (operand.Type == WorkflowInputTypes.Array)
        {
            results[index] = results[index] with { When = WorkflowResultConditionText.Compose(key, null, null) };
            await CommitDeclarationAsync();
            return;
        }

        var current = results[index].When;
        var symbol = op ?? WorkflowResultConditionText.OperatorOf(current);
        if (symbol is null || !OperatorsFor(operand.Type).Contains(symbol))
        {
            symbol = "==";
        }

        // A literal the new operand cannot take is dropped rather than carried:
        // switching from one enum to another must not leave the old value, and
        // a number's spelling does not become a date by changing the operand.
        var value = literal ?? WorkflowResultConditionText.LiteralOf(current) ?? string.Empty;
        value = operand.Type switch
        {
            WorkflowInputTypes.Enum => operand.Values?.Contains(value, StringComparer.Ordinal) == true ? value : operand.Values?.FirstOrDefault() ?? string.Empty,
            WorkflowInputTypes.Boolean => value is "true" or "false" ? value : "true",
            WorkflowInputTypes.Number => Consultologist.Web.Services.AI.ConsultInputValue.TryParseNumber(value, out _) ? value : string.Empty,
            WorkflowInputTypes.Date => DateOnly.TryParseExact(value, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out _) ? value : string.Empty,
            CountType => int.TryParse(value, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out _) ? value : string.Empty,
            _ => value
        };

        results[index] = results[index] with
        {
            When = WorkflowResultConditionText.Compose(key, symbol, value)
        };

        await CommitDeclarationAsync();
    }

    // Razor cannot parse a nested string literal inside an attribute lambda,
    // which is the only reason this is a method rather than inline.
    private Task SetConditionOperatorAsync(
        WorkflowManifestReader.ResultView result, string operandKey, string? symbol) =>
        SetResultConditionAsync(result, operandKey, op: symbol);


    private async Task RelabelInputAsync(WorkflowManifestReader.InputView input, string? value)
    {
        var label = (value ?? string.Empty).Trim();

        if (label.Length == 0)
        {
            declaredError = $"Input '{input.Id}' has no label.";
            return;
        }

        var inputs = MutableInputs();
        var index = inputs.FindIndex(existing => existing.Id == input.Id);

        if (index >= 0)
        {
            inputs[index] = inputs[index] with { Label = label };
        }

        await CommitDeclarationAsync();
    }

    private async Task SetInputRequiredAsync(WorkflowManifestReader.InputView input, bool required)
    {
        var inputs = MutableInputs();
        var index = inputs.FindIndex(existing => existing.Id == input.Id);

        if (index >= 0)
        {
            inputs[index] = inputs[index] with { Required = required };
        }

        await CommitDeclarationAsync();
    }

    // The string result becomes a one-entry list seeded with the sugar's own
    // id, so delivery filenames do not move when a package converts.
    private async Task ConvertToResultsListAsync()
    {
        var node = EffectiveResultRef ?? DeliverableCandidates.Select(c => $"node:{c.Id}").FirstOrDefault();

        if (node == null)
        {
            declaredError = "Add an aggregator node before declaring documents.";
            return;
        }

        var label = DeliverableCandidates.FirstOrDefault(c => $"node:{c.Id}" == node)?.Label ?? "Consultation note";
        resultsEdit = new List<WorkflowManifestReader.ResultView>
        {
            new("consult", node, label)
        };
        await CommitDeclarationAsync();
    }

    private async Task AddResultAsync()
    {
        var id = newResultId.Trim();

        if (!DeclaredIdPattern.IsMatch(id))
        {
            declaredError = $"Result id '{id}' must be snake_case (a lowercase letter, then lowercase letters, digits, or underscores).";
            return;
        }

        if (EffectiveResults.Any(result => result.Id == id))
        {
            declaredError = $"Duplicate result id '{id}'.";
            return;
        }

        var free = DeliverableCandidates.FirstOrDefault(candidate =>
            EffectiveResults.All(result => result.Node != $"node:{candidate.Id}"));

        if (free == null)
        {
            declaredError = "Every aggregator already owns a document; add an aggregator node first.";
            return;
        }

        MutableResults().Add(new WorkflowManifestReader.ResultView(id, $"node:{free.Id}", id));
        newResultId = string.Empty;
        await CommitDeclarationAsync();
    }

    private async Task RemoveResultAsync(WorkflowManifestReader.ResultView result)
    {
        MutableResults().RemoveAll(existing => existing.Id == result.Id);
        await CommitDeclarationAsync();
    }

    private async Task RenameResultAsync(WorkflowManifestReader.ResultView result, string? value)
    {
        var id = (value ?? string.Empty).Trim();

        if (id == result.Id)
        {
            return;
        }

        if (!DeclaredIdPattern.IsMatch(id))
        {
            declaredError = $"Result id '{id}' must be snake_case (a lowercase letter, then lowercase letters, digits, or underscores).";
            return;
        }

        if (EffectiveResults.Any(existing => existing.Id == id))
        {
            declaredError = $"Duplicate result id '{id}'.";
            return;
        }

        var results = MutableResults();
        var index = results.FindIndex(existing => existing.Id == result.Id);

        if (index >= 0)
        {
            results[index] = results[index] with { Id = id };
        }

        await CommitDeclarationAsync();
    }

    private async Task RelabelResultAsync(WorkflowManifestReader.ResultView result, string? value)
    {
        var label = (value ?? string.Empty).Trim();

        if (label.Length == 0)
        {
            declaredError = $"Result '{result.Id}' has no label.";
            return;
        }

        var results = MutableResults();
        var index = results.FindIndex(existing => existing.Id == result.Id);

        if (index >= 0)
        {
            results[index] = results[index] with { Label = label };
        }

        await CommitDeclarationAsync();
    }

    private async Task RepointResultAsync(WorkflowManifestReader.ResultView result, string? value)
    {
        var node = value ?? string.Empty;

        if (node == result.Node)
        {
            return;
        }

        if (EffectiveResults.Any(existing => existing.Id != result.Id && existing.Node == node))
        {
            declaredError = $"Another document already uses '{node}': each deliverable needs its own aggregator.";
            return;
        }

        var results = MutableResults();
        var index = results.FindIndex(existing => existing.Id == result.Id);

        if (index >= 0)
        {
            results[index] = results[index] with { Node = node };
        }

        await CommitDeclarationAsync();
    }

    // The pending deliverable wins over the manifest's result.
    private string? EffectiveResultRef =>
        resultEdit ?? (content != null ? WorkflowManifestReader.ReadResultRef(content.Manifest) : null);

    // The manifest's nodes minus removals, with pending field and aggregate
    // edits applied, plus pending new nodes — the single list every editing
    // surface (Graph cards, sidebar panes, source dropdowns) reads, so a
    // pending forEach change immediately reshapes valid sources.
    private IReadOnlyList<WorkflowManifestReader.NodeView> EffectiveNodes =>
        nodes.Where(n => !removedNodeIds.Contains(n.Id))
            .Select(n =>
            {
                if (nodeEdits.TryGetValue(n.Id, out var edit))
                {
                    n = n with
                    {
                        Label = edit.Label,
                        ForEach = edit.ForEach,
                        OutputSchema = edit.OutputSchema,
                        FailIfEmpty = edit.FailIfEmpty,
                        HasOutput = edit.OutputSchema != null,
                        Prompt = edit.Prompt ?? n.Prompt
                    };
                }

                if (aggregateEdits.TryGetValue(n.Id, out var sources))
                {
                    n = n with { Aggregate = sources };
                }

                return n with { IsResult = DeliverableRootIds.Contains(n.Id) };
            })
            .Concat(addedNodes.Select(AddedNodeView))
            .ToList();

    private IReadOnlyList<WorkflowManifestReader.NodeView> RemovedNodes =>
        nodes.Where(n => removedNodeIds.Contains(n.Id)).ToList();

    // Loaded prompts minus those made orphans by node removals (with sharing,
    // a prompt survives while any effective node still uses it), plus each
    // pending prompt node's fresh prompt and every standalone pending prompt
    // (variables arrive via the chips, like any added variable).
    private IReadOnlyList<WorkflowManifestReader.PromptView> EffectivePrompts =>
        prompts.Where(p => nodes.Any(n => n.Prompt == p.Id && !removedNodeIds.Contains(n.Id))
                || !nodes.Any(n => n.Prompt == p.Id))
            .Concat(addedNodes.Where(a => a.Aggregate == null && a.PromptRef == null).Select(a => new WorkflowManifestReader.PromptView(
                a.Id, AddedPromptFile(a.Id), Array.Empty<string>(), null)))
            .Concat(addedPrompts.Select(p => new WorkflowManifestReader.PromptView(
                p.Id, AddedStandalonePromptFile(p.Id), Array.Empty<string>(), null)))
            .ToList();

    // Deliverable candidates by spec version: aggregators from v6 on (v7's
    // results must each name one), forEach nodes in v5 where the fan itself
    // was the deliverable.
    private IReadOnlyList<WorkflowManifestReader.NodeView> DeliverableCandidates =>
        (EffectiveSpecVersion >= 6
            ? EffectiveNodes.Where(n => n.Aggregate != null)
            : EffectiveNodes.Where(n => n.ForEach != null)).ToList();

    // Declared inputs and the result set: authorable from v7, and gated on the
    // version being PUBLISHED. A v6 fork that has pressed Upgrade is composing
    // a v8 manifest, so it must be able to author what v8 requires — and the
    // pre-flight below must hold it to those rules (#404).
    private bool IsV7 => EffectiveSpecVersion >= 7;

    // The declared deliverables with pending edits applied. Empty for v5/v6 and
    // for a v7 package still on the string result form.
    private IReadOnlyList<WorkflowManifestReader.ResultView> EffectiveResults =>
        resultsEdit ?? (content != null && IsV7
            ? WorkflowManifestReader.ReadResults(content.Manifest)
            : Array.Empty<WorkflowManifestReader.ResultView>());

    // Every node a deliverable points at — the roots reachability walks back
    // from. v7 unions the declared set; v5/v6 use the single result.
    private IReadOnlyList<string> DeliverableRootIds =>
        EffectiveResults.Count > 0
            ? EffectiveResults
                .Where(result => result.Node.StartsWith("node:", StringComparison.Ordinal))
                .Select(result => result.Node["node:".Length..])
                .ToList()
            : EffectiveResultRef is { } singleRef && singleRef.StartsWith("node:", StringComparison.Ordinal)
                ? new List<string> { singleRef["node:".Length..] }
                : Array.Empty<string>();

    private async Task OnAggregateChangedAsync(WorkflowNodeSummary.AggregateChange change)
    {

        if (addedNodes.FirstOrDefault(a => a.Id == change.NodeId) is { } addedAggregator)
        {
            addedAggregator.Aggregate = change.Sources;
            await PendingChangedAsync();
            return;
        }

        var original = nodes.FirstOrDefault(n => n.Id == change.NodeId)?.Aggregate;

        if (original != null && original.SequenceEqual(change.Sources, StringComparer.Ordinal))
        {
            aggregateEdits.Remove(change.NodeId);
        }
        else if (original != null)
        {
            aggregateEdits[change.NodeId] = change.Sources;
        }

        await PendingChangedAsync();
    }

    private async Task OnResultChangedAsync(ChangeEventArgs args)
    {
        var selected = args.Value?.ToString();

        if (string.IsNullOrEmpty(selected))
        {
            return;
        }

        resultEdit = selected == WorkflowManifestReader.ReadResultRef(content!.Manifest) ? null : selected;
        await PendingChangedAsync();
    }

    // The live guardrail from v6 on: reverse BFS from the effective
    // deliverables over effective binding + aggregate edges, union-rooted since
    // v7 can declare several. Informational — the server's reachability rule is
    // the authority at publish.
    private IReadOnlyList<string> UnreachableNodeLabels()
    {
        if (EffectiveSpecVersion < 6 || DeliverableRootIds.Count == 0)
        {
            return Array.Empty<string>();
        }

        var effective = EffectiveNodes;
        var byId = effective.ToDictionary(n => n.Id, StringComparer.Ordinal);
        var incoming = new Dictionary<string, List<string>>(StringComparer.Ordinal);

        foreach (var node in effective)
        {
            var sources = new List<string>();

            foreach (var row in RowsFor(node))
            {
                if (row.From.StartsWith("node:", StringComparison.Ordinal))
                {
                    sources.Add(row.From["node:".Length..]);
                }
            }

            foreach (var sourceRef in node.Aggregate ?? Array.Empty<string>())
            {
                if (sourceRef.StartsWith("node:", StringComparison.Ordinal))
                {
                    sources.Add(sourceRef["node:".Length..]);
                }
            }

            incoming[node.Id] = sources;
        }

        var reached = new HashSet<string>(StringComparer.Ordinal);
        var queue = new Queue<string>();

        foreach (var rootId in DeliverableRootIds)
        {
            if (byId.ContainsKey(rootId) && reached.Add(rootId))
            {
                queue.Enqueue(rootId);
            }
        }

        while (queue.Count > 0)
        {
            foreach (var sourceId in incoming.GetValueOrDefault(queue.Dequeue()) ?? new List<string>())
            {
                if (byId.ContainsKey(sourceId) && reached.Add(sourceId))
                {
                    queue.Enqueue(sourceId);
                }
            }
        }

        return effective.Where(n => !reached.Contains(n.Id)).Select(n => n.Label).ToList();
    }

    private IReadOnlyList<string> CollectionIds => EffectiveCollections.Select(c => c.Id).ToList();

    // Loaded plus pending, the same deal CollectionIds gets. A pending folder
    // can be forEached the moment it exists; a pending value has to be
    // bindable the same way, or authoring one takes two publishes — which is
    // exactly what it took before this.
    // Pending removals drop out (#321): offering a value you just deleted
    // would build a binding the server rejects, which is the delete guard's
    // mirror image. Pending additions stay in — that is #322.
    private IReadOnlyList<string> ScalarIds =>
        EffectiveScalars.Where(s => !ScalarIsRemoved(s)).Select(s => s.Id).ToList();

    // Output-contract choices are the package's own schema ids — their files
    // are present and already validated as canonical catalog matches.
    private IReadOnlyList<string> ContractOptions => schemaIds;

    private static string NodeKeyFor(string nodeId) => NodeKeyPrefix + nodeId;

    private WorkflowManifestReader.NodeView? SelectedNode() =>
        selectedKey != null && selectedKey.StartsWith(NodeKeyPrefix, StringComparison.Ordinal)
            ? EffectiveNodes.FirstOrDefault(n => n.Id == selectedKey[NodeKeyPrefix.Length..])
            : null;

    private bool NodeHasPending(WorkflowManifestReader.NodeView node) =>
        nodeEdits.ContainsKey(node.Id)
        || aggregateEdits.ContainsKey(node.Id)
        || addedNodes.Any(a => a.Id == node.Id)
        || bindingEdits.Keys.Any(key => key.StartsWith(node.Id + "\n", StringComparison.Ordinal))
        || (node.Prompt != null && HasVariableEdits(node.Prompt));

    private async Task AddNodeAsync()
    {
        var aggregator = newNodeKind == "aggregator";
        var promptRef = aggregator || newNodePrompt.Length == 0 ? null : newNodePrompt;

        // With an existing prompt chosen, the node defaults to the prompt's
        // own name — the house convention (node and prompt sharing an id is
        // fine: they are separate manifest namespaces).
        var id = newNodeId?.Trim() ?? string.Empty;
        if (id.Length == 0 && promptRef != null)
        {
            id = promptRef;
        }

        var label = newNodeLabel?.Trim() ?? string.Empty;
        if (label.Length == 0 && promptRef != null)
        {
            label = char.ToUpperInvariant(id[0]) + id[1..].Replace('-', ' ').Replace('_', ' ');
        }

        if (!ItemIdPattern.IsMatch(id))
        {
            newNodeError = "Node ids are lowercase letters, digits, '-' or '_', starting with a letter or digit.";
            return;
        }

        if (nodes.Any(n => n.Id == id) || addedNodes.Any(a => a.Id == id))
        {
            newNodeError = $"A node named '{id}' already exists.";
            return;
        }

        // Only a freshly minted prompt (named after the node) can collide
        // with an existing prompt id.
        if (promptRef == null && !aggregator && EffectivePrompts.Any(p => p.Id == id))
        {
            newNodeError = $"A prompt named '{id}' already exists — choose it in the prompt field, or pick another node id.";
            return;
        }

        if (label.Length == 0)
        {
            newNodeError = "A label is required.";
            return;
        }
        addedNodes.Add(new AddedNode
        {
            Id = id,
            Label = label,
            ForEach = aggregator || newNodeForEach.Length == 0 ? null : newNodeForEach,
            OutputSchema = aggregator || newNodeOutput.Length == 0 ? null : newNodeOutput,
            Aggregate = aggregator ? new List<string>() : null,
            PromptRef = promptRef
        });
        newNodeId = newNodeLabel = null;
        newNodeForEach = string.Empty;
        newNodeOutput = string.Empty;
        newNodeKind = "prompt";
        newNodePrompt = string.Empty;
        newNodeError = null;
        // Land on the next step: the aggregator's source list or an existing
        // prompt's bindings on the node card, or the new prompt's text.
        selectedKey = aggregator || promptRef != null ? NodeKeyFor(id) : AddedPromptFile(id);
        await PendingChangedAsync();
    }

    private async Task RemoveNodeAsync(string nodeId)
    {
        var added = addedNodes.FirstOrDefault(a => a.Id == nodeId);
        var promptId = added != null
            ? added.PromptRef ?? added.Id
            : nodes.FirstOrDefault(n => n.Id == nodeId)?.Prompt;

        if (added != null)
        {
            addedNodes.Remove(added);
        }
        else if (nodes.Any(n => n.Id == nodeId))
        {
            removedNodeIds.Add(nodeId);
            nodeEdits.Remove(nodeId);
            aggregateEdits.Remove(nodeId);
        }
        else
        {
            return;
        }

        // The node's pending binding edits go with it; its prompt's variable
        // edits only when no other effective node still uses the prompt
        // (prompts may be shared in v6).
        foreach (var key in bindingEdits.Keys.Where(k => k.StartsWith(nodeId + "\n", StringComparison.Ordinal)).ToList())
        {
            bindingEdits.Remove(key);
        }

        if (promptId != null && !EffectiveNodes.Any(n => n.Prompt == promptId))
        {
            variableAdds.Remove(promptId);
            variableRemovals.Remove(promptId);
        }

        if (selectedKey == NodeKeyFor(nodeId)
            || (promptId != null && selectedKey == prompts.FirstOrDefault(p => p.Id == promptId)?.File)
            || selectedKey == AddedPromptFile(nodeId))
        {
            selectedKey = GraphKey;
        }

        await PendingChangedAsync();
    }

    private async Task RestoreNodeAsync(string nodeId)
    {
        removedNodeIds.Remove(nodeId);
        await PendingChangedAsync();
    }

    private async Task OnNodeChangedAsync(WorkflowNodeSummary.NodeChange change)
    {
        // Field edits on a pending node mutate it directly — there is no
        // manifest original to diff against.
        if (addedNodes.FirstOrDefault(a => a.Id == change.NodeId) is { } addedNode
            && !string.IsNullOrWhiteSpace(change.Label))
        {
            addedNode.Label = change.Label;
            addedNode.ForEach = change.ForEach;
            addedNode.OutputSchema = change.OutputSchema;
            addedNode.FailIfEmpty = change.FailIfEmpty;

            if (addedNode.Aggregate == null && change.Prompt != null)
            {
                addedNode.PromptRef = change.Prompt == addedNode.Id ? null : change.Prompt;
            }

                await PendingChangedAsync();
            return;
        }

        var original = nodes.FirstOrDefault(n => n.Id == change.NodeId);

        if (original == null)
        {
            return;
        }

        if (change.Label == original.Label
            && change.ForEach == original.ForEach
            && change.OutputSchema == original.OutputSchema
            && change.FailIfEmpty == original.FailIfEmpty
            && (change.Prompt == null || change.Prompt == original.Prompt))
        {
            nodeEdits.Remove(change.NodeId);
        }
        else
        {
            nodeEdits[change.NodeId] = change;
        }

        await PendingChangedAsync();
    }

    private async Task AddPromptAsync()
    {
        var id = newPromptId?.Trim() ?? string.Empty;

        if (!ItemIdPattern.IsMatch(id))
        {
            newPromptError = "Prompt ids are lowercase letters, digits, '-' or '_', starting with a letter or digit.";
            return;
        }

        if (EffectivePrompts.Any(p => p.Id == id) || nodes.Any(n => n.Id == id) || addedNodes.Any(a => a.Id == id))
        {
            newPromptError = $"A prompt or node named '{id}' already exists.";
            return;
        }

        var pending = new AddedPrompt { Id = id };
        addedPrompts.Add(pending);
        newPromptId = null;
        newPromptError = null;
        // Land on the new prompt's pane — writing its text is the next step.
        selectedKey = AddedStandalonePromptFile(id);
        await PendingChangedAsync();
    }

    private async Task RemoveAddedPromptAsync(AddedPrompt pending)
    {
        addedPrompts.Remove(pending);
        variableAdds.Remove(pending.Id);

        if (selectedKey == AddedStandalonePromptFile(pending.Id))
        {
            selectedKey = prompts.FirstOrDefault()?.File ?? GraphKey;
        }

        await PendingChangedAsync();
    }

    // Pending prompt-variable declarations and removals (#140), keyed by
    // prompt id. New variables start unbound on every using node; publish is
    // blocked per variable until a real source is chosen.
    private readonly Dictionary<string, List<string>> variableAdds = new(StringComparer.Ordinal);
    private readonly Dictionary<string, HashSet<string>> variableRemovals = new(StringComparer.Ordinal);
    private string? newVariableName;
    private string newVariableSource = string.Empty;
    private string? newVariableError;

    private static readonly System.Text.RegularExpressions.Regex VariableNameRegex =
        new("^[a-z][a-z0-9_]*$", System.Text.RegularExpressions.RegexOptions.Compiled);

    private int VariableAddCount => variableAdds.Values.Sum(list => list.Count);

    private int VariableRemovalCount => variableRemovals.Values.Sum(set => set.Count);

    private IReadOnlyList<string> AddedVariables(string? promptId) =>
        promptId != null && variableAdds.TryGetValue(promptId, out var adds) ? adds : Array.Empty<string>();

    private bool IsRemovedVariable(string promptId, string variable) =>
        variableRemovals.TryGetValue(promptId, out var removed) && removed.Contains(variable);

    private bool HasVariableEdits(string promptId) =>
        AddedVariables(promptId).Count > 0
        || (variableRemovals.TryGetValue(promptId, out var removed) && removed.Count > 0);

    private IReadOnlyList<string> EffectiveVariables(WorkflowManifestReader.PromptView prompt)
    {
        var result = prompt.Variables.Where(v => !IsRemovedVariable(prompt.Id, v)).ToList();
        result.AddRange(AddedVariables(prompt.Id));
        return result;
    }

    private bool VariableUsedInText(WorkflowManifestReader.PromptView prompt, string variable) =>
        System.Text.RegularExpressions.Regex.IsMatch(
            GetText(prompt.File),
            @"\{\{\s*" + System.Text.RegularExpressions.Regex.Escape(variable) + @"\s*\}\}");

    private IEnumerable<WorkflowManifestReader.NodeView> NodesUsingPrompt(string promptId) =>
        EffectiveNodes.Where(n => string.Equals(n.Prompt, promptId, StringComparison.Ordinal));

    private string? TryDeclareVariable(string promptId, string rawName, out string name)
    {
        name = rawName.Trim();

        if (!VariableNameRegex.IsMatch(name))
        {
            return "Variable names are lowercase: letters, digits, underscores, starting with a letter.";
        }

        var prompt = EffectivePrompts.FirstOrDefault(p => p.Id == promptId);

        if (prompt == null)
        {
            return "Unknown prompt.";
        }

        if (EffectiveVariables(prompt).Contains(name, StringComparer.Ordinal))
        {
            return $"'{name}' already exists on this prompt.";
        }

        if (!variableAdds.TryGetValue(promptId, out var adds))
        {
            variableAdds[promptId] = adds = new List<string>();
        }

        adds.Add(name);
        return null;
    }

    private async Task AddVariableFromPromptAsync(WorkflowManifestReader.PromptView prompt)
    {
        newVariableError = TryDeclareVariable(prompt.Id, newVariableName ?? string.Empty, out var name);

        if (newVariableError != null)
        {
            return;
        }

        // A chosen source is one explicit decision applied to every node using
        // this prompt; left empty, the variable stays unbound everywhere.
        if (!string.IsNullOrEmpty(newVariableSource))
        {
            foreach (var node in NodesUsingPrompt(prompt.Id))
            {
                bindingEdits[BindingKey(node.Id, name)] = (newVariableSource, null);
            }
        }

        newVariableName = null;
        newVariableSource = string.Empty;
        await PendingChangedAsync();
    }

    private WorkflowNodeSummary.BindingRow RowFor(WorkflowManifestReader.NodeView node, string variable)
    {
        var original = node.Bindings.FirstOrDefault(b => b.Variable == variable);
        var effective = GetEffectiveBinding(node.Id, variable) ?? (original?.From ?? string.Empty, original?.As);

        return new WorkflowNodeSummary.BindingRow(
            variable, effective.From, effective.As, original?.From, original?.As, IsNew: original == null);
    }

    private static bool RowModified(WorkflowNodeSummary.BindingRow row) =>
        row.IsNew || row.From != row.OriginalFrom || row.As != row.OriginalAs;

    private IEnumerable<string> FirstUsingNodeOptions(WorkflowManifestReader.PromptView prompt)
    {
        var node = NodesUsingPrompt(prompt.Id).FirstOrDefault();

        return node == null
            ? Enumerable.Empty<string>()
            : BindingSourceEditor.SourceOptions(nodes, ScalarIds, node, string.Empty, DeclaredInputIds);
    }

    private async Task RemoveVariableAsync(WorkflowManifestReader.PromptView prompt, string variable)
    {

        if (variableAdds.TryGetValue(prompt.Id, out var adds) && adds.Remove(variable))
        {
            if (adds.Count == 0)
            {
                variableAdds.Remove(prompt.Id);
            }
        }
        else
        {
            if (!variableRemovals.TryGetValue(prompt.Id, out var removed))
            {
                variableRemovals[prompt.Id] = removed = new HashSet<string>(StringComparer.Ordinal);
            }

            removed.Add(variable);
        }

        foreach (var node in NodesUsingPrompt(prompt.Id))
        {
            bindingEdits.Remove(BindingKey(node.Id, variable));
        }

        await PendingChangedAsync();
    }

    private async Task RestoreVariableAsync(WorkflowManifestReader.PromptView prompt, string variable)
    {

        if (variableRemovals.TryGetValue(prompt.Id, out var removed))
        {
            removed.Remove(variable);

            if (removed.Count == 0)
            {
                variableRemovals.Remove(prompt.Id);
            }
        }

        await PendingChangedAsync();
    }

    private static string BindingKey(string nodeId, string variable) => nodeId + "\n" + variable;

    private (string From, string? As)? GetEffectiveBinding(string nodeId, string variable) =>
        bindingEdits.TryGetValue(BindingKey(nodeId, variable), out var edit) ? edit : null;

    // The Graph cards' effective row model: declared bindings (minus pending
    // removals, with rebinds applied) plus pending-added variables (unbound
    // until a source is chosen).
    // A node whose effective prompt is not the one its manifest bindings were
    // written for (re-pointed via the selector, or born onto an existing
    // prompt): its rows are the new prompt's variables, all unbound until a
    // source is chosen — the old bindings are dead.
    private bool HasFreshBindings(WorkflowManifestReader.NodeView node)
    {
        var manifestNode = nodes.FirstOrDefault(n => n.Id == node.Id);

        if (manifestNode != null)
        {
            return manifestNode.Prompt != null && node.Prompt != null && manifestNode.Prompt != node.Prompt;
        }

        return addedNodes.FirstOrDefault(a => a.Id == node.Id)?.PromptRef != null;
    }

    private IReadOnlyList<WorkflowNodeSummary.BindingRow> RowsFor(WorkflowManifestReader.NodeView node)
    {
        var rows = new List<WorkflowNodeSummary.BindingRow>();

        if (HasFreshBindings(node))
        {
            var prompt = EffectivePrompts.FirstOrDefault(p => p.Id == node.Prompt);

            foreach (var variable in prompt != null ? EffectiveVariables(prompt) : Array.Empty<string>())
            {
                var effective = GetEffectiveBinding(node.Id, variable);
                rows.Add(new WorkflowNodeSummary.BindingRow(variable, effective?.From ?? string.Empty, effective?.As, null, null, true));
            }

            return rows;
        }

        foreach (var binding in node.Bindings)
        {
            if (node.Prompt != null && IsRemovedVariable(node.Prompt, binding.Variable))
            {
                continue;
            }

            rows.Add(RowFor(node, binding.Variable));
        }

        foreach (var variable in AddedVariables(node.Prompt))
        {
            rows.Add(RowFor(node, variable));
        }

        return rows;
    }

    private string? ValidateVariableNameForNode(WorkflowManifestReader.NodeView node, string name)
    {
        if (!VariableNameRegex.IsMatch(name))
        {
            return "Variable names are lowercase: letters, digits, underscores, starting with a letter.";
        }

        var prompt = EffectivePrompts.FirstOrDefault(p => p.Id == node.Prompt);

        if (prompt == null)
        {
            return "This node has no prompt.";
        }

        return EffectiveVariables(prompt).Contains(name, StringComparer.Ordinal)
            ? $"'{name}' already exists on prompt '{prompt.Id}'."
            : null;
    }

    private async Task OnVariableAddedAsync(WorkflowNodeSummary.VariableAdd add)
    {
        var node = EffectiveNodes.FirstOrDefault(n => n.Id == add.NodeId);

        if (node?.Prompt == null || TryDeclareVariable(node.Prompt, add.Variable, out var name) != null)
        {
            return;
        }

        // The originating node gets the chosen source (when one was picked);
        // other nodes sharing the prompt start unbound.
        if (!string.IsNullOrEmpty(add.From))
        {
            bindingEdits[BindingKey(node.Id, name)] = (add.From, add.As);
        }

        await PendingChangedAsync();
    }

    private async Task OnBindingChangedAsync(WorkflowNodeSummary.BindingChange change)
    {

        var original = nodes.FirstOrDefault(n => n.Id == change.NodeId)?
            .Bindings.FirstOrDefault(b => b.Variable == change.Variable);
        var key = BindingKey(change.NodeId, change.Variable);

        if (original != null && original.From == change.From && original.As == change.As)
        {
            bindingEdits.Remove(key);
        }
        else
        {
            bindingEdits[key] = (change.From, change.As);
        }

        await PendingChangedAsync();
    }

    private bool isLoading;
    private bool isPublishing;
    private string? loadError;
    private string? publishSuccess;
    private List<string> publishErrors = new();

    // Advisory, and only readable at the moment of a successful
    // publish — the version it describes is already immutable (#310).
    private List<string> publishWarnings = new();

    // Master–detail selection: a file path or GraphKey (#110).
    // Held in the tab session rather than the component (#207's shape), so
    // leaving Templates for another page and coming back returns to this pane
    // instead of starting over. A fresh session — including a refresh — has no
    // key, and LoadAsync opens on Graph.
    private string? selectedKey
    {
        get => EditorSession.SelectedKey;
        set => EditorSession.SelectedKey = value;
    }

    protected override async Task OnInitializedAsync()
    {
        editingRef = await ReadRememberedPackageAsync();
        await LoadAsync();
    }

    /// <summary>
    /// The package this browser was last editing. Remembered so a reload keeps
    /// a draft and the package it belongs to together — drafts are keyed per
    /// ref, so landing back on the pin would leave one invisible until the
    /// package was selected again.
    /// </summary>
    private async Task<string?> ReadPinAsync()
    {
        try
        {
            var setting = await AccountService.GetSettingAsync(WorkflowPackagePinSettingKey);
            return string.IsNullOrWhiteSpace(setting?.Value) ? null : setting!.Value.Trim();
        }
        catch (AccessTokenNotAvailableException)
        {
            throw;
        }
        catch
        {
            // Unknown is not "the same"; PinnedElsewhere stays silent rather
            // than claiming agreement it cannot see.
            return null;
        }
    }

    private async Task RememberPackageAsync(string packageRef)
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", EditingRefKey, packageRef);
        }
        catch
        {
            // Remembering is a convenience; failing to is not worth a message.
        }
    }

    private async Task ForgetRememberedPackageAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.removeItem", EditingRefKey);
        }
        catch
        {
        }
    }

    private async Task<string?> ReadRememberedPackageAsync()
    {
        try
        {
            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", EditingRefKey);
            return string.IsNullOrWhiteSpace(stored) ? null : stored.Trim();
        }
        catch
        {
            // No memory is a fine state: the pin is the landing.
            return null;
        }
    }

    private string DraftKey => DraftKeyPrefix + content!.Ref;

    private string? diagramText;
    private bool diagramIncludesPending;
    private bool isDiagramRefreshing;

    private bool HasManifestEdits => bindingEdits.Count > 0 || nodeEdits.Count > 0
        || addedNodes.Count > 0 || removedNodeIds.Count > 0
        || aggregateEdits.Count > 0 || resultEdit != null || addedPrompts.Count > 0
        || VariableAddCount > 0 || VariableRemovalCount > 0
        || inputsEdit != null || resultsEdit != null;

    private void Select(string key)
    {
        selectedKey = key;

        if (key == GraphKey && diagramText == null)
        {
            _ = LoadDiagramAsync();
        }
    }

    private async Task LoadDiagramAsync()
    {
        diagramText = await WorkflowService.GetCurrentDiagramAsync(editingRef);
        diagramIncludesPending = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshDiagramAsync()
    {
        if (isDiagramRefreshing)
        {
            return;
        }

        isDiagramRefreshing = true;

        try
        {
            if (HasManifestEdits)
            {
                var diagram = await WorkflowService.GetDiagramForManifestAsync(ComposeManifest());

                if (diagram != null)
                {
                    var (changed, removedEdges, pendingNodes) = CollectDiagramChanges();
                    diagramText = DecoratePendingDiagram(diagram, changed, removedEdges, pendingNodes, removedNodeIds.ToList());
                    diagramIncludesPending = true;
                }
            }
            else
            {
                diagramText = await WorkflowService.GetCurrentDiagramAsync(editingRef);
                diagramIncludesPending = false;
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        finally
        {
            isDiagramRefreshing = false;
        }
    }

    // The pending diff over the effective diagram: changed pairs draw their
    // edges blue, removed/old edges are re-appended dashed red (they are
    // absent from the effective manifest by definition), and changed nodes
    // keep the blue outline. All presentation, all client-side.
    private (List<(string NodeId, string Variable)> Changed,
             List<(string From, string NodeId, string Variable, bool Rebound)> Removed,
             List<string> PendingNodeIds) CollectDiagramChanges()
    {
        var changed = new List<(string, string)>();
        var removed = new List<(string, string, string, bool)>();
        var pendingNodes = new List<string>();

        foreach (var node in nodes)
        {
            var rows = RowsFor(node);

            if (rows.Any(RowModified))
            {
                pendingNodes.Add(node.Id);
            }

            foreach (var row in rows.Where(RowModified))
            {
                changed.Add((node.Id, row.Variable));

                // A rebound row's old source is an edge that goes away.
                if (!row.IsNew && row.OriginalFrom is { } oldFrom && oldFrom != row.From && IsEdgeSource(oldFrom))
                {
                    removed.Add((oldFrom, node.Id, row.Variable, true));
                }
            }

            // Removed variables' original edges.
            if (node.Prompt != null && variableRemovals.TryGetValue(node.Prompt, out var removedVars))
            {
                foreach (var variable in removedVars)
                {
                    var original = node.Bindings.FirstOrDefault(b => b.Variable == variable);

                    if (original != null && IsEdgeSource(original.From))
                    {
                        removed.Add((original.From, node.Id, variable, false));
                    }
                }
            }
        }

        // Field-edited, aggregate-edited, and freshly added nodes (#117) keep
        // the blue outline; so does a pending deliverable's new target.
        var blueIds = nodeEdits.Keys
            .Concat(aggregateEdits.Keys)
            .Concat(addedNodes.Select(a => a.Id));

        if (resultEdit != null && resultEdit.StartsWith("node:", StringComparison.Ordinal))
        {
            blueIds = blueIds.Append(resultEdit["node:".Length..]);
        }

        foreach (var nodeId in blueIds.Where(id => !pendingNodes.Contains(id)))
        {
            pendingNodes.Add(nodeId);
        }

        // Sources dropped from an aggregate list are edges that go away.
        foreach (var (aggregatorId, sources) in aggregateEdits)
        {
            var original = nodes.FirstOrDefault(n => n.Id == aggregatorId)?.Aggregate ?? Array.Empty<string>();

            foreach (var droppedSource in original.Where(s => !sources.Contains(s)))
            {
                removed.Add((droppedSource, aggregatorId, "aggregate", false));
            }
        }

        // A removed node's own bindings are edges that go away with it.
        foreach (var removedNode in RemovedNodes)
        {
            foreach (var binding in removedNode.Bindings.Where(b => IsEdgeSource(b.From)))
            {
                removed.Add((binding.From, removedNode.Id, binding.Variable, false));
            }
        }

        return (changed, removed, pendingNodes);
    }

    // item:* sources render inside node labels, not as edges.
    private static bool IsEdgeSource(string from) =>
        from.StartsWith("node:", StringComparison.Ordinal)
        || from.StartsWith("input:", StringComparison.Ordinal)
        || from.StartsWith("data:", StringComparison.Ordinal);

    private static string DecoratePendingDiagram(
        string diagram,
        IReadOnlyList<(string NodeId, string Variable)> changed,
        IReadOnlyList<(string From, string NodeId, string Variable, bool Rebound)> removed,
        IReadOnlyList<string> pendingNodeIds,
        IReadOnlyList<string>? removedNodes = null)
    {
        var sb = new System.Text.StringBuilder(diagram);

        if (!diagram.EndsWith('\n'))
        {
            sb.Append('\n');
        }

        // Mermaid styles edges by document-order index: walk the generator's
        // link lines ({source} -->|"{label}"| {target}), matching changed
        // pairs; a parse miss just skips the edge (node outline still shows).
        var blueIndices = new List<int>();
        var linkIndex = 0;

        foreach (var line in diagram.Split('\n'))
        {
            if (!line.Contains("-->", StringComparison.Ordinal))
            {
                continue;
            }

            var labelStart = line.IndexOf("|\"", StringComparison.Ordinal);
            var labelEnd = labelStart < 0 ? -1 : line.IndexOf("\"|", labelStart + 2, StringComparison.Ordinal);

            if (labelEnd > labelStart)
            {
                var label = line[(labelStart + 2)..labelEnd];
                var target = line[(labelEnd + 2)..].Trim();

                foreach (var (nodeId, variable) in changed)
                {
                    if (target == SanitizeMermaidId(nodeId)
                        && (label == variable || label.StartsWith(variable + " (as ", StringComparison.Ordinal)))
                    {
                        blueIndices.Add(linkIndex);
                        break;
                    }
                }
            }

            linkIndex++;
        }

        // Removed/old edges are appended dashed; their indices continue the
        // link count. A source only those edges reference is absent from the
        // effective text — the appended edge re-creates it, marked red.
        var redIndices = new List<int>();
        var redNodeIds = new List<string>();

        foreach (var (from, nodeId, variable, rebound) in removed)
        {
            var sourceRaw = from.StartsWith("node:", StringComparison.Ordinal) ? from["node:".Length..] : from;
            var sourceId = SanitizeMermaidId(sourceRaw);
            var suffix = rebound ? "(was)" : "(removed)";

            sb.Append($"    {sourceId} -. \"{variable} {suffix}\" .-> {SanitizeMermaidId(nodeId)}\n");
            redIndices.Add(linkIndex++);

            if (!diagram.Contains(sourceId + "(", StringComparison.Ordinal)
                && !diagram.Contains(sourceId + "[", StringComparison.Ordinal)
                && !redNodeIds.Contains(sourceId))
            {
                redNodeIds.Add(sourceId);
            }
        }

        // Whole removed nodes (#117): red whether their box survives in the
        // effective text (a dependent still binds them) or only exists through
        // the appended dashed edges.
        foreach (var removedNodeId in removedNodes ?? Array.Empty<string>())
        {
            var sanitized = SanitizeMermaidId(removedNodeId);

            if (!redNodeIds.Contains(sanitized))
            {
                redNodeIds.Add(sanitized);
            }
        }

        if (pendingNodeIds.Count > 0)
        {
            sb.Append("    classDef pending stroke:#0067b8,stroke-width:2.5px\n");
            sb.Append($"    class {string.Join(",", pendingNodeIds.Select(SanitizeMermaidId))} pending\n");
        }

        if (redNodeIds.Count > 0)
        {
            sb.Append("    classDef removed stroke:#a4262c,color:#a4262c\n");
            sb.Append($"    class {string.Join(",", redNodeIds)} removed\n");
        }

        foreach (var index in blueIndices)
        {
            sb.Append($"    linkStyle {index} stroke:#0067b8,stroke-width:2px\n");
        }

        foreach (var index in redIndices)
        {
            sb.Append($"    linkStyle {index} stroke:#a4262c,stroke-width:2px\n");
        }

        return sb.ToString();
    }

    private static string SanitizeMermaidId(string raw)
        => new(raw.Select(c => char.IsLetterOrDigit(c) ? c : '_').ToArray());

    private WorkflowManifestReader.DataItemView? SelectedStandard() =>
        collections.SelectMany(c => c.Items).FirstOrDefault(item => item.File == selectedKey);

    private WorkflowManifestReader.PromptView? SelectedPrompt() =>
        EffectivePrompts.FirstOrDefault(prompt => prompt.File == selectedKey);

    private string GetText(string path) =>
        AddedNodeForPromptFile(path) is { } addedNode ? addedNode.PromptText
        : AddedPromptForFile(path) is { } addedPrompt ? addedPrompt.Text
        : AddedScalarIdForPath(path) is { } pendingScalar ? addedScalars[pendingScalar]
        : edits.TryGetValue(path, out var edited) ? edited : content!.Files.GetValueOrDefault(path, string.Empty);

    /// <summary>The pending value at this path, or null — a published one has a real file.</summary>
    private string? AddedScalarIdForPath(string path) =>
        addedScalars.Keys.FirstOrDefault(id => ScalarPath(id) == path);

    private async Task LoadAsync()
    {
        isLoading = true;
        loadError = null;
        selectionNotice = null;
        ClearPending();
        ResetFormScratch();

        // The diagram belongs to the loaded version: drop it so package
        // switches and post-publish reloads never show a stale graph.
        diagramText = null;
        diagramIncludesPending = false;

        try
        {
            pinnedRef = await ReadPinAsync();
            mine = await WorkflowService.GetMyPackagesAsync();
            newPackageOpen = false;
            newPackageSlug = string.Empty;

            try
            {
                content = await WorkflowService.GetCurrentPackageContentAsync(editingRef);
            }
            catch (Exception ex) when (editingRef != null && ex is not AccessTokenNotAvailableException)
            {
                // A remembered package that no longer resolves — pruned, or a
                // pin that moved out from under it. Fall back to what IS
                // loadable rather than leaving a dead editor, and say why.
                selectionNotice = $"Could not open {editingRef}: {ex.Message} Showing the pinned package instead.";
                editingRef = null;
                await ForgetRememberedPackageAsync();
                content = await WorkflowService.GetCurrentPackageContentAsync();
            }

            prompts = WorkflowManifestReader.ReadPrompts(content.Manifest);
            nodes = WorkflowManifestReader.ReadNodes(content.Manifest);
            collections = WorkflowManifestReader.ReadCollections(content.Manifest, content.Files);
            scalarEntries = WorkflowManifestReader.ReadScalarEntries(content.Manifest);
            publishedScalarIds = scalarEntries.Select(entry => entry.Id).ToList();
            schemaIds = WorkflowManifestReader.ReadSchemaIds(content.Manifest);
            await RestoreDraftAsync();

            // Keep the selection when the pane still exists; otherwise open on
            // Graph — the overview, and the right landing for a cold load or a
            // package switch.
            if (selectedKey == null || !PaneStillExists(selectedKey))
            {
                selectedKey = GraphKey;
            }

            if (selectedKey == GraphKey)
            {
                _ = LoadDiagramAsync();
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            content = null;
            loadError = $"Unable to load the workflow package: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private sealed record DraftAdded(string Collection, string Id, string Name, string Content);

    private sealed record DraftBinding(string NodeId, string Variable, string From, string? As);

    private sealed record DraftNodeEdit(string NodeId, string Label, string? ForEach, string? OutputSchema, string? FailIfEmpty, string? Prompt = null);

    private sealed record DraftAddedNode(string Id, string Label, string? ForEach, string? OutputSchema, string? FailIfEmpty, string PromptText, List<string>? Aggregate = null, string? PromptRef = null);

    private sealed record DraftAddedPrompt(string Id, string Text);

    private sealed record DraftPayload(
        int Version,
        Dictionary<string, string>? Edits,
        List<DraftAdded>? Added,
        List<string>? Removed,
        List<DraftBinding>? Bindings = null,
        Dictionary<string, List<string>>? VariableAdds = null,
        Dictionary<string, List<string>>? VariableRemovals = null,
        List<string>? AddedCollections = null,
        List<DraftNodeEdit>? NodeEdits = null,
        List<DraftAddedNode>? AddedNodes = null,
        List<string>? RemovedNodes = null,
        Dictionary<string, List<string>>? AggregateEdits = null,
        string? ResultEdit = null,
        List<DraftAddedPrompt>? AddedPrompts = null,
        // v7 declarations (#218). Trailing optionals, so a draft written
        // before them still restores — nothing gates on Version.
        List<DraftInput>? Inputs = null,
        List<DraftResult>? Results = null,
        // Pending single-value data entries (#309), same trailing-optional
        // discipline: a draft written before this restores with it null.
        Dictionary<string, string>? AddedScalars = null,
        // #347: a pending specVersion migration. Trailing optional for the same
        // reason — a draft written before it restores with no bump pending.
        int? SpecVersionBump = null,
        // #432: the title and description as edited; "" is a clearing.
        string? Title = null,
        string? Description = null,
        // #453: the tags as edited; an empty list is the stated empty set.
        List<string>? Tags = null);

    // #316: Type and Values ride here or a typed input is silently untyped on
    // reload. Trailing optionals — a draft written before v8 restores with null.
    private sealed record DraftInput(
        string Id, string Label, bool Required, string? Type = null, List<string>? Values = null,
        // v9 (#429): the structure rides too, or a reload strips it. v10
        // (#498): the element's depth rides beside the type name — a draft
        // written before carries Items alone and restores as a bare element.
        string? Items = null, List<DraftField>? Fields = null,
        DraftElement? Element = null);

    private sealed record DraftField(
        string Id, string Label, bool Required, string? Type = null, List<string>? Values = null,
        DraftElement? Element = null, List<DraftField>? Fields = null);

    /// <summary>v10 (#498): an element's own structure, when it has any.</summary>
    private sealed record DraftElement(string Type, DraftElement? Items = null, List<DraftField>? Fields = null, List<string>? Values = null);

    private static DraftElement? ToDraft(WorkflowManifestReader.ElementView? element) =>
        element is null ? null : new DraftElement(element.Type, ToDraft(element.Items), ToDraft(element.Fields), element.Values?.ToList());

    private static List<DraftField>? ToDraft(IReadOnlyList<WorkflowManifestReader.FieldView>? fields) =>
        fields?.Select(f => new DraftField(f.Id, f.Label, f.Required, f.Type, f.Values?.ToList(), ToDraft(f.Items), ToDraft(f.Fields))).ToList();

    private static WorkflowManifestReader.ElementView? FromDraft(DraftElement? element, string? typeName = null) =>
        element is null
            ? typeName is null ? null : new WorkflowManifestReader.ElementView(typeName)
            : new WorkflowManifestReader.ElementView(element.Type, FromDraft(element.Items), FromDraft(element.Fields), element.Values);

    private static List<WorkflowManifestReader.FieldView>? FromDraft(List<DraftField>? fields) =>
        fields?.Select(f => new WorkflowManifestReader.FieldView(f.Id, f.Label, f.Required, f.Type, f.Values, FromDraft(f.Element), FromDraft(f.Fields))).ToList();

    private sealed record DraftResult(string Id, string Node, string Label, string? When = null);

    private async Task RestoreDraftAsync()
    {
        var stored = await JS.InvokeAsync<string?>("localStorage.getItem", DraftKey);

        if (string.IsNullOrWhiteSpace(stored))
        {
            return;
        }

        Dictionary<string, string>? textEdits = null;
        List<DraftAdded>? added = null;
        List<string>? removed = null;
        List<DraftBinding>? bindings = null;
        Dictionary<string, List<string>>? draftVariableAdds = null;
        Dictionary<string, List<string>>? draftVariableRemovals = null;
        List<string>? draftAddedCollections = null;
        List<DraftNodeEdit>? draftNodeEdits = null;
        List<DraftAddedNode>? draftAddedNodes = null;
        List<string>? draftRemovedNodes = null;
        Dictionary<string, List<string>>? draftAggregateEdits = null;
        string? draftResultEdit = null;
        List<DraftAddedPrompt>? draftAddedPrompts = null;
        int? draftSpecVersionBump = null;
        string? draftTitle = null;
        string? draftDescription = null;
        List<string>? draftTags = null;
        List<DraftInput>? draftInputs = null;
        List<DraftResult>? draftResults = null;
        Dictionary<string, string>? draftAddedScalars = null;

        try
        {
            // Versioned draft (#115) first; legacy plain-dictionary drafts fall through.
            if (stored.Contains("\"Version\"", StringComparison.OrdinalIgnoreCase) || stored.Contains("\"version\"", StringComparison.OrdinalIgnoreCase))
            {
                var payload = JsonSerializer.Deserialize<DraftPayload>(stored);
                textEdits = payload?.Edits;
                added = payload?.Added;
                removed = payload?.Removed;
                bindings = payload?.Bindings;
                draftVariableAdds = payload?.VariableAdds;
                draftVariableRemovals = payload?.VariableRemovals;
                draftAddedCollections = payload?.AddedCollections;
                draftNodeEdits = payload?.NodeEdits;
                draftAddedNodes = payload?.AddedNodes;
                draftRemovedNodes = payload?.RemovedNodes;
                draftAggregateEdits = payload?.AggregateEdits;
                draftResultEdit = payload?.ResultEdit;
                draftAddedPrompts = payload?.AddedPrompts;
                draftInputs = payload?.Inputs;
                draftResults = payload?.Results;
                draftAddedScalars = payload?.AddedScalars;
                draftSpecVersionBump = payload?.SpecVersionBump;
                draftTitle = payload?.Title;
                draftDescription = payload?.Description;
                draftTags = payload?.Tags;
            }
            else
            {
                textEdits = JsonSerializer.Deserialize<Dictionary<string, string>>(stored);
            }
        }
        catch (JsonException)
        {
            return;
        }

        foreach (var (path, text) in textEdits ?? new Dictionary<string, string>())
        {
            // Drop entries that no longer differ (or no longer exist) in the
            // loaded package version.
            if (content!.Files.TryGetValue(path, out var original) && !string.Equals(original, text, StringComparison.Ordinal))
            {
                edits[path] = text;
            }
        }

        // Folders before items: an item in a pending folder is only kept when
        // its folder was restored. A folder whose id now exists in the loaded
        // package (published elsewhere) is dropped.
        foreach (var folderId in draftAddedCollections ?? new List<string>())
        {
            if (CollectionIdPattern.IsMatch(folderId)
                && collections.All(c => c.Id != folderId)
                && !publishedScalarIds.Contains(folderId, StringComparer.Ordinal)
                && !addedCollections.Contains(folderId))
            {
                addedCollections.Add(folderId);
            }
        }

        // Values get the same treatment as folders: a pending one whose id now
        // exists in the loaded package — published elsewhere, or colliding
        // with a collection — is dropped rather than restored into a conflict.
        foreach (var (scalarId, text) in draftAddedScalars ?? new Dictionary<string, string>())
        {
            if (ItemIdPattern.IsMatch(scalarId)
                && !publishedScalarIds.Contains(scalarId, StringComparer.Ordinal)
                && collections.All(c => c.Id != scalarId)
                && !addedCollections.Contains(scalarId)
                && !addedScalars.ContainsKey(scalarId))
            {
                addedScalars[scalarId] = text;
            }
        }

        var loadedIds = collections.SelectMany(c => c.Items.Select(i => (c.Id, i.Id))).ToHashSet();
        var validCollections = collections.Select(c => c.Id).Concat(addedCollections).ToHashSet(StringComparer.Ordinal);

        foreach (var draftItem in added ?? new List<DraftAdded>())
        {
            if (!string.IsNullOrWhiteSpace(draftItem.Id)
                && validCollections.Contains(draftItem.Collection)
                && !loadedIds.Contains((draftItem.Collection, draftItem.Id)))
            {
                addedItems.Add(new AddedItem { Collection = draftItem.Collection, Id = draftItem.Id, Name = draftItem.Name, Content = draftItem.Content });
            }
        }

        foreach (var path in removed ?? new List<string>())
        {
            if (content!.Files.ContainsKey(path))
            {
                removedFiles.Add(path);
            }
        }

        // Variables before bindings: an added-variable binding is only kept
        // when its declaration was restored.
        foreach (var (promptId, addNames) in draftVariableAdds ?? new Dictionary<string, List<string>>())
        {
            foreach (var addName in addNames ?? new List<string>())
            {
                // TryDeclareVariable revalidates (prompt existence, name shape,
                // uniqueness against the loaded version).
                TryDeclareVariable(promptId, addName, out _);
            }
        }

        foreach (var (promptId, removedNames) in draftVariableRemovals ?? new Dictionary<string, List<string>>())
        {
            var prompt = prompts.FirstOrDefault(p => p.Id == promptId);

            if (prompt == null)
            {
                continue;
            }

            foreach (var removedName in (removedNames ?? new List<string>()).Where(v => prompt.Variables.Contains(v, StringComparer.Ordinal)))
            {
                if (!variableRemovals.TryGetValue(promptId, out var set))
                {
                    variableRemovals[promptId] = set = new HashSet<string>(StringComparer.Ordinal);
                }

                set.Add(removedName);
            }
        }

        // Standalone prompts before nodes (a restored node may point at one),
        // nodes before variables and bindings. Anything whose id now exists in
        // the loaded package is dropped.
        foreach (var draftAddedPrompt in draftAddedPrompts ?? new List<DraftAddedPrompt>())
        {
            if (!string.IsNullOrWhiteSpace(draftAddedPrompt.Id)
                && prompts.All(p => p.Id != draftAddedPrompt.Id)
                && nodes.All(n => n.Id != draftAddedPrompt.Id)
                && addedPrompts.All(p => p.Id != draftAddedPrompt.Id))
            {
                addedPrompts.Add(new AddedPrompt { Id = draftAddedPrompt.Id, Text = draftAddedPrompt.Text });
            }
        }

        foreach (var draftAddedNode in draftAddedNodes ?? new List<DraftAddedNode>())
        {
            if (!string.IsNullOrWhiteSpace(draftAddedNode.Id)
                && !string.IsNullOrWhiteSpace(draftAddedNode.Label)
                && nodes.All(n => n.Id != draftAddedNode.Id)
                && prompts.All(p => p.Id != draftAddedNode.Id)
                && addedNodes.All(a => a.Id != draftAddedNode.Id))
            {
                // A vanished PromptRef target falls back to a fresh prompt
                // named after the node.
                var promptRef = draftAddedNode.PromptRef != null
                    && (prompts.Any(p => p.Id == draftAddedNode.PromptRef) || addedPrompts.Any(p => p.Id == draftAddedNode.PromptRef))
                        ? draftAddedNode.PromptRef
                        : null;

                addedNodes.Add(new AddedNode
                {
                    Id = draftAddedNode.Id,
                    Label = draftAddedNode.Label,
                    ForEach = draftAddedNode.ForEach,
                    OutputSchema = draftAddedNode.OutputSchema,
                    FailIfEmpty = draftAddedNode.FailIfEmpty,
                    PromptText = draftAddedNode.PromptText,
                    Aggregate = draftAddedNode.Aggregate,
                    PromptRef = promptRef
                });
            }
        }

        foreach (var removedNodeId in draftRemovedNodes ?? new List<string>())
        {
            if (nodes.Any(n => n.Id == removedNodeId && !n.IsResult))
            {
                removedNodeIds.Add(removedNodeId);
            }
        }

        // Aggregate-list edits: kept when the aggregator still exists and the
        // list still differs; the deliverable selection when it still differs
        // and its target still exists.
        foreach (var (aggregatorId, sources) in draftAggregateEdits ?? new Dictionary<string, List<string>>())
        {
            var original = nodes.FirstOrDefault(n => n.Id == aggregatorId)?.Aggregate;

            if (original != null && sources is { Count: > 0 }
                && !original.SequenceEqual(sources, StringComparer.Ordinal))
            {
                aggregateEdits[aggregatorId] = sources;
            }
        }

        if (draftResultEdit != null
            && draftResultEdit != WorkflowManifestReader.ReadResultRef(content!.Manifest)
            && draftResultEdit.StartsWith("node:", StringComparison.Ordinal)
            && EffectiveNodes.Any(n => n.Id == draftResultEdit["node:".Length..]))
        {
            resultEdit = draftResultEdit;
        }

        // Declared sections: only meaningful against a v7 package, so a draft
        // written before the pin moved to a v5/v6 package is dropped rather
        // than composed into a manifest that cannot hold it.
        // #347: restore only a bump that is still upward for the package now
        // loaded. A draft written against a v7 fork must not re-apply after the
        // fork has already moved on.
        // The other loaded-version site, and it could not be anything else:
        // this asks whether a drafted bump is still upward for the package now
        // loaded. Comparing against the effective version would compare the
        // bump with itself.
        if (draftSpecVersionBump is { } bump && content != null && bump > LoadedSpecVersion && bump <= NewestSpecVersion)
        {
            specVersionBump = bump;
        }

        // #432: restored whatever the version — a title on a package below 9
        // is refused by name at the desk, the #429 posture, rather than dropped.
        if (draftTitle is { } restoredTitle && restoredTitle != (LoadedTitle ?? string.Empty))
        {
            titleEdit = restoredTitle;
        }

        if (draftDescription is { } restoredDescription && restoredDescription != (LoadedDescription ?? string.Empty))
        {
            descriptionEdit = restoredDescription;
        }

        // #453: same posture — restored whatever the version.
        if (draftTags is { } restoredTags && !restoredTags.SequenceEqual(LoadedTags, StringComparer.Ordinal))
        {
            tagsEdit = restoredTags;
        }

        if (IsV7 && draftInputs is { Count: > 0 })
        {
            inputsEdit = draftInputs
                .Select(input => new WorkflowManifestReader.InputView(
                    input.Id, input.Label, input.Required, input.Type, input.Values,
                    FromDraft(input.Element, input.Items),
                    FromDraft(input.Fields)))
                .ToList();
        }

        if (IsV7 && draftResults is { Count: > 0 }
            && draftResults.All(result => EffectiveNodes.Any(node => $"node:{node.Id}" == result.Node)))
        {
            resultsEdit = draftResults
                .Select(result => new WorkflowManifestReader.ResultView(result.Id, result.Node, result.Label, result.When))
                .ToList();
        }

        // Node-field edits: kept only when the node still exists and the
        // tuple still differs from the loaded version.
        foreach (var draftNodeEdit in draftNodeEdits ?? new List<DraftNodeEdit>())
        {
            var original = nodes.FirstOrDefault(n => n.Id == draftNodeEdit.NodeId);

            if (original == null
                || string.IsNullOrWhiteSpace(draftNodeEdit.Label)
                || (draftNodeEdit.Label == original.Label
                    && draftNodeEdit.ForEach == original.ForEach
                    && draftNodeEdit.OutputSchema == original.OutputSchema
                    && draftNodeEdit.FailIfEmpty == original.FailIfEmpty
                    && (draftNodeEdit.Prompt == null || draftNodeEdit.Prompt == original.Prompt)))
            {
                continue;
            }

            nodeEdits[draftNodeEdit.NodeId] = new WorkflowNodeSummary.NodeChange(
                draftNodeEdit.NodeId, draftNodeEdit.Label, draftNodeEdit.ForEach, draftNodeEdit.OutputSchema, draftNodeEdit.FailIfEmpty, draftNodeEdit.Prompt);
        }

        foreach (var draftBinding in bindings ?? new List<DraftBinding>())
        {
            // Keep rebinds whose node/variable still exists and still differs —
            // or which bind a restored added variable (no original to differ
            // from; effective nodes cover restored pending nodes too).
            var node = EffectiveNodes.FirstOrDefault(n => n.Id == draftBinding.NodeId);
            var original = node?.Bindings.FirstOrDefault(b => b.Variable == draftBinding.Variable);

            if (original != null && (original.From != draftBinding.From || original.As != draftBinding.As))
            {
                bindingEdits[BindingKey(draftBinding.NodeId, draftBinding.Variable)] = (draftBinding.From, draftBinding.As);
            }
            else if (original == null
                && node != null
                && AddedVariables(node.Prompt).Contains(draftBinding.Variable, StringComparer.Ordinal))
            {
                bindingEdits[BindingKey(draftBinding.NodeId, draftBinding.Variable)] = (draftBinding.From, draftBinding.As);
            }
        }
    }

    /// <summary>
    /// Every edit ends here, so this is where "the pending state changed"
    /// belongs: the draft is saved, and the banner describing a *previous*
    /// publish stops standing over work it does not describe (#326). Twenty-two
    /// handlers used to repeat those two lines, and the twenty-third could
    /// forget them.
    ///
    /// Publish errors are deliberately not cleared here — they name what to
    /// fix, and fixing it is an edit.
    /// </summary>
    private async Task PendingChangedAsync()
    {
        publishSuccess = null;
        publishWarnings.Clear();

        if (PendingCount == 0)
        {
            await JS.InvokeVoidAsync("localStorage.removeItem", DraftKey);
            return;
        }

        var payload = new DraftPayload(
            13,
            edits,
            addedItems.Select(a => new DraftAdded(a.Collection, a.Id, a.Name, a.Content)).ToList(),
            removedFiles.ToList(),
            bindingEdits.Select(pair =>
            {
                var parts = pair.Key.Split('\n', 2);
                return new DraftBinding(parts[0], parts[1], pair.Value.From, pair.Value.As);
            }).ToList(),
            variableAdds.ToDictionary(pair => pair.Key, pair => pair.Value.ToList()),
            variableRemovals.ToDictionary(pair => pair.Key, pair => pair.Value.ToList()),
            addedCollections.ToList(),
            nodeEdits.Values.Select(edit => new DraftNodeEdit(edit.NodeId, edit.Label, edit.ForEach, edit.OutputSchema, edit.FailIfEmpty, edit.Prompt)).ToList(),
            addedNodes.Select(a => new DraftAddedNode(a.Id, a.Label, a.ForEach, a.OutputSchema, a.FailIfEmpty, a.PromptText, a.Aggregate, a.PromptRef)).ToList(),
            removedNodeIds.ToList(),
            aggregateEdits.ToDictionary(pair => pair.Key, pair => pair.Value.ToList()),
            resultEdit,
            addedPrompts.Select(p => new DraftAddedPrompt(p.Id, p.Text)).ToList(),
            inputsEdit?.Select(i => new DraftInput(
                i.Id, i.Label, i.Required, i.Type, i.Values?.ToList(),
                i.Items?.Type,
                ToDraft(i.Fields),
                i.Items is { IsBare: false } ? ToDraft(i.Items) : null)).ToList(),
            resultsEdit?.Select(r => new DraftResult(r.Id, r.Node, r.Label, r.When)).ToList(),
            new Dictionary<string, string>(addedScalars, StringComparer.Ordinal),
            specVersionBump,
            titleEdit,
            descriptionEdit,
            tagsEdit);
        await JS.InvokeVoidAsync("localStorage.setItem", DraftKey, JsonSerializer.Serialize(payload));
    }

    private async Task OnTextChangedAsync(string path, string value)
    {

        // A pending node's or standalone pending prompt's text lives on its
        // draft object, not in edits.
        if (AddedNodeForPromptFile(path) is { } addedNode)
        {
            addedNode.PromptText = value;
            await PendingChangedAsync();
            return;
        }

        if (AddedPromptForFile(path) is { } addedPrompt)
        {
            addedPrompt.Text = value;
            await PendingChangedAsync();
            return;
        }

        // A pending value's text lives on its draft entry for the same reason:
        // there is no published file for it to differ from yet.
        if (AddedScalarIdForPath(path) is { } pendingScalar)
        {
            addedScalars[pendingScalar] = value;
            await PendingChangedAsync();
            return;
        }

        if (content!.Files.TryGetValue(path, out var original) && string.Equals(original, value, StringComparison.Ordinal))
        {
            edits.Remove(path);
        }
        else
        {
            edits[path] = value;
        }

        await PendingChangedAsync();
    }

    private bool CollectionHasMembershipChanges(WorkflowManifestReader.CollectionView collection) =>
        collection.Items.Any(item => removedFiles.Contains(item.File))
        || addedItems.Any(a => a.Collection == collection.Id);

    private string ComposeIndexJson(WorkflowManifestReader.CollectionView collection)
    {
        // Preserve the loaded field list (new folders have none — the default
        // applies); existing items keep their order, removals drop, additions
        // append.
        var fields = new List<string> { "id", "name", "content" };
        if (content!.Files.TryGetValue(collection.Directory + "index.json", out var loadedIndexJson))
        {
            try
            {
                using var loadedIndex = System.Text.Json.JsonDocument.Parse(loadedIndexJson);
                if (loadedIndex.RootElement.TryGetProperty("fields", out var f) && f.ValueKind == JsonValueKind.Array)
                {
                    fields = f.EnumerateArray().Select(v => v.GetString() ?? string.Empty).ToList();
                }
            }
            catch (JsonException)
            {
            }
        }

        var items = collection.Items
            .Where(item => !removedFiles.Contains(item.File))
            .Select(item => new { id = item.Id, name = item.Name, file = item.File[collection.Directory.Length..] })
            .Concat(addedItems
                .Where(a => a.Collection == collection.Id)
                .Select(a => new { id = a.Id, name = a.Name, file = $"{a.Id}.md" }))
            .ToList();

        return JsonSerializer.Serialize(new { fields, items }, new JsonSerializerOptions { WriteIndented = true });
    }

    /// <summary>
    /// #447: target names one of my packages for a new version; newPackageSlug
    /// names a package I do not have; both null is my first package. The
    /// server applies the same rules and the fork-clears-metadata rule.
    /// </summary>
    private async Task PublishAsync(string? target, string? newPackageSlug)
    {
        if (content == null || PendingCount == 0 || isPublishing)
        {
            return;
        }

        isPublishing = true;
        ResetPublishFeedback();

        try
        {
            // Declared-but-unbound variables and empty new folders block publish
            // with a named message (explicit initialization; the validator would
            // reject both anyway — this is just the friendlier failure).
            var unbound = new List<string>();

            foreach (var folderId in addedCollections)
            {
                if (!addedItems.Any(a => a.Collection == folderId))
                {
                    unbound.Add($"Data folder '{folderId}' has no items yet — add at least one before publishing.");
                }
            }

            // An empty value is different from an empty folder, and worse
            // (#323). The validator rejects a folder with no index; a scalar
            // may be any string, "" included, so nothing downstream objects —
            // this is the only check standing between an author and a value
            // that renders as nothing mid-sentence.
            //
            // Blocked rather than defaulted: a plausible guess is exactly what
            // must not be substituted for a choice the author has not made.
            // Whitespace counts as empty for the same reason it counts in the
            // rendered prompt.
            // Scoped to what this author did: a value they added, or one they
            // edited to empty. A pre-existing empty value they never touched
            // does not block unrelated work — being unable to publish a prompt
            // fix because a package you forked carries a bad value would be a
            // worse trap than the one this closes.
            foreach (var scalar in EffectiveScalars)
            {
                var authored = addedScalars.ContainsKey(scalar.Id) || edits.ContainsKey(scalar.Path);

                if (authored && string.IsNullOrWhiteSpace(GetText(scalar.Path)))
                {
                    unbound.Add($"Data value '{scalar.Id}' has no text yet — enter a value before publishing.");
                }
            }

            foreach (var addedNode in addedNodes)
            {
                if (addedNode.Aggregate != null)
                {
                    if (addedNode.Aggregate.Count == 0)
                    {
                        unbound.Add($"Aggregator '{addedNode.Id}' has no sources yet — add at least one on its card.");
                    }
                }
                else if (addedNode.PromptRef == null && string.IsNullOrWhiteSpace(addedNode.PromptText))
                {
                    unbound.Add($"Node '{addedNode.Id}' has no prompt text yet — write it under Prompts.");
                }
            }

            // Standalone pending prompts: text required, and the orphan rule's
            // friendly face — some node must use them.
            foreach (var pending in addedPrompts)
            {
                if (string.IsNullOrWhiteSpace(pending.Text))
                {
                    unbound.Add($"Prompt '{pending.Id}' has no text yet — write it under Prompts.");
                }
                else if (!EffectiveNodes.Any(n => n.Prompt == pending.Id))
                {
                    unbound.Add($"Prompt '{pending.Id}' is not used by any node yet — point a node at it or remove it.");
                }
            }

            // Re-pointed nodes and nodes born onto an existing prompt: every
            // variable of that prompt needs an explicitly chosen source.
            foreach (var node in EffectiveNodes.Where(HasFreshBindings))
            {
                var freshPrompt = EffectivePrompts.FirstOrDefault(p => p.Id == node.Prompt);

                foreach (var variable in freshPrompt != null ? EffectiveVariables(freshPrompt) : Array.Empty<string>())
                {
                    if (string.IsNullOrEmpty(GetEffectiveBinding(node.Id, variable)?.From))
                    {
                        unbound.Add($"Variable '{variable}' on node '{node.Id}' needs a source — set it in Graph.");
                    }
                }
            }

            foreach (var prompt in EffectivePrompts)
            {
                foreach (var variable in AddedVariables(prompt.Id))
                {
                    foreach (var node in NodesUsingPrompt(prompt.Id))
                    {
                        if (string.IsNullOrEmpty(GetEffectiveBinding(node.Id, variable)?.From))
                        {
                            unbound.Add($"Variable '{variable}' on node '{node.Id}' needs a source — set it in Graph.");
                        }
                    }
                }
            }

            unbound.AddRange(DeclaredSectionErrors());
            unbound.AddRange(PackageMetadataErrors());

            if (unbound.Count > 0)
            {
                publishErrors = unbound;
                return;
            }

            var files = new Dictionary<string, string>(content.Files, StringComparer.Ordinal);
            foreach (var (path, text) in edits)
            {
                files[path] = text;
            }

            foreach (var path in removedFiles)
            {
                files.Remove(path);
            }

            foreach (var added in addedItems)
            {
                files[AddedPath(added)] = added.Content;
            }

            // A pending value is one file at its derived path. Edits to a
            // published one already arrived through `edits` above.
            foreach (var (scalarId, text) in addedScalars)
            {
                files[ScalarPath(scalarId)] = text;
            }

            // Pending fresh prompts and standalone pending prompts bring their
            // files; a removed node takes its prompt's file away only when no
            // other effective node still uses the prompt.
            foreach (var addedNode in addedNodes.Where(a => a.Aggregate == null && a.PromptRef == null))
            {
                files[AddedPromptFile(addedNode.Id)] = addedNode.PromptText;
            }

            foreach (var pending in addedPrompts)
            {
                files[AddedStandalonePromptFile(pending.Id)] = pending.Text;
            }

            foreach (var removedNodeId in removedNodeIds)
            {
                var promptId = nodes.FirstOrDefault(n => n.Id == removedNodeId)?.Prompt;
                var promptFile = promptId != null ? prompts.FirstOrDefault(p => p.Id == promptId)?.File : null;

                if (promptFile != null && !EffectiveNodes.Any(n => n.Prompt == promptId))
                {
                    files.Remove(promptFile);
                }
            }

            // Membership changed => the collection's index.json is recomposed
            // (new folders always compose theirs); the server validator remains
            // the authority on the result.
            foreach (var collection in EffectiveCollections)
            {
                if (CollectionHasMembershipChanges(collection) || addedCollections.Contains(collection.Id))
                {
                    files[collection.Directory + "index.json"] = ComposeIndexJson(collection);
                }
            }

            var composed = ComposeManifest();
            var outcome = await WorkflowService.PublishPackageAsync(
                new WorkflowPackagePublishRequest(content.Ref, composed, files, target, newPackageSlug));

            if (!outcome.Succeeded)
            {
                publishErrors = outcome.Errors.ToList();
                return;
            }

            await JS.InvokeVoidAsync("localStorage.removeItem", DraftKey);
            var publishedRef = outcome.Response!.Ref;
            // Captured before LoadAsync resets content: what this was built FROM
            // is the part a reader cannot reconstruct afterwards, and it is the
            // whole story when the source was not their own package (#411).
            var sourceRef = content.Ref;
            var sourceWasForeign = !EditingOwnPackage;
            var asNewPackage = newPackageSlug != null || sourceWasForeign;
            // The published version is the pin now (the server flipped it);
            // the editor follows it rather than reloading the source.
            editingRef = null;
            await ForgetRememberedPackageAsync();
            // Warnings arrive with a *successful* publish and the version is
            // immutable, so this is the only moment they can be read. Held
            // across LoadAsync, which resets the rest of the page state.
            var warnings = outcome.Response.Warnings ?? new List<string>();
            // #432: the title the publish carried — none on a fork, which the
            // server clears; quoted so the success names what was just named.
            var publishedTitle = asNewPackage ? null : WorkflowManifestReader.ReadTitle(composed);
            var named = string.IsNullOrEmpty(publishedTitle) ? string.Empty : $" (\"{publishedTitle}\")";
            // #429/#492: read before LoadAsync clears the bump.
            var notYetRunnable = NotYetRunnable;
            await LoadAsync();
            publishSuccess = (asNewPackage
                ? $"Published {publishedRef}{named} as a new package from {sourceRef} and switched your consults to it."
                : $"Published {publishedRef}{named} and switched your consults to it.")
                + (notYetRunnable ? " It is not yet runnable." : string.Empty);
            publishWarnings = warnings;
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            publishErrors = new List<string> { $"Publish failed: {ex.Message}" };
        }
        finally
        {
            isPublishing = false;
        }
    }

    private async Task DiscardAsync()
    {
        if (content == null)
        {
            return;
        }

        ClearPending();
        ResetFormScratch();
        ResetPublishFeedback();

        // Nothing is pending now, and that branch of PendingChangedAsync is
        // exactly the localStorage.removeItem this used to call by hand.
        await PendingChangedAsync();
    }

    private void ClearPending()
    {
        foreach (var kind in PendingKinds)
        {
            kind.Clear();
        }
    }

    /// <summary>
    /// The half-typed contents of the "new item", "new folder", "new value",
    /// "new node", "new prompt" and "new variable" forms. Not pending state —
    /// none of it publishes — but it belongs to the version being left, so
    /// loading and discarding both drop it.
    ///
    /// Shared because the two had already drifted (#326): Load kept a
    /// half-typed item, and neither cleared the value form.
    /// </summary>
    private void ResetFormScratch()
    {
        declaredError = null;
        newPromptId = newPromptError = null;
        newVariableName = newVariableError = null;
        newVariableSource = string.Empty;
        newItemId = newItemName = newItemContent = newItemError = null;
        newCollectionId = newCollectionError = null;
        newScalarId = newScalarError = null;
        newNodeId = newNodeLabel = newNodeError = null;
        newNodeForEach = string.Empty;
        newNodeOutput = string.Empty;
        newNodeKind = "prompt";
        newFieldIds.Clear();
    }

    /// <summary>
    /// An operation is starting, so the previous one's outcome goes — errors
    /// included, unlike an ordinary edit, which leaves them standing while you
    /// fix what they name. Publish and Revert only; both set new feedback when
    /// they finish.
    /// </summary>
    private void ResetPublishFeedback()
    {
        publishErrors = new List<string>();
        publishSuccess = null;
        publishWarnings.Clear();
    }

    // The manifest rides opaque except for this one surgical write: pending
    // rebinds land in nodes[].bindings, everything else passes through. Casing
    // is tolerant like the reader's — the worker serializer may have written
    // PascalCase, and the server parses either. Binding dictionary keys
    // (variable names) are never re-cased by the serializer.
    /// <summary>
    /// v10 (#498): the v9 form is the type name, and the editor writes it
    /// whenever the element has nothing of its own — an array of objects or
    /// of enums keeps its fields or values on the input, so every v9 package
    /// composes the bytes it composed. Only an element that is itself an
    /// array (or carries structure) writes as a spec, recursively.
    /// </summary>
    private static System.Text.Json.Nodes.JsonNode WriteElement(WorkflowManifestReader.ElementView element)
    {
        if (element.IsBare)
        {
            return element.Type;
        }

        var node = new System.Text.Json.Nodes.JsonObject { ["type"] = element.Type };
        if (element.Items != null)
        {
            node["items"] = WriteElement(element.Items);
        }

        if (element.Fields is { Count: > 0 })
        {
            node["fields"] = WriteFields(element.Fields);
        }

        if (element.Values is { Count: > 0 })
        {
            node["values"] = new System.Text.Json.Nodes.JsonArray(element.Values.Select(v => (System.Text.Json.Nodes.JsonNode?)v).ToArray());
        }

        return node;
    }

    private static System.Text.Json.Nodes.JsonArray WriteFields(IReadOnlyList<WorkflowManifestReader.FieldView> fields) =>
        new(fields.Select(field =>
        {
            var fieldNode = new System.Text.Json.Nodes.JsonObject
            {
                ["id"] = field.Id,
                ["label"] = field.Label,
                ["required"] = field.Required
            };

            if (field.Type != null)
            {
                fieldNode["type"] = field.Type;
            }

            if (field.Values is { Count: > 0 })
            {
                fieldNode["values"] = new System.Text.Json.Nodes.JsonArray(field.Values.Select(v => (System.Text.Json.Nodes.JsonNode?)v).ToArray());
            }

            // v10 (#498): a field's own structure, to any depth.
            if (field.Items != null)
            {
                fieldNode["items"] = WriteElement(field.Items);
            }

            if (field.Fields is { Count: > 0 })
            {
                fieldNode["fields"] = WriteFields(field.Fields);
            }

            return (System.Text.Json.Nodes.JsonNode?)fieldNode;
        }).ToArray());

    private JsonElement ComposeManifest()
    {
        // Nothing structural pending: send the manifest through untouched.
        // This used to be a thirteen-term boolean that every new kind of
        // pending change had to be added to, and #309 shipped because one was
        // not — the value reached `files` and vanished from the document
        // describing them. Each kind now answers for itself (#326).
        if (!PendingKinds.Any(kind => kind.AffectsManifest()))
        {
            return content!.Manifest;
        }

        var root = System.Text.Json.Nodes.JsonNode.Parse(content!.Manifest.GetRawText())!;

        // #347: the editor's first write to specVersion. Before this it never
        // wrote the field at all, so a fork inherited its version from whatever
        // was pinned when it was forked and stayed there — the only way to a
        // newer format was repinning to somebody else's package, which starts
        // from THEIR content and breaks the fork's derivedFrom chain.
        //
        // Nothing else changes, which is what makes the migration provable:
        // package-format-v8.md's own migration is exactly this edit, and the
        // publisher validates the stamped manifest before writing anything, so
        // a bump that does not hold is refused whole.
        if (specVersionBump is { } bumped)
        {
            // Casing is tolerant like the reader's: the worker serializer may
            // have written PascalCase.
            root["specVersion"] = bumped;
            if (root["SpecVersion"] != null)
            {
                root["SpecVersion"] = bumped;
            }

            // #453: v9 requires tags, so the minimal v9 migration is TWO
            // edits — the version line and an empty tags array. Written only
            // when the manifest has no tags key in either casing: a package
            // that already states them keeps them.
            if (bumped >= 9 && root["tags"] is null && root["Tags"] is null)
            {
                root["tags"] = new System.Text.Json.Nodes.JsonArray();
            }
        }

        // #432: the title and description, written as edited.
        WriteMetadata(root, "title", titleEdit);
        WriteMetadata(root, "description", descriptionEdit);

        // #453: the tags, written as edited — always as an array, never removed:
        // the empty set is a value. Casing follows the key as read.
        if (tagsEdit is { } editedTags)
        {
            var tagsKey = root["Tags"] is not null ? "Tags" : "tags";
            root[tagsKey] = new System.Text.Json.Nodes.JsonArray(editedTags.Select(tag => (System.Text.Json.Nodes.JsonNode?)tag).ToArray());
        }

        // New folders (#154): one data-map entry per pending collection; the
        // directory value's trailing slash is what marks it as a collection.
        if (addedCollections.Count > 0 || addedScalars.Count > 0 || RemovedScalarIds.Any())
        {
            var dataKey = root["Data"] is not null ? "Data" : "data";
            if (root[dataKey] is not System.Text.Json.Nodes.JsonObject dataObject)
            {
                dataObject = new System.Text.Json.Nodes.JsonObject();
                root[dataKey] = dataObject;
            }

            foreach (var folderId in addedCollections)
            {
                dataObject[folderId] = $"data/{folderId}/";
            }

            // No trailing slash — that one character is the whole difference,
            // and getting it wrong here silently turns a value into a
            // collection the resolver then cannot find an index.json for.
            foreach (var scalarId in addedScalars.Keys)
            {
                dataObject[scalarId] = ScalarPath(scalarId);
            }

            // The other half of a deletion (#321). The file leaves through
            // removedFiles at publish; without this the data map keeps naming
            // it and the resolver fails on a package that looks fine here.
            // Casing follows the entry as read, not the key we would write.
            foreach (var scalarId in RemovedScalarIds)
            {
                dataObject.Remove(scalarId);
            }
        }

        // Variable declarations: each edited prompt's variables array becomes
        // the effective set (declared order minus removals, adds appended).
        if ((root["prompts"] ?? root["Prompts"]) is System.Text.Json.Nodes.JsonArray promptsArray)
        {
            foreach (var prompt in prompts)
            {
                if (!HasVariableEdits(prompt.Id))
                {
                    continue;
                }

                var promptObject = promptsArray
                    .OfType<System.Text.Json.Nodes.JsonObject>()
                    .FirstOrDefault(p => (p["id"] ?? p["Id"])?.GetValue<string>() == prompt.Id);

                if (promptObject == null)
                {
                    continue;
                }

                var variablesKey = promptObject.ContainsKey("Variables") ? "Variables" : "variables";
                promptObject[variablesKey] = new System.Text.Json.Nodes.JsonArray(
                    EffectiveVariables(prompt)
                        .Select(v => (System.Text.Json.Nodes.JsonNode?)System.Text.Json.Nodes.JsonValue.Create(v))
                        .ToArray());
            }
        }

        if ((root["nodes"] ?? root["Nodes"]) is not System.Text.Json.Nodes.JsonArray nodesArray)
        {
            return JsonSerializer.SerializeToElement(root);
        }

        System.Text.Json.Nodes.JsonObject? NodeFor(string nodeId) =>
            nodesArray
                .OfType<System.Text.Json.Nodes.JsonObject>()
                .FirstOrDefault(n => (n["id"] ?? n["Id"])?.GetValue<string>() == nodeId);

        System.Text.Json.Nodes.JsonObject? BindingsFor(string nodeId) =>
            NodeFor(nodeId) is { } nodeObject
                && (nodeObject["bindings"] ?? nodeObject["Bindings"]) is System.Text.Json.Nodes.JsonObject bindingsObject
                    ? bindingsObject
                    : null;

        // Pending new nodes (#117): the node object and — for prompt nodes —
        // its 1:1 prompt entry. Bindings start empty here; the generic rebind
        // loop below fills them from bindingEdits like any other node's.
        // Aggregators carry only their ordered source list.
        foreach (var addedNode in addedNodes)
        {
            if (addedNode.Aggregate != null)
            {
                nodesArray.Add(new System.Text.Json.Nodes.JsonObject
                {
                    ["id"] = addedNode.Id,
                    ["label"] = addedNode.Label,
                    ["aggregate"] = new System.Text.Json.Nodes.JsonArray(
                        addedNode.Aggregate
                            .Select(s => (System.Text.Json.Nodes.JsonNode?)System.Text.Json.Nodes.JsonValue.Create(s))
                            .ToArray())
                });
                continue;
            }

            if (addedNode.PromptRef == null
                && (root["prompts"] ?? root["Prompts"]) is System.Text.Json.Nodes.JsonArray promptsArrayForAdd)
            {
                promptsArrayForAdd.Add(new System.Text.Json.Nodes.JsonObject
                {
                    ["id"] = addedNode.Id,
                    ["file"] = AddedPromptFile(addedNode.Id),
                    ["variables"] = new System.Text.Json.Nodes.JsonArray(
                        AddedVariables(addedNode.Id)
                            .Select(v => (System.Text.Json.Nodes.JsonNode?)System.Text.Json.Nodes.JsonValue.Create(v))
                            .ToArray())
                });
            }

            var newNodeObject = new System.Text.Json.Nodes.JsonObject
            {
                ["id"] = addedNode.Id,
                ["label"] = addedNode.Label,
                ["prompt"] = addedNode.PromptRef ?? addedNode.Id,
                ["bindings"] = new System.Text.Json.Nodes.JsonObject()
            };

            if (addedNode.ForEach != null)
            {
                newNodeObject["forEach"] = addedNode.ForEach;
            }

            if (addedNode.OutputSchema != null)
            {
                var newOutputObject = new System.Text.Json.Nodes.JsonObject { ["schema"] = addedNode.OutputSchema };

                if (!string.IsNullOrWhiteSpace(addedNode.FailIfEmpty))
                {
                    newOutputObject["failIfEmpty"] = addedNode.FailIfEmpty;
                }

                newNodeObject["output"] = newOutputObject;
            }

            nodesArray.Add(newNodeObject);
        }

        // Aggregate-list edits on existing aggregators (#117).
        foreach (var pair in aggregateEdits)
        {
            if (!removedNodeIds.Contains(pair.Key) && NodeFor(pair.Key) is { } aggregatorObject)
            {
                aggregatorObject[aggregatorObject.ContainsKey("Aggregate") ? "Aggregate" : "aggregate"] =
                    new System.Text.Json.Nodes.JsonArray(
                        pair.Value
                            .Select(s => (System.Text.Json.Nodes.JsonNode?)System.Text.Json.Nodes.JsonValue.Create(s))
                            .ToArray());
            }
        }

        // The pending declarations. A v7 package's results list owns the
        // deliverable — writing the string result beside it would trip the
        // validator's "Declare result or results, not both".
        if (inputsEdit != null)
        {
            root[root["Inputs"] is not null ? "Inputs" : "inputs"] = new System.Text.Json.Nodes.JsonArray(
                inputsEdit
                    .Select(input =>
                    {
                        var node = new System.Text.Json.Nodes.JsonObject
                        {
                            ["id"] = input.Id,
                            ["label"] = input.Label,
                            ["required"] = input.Required
                        };

                        // Omitted when absent, so a v7 package composes exactly
                        // the bytes it composes today: type null means text.
                        if (input.Type != null)
                        {
                            node["type"] = input.Type;
                        }

                        if (input.Values is { Count: > 0 })
                        {
                            node["values"] = new System.Text.Json.Nodes.JsonArray(
                                input.Values.Select(v => (System.Text.Json.Nodes.JsonNode?)v).ToArray());
                        }

                        // v9 (#429): carried as read. Omitted when absent, so
                        // every v7 and v8 package composes the bytes it did.
                        // v10 (#498): an element that is an array writes as a
                        // spec; fields write their own structure.
                        if (input.Items != null)
                        {
                            node["items"] = WriteElement(input.Items);
                        }

                        if (input.Fields is { Count: > 0 })
                        {
                            node["fields"] = WriteFields(input.Fields);
                        }

                        return (System.Text.Json.Nodes.JsonNode?)node;
                    })
                    .ToArray());
        }

        if (resultsEdit != null)
        {
            root.AsObject().Remove("result");
            root.AsObject().Remove("Result");
            root[root["Results"] is not null ? "Results" : "results"] = new System.Text.Json.Nodes.JsonArray(
                resultsEdit
                    .Select(result =>
                    {
                        var node = new System.Text.Json.Nodes.JsonObject
                        {
                            ["id"] = result.Id,
                            ["node"] = result.Node,
                            ["label"] = result.Label
                        };

                        // The raw string as authored: a row nobody edited keeps
                        // its original text rather than being normalised.
                        if (!string.IsNullOrWhiteSpace(result.When))
                        {
                            node["when"] = result.When;
                        }

                        return (System.Text.Json.Nodes.JsonNode?)node;
                    })
                    .ToArray());
        }
        else if (resultEdit != null)
        {
            root[root["Result"] is not null ? "Result" : "result"] = resultEdit;
        }

        // Removed nodes lose their node object and their prompt entry.
        foreach (var removedNodeId in removedNodeIds)
        {
            if (NodeFor(removedNodeId) is { } removedNodeObject)
            {
                nodesArray.Remove(removedNodeObject);
            }

            var removedPromptId = nodes.FirstOrDefault(n => n.Id == removedNodeId)?.Prompt;

            if (removedPromptId != null
                && !EffectiveNodes.Any(n => n.Prompt == removedPromptId)
                && (root["prompts"] ?? root["Prompts"]) is System.Text.Json.Nodes.JsonArray promptsArrayForRemove
                && promptsArrayForRemove
                    .OfType<System.Text.Json.Nodes.JsonObject>()
                    .FirstOrDefault(p => (p["id"] ?? p["Id"])?.GetValue<string>() == removedPromptId) is { } removedPromptObject)
            {
                promptsArrayForRemove.Remove(removedPromptObject);
            }
        }

        // Standalone pending prompts (#170): one prompts[] entry each.
        if (addedPrompts.Count > 0
            && (root["prompts"] ?? root["Prompts"]) is System.Text.Json.Nodes.JsonArray promptsArrayForStandalone)
        {
            foreach (var pending in addedPrompts)
            {
                promptsArrayForStandalone.Add(new System.Text.Json.Nodes.JsonObject
                {
                    ["id"] = pending.Id,
                    ["file"] = AddedStandalonePromptFile(pending.Id),
                    ["variables"] = new System.Text.Json.Nodes.JsonArray(
                        AddedVariables(pending.Id)
                            .Select(v => (System.Text.Json.Nodes.JsonNode?)System.Text.Json.Nodes.JsonValue.Create(v))
                            .ToArray())
                });
            }
        }

        // Node-field edits (#117): label always written; forEach and output
        // written or removed to match the effective tuple. Removed nodes'
        // stale edits are skipped.
        foreach (var pair in nodeEdits)
        {
            if (removedNodeIds.Contains(pair.Key) || NodeFor(pair.Key) is not { } nodeObject)
            {
                continue;
            }

            nodeObject[nodeObject.ContainsKey("Label") ? "Label" : "label"] = pair.Value.Label;

            // A re-pointed prompt replaces the bindings wholesale — the old
            // ones were written for the old prompt's variables; the rebind
            // loop below fills the fresh ones from bindingEdits.
            if (pair.Value.Prompt != null
                && pair.Value.Prompt != nodes.FirstOrDefault(n => n.Id == pair.Key)?.Prompt)
            {
                nodeObject[nodeObject.ContainsKey("Prompt") ? "Prompt" : "prompt"] = pair.Value.Prompt;
                nodeObject.Remove("bindings");
                nodeObject.Remove("Bindings");
                nodeObject["bindings"] = new System.Text.Json.Nodes.JsonObject();
            }

            if (pair.Value.ForEach is null)
            {
                nodeObject.Remove("forEach");
                nodeObject.Remove("ForEach");
            }
            else
            {
                nodeObject[nodeObject.ContainsKey("ForEach") ? "ForEach" : "forEach"] = pair.Value.ForEach;
            }

            if (pair.Value.OutputSchema is null)
            {
                nodeObject.Remove("output");
                nodeObject.Remove("Output");
            }
            else
            {
                var outputObject = new System.Text.Json.Nodes.JsonObject { ["schema"] = pair.Value.OutputSchema };

                if (!string.IsNullOrWhiteSpace(pair.Value.FailIfEmpty))
                {
                    outputObject["failIfEmpty"] = pair.Value.FailIfEmpty;
                }

                nodeObject[nodeObject.ContainsKey("Output") ? "Output" : "output"] = outputObject;
            }
        }

        // Rebinds and added-variable bindings (the indexer adds missing keys).
        foreach (var pair in bindingEdits)
        {
            var parts = pair.Key.Split('\n', 2);

            if (BindingsFor(parts[0]) is not { } bindingsObject)
            {
                continue;
            }

            bindingsObject[parts[1]] = pair.Value.As is null
                ? System.Text.Json.Nodes.JsonValue.Create(pair.Value.From)
                : new System.Text.Json.Nodes.JsonObject
                {
                    ["from"] = pair.Value.From,
                    ["as"] = pair.Value.As
                };
        }

        // Removed variables lose their binding keys on every using node.
        foreach (var prompt in prompts)
        {
            if (!variableRemovals.TryGetValue(prompt.Id, out var removedVariables) || removedVariables.Count == 0)
            {
                continue;
            }

            foreach (var node in NodesUsingPrompt(prompt.Id))
            {
                if (BindingsFor(node.Id) is not { } bindingsObject)
                {
                    continue;
                }

                foreach (var variable in removedVariables)
                {
                    bindingsObject.Remove(variable);
                }
            }
        }

        return JsonSerializer.SerializeToElement(root);
    }

    // A different package to look at — not a different package to run. Drafts
    // are keyed per ref, so pending edits stay with their package and reappear
    // on switching back.
    private async Task OnPackageSelectedAsync(string packageRef)
    {
        editingRef = packageRef;
        await RememberPackageAsync(packageRef);
        await LoadAsync();
    }

    // The load-error escape hatch still writes the pin: an unloadable pin is
    // exactly the situation where changing what the consults run is the repair.
    private async Task OnPackagePinnedAsync()
    {
        editingRef = null;
        await ForgetRememberedPackageAsync();
        await LoadAsync();
    }

    private async Task RevertToDefaultAsync()
    {
        if (isPublishing)
        {
            return;
        }

        ResetPublishFeedback();

        try
        {
            await AccountService.DeleteSettingAsync(WorkflowPackagePinSettingKey);
            // Both meanings move together. Reverting the pin while the editor
            // stayed on something else would report "reverted to X" naming
            // whatever happened to be loaded (#411).
            editingRef = null;
            await ForgetRememberedPackageAsync();
            await LoadAsync();
            publishSuccess = $"Reverted to the default package ({content?.Ref}). Your published versions are kept.";
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            publishErrors = new List<string> { $"Revert failed: {ex.Message}" };
        }
    }
}
