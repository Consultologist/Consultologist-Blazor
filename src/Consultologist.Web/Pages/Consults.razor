@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Microsoft.AspNetCore.Components.Routing
@using System.Diagnostics
@using System.Text.Json
@using Consultologist.Web.Services.AI
@using Consultologist.Web.Services.Accounts
@using Consultologist.Web.Services.Diagnostics
@using Consultologist.Web.Services.Documents
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IAIEndpointService AIService
@inject IDocumentEndpointService DocumentService
@inject ISseDiagnosticsService SseDiagnostics
@inject ILogger<Consults> Logger
@inject IWorkflowEndpointService WorkflowService
@inject ConsultJobSession JobSession
@inject IAccountEndpointService AccountService
@attribute [Authorize]
@implements IAsyncDisposable

@page "/consults"
@page "/consults/{JobId}"

<PageTitle>Consults</PageTitle>

<section class="page-header">
    <div class="page-header__content">
        <span class="section-eyebrow">Consults</span>
        <h1 class="page-title">Draft and review specialist consult notes.</h1>
        <p class="page-description">
            Paste the source consult draft and generate each note section from the active writing standards.
        </p>
    </div>
</section>

<AuthorizeView>
    <Authorized>
        @if (!IsRunPhase)
        {
            <div class="consult-setup">
                <section class="workflow-panel">
                    <div class="form-stack">
                        <h2 class="panel-title">Consult details</h2>
                        <p class="panel-description">
                            Paste the referral, history, or draft note. Each output section uses this draft as the source of truth.
                        </p>

                        @* One field per declared input, all visible: the package
                           states its intake form, and a single input keeps the
                           full-height writing area the page has always had. *@
                        @foreach (var field in inputFields)
                        {
                            <label class="input-field" @key="field.Id">
                                <span>
                                    @field.Label
                                    @if (!field.Required)
                                    {
                                        <span class="muted-text input-field__optional">(optional)</span>
                                    }
                                </span>
                                @* #236: a slot holds either typed text or an
                                   attached document, never both. The text is
                                   kept underneath so removing the file gives
                                   it back. *@
                                @{ Console.WriteLine($"[#510] render slot={field.Id} hasLoaded={field.HasLoaded} hasFile={field.HasFile}"); }
                                @if (field.HasLoaded)
                                {
                                    @* #510: filled from previous runs. One chip per
                                       deliverable, its text shown as a preview: what
                                       runs is the server's copy of that run's text. *@
                                    <div class="input-field__documents" @onclick:stopPropagation="true">
                                        @for (var i = 0; i < field.Loaded.Count; i++)
                                        {
                                            var index = i;
                                            var loaded = field.Loaded[index];
                                            var currentField = field;
                                            <div class="input-field__document input-field__loaded">
                                                <span class="input-field__chip">
                                                    <span class="input-field__chip-name">@loaded.Label</span>
                                                    <span class="muted-text">@loaded.RunName</span>
                                                    <FluentButton Appearance="Appearance.Stealth"
                                                                  Title="Remove this loaded deliverable"
                                                                  @onclick="() => RemoveLoaded(currentField, index)">Remove</FluentButton>
                                                </span>
                                                <div class="input-field__preview">@loaded.Text</div>
                                            </div>
                                        }
                                        @* Shown, not editable: what runs is the deliverable as
                                           that run produced it. To change the words, remove it
                                           and paste text instead. *@
                                        <span class="muted-text input-field__hint">
                                            The run will use this text exactly as that run produced it. To change it, remove it and paste text instead.
                                        </span>
                                        @if (field.TakesSeveralDocuments)
                                        {
                                            <span class="input-field__loaded-actions">
                                                <PreviousRunPicker OnChosen="loaded => LoadDeliverable(field, loaded)" />
                                            </span>
                                        }
                                    </div>
                                }
                                else if (field.HasFile && field.TakesSeveralDocuments)
                                {
                                    @* #428/#429: several documents, in the order chosen —
                                       the order the elements hash in. Rows are kept
                                       underneath; "Remove all" gives them back. *@
                                    <div class="input-field__documents" @onclick:stopPropagation="true">
                                        @for (var i = 0; i < field.Documents.Count; i++)
                                        {
                                            var index = i;
                                            var document = field.Documents[index];
                                            var currentField = field;
                                            <div class="input-field__document" @key="document">
                                                <span class="input-field__chip">
                                                    <span class="muted-text input-field__row-number">@(index + 1).</span>
                                                    <span class="input-field__chip-name">@document.FileName</span>
                                                    @if (document.PageCount is { } pages)
                                                    {
                                                        <span class="muted-text">@pages page@(pages == 1 ? "" : "s")</span>
                                                    }
                                                    <span class="input-field__row-buttons">
                                                        <button type="button" class="aggregate-row__button" title="Move up"
                                                                disabled="@(index == 0)"
                                                                @onclick="() => MoveDocument(currentField, index, -1)">↑</button>
                                                        <button type="button" class="aggregate-row__button" title="Move down"
                                                                disabled="@(index == currentField.Documents.Count - 1)"
                                                                @onclick="() => MoveDocument(currentField, index, +1)">↓</button>
                                                        <button type="button" class="aggregate-row__button" title="Remove this file"
                                                                @onclick="() => RemoveDocument(currentField, index)">×</button>
                                                    </span>
                                                </span>
                                                <div class="input-field__preview">@document.PreviewText</div>
                                            </div>
                                        }
                                        <span class="input-field__file">
                                            <InputFile multiple OnChange="args => LoadFileAsync(field, args)" />
                                            @if (field.IsReading)
                                            {
                                                <FluentProgressRing style="width: 16px; height: 16px;" />
                                                <span class="muted-text">Reading&hellip;</span>
                                            }
                                            <FluentButton Appearance="Appearance.Stealth"
                                                          Title="Remove every file and type instead"
                                                          @onclick="() => RemoveFile(field)">Remove all</FluentButton>
                                        </span>
                                        <span class="muted-text input-field__hint">
                                            Looks wrong? Remove the file and type the entry instead.
                                        </span>
                                    </div>
                                }
                                else if (field.HasFile)
                                {
                                    <span class="input-field__chip" @onclick:stopPropagation="true">
                                        <span class="input-field__chip-name">@field.FileName</span>
                                        @if (field.PageCount is { } pages)
                                        {
                                            <span class="muted-text">@pages page@(pages == 1 ? "" : "s")</span>
                                        }
                                        <FluentButton Appearance="Appearance.Stealth"
                                                      Title="Remove this file"
                                                      @onclick="() => RemoveFile(field)">Remove</FluentButton>
                                    </span>
                                    @* What the server read, shown before it can
                                       become a consult. Extraction is lossy on
                                       columns and tables, so a garbled read has
                                       to be visible while it is still cheap to
                                       reject. *@
                                    <span class="muted-text">What we read from this file:</span>
                                    <div class="input-field__preview">@field.PreviewText</div>
                                    <span class="muted-text input-field__hint">
                                        Looks wrong? Remove the file and paste the text instead.
                                    </span>
                                }
                                else if (field.Type == WorkflowInputTypes.Object)
                                {
                                    @* v9: a field group — one labelled control per
                                       declared field. An untouched optional object is
                                       absent; a touched one answers every required
                                       field before the run opens. *@
                                    <div class="input-field__group" @onclick:stopPropagation="true">
                                        @StructureControl(field.Root)
                                    </div>
                                }
                                else if (field.Type == WorkflowInputTypes.Array)
                                {
                                    @* v9: a row set in the order the clinician puts
                                       it — the order the elements hash in. No rows is
                                       absent; an empty row names itself and holds the
                                       run rather than being dropped. *@
                                    <div class="input-field__group" @onclick:stopPropagation="true">
                                        @for (var i = 0; i < field.Rows.Count; i++)
                                        {
                                            var index = i;
                                            var row = field.Rows[index];
                                            var currentField = field;
                                            <div class="input-field__row" @key="row">
                                                <span class="muted-text input-field__row-number">@(index + 1).</span>
                                                <div class="input-field__row-body">
                                                    @StructureControl(row)
                                                </div>
                                                <span class="input-field__row-buttons">
                                                    <button type="button" class="aggregate-row__button" title="Move up"
                                                            disabled="@(index == 0)"
                                                            @onclick="() => currentField.MoveRow(index, -1)">↑</button>
                                                    <button type="button" class="aggregate-row__button" title="Move down"
                                                            disabled="@(index == currentField.Rows.Count - 1)"
                                                            @onclick="() => currentField.MoveRow(index, +1)">↓</button>
                                                    <button type="button" class="aggregate-row__button" title="Remove entry"
                                                            @onclick="() => currentField.RemoveRow(index)">×</button>
                                                </span>
                                            </div>
                                        }
                                        <button type="button" class="input-field__add"
                                                @onclick="() => field.AddRow()">+ Add entry</button>
                                        @if (field.TakesSeveralDocuments)
                                        {
                                            @* Or attach documents: each becomes one entry, in the
                                               order chosen (v9 § 7). The same no-filter rule as the
                                               single picker. *@
                                            <span class="input-field__file">
                                                <InputFile multiple OnChange="args => LoadFileAsync(field, args)" />
                                                @if (field.IsReading)
                                                {
                                                    <FluentProgressRing style="width: 16px; height: 16px;" />
                                                    <span class="muted-text">Reading&hellip;</span>
                                                }
                                            </span>
                                            @* #510: or a previous run's deliverable, one per entry. *@
                                            <PreviousRunPicker OnChosen="loaded => LoadDeliverable(field, loaded)" />
                                        }
                                    </div>
                                }
                                else
                                {
                                    @* v8/v9: one control per scalar type, the same
                                       fragment that draws a row's element and an
                                       object's field. *@
                                    @ScalarControl(field.Scalar)
                                    @if (field.TakesOneDocument)
                                    {
                                        @* No accept filter and no extension list: the
                                           parser is the only thing that knows what a
                                           format is, and a second opinion here could
                                           disagree with it (docs/DOCUMENT_INPUT.md § 1). *@
                                        <span class="input-field__file" @onclick:stopPropagation="true">
                                            <InputFile OnChange="args => LoadFileAsync(field, args)" />
                                            @if (field.IsReading)
                                            {
                                                <FluentProgressRing style="width: 16px; height: 16px;" />
                                                <span class="muted-text">Reading&hellip;</span>
                                            }
                                        </span>
                                        @* #510: or a previous run's deliverable. *@
                                        <PreviousRunPicker OnChosen="loaded => LoadDeliverable(field, loaded)" />
                                    }
                                }
                                @if (field.Problem is { } problem)
                                {
                                    <span class="input-field__error">@problem</span>
                                }
                                @if (field.FileError != null)
                                {
                                    <span class="input-field__file-error">@field.FileError</span>
                                }
                            </label>
                        }

                        @if (isBlocksLoading)
                        {
                            <div class="loading-state">
                                <FluentProgressRing />
                                <span>Loading section standards...</span>
                            </div>
                        }
                        else if (!string.IsNullOrEmpty(blocksLoadError))
                        {
                            <FluentMessageBar Intent="MessageIntent.Error">@blocksLoadError</FluentMessageBar>
                            @* Escape hatch: a pin to an unloadable package must stay
                               correctable from here — the picker loads independently. *@
                            <div class="setup-context">
                                <span class="setup-context__line">
                                    Switch to another package:
                                    <WorkflowPackagePicker OnPinned="OnPackagePinnedAsync" />
                                </span>
                            </div>
                        }
                        else if (packageBlocks.Count > 0)
                        {
                            <div class="setup-context">
                                <span class="setup-context__line">
                                    Runs
                                    @if (!string.IsNullOrWhiteSpace(currentPackageTitle))
                                    {
                                        @* v9 § 4 (#432): the title when there is one; the
                                           picker beside it always shows the ref. *@
                                        <span class="setup-context__title">@currentPackageTitle</span>
                                    }
                                    <WorkflowPackagePicker @key="currentPackageRef"
                                                           Disabled="@isAiRequestLoading"
                                                           OnPinned="OnPackagePinnedAsync" />
                                    <span class="muted-text">· @SectionSummary</span>
                                </span>
                                <details class="setup-sections">
                                    <summary>Sections it will generate</summary>
                                    @if (IsMultiDeliverable)
                                    {
                                        @* Each section is generated once per deliverable, so
                                           the roster groups under the authored document labels
                                           rather than repeating names in one flat list. *@
                                        @foreach (var deliverable in declaredResults!)
                                        {
                                            <div class="setup-sections__group">
                                                <span class="setup-sections__group-label">@deliverable.Label</span>
                                                <ul>
                                                    @foreach (var standard in BlocksFor(deliverable.Id))
                                                    {
                                                        <li>@standard.Name</li>
                                                    }
                                                </ul>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <ul>
                                            @foreach (var standard in packageBlocks)
                                            {
                                                <li>@standard.Name</li>
                                            }
                                        </ul>
                                    }
                                </details>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(aiRequestError))
                        {
                            <FluentMessageBar Intent="MessageIntent.Error">
                                @aiRequestError
                                @if (refusedJobId != null)
                                {
                                    @* #434: nothing was produced, and a record says so. *@
                                    <a class="refusal-history-link" href="/history/@refusedJobId">View in History</a>
                                }
                            </FluentMessageBar>
                        }

                        @if (!string.IsNullOrEmpty(scheduleConfirmation))
                        {
                            <FluentMessageBar Intent="MessageIntent.Success">@scheduleConfirmation</FluentMessageBar>
                        }

                        @* #486: told before submit, not after — a consult with no delivery
                           address is not emailed, and this is the moment to say so. *@
                        @if (accountEmailPdf == false)
                        {
                            @* #518: the choice comes before the address — it is what the record will say. *@
                            <FluentMessageBar Intent="MessageIntent.Info" AllowDismiss="false" Class="delivery-address-notice delivery-address-notice--not-requested">
                                This consult will not be emailed — you chose not to email runs started from the app.
                                <a href="/profile">Change it on your profile</a> if you want this one emailed.
                            </FluentMessageBar>
                        }
                        else if (accountDeliveryAddressKnown && accountDeliveryAddress == null)
                        {
                            <FluentMessageBar Intent="MessageIntent.Info" AllowDismiss="false" Class="delivery-address-notice">
                                This consult will not be emailed — no delivery address is verified.
                                <a href="/profile">Set one on your profile</a> to receive completed consults by email.
                            </FluentMessageBar>
                        }

                        <div class="action-row">
                            <FluentSwitch @bind-Value="RunOvernight"
                                          Label="Run overnight"
                                          Disabled="@(isAiRequestLoading || isSchedulingRequest)" />
                            @* #390: the time is shown only once the switch is on, seeded from the
                               account default. The common case stays one click — turn it on, press
                               Schedule — and the control is there for the case that is not.

                               Native input, matching the v8 date field above: the control's value
                               IS the contract, and nothing in this app uses a Fluent picker. *@
                            @if (runOvernight)
                            {
                                <input type="datetime-local"
                                       class="node-field__input"
                                       value="@scheduledAtLocal"
                                       max="@MaxScheduleLocal"
                                       @onchange="args => scheduledAtLocal = args.Value?.ToString() ?? string.Empty"
                                       disabled="@isSchedulingRequest"
                                       aria-label="When this consult should run" />
                            }
                            @if (totalBlockCount > 0)
                            {
                                <FluentButton Appearance="Appearance.Neutral" @onclick="BackToRun">
                                    Back to consult
                                </FluentButton>
                            }
                            <FluentButton Appearance="Appearance.Accent"
                                          @onclick="CreateConsultAsync"
                                          Disabled="@(isBlocksLoading || isAiRequestLoading || isSchedulingRequest || !HasEveryRequiredInput || !HasNoInputProblems || packageBlocks.Count == 0)">
                                @(runOvernight ? "Schedule consult" : "Create consult")
                            </FluentButton>
                        </div>
                    </div>
                </section>
            </div>
        }
        else
        {
            <div class="consult-run">
                @* #367: the way back. Only when JobId is set — that means the page
                   was reached by re-attaching to a recorded job, so there is a
                   History row to return to. A run started in this session has no
                   "back", and the header's History link already covers it.

                   /history/{jobId} opens that job's detail panel expanded, so the
                   round trip lands where it started rather than at the top of the
                   list. *@
                @if (!string.IsNullOrWhiteSpace(JobId))
                {
                    <a class="back-to-history-link" href="/history/@JobId">&#x2039; Back to this job in History</a>
                }
                <details class="draft-bar">
                    <summary class="draft-bar__summary">
                        <span class="draft-bar__chevron" aria-hidden="true">&#x203A;</span>
                        <span class="draft-bar__label">@(inputFields.Count == 1 ? "Draft" : "Inputs")</span>
                        <span class="draft-bar__snippet">@DraftSnippet</span>
                        @if (HasAnyInput)
                        {
                            <span @onclick:stopPropagation="true">
                                <FluentButton Appearance="Appearance.Stealth"
                                              @onclick="EditDraft"
                                              Disabled="@isAiRequestLoading">
                                    @(inputFields.Count == 1 ? "Edit draft" : "Edit inputs")
                                </FluentButton>
                            </span>
                        }
                    </summary>
                    <div class="draft-bar__full">
                        @if (inputFields.Count == 1)
                        {
                            @inputFields[0].EffectiveText
                        }
                        else
                        {
                            @* Each supplied input under its authored label; an
                               absent optional input simply does not appear. *@
                            @foreach (var field in inputFields.Where(f => f.IsFilled))
                            {
                                <div class="draft-bar__input" @key="field.Id">
                                    <span class="draft-bar__input-label">@field.Label</span>
                                    <span>@field.EffectiveText</span>
                                </div>
                            }
                        }
                    </div>
                </details>

                <div class="consult-run__grid">
                    <section class="result-panel">
                        @if (assembledDocuments.Count > 0)
                        {
                            @* The deliverables: one server-assembled document in
                               v6 and single-result v7, one tab each when the
                               package declares several. *@
                            <div>
                                <div class="result-header">
                                    <h2 class="panel-title">@(assembledDocuments.Count == 1 ? assembledDocuments[0].Label : "Documents")</h2>
                                    <div class="result-header__actions">
                                        <FluentBadge Appearance="Appearance.Accent">assembled</FluentBadge>
                                        <FluentButton Appearance="Appearance.Accent" @onclick="CopyNoteAsync">
                                            @CopyButtonLabel
                                        </FluentButton>
                                    </div>
                                </div>

                                @* #486: what happened to the completion email. *@
                                @if (DeliveryState.Describe(deliveryOutcome, deliveryDocumentAttached) is { } deliveryText)
                                {
                                    <p class="delivery-line delivery-line--@(deliveryOutcome)">@deliveryText</p>
                                }

                                @if (textDroppedAtUtc is { } deletedAt)
                                {
                                    @* #368: a named state — the record is kept, the text is not. *@
                                    <div class="note-deleted-state">
                                        <p>The produced text was deleted on @deletedAt.ToLocalTime().ToString("MMM d, yyyy") under the retention policy. The record — its hashes, nodes, package, catalog and terminology — is kept, and is in History.</p>
                                    </div>
                                }
                                else if (assembledDocuments.Count == 1)
                                {
                                    <article class="note-preview generated-note generated-note--assembled">
                                        @((MarkupString)MarkdownPreview.Render(assembledDocuments[0].Text ?? string.Empty))
                                    </article>
                                }
                                else
                                {
                                    @* FluentTabs carries the whole ARIA tab pattern —
                                       roving tabindex, arrow/Home/End keys, overflow
                                       when the labels outgrow the panel. *@
                                    <FluentTabs @bind-ActiveTabId="activeDocumentId" class="document-tabs">
                                        @foreach (var document in assembledDocuments)
                                        {
                                            <FluentTab Id="@document.ResultId"
                                                       Label="@document.Label"
                                                       @key="document.ResultId">
                                                <article class="note-preview generated-note generated-note--assembled">
                                                    @((MarkupString)MarkdownPreview.Render(document.Text ?? string.Empty))
                                                </article>
                                            </FluentTab>
                                        }
                                    </FluentTabs>
                                }

                                @* #315: the person who just ran the consult is
                                   the one most likely to wonder where the second
                                   document went. Labels and declared values are
                                   authored package content, so this carries no
                                   clinical detail. *@
                                @foreach (var skipped in skippedDocuments)
                                {
                                    <p class="muted-text" data-skipped-result="@skipped.ResultId">
                                        <strong>@skipped.Label</strong> was not produced: it @skipped.Reason.
                                    </p>
                                }
                            </div>
                        }
                        else if (generatedBlocks.Count > 0)
                        {
                            <div>
                                <div class="result-header">
                                    <h2 class="panel-title">Consultation note</h2>
                                    <div class="result-header__actions">
                                        <FluentBadge Appearance="Appearance.Accent">
                                            @generatedBlocks.Count sections
                                        </FluentBadge>
                                        @if (!isAiRequestLoading || runTerminalStatus != null)
                                        {
                                            <FluentButton Appearance="Appearance.Accent" @onclick="CopyNoteAsync">
                                                @CopyButtonLabel
                                            </FluentButton>
                                        }
                                    </div>
                                </div>

                                <article class="note-preview generated-note">
                                    @foreach (var standard in packageBlocks)
                                    {
                                        if (generatedBlocks.TryGetValue(standard.Id, out var prose) && !string.IsNullOrWhiteSpace(prose))
                                        {
                                            <section class="note-section">
                                                <h3>@standard.Name</h3>
                                                <p>@prose</p>
                                            </section>
                                        }
                                    }
                                </article>
                            </div>
                        }
                        else
                        {
                            <div class="empty-note-state">
                                <h2 class="panel-title">Consultation note</h2>
                                <p class="panel-description">
                                    Sections appear here as they are generated.
                                </p>
                                @if (isAiRequestLoading)
                                {
                                    <div class="loading-state">
                                        <FluentProgressRing />
                                        <span>Generating&hellip;</span>
                                    </div>
                                }
                            </div>
                        }
                    </section>

                    <section class="workflow-panel run-rail">
                        <div class="form-stack">
                            <h2 class="panel-title">Run</h2>

                            @{
                                var stageTotal = totalAnalysisStageCount > 0 ? totalAnalysisStageCount : 6;
                                var setupStatus = SetupRowStatus();
                            }
                            <div class="node-grid">
                                <div class="node-row">
                                    <span class="node-row__chevron" aria-hidden="true"></span>
                                    <span class="node-row__status @RunStatusCss(setupStatus)">@RunStatusGlyph(setupStatus)</span>
                                    <span class="node-row__label">Setup</span>
                                </div>

                                @if (RailNodes is { Count: > 0 } railNodes)
                                {
                                    @* v10 (#496): a package with classifiers decides what to produce
                                       first. The stage is named, the classifiers listed under it, and
                                       the count is "not yet decided" until the boundary. *@
                                    @if (HasClassifiers)
                                    {
                                        var decidingStatus = DecidingRowStatus();
                                        <details class="node-group node-group--deciding" open>
                                            <summary class="node-row">
                                                <span class="node-row__chevron" aria-hidden="true">&#x203A;</span>
                                                <span class="node-row__status @RunStatusCss(decidingStatus)">@RunStatusGlyph(decidingStatus)</span>
                                                <span class="node-row__label">Deciding what to produce</span>
                                                @if (classifications is { Count: > 0 })
                                                {
                                                    <span class="node-row__count muted-text">@DecisionState.Describe(classifications)</span>
                                                }
                                            </summary>
                                            @for (var c = 0; c < railNodes.Count; c++)
                                            {
                                                var classifier = railNodes[c];
                                                if (!classifier.IsClassifier)
                                                {
                                                    continue;
                                                }
                                                var classifierStatus = NodeRowStatus(classifier, c);
                                                <div class="node-row node-row--item">
                                                    <span class="node-row__chevron" aria-hidden="true"></span>
                                                    <span class="node-row__status @RunStatusCss(classifierStatus)">@RunStatusGlyph(classifierStatus)</span>
                                                    <span class="node-row__label">@classifier.Label</span>
                                                    @if (classifications?.GetValueOrDefault(classifier.Id) is { } answer)
                                                    {
                                                        <span class="node-row__count muted-text">@answer</span>
                                                    }
                                                </div>
                                            }
                                            @if (NotYetDecided)
                                            {
                                                <div class="node-row__caption muted-text deciding-caption">Not yet decided — which documents to produce depends on the answers above.</div>
                                            }
                                            else if (decisionFailureKind != null)
                                            {
                                                <div class="node-row__caption muted-text deciding-caption">@DecisionState.DoneLabel(decisionFailureKind)@(startFailureDetail is { } why ? $" — {why}" : "")</div>
                                            }
                                        </details>
                                    }

                                    @* The manifest node map, loaded at page init: every node named and every
                                       forEach group's sections listed before the first event arrives. *@
                                    for (var i = 0; i < railNodes.Count; i++)
                                    {
                                        var node = railNodes[i];
                                        if (node.IsClassifier)
                                        {
                                            continue;
                                        }
                                        var stageStatus = NodeRowStatus(node, i);
                                        var done = stageStatus == "Completed";
                                        var current = stageStatus == "Running";

                                        if (node.ForEach != null)
                                        {
                                            var nodeItems = ItemsFor(node);
                                            var doneItems = nodeItems.Count(item => NodeItemStatus(node, done, current, item.Id) == "Completed");
                                            <details class="node-group" open>
                                                <summary class="node-row">
                                                    <span class="node-row__chevron" aria-hidden="true">&#x203A;</span>
                                                    <span class="node-row__status @RunStatusCss(stageStatus)">@RunStatusGlyph(stageStatus)</span>
                                                    <span class="node-row__label">@node.Label</span>
                                                    <span class="node-row__count muted-text">@doneItems/@nodeItems.Count</span>
                                                </summary>
                                                @foreach (var item in nodeItems)
                                                {
                                                    var itemStatus = NodeItemStatus(node, done, current, item.Id);
                                                    <div class="node-row node-row--item">
                                                        <span class="node-row__chevron" aria-hidden="true"></span>
                                                        <span class="node-row__status @RunStatusCss(itemStatus)">@RunStatusGlyph(itemStatus)</span>
                                                        <span class="node-row__label">@item.Name</span>
                                                    </div>
                                                }
                                            </details>
                                        }
                                        else
                                        {
                                            <div class="node-row">
                                                <span class="node-row__chevron" aria-hidden="true"></span>
                                                <span class="node-row__status @RunStatusCss(stageStatus)">@RunStatusGlyph(stageStatus)</span>
                                                <span class="node-row__label">@node.Label</span>
                                            </div>
                                        }

                                        if (current && !string.IsNullOrEmpty(aiProgressNotice))
                                        {
                                            <div class="node-row__caption muted-text">@aiProgressNotice</div>
                                        }
                                    }
                                }
                                else
                                {
                                    @* Fallback when the manifest could not be fetched: event-fed labels,
                                       sections grouped under the final stage only. *@
                                    for (var i = 1; i <= stageTotal; i++)
                                    {
                                        var stepNum = i;
                                        var done = completedAnalysisStageCount >= stepNum;
                                        var current = !done && completedAnalysisStageCount == stepNum - 1 && isAiRequestLoading;
                                        var stageStatus = done ? "Completed" : current ? "Running" : null;
                                        var isSectionStage = stepNum == stageTotal;

                                        if (isSectionStage && (done || current))
                                        {
                                            <details class="node-group" open>
                                                <summary class="node-row">
                                                    <span class="node-row__chevron" aria-hidden="true">&#x203A;</span>
                                                    <span class="node-row__status @RunStatusCss(stageStatus)">@RunStatusGlyph(stageStatus)</span>
                                                    <span class="node-row__label">@GetStageChecklistLabel(stepNum)</span>
                                                    <span class="node-row__count muted-text">@completedBlockCount/@totalBlockCount</span>
                                                </summary>
                                                @foreach (var sec in packageBlocks)
                                                {
                                                    var sectionStatus = generatedBlocks.ContainsKey(sec.Id) ? "Completed"
                                                        : failedBlockErrors.ContainsKey(sec.Id) ? "Failed"
                                                        : current ? "Running" : null;
                                                    <div class="node-row node-row--item">
                                                        <span class="node-row__chevron" aria-hidden="true"></span>
                                                        <span class="node-row__status @RunStatusCss(sectionStatus)">@RunStatusGlyph(sectionStatus)</span>
                                                        <span class="node-row__label">@sec.Name</span>
                                                    </div>
                                                }
                                            </details>
                                        }
                                        else
                                        {
                                            <div class="node-row">
                                                <span class="node-row__chevron" aria-hidden="true"></span>
                                                <span class="node-row__status @RunStatusCss(stageStatus)">@RunStatusGlyph(stageStatus)</span>
                                                <span class="node-row__label">@GetStageChecklistLabel(stepNum)</span>
                                            </div>
                                            @if (current && !string.IsNullOrEmpty(aiProgressNotice))
                                            {
                                                <div class="node-row__caption muted-text">@aiProgressNotice</div>
                                            }
                                        }
                                    }
                                }

                                @{
                                    var doneStatus = DoneRowStatus();
                                }
                                <div class="node-row">
                                    <span class="node-row__chevron" aria-hidden="true"></span>
                                    <span class="node-row__status @RunStatusCss(doneStatus)">@RunStatusGlyph(doneStatus)</span>
                                    <span class="node-row__label">@(doneStatus == "Failed" ? (decisionFailureKind != null ? DecisionState.DoneLabel(decisionFailureKind) : "Failed") : "Done")</span>
                                    @if (NotYetDecided)
                                    {
                                        <span class="node-row__count muted-text">— sections, not yet decided</span>
                                    }
                                    else if (doneStatus != null)
                                    {
                                        <span class="node-row__count muted-text">@generatedBlocks.Count/@totalBlockCount sections</span>
                                    }
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(aiRequestError))
                            {
                                <FluentMessageBar Intent="MessageIntent.Error">
                                @aiRequestError
                                @if (refusedJobId != null)
                                {
                                    @* #434: nothing was produced, and a record says so. *@
                                    <a class="refusal-history-link" href="/history/@refusedJobId">View in History</a>
                                }
                            </FluentMessageBar>
                            }
                        </div>
                    </section>
                </div>
            </div>
        }
    </Authorized>
</AuthorizeView>

@code {
  /// <summary>
  /// One control per scalar type (v8; v9 adds number). Drawn at the top of a
  /// scalar slot, inside an array's row and inside an object's field group —
  /// one fragment, so the three sites cannot drift. A fragment rather than a
  /// component: its handlers run in this page's own render context, so the
  /// submit gate re-evaluates without a callback layer.
  /// </summary>
  private RenderFragment<ScalarSlot> ScalarControl => slot =>
    @<text>
      @if (slot.Type == WorkflowInputTypes.Date)
      {
        @* v8: the control's value IS the contract. The server accepts only
           ISO YYYY-MM-DD and rejects rather than normalises, so this is not
           a display preference. Empty until chosen — never today's date. *@
        <input type="date"
               class="node-field__input"
               value="@slot.Value"
               @onchange="args => slot.Value = args.Value?.ToString() ?? string.Empty"
               aria-label="@slot.Label" />
      }
      else if (slot.Type == WorkflowInputTypes.Enum)
      {
        @* No selection until one is made: a plausible default is still a
           value nobody chose. *@
        <select class="node-field__input"
                value="@slot.Value"
                @onchange="args => slot.Value = args.Value?.ToString() ?? string.Empty"
                aria-label="@slot.Label">
          <option value="">choose…</option>
          @foreach (var option in slot.Values)
          {
            <option value="@option">@option</option>
          }
        </select>
      }
      else if (slot.Type == WorkflowInputTypes.Boolean)
      {
        @* Tri-state on purpose: unanswered is not false, and a required
           boolean nobody touched must block the run rather than quietly
           submit false. *@
        <select class="node-field__input"
                value="@(slot.Flag is null ? string.Empty : slot.Flag.Value ? "true" : "false")"
                @onchange="args => SetFlag(slot, args.Value?.ToString())"
                aria-label="@slot.Label">
          <option value="">choose…</option>
          <option value="true">Yes</option>
          <option value="false">No</option>
        </select>
      }
      else if (slot.Type == WorkflowInputTypes.Number)
      {
        @* v9: a text control, not type=number. The canonical form is the
           caller's own spelling — "1.50" is sent as "1.50" — and a number
           control would not promise to keep it. The parse gate is the slot's. *@
        <input type="text"
               inputmode="decimal"
               class="node-field__input input-field__number"
               value="@slot.Value"
               @onchange="args => slot.Value = args.Value?.ToString() ?? string.Empty"
               aria-label="@slot.Label" />
      }
      else
      {
        @* Bound to the slot's own property: Blazor's expression formatter
           cannot parse an indexer whose argument is a property access. *@
        <FluentTextArea @bind-Value="slot.Value"
                        Placeholder="@slot.Placeholder"
                        Rows="@slot.Rows" />
      }
    </text>;

  /// <summary>
  /// v10 (#497): the tree below a slot. A scalar is its control; an object's
  /// fields each carry a label and, beneath it, this fragment again; an
  /// array's rows are numbered, movable and removable and each holds this
  /// fragment again, with the array's own "+ Add entry". A fragment, as
  /// ScalarControl is, so every level's handlers run in this page's render
  /// context. The input's own markup draws the outermost group (and the
  /// document picker); a nested group draws its own border.
  /// </summary>
  private RenderFragment<ConsultInputNode> StructureControl => node =>
    @<text>
      @if (node.IsScalar)
      {
        @ScalarControl(node.Scalar)
      }
      else if (node.IsObject)
      {
        @foreach (var member in node.Fields)
        {
          <label class="input-field__member" @key="member">
            <span>
              @member.Label
              @if (!member.Required)
              {
                <span class="muted-text input-field__optional">(optional)</span>
              }
            </span>
            @* An object member draws its group here; an array draws its own. *@
            @if (member.IsObject)
            {
              <div class="input-field__group input-field__group--nested" @onclick:stopPropagation="true">
                @StructureControl(member)
              </div>
            }
            else
            {
              @StructureControl(member)
            }
          </label>
        }
      }
      else if (node.Depth > 0)
      {
        @* A nested array draws its own bordered group; the input's markup
           draws the outermost one. *@
        <div class="input-field__group input-field__group--nested" @onclick:stopPropagation="true">
          @ArrayRows(node)
          <button type="button" class="input-field__add"
                  @onclick="() => node.AddRow()">+ Add entry</button>
        </div>
      }
      else
      {
        @ArrayRows(node)
      }
    </text>;

  private RenderFragment<ConsultInputNode> ArrayRows => node =>
    @<text>
        @for (var i = 0; i < node.Rows.Count; i++)
        {
          var index = i;
          var row = node.Rows[index];
          var array = node;
          <div class="input-field__row" @key="row">
            <span class="muted-text input-field__row-number">@(index + 1).</span>
            <div class="input-field__row-body">
              @StructureControl(row)
            </div>
            <span class="input-field__row-buttons">
              <button type="button" class="aggregate-row__button" title="Move up"
                      disabled="@(index == 0)"
                      @onclick="() => array.MoveRow(index, -1)">↑</button>
              <button type="button" class="aggregate-row__button" title="Move down"
                      disabled="@(index == array.Rows.Count - 1)"
                      @onclick="() => array.MoveRow(index, +1)">↓</button>
              <button type="button" class="aggregate-row__button" title="Remove entry"
                      @onclick="() => array.RemoveRow(index)">×</button>
            </span>
          </div>
        }
    </text>;

  private static readonly int MaxSseReconnectAttempts = 1;
  private static readonly JsonSerializerOptions SseJsonOptions = new()
  {
    PropertyNameCaseInsensitive = true
  };

  // One editable field per declared input. v5/v6 packages declare nothing, so
  // the fields fall back to the frozen consult_draft slot and one code path
  // renders both eras. Seeded before the package resolves — the setup form
  // renders once first.
  private List<ConsultInputField> inputFields = LegacyInputs
    .Select(input => new ConsultInputField(input, textRows: 16))
    .ToList();
  private IReadOnlyList<WorkflowPackageResultResponse>? declaredResults;
  private bool editingDraft;
  private bool runEventSeen;
  private string? runTerminalStatus;
  private string? copyFeedback;
  private int copyFeedbackToken;
  private IReadOnlyList<ConsultGenerationResultDocumentResponse> assembledDocuments = Array.Empty<ConsultGenerationResultDocumentResponse>();
  // #368: set when the record says its text was deleted under the retention policy.
  private DateTimeOffset? textDroppedAtUtc;
  // #486
  private string? deliveryOutcome;
  private bool? deliveryDocumentAttached;

  // #315: declared deliverables this job's inputs excluded.
  private IReadOnlyList<ConsultSkippedDocumentResponse> skippedDocuments = Array.Empty<ConsultSkippedDocumentResponse>();
  private string? activeDocumentId;
  private List<PackageBlock> packageBlocks = new();
  // #360: the CURRENT pin, resolved to a concrete name@vYYYY.MM.N. One meaning,
  // written in one place — beside SyncInputFields, from the same package — so
  // the ref and the form's field ids cannot disagree. Sending it is deliberate
  // rather than incidental: it pins the version the fields were built from,
  // closing the race where a floating @latest pin moves between render and
  // submit. The version a *running* job used is not this; that is on the job's
  // own snapshot (ConsultGenerationJobResponse.WorkflowPackage).
  private string? currentPackageRef;
  private string? currentPackageTitle;
  private IReadOnlyList<WorkflowManifestReader.NodeView>? workflowNodes;
  private IReadOnlyList<WorkflowManifestReader.CollectionView> workflowCollections = Array.Empty<WorkflowManifestReader.CollectionView>();

  // #361: the graph the RUNNING job declared, adopted from its snapshot. The
  // fields above are the pinned package's, which is right before a job exists
  // and wrong afterwards: re-attaching to an earlier run drew it against
  // whatever had been published since. Null until a snapshot arrives, and null
  // for a job recorded before the job carried its own roster.
  private IReadOnlyList<RailNode>? jobNodes;
  private IReadOnlyList<ConsultCollectionRoster>? jobCollections;

  /// <summary>
  /// What a rail row needs, from either source. IsResult has no wire form, but
  /// an aggregator is what a result node is in every package the block resolver
  /// accepts, and Aggregate was already being serialized.
  /// </summary>
  private sealed record RailNode(string Id, string Label, string? ForEach, bool IsResult, bool IsClassifier = false);

  private IReadOnlyList<RailNode>? RailNodes =>
    jobNodes ?? workflowNodes?.Select(node => new RailNode(node.Id, node.Label, node.ForEach, node.IsResult)).ToList();

  // v10 (#496): the boundary, as the job reports it. Deciding with no date
  // is "not yet decided" — the count is not known, and the rail says so
  // rather than showing the pinned skeleton's size.
  private bool deciding;
  private DateTimeOffset? decidedAtUtc;
  private IReadOnlyDictionary<string, string>? classifications;
  private string? decisionFailureKind;
  private string? startFailureDetail;
  // A Completed job was decided and a Failed one says how it failed; a
  // Running, Scheduled or Cancelled job may genuinely never have decided.
  private bool NotYetDecided => deciding && decidedAtUtc == null && decisionFailureKind == null && runTerminalStatus is not ("Completed" or "Failed");
  private bool HasClassifiers => RailNodes?.Any(node => node.IsClassifier) == true;
  private HashSet<string> completedNodeItems = new();

  // #356: node id -> the status the JOB reports for it. The rail used to mark
  // rows by position against a count, so a job that completed two nodes turned
  // the first two rows green whatever actually ran. Identity was on the wire the
  // whole time: node-completed carries NodeId, and the job response's NodeOutputs
  // is keyed by node id and carries a real status.
  private Dictionary<string, string> nodeStatuses = new(StringComparer.Ordinal);
  private Dictionary<string, string> generatedBlocks = new();
  private Dictionary<string, string> failedBlockErrors = new();
  private bool isBlocksLoading;
  private string? blocksLoadError;
  private bool isAiRequestLoading;
  private string? aiRequestError;
  // #434: set beside aiRequestError when the refusal left a row in History —
  // a well-formed request the package produced nothing for. Cleared with it.
  private string? refusedJobId;

  // #157: "run overnight" preset — next 2:00 AM browser-local, sent as UTC.
  // #390: the time is no longer a preset. scheduledAtLocal is the datetime-local
  // control's value; the account default seeds it when the switch goes on.
  private bool runOvernight;
  private string scheduledAtLocal = string.Empty;
  private string? accountScheduleTime;
  // #486: the verified delivery address, or null — told before submit, and in
  // the schedule confirmation, rather than promising an email that will not come.
  private string? accountDeliveryAddress;
  private bool accountDeliveryAddressKnown;
  // #518: the account's choice on emailing app-initiated runs; false = not emailed.
  private bool? accountEmailPdf;

  /// <summary>
  /// #390: turning the switch on seeds the time from the account default, so
  /// the common case is still one click. It seeds only when empty — a time the
  /// user already edited survives toggling off and on again.
  /// </summary>
  private bool RunOvernight
  {
    get => runOvernight;
    set
    {
      runOvernight = value;

      if (value && string.IsNullOrEmpty(scheduledAtLocal))
      {
        scheduledAtLocal = ScheduleDefault.ToLocalInputValue(
          ScheduleDefault.NextOccurrenceUtc(accountScheduleTime, DateTime.Now));
      }
    }
  }

  // The client refuses what the server would: ValidateRequest allows only the
  // 7-day maximum (past times run immediately and are not errors).
  private static string MaxScheduleLocal =>
    ScheduleDefault.LocalInputValueIn(TimeSpan.FromDays(7));
  private bool isSchedulingRequest;
  private string? scheduleConfirmation;
  private string? aiProgressNotice;
  private int completedBlockCount;
  private int totalBlockCount;
  private int completedAnalysisStageCount;
  private int totalAnalysisStageCount;
  private List<string>? nodeLabels;
  private CancellationTokenSource? activeEventStreamCancellationTokenSource;
  private string? activeEventStreamCancellationReason;
  private SseAttemptState? activeSseAttempt;
  private IReadOnlyList<PackageBlock> activeBlockSnapshots = Array.Empty<PackageBlock>();

  [Parameter]
  public string? JobId { get; set; }

  protected override async Task OnInitializedAsync()
  {
    Navigation.LocationChanged += HandleLocationChanged;
    await LoadScheduleDefaultAsync();
    await LoadPackageBlocksAsync();
    await LoadWorkflowNodesAsync();
    await TryReattachAsync();
  }

  // #207: re-attach to an in-flight (or just-finished) job instead of showing
  // a blank setup. The route job id (History's "watch live") wins over the
  // per-tab session; when the session matches, it supplies the draft and the
  // exact block roster the run was submitted with — the job record carries
  // neither, so a route-only entry renders without draft text and with the
  // current pin's roster (the polling fallback's existing limitation).
  private async Task TryReattachAsync()
  {
    var memento = JobSession.Current;
    var targetJobId = !string.IsNullOrWhiteSpace(JobId) ? JobId : memento?.JobId;

    if (targetJobId == null)
    {
      return;
    }

    var sessionMatches = memento != null && memento.JobId == targetJobId;

    if (sessionMatches)
    {
      // Inputs only. ApplyInputValues fills values into the fields
      // SyncInputFields already built from the current pin; it never rebuilds
      // the field set.
      //
      // #360: this used to adopt the job's package ref as well, which then went
      // out with the NEXT submit — sending the current package's input ids to
      // the previous package. That announced itself only when an id had been
      // renamed ("Unknown input(s) 'include_billing_rename'"); when the two
      // declarations happened to agree it silently ran the older version while
      // the form displayed the newer one. The version a running job used is not
      // this page's to remember: it is on the job's own snapshot, fetched below
      // and rendered by History as its provenance chip.
      ApplyInputValues(memento!.Inputs, memento.Values);
    }

    var blockSnapshots = sessionMatches
      ? memento!.Blocks.Select(block => new PackageBlock(block.Id, block.Name)).ToList()
      : packageBlocks.ToList();

    try
    {
      isAiRequestLoading = true;
      editingDraft = false;
      await InvokeAsync(StateHasChanged);

      var snapshot = await AIService.GetConsultGenerationJobAsync(targetJobId);
      ApplyConsultGenerationJobResponse(snapshot, blockSnapshots);

      // #202: Cancelled is terminal too. Without it a re-attach would open an
      // SSE stream against an orchestration that has been terminated.
      if (snapshot.Status is "Completed" or "Failed" or "Cancelled")
      {
        runTerminalStatus = snapshot.Status;
        return;
      }

      await RunAttachedJobAsync(targetJobId, blockSnapshots);
    }
    catch (AccessTokenNotAvailableException exception)
    {
      exception.Redirect();
    }
    catch (Exception ex)
    {
      aiRequestError = $"Unable to attach to job: {ex.Message}";
      runTerminalStatus = null;
      totalBlockCount = 0;
    }
    finally
    {
      isAiRequestLoading = false;
      activeSseAttempt = null;
      activeEventStreamCancellationReason = null;
    }
  }

  // The full node map is display enrichment for the run rail; failures fall
  // back to the event-fed labels. Collections ride along so each forEach
  // group lists its own collection's items — the package's Sections are the
  // deliverable's BLOCKS in v6 (they can include scalar aggregate sources),
  // not any collection's item list.
  private async Task LoadWorkflowNodesAsync()
  {
    try
    {
      var content = await WorkflowService.GetCurrentPackageContentAsync();
      workflowNodes = WorkflowManifestReader.ReadNodes(content.Manifest);
      workflowCollections = WorkflowManifestReader.ReadCollections(content.Manifest, content.Files);
    }
    catch (AccessTokenNotAvailableException exception)
    {
      exception.Redirect();
    }
    catch
    {
      workflowNodes = null;
      workflowCollections = Array.Empty<WorkflowManifestReader.CollectionView>();
    }
  }

  // A forEach node's rail items are its own collection's; the blocks list is
  // the fallback only when the collection cannot be resolved.
  //
  // #361: the JOB's roster wins when it has one. The collections below belong
  // to the pinned package, which is the right answer only before a job exists —
  // afterwards it describes whatever has been published since.
  private IReadOnlyList<(string Id, string Name)> ItemsFor(RailNode node)
  {
    const string dataPrefix = "data:";
    var collectionId = node.ForEach != null && node.ForEach.StartsWith(dataPrefix, StringComparison.Ordinal)
      ? node.ForEach[dataPrefix.Length..]
      : node.ForEach;

    var recorded = jobCollections?.FirstOrDefault(roster => roster.CollectionId == collectionId);

    if (recorded != null)
    {
      return recorded.Items.Select(item => (item.Id, item.Name)).ToList();
    }

    var collection = workflowCollections.FirstOrDefault(c => c.Id == collectionId);

    return collection != null
      ? collection.Items.Select(item => (item.Id, item.Name)).ToList()
      : packageBlocks.Select(sec => (sec.Id, sec.Name)).ToList();
  }

  /// <summary>
  /// #390: the account's preferred time, read the way the workflow pin is —
  /// tolerantly. A setting that is missing, blank or unreadable leaves the
  /// fallback in place rather than reporting anything: nobody came to this page
  /// to be told about a preference.
  /// </summary>
  /// <summary>#486: the promise matches the account — an email only where one will go.</summary>
  internal static string ScheduleConfirmationFor(DateTimeOffset scheduledAtUtc, string? deliveryAddress, bool? emailPdf = null) =>
    $"Consult scheduled for {scheduledAtUtc.ToLocalTime():MMM d, h:mm tt} — it will appear in History"
    + (emailPdf == false
      ? ", and it will not be emailed — by your choice."
      : deliveryAddress == null
      ? ", and it will not be emailed: no delivery address is verified on your profile."
      : $", and you'll receive an email at {deliveryAddress} when it's ready.");

  private async Task LoadScheduleDefaultAsync()
  {
    try
    {
      var setting = await AccountService.GetSettingAsync(ScheduleDefault.SettingKey);
      accountScheduleTime = ScheduleDefault.Parse(setting?.Value);
      var emailPdf = await AccountService.GetSettingAsync(EmailPdfPreference.SettingKey);
      accountEmailPdf = EmailPdfPreference.Parse(emailPdf?.Value);
      var me = await AccountService.GetCurrentAccountAsync();
      accountDeliveryAddress = me.DeliveryAddress;
      accountDeliveryAddressKnown = true;
    }
    catch (AccessTokenNotAvailableException exception)
    {
      exception.Redirect();
    }
    catch
    {
      // Fallback stands.
    }
  }

  private async Task LoadPackageBlocksAsync()
  {
    isBlocksLoading = true;
    blocksLoadError = null;

    try
    {
      // Sections come from the package endpoint — one server-side source for every
      // spec version. The account standards override retired with the v5 input
      // model; customization returns as package forking (the in-app editor).
      var package = await WorkflowService.GetCurrentPackageAsync();
      currentPackageRef = package.Ref;
      currentPackageTitle = package.Title;

      packageBlocks = (package.Blocks ?? Array.Empty<WorkflowPackageBlockResponse>())
        .Select(block => new PackageBlock(block.Id, block.Name))
        .ToList();

      // v7: the declaration the form renders from and the deliverables it
      // groups by. Null on v5/v6 — the fields then fall back to the frozen
      // consult_draft slot.
      declaredResults = package.Results;
      SyncInputFields(package.Inputs);
    }
    catch (AccessTokenNotAvailableException exception)
    {
      exception.Redirect();
    }
    catch (Exception ex)
    {
      packageBlocks = new();
      blocksLoadError = $"Unable to load section standards: {ex.Message}";
    }
    finally
    {
      isBlocksLoading = false;
    }
  }

  private async Task CreateConsultAsync()
  {
    editingDraft = false;
    runEventSeen = false;
    runTerminalStatus = null;
    assembledDocuments = Array.Empty<ConsultGenerationResultDocumentResponse>();
    activeDocumentId = null;
    completedNodeItems = new();
    nodeStatuses = new(StringComparer.Ordinal);
    jobNodes = null;
    jobCollections = null;
    aiRequestError = null;
    refusedJobId = null;
    aiProgressNotice = null;
    scheduleConfirmation = null;
    generatedBlocks = new();
    failedBlockErrors = new();
    completedBlockCount = 0;
    totalBlockCount = 0;
    completedAnalysisStageCount = 0;
    totalAnalysisStageCount = 0;
    nodeLabels = null;

    if (!HasEveryRequiredInput)
    {
      var missing = inputFields
        .Where(field => field.Required && !field.IsFilled)
        .Select(field => field.Label);
      aiRequestError = $"{string.Join(", ", missing)} is required.";
      return;
    }

    if (inputFields.Select(field => field.Problem).FirstOrDefault(problem => problem != null) is { } problem)
    {
      aiRequestError = problem;
      return;
    }

    if (packageBlocks.Count == 0)
    {
      aiRequestError = "No section standards are available.";
      return;
    }

    // #157: a scheduled submit never enters the run phase — the job sleeps
    // server-side and History (plus the completion email) is its surface.
    if (runOvernight)
    {
      try
      {
        isSchedulingRequest = true;
        // #390: the time the user chose. Falling back keeps a cleared field
        // from silently scheduling nothing.
        var scheduledAtUtc = ScheduleDefault.FromLocalInputValue(scheduledAtLocal)
          ?? ScheduleDefault.NextOccurrenceUtc(accountScheduleTime, DateTime.Now);
        var job = await AIService.StartConsultGenerationJobAsync(
          SuppliedInputs(), currentPackageRef, scheduledAtUtc, SuppliedFiles(), SuppliedRefs());
        scheduleConfirmation = ScheduleConfirmationFor(scheduledAtUtc, accountDeliveryAddress, accountEmailPdf);
        runOvernight = false;
        scheduledAtLocal = string.Empty;
        ClearInputs();
      }
      // #348: the server's own words, unprefixed. "Error scheduling consult"
      // in front of "no document applies to these inputs" describes a fault
      // that did not occur — the schedule was declined, not attempted.
      catch (ConsultGenerationRefusedException refusal)
      {
        aiRequestError = refusal.Message;
        refusedJobId = refusal.JobId;
      }
      catch (Exception ex)
      {
        aiRequestError = $"Error scheduling consult: {ex.Message}";
      }
      finally
      {
        isSchedulingRequest = false;
      }

      return;
    }

    try
    {
      isAiRequestLoading = true;
      var inputSnapshot = SuppliedInputs();
      var fileSnapshot = SuppliedFiles();
      // What the run displays and what re-attach restores: the text, however
      // the slot was filled. The request itself carries the files.
      var textSnapshot = EffectiveInputTexts();
      var blockSnapshots = packageBlocks.ToList();
      totalBlockCount = blockSnapshots.Count;
      await InvokeAsync(StateHasChanged);

      // Sections are package data resolved server-side; the request carries only
      // the declared inputs (and the resolved package ref).
      var job = await AIService.StartConsultGenerationJobAsync(
        inputSnapshot, currentPackageRef, files: fileSnapshot, refs: SuppliedRefs());

      // #207: remember the job per-tab so navigating away and back re-attaches.
      JobSession.Current = new ConsultJobMemento(
        job.JobId,
        textSnapshot,
        blockSnapshots.Select(block => new ConsultJobBlock(block.Id, block.Name)).ToList(),
        EffectiveInputValues());

      await RunAttachedJobAsync(job.JobId, blockSnapshots);
    }
    catch (ConsultGenerationRefusedException refusal)
    {
      aiRequestError = refusal.Message;
      refusedJobId = refusal.JobId;
    }
    catch (Exception ex)
    {
      aiRequestError = $"Error calling agent: {ex.Message}";
    }
    finally
    {
      isAiRequestLoading = false;
      activeSseAttempt = null;
      activeEventStreamCancellationReason = null;
    }
  }

  // The live-viewing block shared by submit and re-attach: stream, then fall
  // back to polling if the stream cannot complete.
  private async Task RunAttachedJobAsync(string jobId, IReadOnlyList<PackageBlock> blockSnapshots)
  {
    var streamResult = await StreamConsultGenerationJobAsync(jobId, blockSnapshots);

    if (streamResult == ConsultGenerationStreamResult.FallbackToPolling && isAiRequestLoading)
    {
      Logger.LogWarning(
        "Consult generation falling back to polling. JobId={JobId}, CompletedCount={CompletedCount}, FailedCount={FailedCount}, TotalCount={TotalCount}",
        jobId,
        generatedBlocks.Count,
        failedBlockErrors.Count,
        totalBlockCount);

      aiProgressNotice = "Live updates paused; checking status periodically.";
      MarkPollingFallbackStarted();
      await InvokeAsync(StateHasChanged);
      await PollConsultGenerationJobAsync(jobId, blockSnapshots);
    }
  }

  private async Task<ConsultGenerationStreamResult> StreamConsultGenerationJobAsync(
    string jobId,
    IReadOnlyList<PackageBlock> blockSnapshots)
  {
    activeBlockSnapshots = blockSnapshots;
    var stream = new SseStreamState(jobId);

    try
    {
      for (var reconnectAttempt = 0; reconnectAttempt <= MaxSseReconnectAttempts; reconnectAttempt++)
      {
        var attempt = stream.StartAttempt();
        activeSseAttempt = attempt;
        var lastEventId = reconnectAttempt == 0 ? null : stream.LatestEventId;

        var attemptResult = await StreamOneSseAttemptAsync(
          jobId,
          blockSnapshots,
          stream,
          attempt,
          reconnectAttempt,
          lastEventId);

        if (attemptResult == ConsultGenerationAttemptResult.Completed)
        {
          return ConsultGenerationStreamResult.Completed;
        }

        if (attemptResult == ConsultGenerationAttemptResult.FallbackToPolling
            || !CanReconnectSse(stream, reconnectAttempt))
        {
          return ConsultGenerationStreamResult.FallbackToPolling;
        }

        var reconnectBackoff = GetSseReconnectBackoff(reconnectAttempt);
        Logger.LogInformation(
          "Reconnecting consult generation SSE stream. JobId={JobId}, ReconnectAttempt={ReconnectAttempt}, LastEventId={LastEventId}, BackoffMs={BackoffMs}",
          jobId,
          reconnectAttempt + 1,
          stream.LatestEventId,
          reconnectBackoff.TotalMilliseconds);

        await Task.Delay(reconnectBackoff);

        if (!isAiRequestLoading || activeEventStreamCancellationReason != null)
        {
          return ConsultGenerationStreamResult.FallbackToPolling;
        }
      }

      return ConsultGenerationStreamResult.FallbackToPolling;
    }
    finally
    {
      activeBlockSnapshots = Array.Empty<PackageBlock>();
    }
  }

  private async Task<ConsultGenerationAttemptResult> StreamOneSseAttemptAsync(
    string jobId,
    IReadOnlyList<PackageBlock> blockSnapshots,
    SseStreamState stream,
    SseAttemptState attempt,
    int reconnectAttempt,
    string? lastEventId)
  {
    const int streamTimeoutMinutes = 10;
    using var streamCancellationTokenSource = new CancellationTokenSource();
    using var timeoutCancellationTokenSource = new CancellationTokenSource(TimeSpan.FromMinutes(streamTimeoutMinutes));
    using var linkedCancellationTokenSource = CancellationTokenSource.CreateLinkedTokenSource(
      streamCancellationTokenSource.Token,
      timeoutCancellationTokenSource.Token);
    activeEventStreamCancellationTokenSource = streamCancellationTokenSource;
    activeEventStreamCancellationReason = null;

    try
    {
      Logger.LogInformation(
        "Opening consult generation SSE stream. JobId={JobId}, AttemptId={AttemptId}, SectionCount={SectionCount}, ReconnectAttempt={ReconnectAttempt}, ResumeCursorPresent={ResumeCursorPresent}",
        jobId,
        attempt.AttemptId,
        blockSnapshots.Count,
        reconnectAttempt,
        !string.IsNullOrWhiteSpace(lastEventId));

      await foreach (var jobEvent in AIService.StreamConsultGenerationJobEventsAsync(
        jobId,
        attempt.AttemptId,
        linkedCancellationTokenSource.Token,
        lastEventId))
      {
        attempt.RecordEvent(jobEvent);
        stream.RecordEvent(jobEvent);
        var eventResult = await HandleConsultGenerationJobEventAsync(jobEvent.EventName, jobEvent.Json);

        if (eventResult.ServerErrorEventSeen)
        {
          attempt.ServerErrorEventSeen = true;
          stream.ServerErrorEventSeen = true;
        }

        if (eventResult.Result == ConsultGenerationEventResult.Completed)
        {
          ReportSseExit(attempt, GetCompletedSseExitReason(attempt, eventResult.FinalStatus));
          return ConsultGenerationAttemptResult.Completed;
        }

        if (eventResult.Result == ConsultGenerationEventResult.FallbackToPolling)
        {
          if (eventResult.FallbackDiagnosticReason != null)
          {
            ReportSseExit(attempt, eventResult.FallbackDiagnosticReason);
          }

          return ConsultGenerationAttemptResult.FallbackToPolling;
        }
      }

      Logger.LogWarning(
        "Consult generation SSE stream ended before done. JobId={JobId}, AttemptId={AttemptId}, ReconnectAttempt={ReconnectAttempt}",
        jobId,
        attempt.AttemptId,
        reconnectAttempt);

      if (attempt.ServerErrorEventSeen)
      {
        ReportSseExit(attempt, "server-error-event");
        return ConsultGenerationAttemptResult.Completed;
      }

      ReportSseExit(attempt, "ended-before-done");
      return ConsultGenerationAttemptResult.RetrySse;
    }
    catch (OperationCanceledException) when (timeoutCancellationTokenSource.IsCancellationRequested
                                            && !streamCancellationTokenSource.IsCancellationRequested)
    {
      Logger.LogWarning(
        "Consult generation SSE stream timed out before completion. JobId={JobId}, TimeoutMinutes={TimeoutMinutes}",
        jobId,
        streamTimeoutMinutes);

      ReportSseExit(attempt, "timeout");
      return ConsultGenerationAttemptResult.RetrySse;
    }
    catch (OperationCanceledException)
    {
      var reason = activeEventStreamCancellationReason ?? "manual-cancel";
      Logger.LogWarning(
        "Consult generation SSE stream canceled. JobId={JobId}, AttemptId={AttemptId}, Reason={Reason}",
        jobId,
        attempt.AttemptId,
        reason);

      ReportSseExit(attempt, reason);
      return ConsultGenerationAttemptResult.FallbackToPolling;
    }
    catch (AccessTokenNotAvailableException ex)
    {
      Logger.LogWarning(
        ex,
        "Consult generation SSE stream authorization failed. JobId={JobId}, AttemptId={AttemptId}",
        jobId,
        attempt.AttemptId);

      ReportSseExit(attempt, "exception");
      return ConsultGenerationAttemptResult.FallbackToPolling;
    }
    catch (Exception ex)
    {
      Logger.LogWarning(
        ex,
        "Consult generation SSE stream setup failed. JobId={JobId}",
        jobId);

      ReportSseExit(attempt, "exception");
      return ConsultGenerationAttemptResult.RetrySse;
    }
    finally
    {
      if (ReferenceEquals(activeEventStreamCancellationTokenSource, streamCancellationTokenSource))
      {
        activeEventStreamCancellationTokenSource = null;
      }
    }
  }

  private async Task PollConsultGenerationJobAsync(string jobId, IReadOnlyList<PackageBlock> blockSnapshots)
  {
    try
    {
      while (isAiRequestLoading)
      {
        var response = await AIService.GetConsultGenerationJobAsync(jobId);

        ApplyConsultGenerationJobResponse(response, blockSnapshots);
        await InvokeAsync(StateHasChanged);

        if (response.Status is "Completed" or "Failed" or "Cancelled")
        {
          runTerminalStatus = response.Status;
          aiProgressNotice = null;
          MarkPollingFallbackCompleted();
          return;
        }

        await Task.Delay(TimeSpan.FromSeconds(2));
      }
    }
    catch (Exception ex)
    {
      aiProgressNotice = null;
      aiRequestError = $"Error checking consult generation status: {ex.Message}";
    }
  }

  private async Task<ConsultGenerationEventHandlingResult> HandleConsultGenerationJobEventAsync(string eventName, string json)
  {
    try
    {
      switch (eventName)
      {
        case "snapshot":
          var snapshot = JsonSerializer.Deserialize<ConsultGenerationJobResponse>(json, SseJsonOptions);
          if (snapshot != null)
          {
            Logger.LogInformation(
              "Consult generation SSE snapshot received. JobId={JobId}, Status={Status}, TotalCount={TotalCount}, CompletedCount={CompletedCount}, FailedCount={FailedCount}",
              snapshot.JobId,
              snapshot.Status,
              snapshot.TotalBlockCount,
              snapshot.CompletedBlockCount,
              snapshot.FailedBlockCount);

            ApplyConsultGenerationJobResponse(snapshot, GetActiveBlockSnapshots());
          }
          break;

        case "block-completed":
          var completed = JsonSerializer.Deserialize<ConsultGenerationBlockCompletedEvent>(json, SseJsonOptions);
          if (completed != null)
          {
            generatedBlocks = new Dictionary<string, string>(generatedBlocks)
            {
              [completed.BlockId] = completed.Text
            };
            var nextFailedSections = new Dictionary<string, string>(failedBlockErrors);
            nextFailedSections.Remove(completed.BlockId);
            failedBlockErrors = nextFailedSections;
            completedBlockCount = generatedBlocks.Count + failedBlockErrors.Count;
          }
          break;

        case "block-failed":
          var failed = JsonSerializer.Deserialize<ConsultGenerationBlockFailedEvent>(json, SseJsonOptions);
          if (failed != null)
          {
            failedBlockErrors = new Dictionary<string, string>(failedBlockErrors)
            {
              [failed.BlockId] = failed.Error
            };
            var nextGeneratedSections = new Dictionary<string, string>(generatedBlocks);
            nextGeneratedSections.Remove(failed.BlockId);
            generatedBlocks = nextGeneratedSections;
            completedBlockCount = generatedBlocks.Count + failedBlockErrors.Count;
            UpdateFailedBlockError(GetActiveBlockSnapshots());
          }
          break;

        case "node-completed":
          var nodeEvent = JsonSerializer.Deserialize<ConsultGenerationNodeCompletedEvent>(json, SseJsonOptions);
          if (nodeEvent != null)
          {
            aiProgressNotice = string.IsNullOrWhiteSpace(nodeEvent.Label) ? "Generating consult" : nodeEvent.Label;
            // #356: the id is what the rail marks on. The counts stay for the
            // manifest-less fallback branch, which has no ids to match.
            nodeStatuses[nodeEvent.NodeId] = "Completed";
            // Node events are per-key deduped server-side; keep counts monotonic.
            completedAnalysisStageCount = Math.Max(completedAnalysisStageCount, nodeEvent.CompletedNodeCount);
            totalAnalysisStageCount = nodeEvent.TotalNodeCount;
          }
          break;

        case "item-step":
          var sectionStep = JsonSerializer.Deserialize<ConsultGenerationItemStepEvent>(json, SseJsonOptions);
          if (sectionStep != null)
          {
            var stepLabel = string.IsNullOrWhiteSpace(sectionStep.Label) ? "Generating section" : sectionStep.Label;
            aiProgressNotice = $"{stepLabel}: {sectionStep.ItemName}";
            // Step is the forEach node id that just completed for this section
            // (one event per node/section pair) — the run rail's per-group ticks.
            completedNodeItems.Add($"{sectionStep.Step}:{sectionStep.ItemId}");
          }
          break;

        case "done":
          var final = JsonSerializer.Deserialize<ConsultGenerationJobResponse>(json, SseJsonOptions);
          if (final != null)
          {
            Logger.LogInformation(
              "Consult generation SSE done received. JobId={JobId}, Status={Status}, TotalCount={TotalCount}, CompletedCount={CompletedCount}, FailedCount={FailedCount}",
              final.JobId,
              final.Status,
              final.TotalBlockCount,
              final.CompletedBlockCount,
              final.FailedBlockCount);

            ApplyConsultGenerationJobResponse(final, GetActiveBlockSnapshots());
          }

          runTerminalStatus = final?.Status ?? "Completed";
          await InvokeAsync(StateHasChanged);
          return new ConsultGenerationEventHandlingResult(
            ConsultGenerationEventResult.Completed,
            FinalStatus: final?.Status);

        case "error":
          var error = JsonSerializer.Deserialize<ConsultGenerationErrorEvent>(json, SseJsonOptions);
          if (error != null && IsPreprocessingFailureStage(error.Stage))
          {
            aiProgressNotice = null;
            aiRequestError = error.Error;
            runTerminalStatus = "Failed";
            isAiRequestLoading = false;
            await InvokeAsync(StateHasChanged);
            return new ConsultGenerationEventHandlingResult(
              ConsultGenerationEventResult.Continue,
              ServerErrorEventSeen: true);
          }

          Logger.LogWarning(
            "Consult generation SSE error event received. PayloadLength={PayloadLength}",
            json.Length);

          return new ConsultGenerationEventHandlingResult(
            ConsultGenerationEventResult.FallbackToPolling,
            ServerErrorEventSeen: true,
            FallbackDiagnosticReason: "server-error-event");
      }

      await InvokeAsync(StateHasChanged);
      return new ConsultGenerationEventHandlingResult(ConsultGenerationEventResult.Continue);
    }
    catch
    {
      Logger.LogWarning(
        "Consult generation SSE event handling failed. EventName={EventName}, PayloadLength={PayloadLength}",
        eventName,
        json.Length);

      return new ConsultGenerationEventHandlingResult(
        ConsultGenerationEventResult.FallbackToPolling,
        FallbackDiagnosticReason: "exception");
    }
  }

  private void ApplyConsultGenerationJobResponse(
    ConsultGenerationJobResponse response,
    IReadOnlyList<PackageBlock> blockSnapshots)
  {
    // Every payload applied here is snapshot-shaped (the snapshot event, a
    // done payload, or a polled response) — the rail's Setup row completes
    // on it.
    runEventSeen = true;
    generatedBlocks = response.GeneratedBlocks;
    textDroppedAtUtc = response.TextDroppedAtUtc;
    deciding = response.Deciding == true;
    decidedAtUtc = response.DecidedAtUtc;
    classifications = response.Classifications ?? classifications;
    decisionFailureKind = response.DecisionFailureKind;
    startFailureDetail = response.StartFailure ?? startFailureDetail;
    deliveryOutcome = response.DeliveryOutcome;
    deliveryDocumentAttached = response.DeliveryDocumentAttached;

    // The deliverables, present on Completed payloads only and kept once seen.
    // v7 sends the set; v6 sends one string, which becomes a one-entry set so
    // the render path is shared.
    if (response.AssembledDocuments is { Count: > 0 })
    {
      assembledDocuments = response.AssembledDocuments;
    }

    // Kept once seen, like the documents: a later poll that omits them must
    // not make the explanation disappear.
    if (response.SkippedDocuments is { Count: > 0 })
    {
      skippedDocuments = response.SkippedDocuments;
    }
    else if (response.AssembledDocument != null)
    {
      assembledDocuments = new[]
      {
        new ConsultGenerationResultDocumentResponse("consult", "Consultation note", response.AssembledDocument)
      };
    }
    failedBlockErrors = response.FailedBlocks;
    // v10 (#496): while the job is deciding, zero means "not yet decided" and
    // must not fall back to the pinned skeleton's size.
    totalBlockCount = response.TotalBlockCount == 0 && !(deciding && response.DecidedAtUtc == null) ? blockSnapshots.Count : response.TotalBlockCount;
    completedBlockCount = response.CompletedBlockCount + response.FailedBlockCount;

    // #361: the job's own graph. One seam covers the SSE snapshot and done
    // events, every poll and the re-attach fetch; for a new job it is a no-op,
    // since its package and the pin are the same package.
    if (response.Nodes is { Count: > 0 })
    {
      jobNodes = response.Nodes
        .Select(node => new RailNode(node.Id, node.Label, node.ForEach, node.Aggregate is { Count: > 0 },
          IsClassifier: string.Equals(node.OutputContract, "classification", StringComparison.Ordinal)))
        .ToList();
    }

    if (response.Collections is { Count: > 0 })
    {
      jobCollections = response.Collections;
    }

    // #356: the job's own per-node verdict, keyed by node id. Composite
    // "nodeId:itemId" entries are fan instances and belong to the item rows, not
    // to a node row. This is the authoritative source and covers snapshot, poll,
    // done and re-attach alike.
    if (response.NodeOutputs is { Count: > 0 })
    {
      foreach (var (key, output) in response.NodeOutputs.Where(entry => !entry.Key.Contains(':', StringComparison.Ordinal)))
      {
        nodeStatuses[key] = output.Status;
      }
    }

    if (response.Status != "Failed"
        && response.Nodes is { Count: > 0 }
        && response.CompletedStageCount.HasValue
        && response.CompletedStageCount.Value < response.Nodes.Count)
    {
      // The next in-flight node's package-declared label is the progress notice
      // — the first node the job has not reported complete, not the one at the
      // completed count's index (#356).
      aiProgressNotice = (response.Nodes.FirstOrDefault(node =>
          !nodeStatuses.TryGetValue(node.Id, out var status) || status != "Completed")
        ?? response.Nodes[response.CompletedStageCount.Value]).Label;
    }

    if (response.CompletedStageCount.HasValue)
      completedAnalysisStageCount = response.CompletedStageCount.Value;
    if (response.TotalStageCount.HasValue)
      totalAnalysisStageCount = response.TotalStageCount.Value;
    if (response.Nodes is { Count: > 0 })
      nodeLabels = response.Nodes.Select(node => node.Label).ToList();

    if (response.Status == "Failed" && !string.IsNullOrWhiteSpace(response.AnalysisError))
    {
      aiProgressNotice = null;
      aiRequestError = response.AnalysisError;
      return;
    }

    if (response.Status == "Failed" && !string.IsNullOrWhiteSpace(response.RuntimeFailureError))
    {
      aiProgressNotice = null;
      aiRequestError = response.RuntimeFailureError;
      return;
    }

    UpdateFailedBlockError(blockSnapshots);
  }

  private static bool IsPreprocessingFailureStage(string? stage)
  {
    return !string.IsNullOrWhiteSpace(stage)
      && stage.EndsWith("-failed", StringComparison.Ordinal);
  }

  // v10 (#496): a deciding job has no count yet and is still a run.
  private bool IsRunPhase => !editingDraft && (isAiRequestLoading || totalBlockCount > 0 || deciding);

  // The frozen v5/v6 slot, synthesized when a package declares nothing: one
  // required input labelled as the page always labelled it.
  private static readonly IReadOnlyList<WorkflowPackageInputResponse> LegacyInputs =
    new[] { new WorkflowPackageInputResponse("consult_draft", "Consult draft", true) };

  private bool IsMultiDeliverable => declaredResults is { Count: > 1 };

  // v7 block ids carry the deliverable: "{resultId}:{nodeId}[:{itemId}]".
  private IEnumerable<PackageBlock> BlocksFor(string resultId) =>
    packageBlocks.Where(block => block.Id.StartsWith($"{resultId}:", StringComparison.Ordinal));

  private string SectionSummary =>
    IsMultiDeliverable
      ? $"{declaredResults!.Count} documents · {BlocksFor(declaredResults[0].Id).Count()} sections each"
      : $"{packageBlocks.Count} sections";

  // Rebuilds the fields for a package's declaration, carrying whatever was
  // already supplied into an id the new package still declares — switching
  // packages never smuggles a stale input into a run.
  //
  // #236: an attachment carries the same way typed text does. Dropping it
  // would discard an upload the clinician just made without asking, and would
  // leave the two ways of filling a slot behaving differently for no reason
  // they could see.
  private void SyncInputFields(IReadOnlyList<WorkflowPackageInputResponse>? declaration)
  {
    Console.WriteLine($"[#510] SyncInputFields declared={declaration?.Count}");
    var carried = inputFields.ToDictionary(field => field.Id, field => field, StringComparer.Ordinal);

    var declared = declaration is { Count: > 0 } ? declaration : LegacyInputs;

    inputFields = declared
      .Select(input =>
      {
        var field = new ConsultInputField(input, textRows: declared.Count == 1 ? 16 : 6);

        // #429: the whole answer carries — a chosen boolean too, which used
        // to be dropped here — but only into a slot of the same shape.
        if (carried.TryGetValue(input.Id, out var previous))
        {
          field.AdoptFrom(previous);
        }

        return field;
      })
      .ToList();
  }

  // Re-attaching to a running job restores what it ran on — as typed when
  // the memento holds it so (#429), as text before that. Either way an
  // attachment in the form is stale by definition: the document travelled
  // as the text the server read.
  private void ApplyInputValues(
    IReadOnlyDictionary<string, string> values,
    IReadOnlyDictionary<string, ConsultInputValue>? typed)
  {
    foreach (var field in inputFields)
    {
      if (typed != null && typed.TryGetValue(field.Id, out var value))
      {
        field.Restore(value);
      }
      else
      {
        field.RestoreText(values.GetValueOrDefault(field.Id, string.Empty));
      }
    }
  }

  // What re-attach restores: each slot as typed, a document slot as the text
  // the server read — one element per document for an array of text.
  private Dictionary<string, ConsultInputValue> EffectiveInputValues() =>
    inputFields
      .Where(field => field.IsFilled)
      .ToDictionary(field => field.Id, field => field.EffectiveValue, StringComparer.Ordinal);

  // #236: clears the whole slot, not just its text. Leaving the attachment
  // behind left a scheduled submit showing "loaded referral.txt" over an
  // empty box — a label describing something that was no longer there.
  private void ClearInputs()
  {
    Console.WriteLine("[#510] ClearInputs");
    foreach (var field in inputFields)
    {
      field.Clear();
    }

    scheduleConfirmation = null;
  }

  // #236: bytes accepted before anything is uploaded, so a huge file is not
  // sent merely to be refused. A size bound, not format knowledge — the
  // parser is the only thing that knows what a format is, and it applies the
  // same bound server-side (ConsultGenerationJobs.MaxInputFileBytes).
  private const int MaxUploadBytes = 10 * 1024 * 1024;

  private async Task LoadFileAsync(ConsultInputField field, InputFileChangeEventArgs args)
  {
    if (args.FileCount == 0)
    {
      return;
    }

    // #429: an array of text takes several, in the order chosen; anything
    // else takes one — the server's own rule. args.File throws for several,
    // which is what made a multi-select unsupported rather than unused.
    var files = field.TakesSeveralDocuments
      ? args.GetMultipleFiles(args.FileCount)
      : new[] { args.File };

    // Attaching a file is an edit like any other: a stale confirmation would
    // outlive what it described.
    field.FileError = null;
    scheduleConfirmation = null;
    field.IsReading = true;
    await InvokeAsync(StateHasChanged);

    var refusals = new List<string>();

    try
    {
      foreach (var file in files)
      {
        // Among several, the refusal names which — the filename stays in the
        // browser, as every filename does. Alone, it is the server's sentence
        // verbatim, as it always was.
        string Refused(string sentence) => files.Count == 1 ? sentence : $"{file.Name}: {sentence}";

        if (file.Size > MaxUploadBytes)
        {
          refusals.Add(Refused($"That file is larger than {MaxUploadBytes / (1024 * 1024)} MB."));
          continue;
        }

        try
        {
          using var buffer = new MemoryStream();
          await using (var stream = file.OpenReadStream(MaxUploadBytes))
          {
            await stream.CopyToAsync(buffer);
          }

          var content = buffer.ToArray();
          var outcome = await DocumentService.ExtractAsync(content, file.ContentType);

          if (!outcome.Succeeded)
          {
            // The server's own sentence for this cause, shown verbatim. The
            // slot stays as it was, so a refused file changes nothing.
            refusals.Add(Refused(outcome.Error!));
            continue;
          }

          // The file becomes the input. What was typed is left alone
          // underneath so that removing the file gives it back.
          if (!field.TakesSeveralDocuments)
          {
            field.Documents.Clear();
          }

          field.Documents.Add(new AttachedDocument(
            file.Name,
            string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType,
            content,
            outcome.PageCount,
            outcome.Text!));
        }
        catch (Exception ex)
        {
          refusals.Add(Refused($"That file could not be read: {ex.Message}"));
        }
      }
    }
    finally
    {
      field.IsReading = false;
      field.FileError = refusals.Count > 0 ? string.Join(" ", refusals) : null;
    }
  }

  private void MoveDocument(ConsultInputField field, int index, int delta)
  {
    (field.Documents[index], field.Documents[index + delta]) = (field.Documents[index + delta], field.Documents[index]);
    scheduleConfirmation = null;
  }

  private void RemoveDocument(ConsultInputField field, int index)
  {
    field.Documents.RemoveAt(index);
    scheduleConfirmation = null;
  }

  // #510: a previous run's deliverable into the slot. A text slot takes one
  // (replacing what was there); an array of text takes one per entry. Typed
  // rows and documents give way: a slot is text, files or references.
  private void LoadDeliverable(ConsultInputField field, LoadedDeliverable loaded)
  {
    Console.WriteLine($"[#510] LoadDeliverable slot={field.Id} sameInstance={ReferenceEquals(field, inputFields.FirstOrDefault(f => f.Id == field.Id))} loadedBefore={field.Loaded.Count}");
    if (!field.TakesSeveralDocuments)
    {
      field.Clear();
    }
    else if (!field.HasLoaded)
    {
      field.Clear();
    }

    field.Loaded.Add(loaded);
    scheduleConfirmation = null;
    Console.WriteLine($"[#510] LoadDeliverable done slot={field.Id} loadedAfter={field.Loaded.Count} hasLoaded={field.HasLoaded}");
  }

  private void RemoveLoaded(ConsultInputField field, int index)
  {
    Console.WriteLine($"[#510] RemoveLoaded slot={field.Id} index={index}");
    field.Loaded.RemoveAt(index);
    scheduleConfirmation = null;
  }

  private void RemoveFile(ConsultInputField field)
  {
    field.Documents.Clear();
    field.FileError = null;
    scheduleConfirmation = null;
  }

  // What the request carries: declared ids with text, for slots filled by
  // typing. Blank optional inputs are omitted, not sent empty — the API
  // rejects blank values, and the effective-input hash covers exactly what
  // was supplied.
  // Tri-state, so an untouched required boolean blocks the run instead of
  // quietly submitting false. Razor cannot parse a switch expression inside an
  // inline lambda, which is the only reason this is a method.
  private static void SetFlag(ScalarSlot slot, string? choice) =>
    slot.Flag = choice switch
    {
      "true" => true,
      "false" => false,
      _ => null
    };

  private Dictionary<string, ConsultInputValue> SuppliedInputs() =>
    inputFields
      .Where(field => !field.HasFile && !field.HasLoaded && field.Supplied is not null)
      .ToDictionary(field => field.Id, field => field.Supplied!, StringComparer.Ordinal);

  // #510: the references. The server copies each run's text and records the
  // origin; the text the form showed was only a preview.
  private Dictionary<string, IReadOnlyList<ConsultInputRef>>? SuppliedRefs()
  {
    var refs = inputFields
      .Where(field => field.HasLoaded)
      .ToDictionary(
        field => field.Id,
        field => (IReadOnlyList<ConsultInputRef>)field.Loaded.Select(loaded => loaded.Reference).ToList(),
        StringComparer.Ordinal);
    // Null, not empty: a request with nothing loaded is the request it always was.
    return refs.Count > 0 ? refs : null;
  }

  // #236: the attached documents. The file travels rather than its text, so
  // the server extracts it and the record says what read it. #428: a slot
  // lists its documents, in the order chosen.
  private Dictionary<string, IReadOnlyList<InputFilePayload>> SuppliedFiles() =>
    inputFields
      .Where(field => field.HasFile)
      .ToDictionary(
        field => field.Id,
        field => (IReadOnlyList<InputFilePayload>)field.Documents
          .Select(document => new InputFilePayload(document.ContentType, document.Content))
          .ToList(),
        StringComparer.Ordinal);

  // What every display surface and memento shows: the text that ran,
  // whichever way the slot was filled.
  private Dictionary<string, string> EffectiveInputTexts() =>
    inputFields
      .Where(field => field.IsFilled)
      .ToDictionary(field => field.Id, field => field.EffectiveText, StringComparer.Ordinal);

  // NB: 'field' is a contextual keyword inside property accessors (C# 14), so
  // the lambdas below name their parameter 'entry'.
  private bool HasEveryRequiredInput =>
    inputFields.Where(entry => entry.Required).All(entry => entry.IsFilled);

  // #429: a value that is present and wrong — on an optional slot as much as
  // a required one — must not be quietly omitted. Named, and the run waits.
  private bool HasNoInputProblems => inputFields.All(entry => entry.Problem is null);

  private bool HasAnyInput => inputFields.Any(entry => entry.IsFilled);

  // The draft bar summarizes the first supplied input — the primary slot in
  // every package shape we ship.
  private string DraftSnippet
  {
    get
    {
      var first = inputFields
        .Select(entry => entry.EffectiveText)
        .FirstOrDefault(value => !string.IsNullOrWhiteSpace(value)) ?? string.Empty;
      var flattened = first.ReplaceLineEndings(" ").Trim();
      // Empty when re-attached from another tab — the record carries no inputs.
      return flattened.Length == 0 ? "—"
        : flattened.Length <= 80 ? flattened
        : flattened[..80] + "…";
    }
  }

  private void EditDraft()
  {
    editingDraft = true;
  }

  private void BackToRun()
  {
    editingDraft = false;
  }

  // The tab in view: the selected deliverable, else the first (result-set order).
  private ConsultGenerationResultDocumentResponse? ActiveDocument =>
    assembledDocuments.FirstOrDefault(document => document.ResultId == activeDocumentId)
      ?? assembledDocuments.FirstOrDefault();

  private string CopyButtonLabel => copyFeedback ?? "Copy note";

  // Copies the finished note as plain text: the document in view verbatim (the
  // active tab when a package declares several), or note-ordered sections —
  // name on its own line, prose below, blank line between (v5).
  private async Task CopyNoteAsync()
  {
    var text = ActiveDocument?.Text ?? string.Join("\n\n", packageBlocks
      .Where(standard => generatedBlocks.TryGetValue(standard.Id, out var prose) && !string.IsNullOrWhiteSpace(prose))
      .Select(standard => $"{standard.Name}\n{generatedBlocks[standard.Id].Trim()}"));

    try
    {
      await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
      copyFeedback = "Copied ✓";
    }
    catch (Exception)
    {
      copyFeedback = "Copy failed";
    }

    var token = ++copyFeedbackToken;
    await Task.Delay(TimeSpan.FromSeconds(2));

    if (token == copyFeedbackToken)
    {
      copyFeedback = null;
      await InvokeAsync(StateHasChanged);
    }
  }

  // A new pin resolves to a different package: reload the sections and the
  // node map from it.
  private async Task OnPackagePinnedAsync()
  {
    await LoadPackageBlocksAsync();
    await LoadWorkflowNodesAsync();
  }

  // Setup covers standards resolution and job submission; the snapshot event
  // marks it done — symmetric with done/error resolving the Done row.
  private string? SetupRowStatus()
  {
    return runEventSeen || !isAiRequestLoading ? "Completed" : "Running";
  }

  // Block ids are composite — "nodeId:itemId" in v6, "resultId:nodeId:itemId"
  // in v7 — while the live prose-step events carry the plain item id. The item
  // is always the last segment, so matching on it covers every spec version
  // (v5's plain ids have no separator at all).
  private static string ItemPart(string sectionId)
  {
    var separator = sectionId.LastIndexOf(':');
    return separator < 0 ? sectionId : sectionId[(separator + 1)..];
  }

  // Per-item status under one forEach node, keyed by the plain item id (the
  // prose-step events' currency). Pair ticks come from those events; a done
  /// <summary>
  /// #356: a row's glyph comes from what the job says about THAT node, matched
  /// by id — never from its position against a count. The count could not carry
  /// the information: the node-completed event's CompletedNodeCount is a rank
  /// among completed nodes in manifest order, recomputed at synthesis, so a DAG
  /// that finishes its third node first reports 1 and the rail ticked the first.
  ///
  /// Running is the one status the server cannot tell us mid-run: node outputs
  /// are written on completion, and the snapshot event is deduped under a fixed
  /// key so only the first is ever sent. So it is inferred — the earliest
  /// unsettled row while the job is in flight — and kept deliberately as a guess
  /// about WHERE work is, never a claim that anything finished.
  /// </summary>
  private string? NodeRowStatus(RailNode node, int index)
  {
    if (nodeStatuses.TryGetValue(node.Id, out var status))
    {
      return status;
    }

    if (!isAiRequestLoading || RailNodes is not { } railNodes)
    {
      return null;
    }

    var earliestUnsettled = railNodes
      .TakeWhile(candidate => nodeStatuses.ContainsKey(candidate.Id))
      .Count();

    return index == earliestUnsettled ? "Running" : null;
  }

  // node covers items whose events were missed (polling fallback), and failed
  // sections — keyed by composite block ids in v6 — skip their remaining steps.
  private string? NodeItemStatus(RailNode node, bool nodeDone, bool nodeCurrent, string itemId)
  {
    if (completedNodeItems.Contains($"{node.Id}:{ItemPart(itemId)}")
        || completedNodeItems.Contains($"{node.Id}:{itemId}")
        || (node.IsResult && generatedBlocks.ContainsKey(itemId)))
    {
      return "Completed";
    }

    if (failedBlockErrors.Keys.Any(key => key == itemId || ItemPart(key) == itemId))
    {
      return "Failed";
    }

    if (nodeDone)
    {
      return "Completed";
    }

    if (nodeCurrent)
    {
      return "Running";
    }

    return null;
  }

  // The Done row resolves only on a terminal signal: the done event, an error
  // event, or a terminal polled status. Failed sections downgrade a Completed
  // status, matching the error bars.
  // v10 (#496): the deciding stage's own verdict — every classifier's, folded.
  private string? DecidingRowStatus()
  {
    if (decisionFailureKind != null)
    {
      return "Failed";
    }

    if (decidedAtUtc != null)
    {
      return "Completed";
    }

    var classifiers = RailNodes?.Where(node => node.IsClassifier).ToList() ?? new List<RailNode>();
    if (classifiers.Any(node => nodeStatuses.GetValueOrDefault(node.Id) == "Failed"))
    {
      return "Failed";
    }

    return classifiers.Count > 0 && classifiers.All(node => nodeStatuses.GetValueOrDefault(node.Id) == "Completed")
      ? "Completed"
      : isAiRequestLoading || (runEventSeen && runTerminalStatus == null) ? "Running" : null;
  }

  private string? DoneRowStatus()
  {
    if (runTerminalStatus != null)
    {
      return runTerminalStatus == "Failed" || !string.IsNullOrEmpty(aiRequestError)
        ? "Failed"
        : "Completed";
    }

    // The run stopped without a terminal event (e.g., the submit call threw).
    if (!isAiRequestLoading && !string.IsNullOrEmpty(aiRequestError))
    {
      return "Failed";
    }

    return null;
  }

  // ⊘ is Skipped and ○ is not-started: a node the job decided against and one it
  // has not reached yet are different facts, and after #356 the rail can tell
  // them apart. History spends ○ on Skipped and · on not-started; the rail keeps
  // ○ where it has always been, so no existing row's glyph moves.
  private static string RunStatusGlyph(string? status) => status switch
  {
    "Completed" => "✓",
    "Failed" => "✗",
    "Running" => "●",
    "Skipped" => "⊘",
    _ => "○"
  };

  private static string RunStatusCss(string? status) => status switch
  {
    "Completed" => "node-status--success",
    "Failed" => "node-status--failure",
    "Running" => "node-status--current",
    "Skipped" => "node-status--skipped",
    _ => "node-status--muted"
  };

  private string GetStageChecklistLabel(int stepNum)
  {
    // Labels come from the job's package-declared nodes; the generic fallback covers
    // the moments before the first snapshot arrives.
    if (nodeLabels != null && stepNum >= 1 && stepNum <= nodeLabels.Count)
    {
      return nodeLabels[stepNum - 1];
    }

    return $"Stage {stepNum}";
  }

  private void UpdateFailedBlockError(IReadOnlyList<PackageBlock> blockSnapshots)
  {
    if (failedBlockErrors.Count == 0)
    {
      if (aiRequestError?.StartsWith("Unable to generate:", StringComparison.Ordinal) == true)
      {
        aiRequestError = null;
      }

      return;
    }

    var failedSectionNames = blockSnapshots
      .Where(section => failedBlockErrors.ContainsKey(section.Id))
      .Select(section => section.Name);

    aiRequestError = $"Unable to generate: {string.Join(", ", failedSectionNames)}.";
  }

  private void MarkPollingFallbackStarted()
  {
    if (activeSseAttempt == null)
    {
      return;
    }

    activeSseAttempt.PollingFallbackStarted = true;
    ReportSseExit(activeSseAttempt, "polling-fallback-started");
  }

  private void MarkPollingFallbackCompleted()
  {
    if (activeSseAttempt == null)
    {
      return;
    }

    activeSseAttempt.PollingFallbackStarted = true;
    activeSseAttempt.PollingFallbackCompleted = true;
    ReportSseExit(activeSseAttempt, "polling-fallback-completed");
  }

  private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
  {
    CancelActiveEventStream("navigation");
  }

  private void CancelActiveEventStream(string reason)
  {
    activeEventStreamCancellationReason ??= reason;

    if (IsLifecycleSseExitReason(reason))
    {
      isAiRequestLoading = false;
    }

    if (activeSseAttempt != null)
    {
      ReportSseExit(activeSseAttempt, reason);
    }

    try
    {
      activeEventStreamCancellationTokenSource?.Cancel();
    }
    catch (ObjectDisposedException)
    {
    }
  }

  private void ReportSseExit(SseAttemptState attempt, string reason)
  {
    if (IsTerminalSseExitReason(reason))
    {
      if (attempt.TerminalExitReported)
      {
        return;
      }

      attempt.TerminalExitReported = true;
    }

    if (IsLifecycleSseExitReason(reason))
    {
      if (attempt.LifecycleExitReported)
      {
        return;
      }

      attempt.LifecycleExitReported = true;
    }

    _ = SseDiagnostics.ReportSseExitAsync(new SseExitDiagnostic(
      attempt.JobId,
      attempt.AttemptId,
      reason,
      attempt.LatestEventId,
      attempt.LatestEventType,
      attempt.EventCount,
      attempt.ElapsedMs,
      attempt.PollingFallbackStarted,
      attempt.PollingFallbackCompleted));
  }

  private static bool IsLifecycleSseExitReason(string reason)
  {
    return reason is "component-disposed" or "navigation";
  }

  private static bool IsTerminalSseExitReason(string reason)
  {
    return reason is "completed-via-sse"
      or "server-error-event"
      or "ended-before-done"
      or "timeout"
      or "exception"
      or "manual-cancel";
  }

  private static string GetCompletedSseExitReason(SseAttemptState attempt, string? finalStatus)
  {
    return attempt.ServerErrorEventSeen || finalStatus == "Failed"
      ? "server-error-event"
      : "completed-via-sse";
  }

  private static bool CanReconnectSse(SseStreamState stream, int reconnectAttempt)
  {
    if (MaxSseReconnectAttempts <= 0)
    {
      return false;
    }

    return reconnectAttempt < MaxSseReconnectAttempts
      && !stream.TerminalEventSeen
      && (!string.IsNullOrWhiteSpace(stream.LatestEventId) || stream.EventCount == 0);
  }

  private static TimeSpan GetSseReconnectBackoff(int reconnectAttempt)
  {
    return reconnectAttempt switch
    {
      0 => TimeSpan.FromMilliseconds(500),
      1 => TimeSpan.FromMilliseconds(1500),
      _ => TimeSpan.FromSeconds(3)
    };
  }

  private IReadOnlyList<PackageBlock> GetActiveBlockSnapshots()
  {
    return activeBlockSnapshots.Count > 0
      ? activeBlockSnapshots
      : packageBlocks;
  }

  // One deliverable block of the pinned package (v5: a section; v6: the
  // result aggregator's expansion) — the note-stream and tally roster.
  private sealed record PackageBlock(string Id, string Name);

  /// <summary>
  /// One scalar answer: a scalar input's value, one element of an array, or
  /// one field of an object. The control binds to it wherever it sits. A
  /// mutable class, not a record: the text area binds to Value directly,
  /// which is the only shape Blazor's expression formatter accepts inside a
  /// loop (an indexer keyed by a property access throws at render time).
  /// </summary>
  private sealed class ScalarSlot
  {
    public ScalarSlot(string id, string label, bool required, string? type, IReadOnlyList<string>? values, int rows, string? placeholder = null)
    {
      Id = id;
      Label = label;
      Required = required;
      Type = type ?? WorkflowInputTypes.Text;
      Values = values ?? Array.Empty<string>();
      Rows = rows;
      Placeholder = placeholder ?? $"Enter {label.ToLowerInvariant()}...";
    }

    public string Id { get; }
    public string Label { get; }
    public bool Required { get; }
    public string Type { get; }
    public IReadOnlyList<string> Values { get; }
    public int Rows { get; }
    public string Placeholder { get; }

    // text, date, enum — and a number, as typed: the canonical form is the
    // caller's own spelling, so "1.50" is sent as "1.50".
    public string Value { get; set; } = string.Empty;

    /// <summary>
    /// A boolean's value, held apart from Value so an untouched control is
    /// distinguishable from a false one. Explicit initialisation: null until
    /// the clinician chooses, never defaulted to false.
    /// </summary>
    public bool? Flag { get; set; }

    public bool IsTouched => Type == WorkflowInputTypes.Boolean ? Flag.HasValue : !string.IsNullOrWhiteSpace(Value);

    /// <summary>What this slot sends, or null when nothing was chosen — or, for a number, nothing parseable.</summary>
    public ConsultInputValue? Supplied => Type switch
    {
      WorkflowInputTypes.Boolean => Flag is { } flag ? ConsultInputValue.OfBoolean(flag) : null,
      // v9: the gate is the same parse the server applies; a spelling it
      // refuses is named here rather than sent to be refused there.
      WorkflowInputTypes.Number => ConsultInputValue.TryParseNumber(Value.Trim(), out var number) ? number : null,
      _ => string.IsNullOrWhiteSpace(Value) ? null : ConsultInputValue.OfText(Value)
    };

    public bool IsFilled => Supplied is not null;

    /// <summary>What is wrong with a touched value, as the fragment after its subject; null when nothing is.</summary>
    public string? Problem => Type == WorkflowInputTypes.Number && IsTouched && Supplied is null
      ? "must be a plain decimal number, like 12 or 1.50."
      : null;

    /// <summary>The text that ran: a chosen boolean reads true or false, a number as spelled.</summary>
    public string EffectiveText => Supplied is { HasCanonical: true } supplied ? supplied.Canonical : Value;

    public void Clear()
    {
      Value = string.Empty;
      Flag = null;
    }

    public void CopyFrom(ScalarSlot other)
    {
      Value = other.Value;
      Flag = other.Flag;
    }
  }

  /// <summary>
  /// v10 (#497): one node of the intake tree — a scalar slot, an object of
  /// nodes, or an array of rows that are nodes — so a row can hold a group
  /// and a group a row set, to any depth the package declares. The v9 rules
  /// hold at every level: a value starts empty and is never defaulted; an
  /// untouched optional structure is absent; a touched one answers every
  /// required field; no rows is absent and an empty row names itself. A
  /// sentence about a problem spells the path down to it.
  /// </summary>
  private sealed class ConsultInputNode
  {
    private readonly IReadOnlyList<WorkflowPackageFieldResponse> fieldSpecs;

    public ConsultInputNode(
      string id, string label, bool required, string? type, IReadOnlyList<string>? values,
      WorkflowPackageElementResponse? element, IReadOnlyList<WorkflowPackageFieldResponse>? fields,
      int depth, int rows = 3, string? placeholder = null)
    {
      Id = id;
      Label = label;
      Required = required;
      Type = type ?? WorkflowInputTypes.Text;
      Values = values ?? element?.Values ?? Array.Empty<string>();
      Element = element;
      Depth = depth;
      // An array of objects declares its fields on the element (v10) and, for
      // a v9 package, beside it as well; either way the element's win.
      fieldSpecs = (IsArray ? element?.Fields ?? fields : fields) ?? Array.Empty<WorkflowPackageFieldResponse>();
      Scalar = new ScalarSlot(id, label, required, Type, Values, rows, placeholder);
      Fields = IsObject ? fieldSpecs.Select(Child).ToList() : Array.Empty<ConsultInputNode>();
    }

    public string Id { get; }
    public string Label { get; }
    public bool Required { get; }
    public string Type { get; }
    public IReadOnlyList<string> Values { get; }

    /// <summary>What one row of an array is; null means text (the v9 default).</summary>
    public WorkflowPackageElementResponse? Element { get; }

    /// <summary>How far below the input this node sits — the markup indents by it.</summary>
    public int Depth { get; }

    public bool IsObject => Type == WorkflowInputTypes.Object;
    public bool IsArray => Type == WorkflowInputTypes.Array;
    public bool IsScalar => !IsObject && !IsArray;

    /// <summary>The scalar control's slot; meaningful only when IsScalar.</summary>
    public ScalarSlot Scalar { get; }

    /// <summary>An object's fields, one node each, in declaration order.</summary>
    public IReadOnlyList<ConsultInputNode> Fields { get; }

    /// <summary>An array's rows, in the order the clinician put them.</summary>
    public List<ConsultInputNode> Rows { get; } = new();

    public bool IsTouched => IsScalar ? Scalar.IsTouched : IsObject ? Fields.Any(member => member.IsTouched) : Rows.Count > 0;

    public bool IsEmpty => !IsTouched;

    /// <summary>
    /// What this node sends, or null when nothing was chosen. An object that
    /// must be touched first (an optional member group) is absent until it is;
    /// a row's object is already touched by being a row.
    /// </summary>
    public ConsultInputValue? Supplied(bool requireTouched = true)
    {
      if (IsScalar)
      {
        return Scalar.Supplied;
      }

      if (IsObject)
      {
        if (requireTouched && !IsTouched)
        {
          return null;
        }

        if (Fields.Any(member => member.Problem(member.Label) != null || (member.Required && !member.IsFilled)))
        {
          return null;
        }

        return ConsultInputValue.OfObject(
          Fields.Where(member => member.IsFilled).Select(member => new ConsultInputEntry(member.Id, member.Supplied()!)));
      }

      // No rows is absent; a row that is empty or wrong holds the whole slot.
      return Rows.Count == 0 || Rows.Any(row => row.IsEmpty || row.Supplied(requireTouched: false) is null)
        ? null
        : ConsultInputValue.OfArray(Rows.Select(row => row.Supplied(requireTouched: false)!));
    }

    public bool IsFilled => Supplied() is not null;

    /// <summary>
    /// A sentence about a value that is present and wrong, with its subject
    /// ("Prior notes", "Family history row 2: Contact") supplied by the
    /// caller; null when nothing is wrong. An untouched node is not wrong.
    /// </summary>
    public string? Problem(string subject)
    {
      if (IsScalar)
      {
        return Scalar.Problem is { } problem ? $"{subject} {problem}" : null;
      }

      if (IsObject)
      {
        return IsTouched ? FieldsProblem($"{subject}:") : null;
      }

      for (var index = 0; index < Rows.Count; index++)
      {
        var row = Rows[index];
        var rowSubject = $"{subject} row {index + 1}";
        if (row.IsEmpty)
        {
          return $"{rowSubject} is empty; fill it in or remove it.";
        }

        if ((row.IsObject ? row.FieldsProblem($"{rowSubject}:") : row.Problem(rowSubject)) is { } problem)
        {
          return problem;
        }
      }

      return null;
    }

    private string? FieldsProblem(string subject)
    {
      foreach (var member in Fields)
      {
        if (member.Problem($"{subject} {member.Label}") is { } problem)
        {
          return problem;
        }
      }

      foreach (var member in Fields)
      {
        if (member.Required && !member.IsFilled)
        {
          return $"{subject} {member.Label} is required.";
        }
      }

      return null;
    }

    /// <summary>The text that ran, for display surfaces that show inputs.</summary>
    public string EffectiveText => IsScalar
      ? Scalar.EffectiveText
      : IsObject
        ? string.Join("\n", Fields.Where(member => member.IsFilled).Select(member => $"{member.Label}: {member.EffectiveText}"))
        : string.Join(Element?.Type == WorkflowInputTypes.Object ? "\n\n" : "\n", Rows.Where(row => !row.IsEmpty).Select(row => row.EffectiveText));

    public ConsultInputNode AddRow()
    {
      var row = new ConsultInputNode(Id, Label, true, Element?.Type, Element?.Values, Element?.Items, Element?.Fields, Depth + 1);
      Rows.Add(row);
      return row;
    }

    public void RemoveRow(int index) => Rows.RemoveAt(index);

    public void MoveRow(int index, int delta) =>
      (Rows[index], Rows[index + delta]) = (Rows[index + delta], Rows[index]);

    public void Clear()
    {
      Scalar.Clear();
      foreach (var member in Fields)
      {
        member.Clear();
      }

      Rows.Clear();
    }

    /// <summary>The declared shape, spelled — two nodes with the same shape can adopt each other's answers.</summary>
    public string Shape => IsScalar
      ? $"{Type}[{string.Join(",", Values)}]"
      : IsObject
        ? $"object({string.Join(";", Fields.Select(member => $"{member.Id}={member.Shape}"))})"
        : $"array<{new ConsultInputNode(Id, Label, true, Element?.Type, Element?.Values, Element?.Items, Element?.Fields, Depth + 1).Shape}>";

    public void CopyFrom(ConsultInputNode other)
    {
      Scalar.CopyFrom(other.Scalar);
      for (var index = 0; index < Fields.Count; index++)
      {
        Fields[index].CopyFrom(other.Fields[index]);
      }

      Rows.AddRange(other.Rows);
    }

    /// <summary>Re-attach from a typed memento (#429): a scalar, an object's fields, an array's rows — recursively (#497).</summary>
    public void Restore(ConsultInputValue value)
    {
      if (IsScalar)
      {
        if (value.IsBoolean)
        {
          Scalar.Flag = value.Flag;
        }
        else if (value.HasCanonical)
        {
          Scalar.Value = value.Canonical;
        }
      }
      else if (IsObject)
      {
        if (!value.IsObject)
        {
          return;
        }

        foreach (var entry in value.Fields!)
        {
          Fields.FirstOrDefault(member => member.Id == entry.Id)?.Restore(entry.Value);
        }
      }
      else if (value.IsArray)
      {
        foreach (var element in value.Elements!)
        {
          AddRow().Restore(element);
        }
      }
    }

    private ConsultInputNode Child(WorkflowPackageFieldResponse spec) =>
      new(spec.Id, spec.Label, spec.Required, spec.Type, spec.Values, spec.Items, spec.Fields, Depth + 1);
  }

  /// <summary>
  /// #236: an attached document. The bytes are held because the job request
  /// carries the file itself — the server extracts it again there, so what
  /// runs is what the server read rather than what this client reported. An
  /// IBrowserFile's stream does not survive until submit, so it cannot be
  /// re-read then. The preview is load-bearing beyond display: the run-phase
  /// draft bar and the re-attach memento both need the input text, and this
  /// is the client's only copy.
  /// </summary>
  private sealed record AttachedDocument(
    string FileName,
    string ContentType,
    byte[] Content,
    int? PageCount,
    string PreviewText);

  /// <summary>
  /// One editable setup field. v9 (#429): a scalar, an object of fields, or
  /// an array of rows — v10 (#497) to any depth, held as a tree of nodes;
  /// and, for a text or an array-of-text slot, the documents that fill it
  /// instead.
  /// </summary>
  private sealed class ConsultInputField
  {
    public ConsultInputField(WorkflowPackageInputResponse input, int textRows)
    {
      Id = input.Id;
      Label = input.Label;
      Required = input.Required;
      Type = WorkflowInputTypes.Of(input);
      Items = input.Items?.Type ?? WorkflowInputTypes.Text;

      var placeholder = Id == "consult_draft"
        ? "Enter referral details, clinical context, and the consult question..."
        : null;
      Root = new ConsultInputNode(Id, Label, Required, Type, input.Values, input.Items, input.Fields, depth: 0, textRows, placeholder);
    }

    public string Id { get; }
    public string Label { get; }
    public bool Required { get; }

    // v8: what control this slot renders. v9: an array's element type name
    // — the document rule reads it; the tree below holds the rest.
    public string Type { get; }
    public string Items { get; }

    /// <summary>The input's tree: this slot's scalar, or its fields, or its rows.</summary>
    public ConsultInputNode Root { get; }

    /// <summary>The scalar answer, for a scalar slot. Value and Flag forward here.</summary>
    public ScalarSlot Scalar => Root.Scalar;
    public string Value { get => Scalar.Value; set => Scalar.Value = value; }
    public bool? Flag { get => Scalar.Flag; set => Scalar.Flag = value; }

    /// <summary>An array's rows, in the order the clinician put them.</summary>
    public List<ConsultInputNode> Rows => Root.Rows;

    /// <summary>The documents filling this slot, in the order chosen (#428: that order is the record's).</summary>
    public List<AttachedDocument> Documents { get; } = new();

    // #208: why a load was refused. Per-field so a failed upload names the
    // field the user aimed at.
    public string? FileError { get; set; }
    public bool IsReading { get; set; }

    public bool HasFile => Documents.Count > 0;

    /// <summary>#510: the previous runs' deliverables filling this slot, in order.</summary>
    public List<LoadedDeliverable> Loaded { get; } = new();
    public bool HasLoaded => Loaded.Count > 0;

    // The single-document view the markup still renders (#429 PR A keeps it
    // until the multi-file slot lands).
    public string? FileName => Documents.Count > 0 ? Documents[0].FileName : null;
    public int? PageCount => Documents.Count > 0 ? Documents[0].PageCount : null;
    public string PreviewText => Documents.Count > 0 ? Documents[0].PreviewText : string.Empty;

    /// <summary>The server's rule (ExtractInputFilesAsync): only an array of text takes several documents.</summary>
    public bool TakesSeveralDocuments => Type == WorkflowInputTypes.Array && Items == WorkflowInputTypes.Text;
    public bool TakesOneDocument => Type == WorkflowInputTypes.Text;

    /// <summary>What this slot sends, or null when nothing was chosen (the tree's rules, from the root).</summary>
    public ConsultInputValue? Supplied => Root.Supplied();

    /// <summary>
    /// What this slot contributes, whichever way it was filled — the one
    /// question every gate should be asking.
    /// </summary>
    public bool IsFilled => HasFile || HasLoaded || Supplied is not null;

    /// <summary>
    /// A named sentence about a value that is present and wrong — a number
    /// that does not parse, an empty row, a required field left blank once
    /// the object was touched. Null when nothing is wrong; an untouched slot
    /// is not wrong, only (if required) unfilled.
    /// </summary>
    public string? Problem
    {
      get
      {
        if (HasFile || HasLoaded)
        {
          return null;
        }

        return Root.Problem(Label);
      }
    }

    /// <summary>The text that ran, for display surfaces that show inputs.</summary>
    public string EffectiveText
    {
      get
      {
        if (HasFile)
        {
          return string.Join("\n\n", Documents.Select(document => document.PreviewText));
        }

        if (HasLoaded)
        {
          return string.Join("\n\n", Loaded.Select(loaded => loaded.Text));
        }

        return Root.EffectiveText;
      }
    }

    public string Placeholder => Scalar.Placeholder;

    public ConsultInputNode AddRow() => Root.AddRow();

    public void RemoveRow(int index) => Root.RemoveRow(index);

    public void MoveRow(int index, int delta) => Root.MoveRow(index, delta);

    public void Clear()
    {
      Console.WriteLine($"[#510] Field.Clear slot={Id} loaded={Loaded.Count}\n{Environment.StackTrace}");
      Root.Clear();
      Documents.Clear();
      Loaded.Clear();
      FileError = null;
    }

    /// <summary>
    /// Carries what was supplied into a slot the new package still declares
    /// with the same shape — switching packages never smuggles a stale input
    /// into a run, and a slot whose shape changed starts empty.
    /// </summary>
    public void AdoptFrom(ConsultInputField previous)
    {
      if (previous.Root.Shape != Root.Shape)
      {
        return;
      }

      Root.CopyFrom(previous.Root);
      Documents.AddRange(previous.Documents);
      Loaded.AddRange(previous.Loaded);
    }

    /// <summary>What this slot ran on, as a value: documents as the text read, one element each for an array.</summary>
    public ConsultInputValue EffectiveValue => HasFile
      ? TakesSeveralDocuments
        ? ConsultInputValue.OfArray(Documents.Select(document => ConsultInputValue.OfText(document.PreviewText)))
        : ConsultInputValue.OfText(Documents[0].PreviewText)
      : HasLoaded
        ? TakesSeveralDocuments
          ? ConsultInputValue.OfArray(Loaded.Select(loaded => ConsultInputValue.OfText(loaded.Text)))
          : ConsultInputValue.OfText(Loaded[0].Text)
        : Supplied!;

    /// <summary>Re-attach from a typed memento (#429): the tree restores itself from the root.</summary>
    public void Restore(ConsultInputValue value)
    {
      Clear();
      Root.Restore(value);
    }

    /// <summary>Re-attach from a text memento: a scalar is restored as typed and a boolean by its word.</summary>
    public void RestoreText(string text)
    {
      Clear();

      if (Type == WorkflowInputTypes.Boolean)
      {
        Flag = text switch { "true" => true, "false" => false, _ => null };
      }
      else if (Type is not (WorkflowInputTypes.Object or WorkflowInputTypes.Array))
      {
        Value = text;
      }
    }
  }

