@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Microsoft.AspNetCore.Components.Routing
@using System.Diagnostics
@using System.Text.Json
@using Consultologist.Web.Services.AI
@using Consultologist.Web.Services.Diagnostics
@using Consultologist.Web.Services.Documents
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IAIEndpointService AIService
@inject IDocumentEndpointService DocumentService
@inject ISseDiagnosticsService SseDiagnostics
@inject ILogger<Consults> Logger
@inject IWorkflowEndpointService WorkflowService
@inject ConsultJobSession JobSession
@attribute [Authorize]
@implements IAsyncDisposable

@page "/consults"
@page "/consults/{JobId}"

<PageTitle>Consults</PageTitle>

<section class="page-header">
    <div class="page-header__content">
        <span class="section-eyebrow">Consults</span>
        <h1 class="page-title">Draft and review specialist consult notes.</h1>
        <p class="page-description">
            Paste the source consult draft and generate each note section from the active writing standards.
        </p>
    </div>
</section>

<AuthorizeView>
    <Authorized>
        @if (!IsRunPhase)
        {
            <div class="consult-setup">
                <section class="workflow-panel">
                    <div class="form-stack">
                        <h2 class="panel-title">Consult details</h2>
                        <p class="panel-description">
                            Paste the referral, history, or draft note. Each output section uses this draft as the source of truth.
                        </p>

                        @* One field per declared input, all visible: the package
                           states its intake form, and a single input keeps the
                           full-height writing area the page has always had. *@
                        @foreach (var field in inputFields)
                        {
                            <label class="input-field" @key="field.Id">
                                <span>
                                    @field.Label
                                    @if (!field.Required)
                                    {
                                        <span class="muted-text input-field__optional">(optional)</span>
                                    }
                                </span>
                                @* #236: a slot holds either typed text or an
                                   attached document, never both. The text is
                                   kept underneath so removing the file gives
                                   it back. *@
                                @if (field.HasFile)
                                {
                                    <span class="input-field__chip" @onclick:stopPropagation="true">
                                        <span class="input-field__chip-name">@field.FileName</span>
                                        @if (field.PageCount is { } pages)
                                        {
                                            <span class="muted-text">@pages page@(pages == 1 ? "" : "s")</span>
                                        }
                                        <FluentButton Appearance="Appearance.Stealth"
                                                      Title="Remove this file"
                                                      @onclick="() => RemoveFile(field)">Remove</FluentButton>
                                    </span>
                                    @* What the server read, shown before it can
                                       become a consult. Extraction is lossy on
                                       columns and tables, so a garbled read has
                                       to be visible while it is still cheap to
                                       reject. *@
                                    <span class="muted-text">What we read from this file:</span>
                                    <div class="input-field__preview">@field.PreviewText</div>
                                    <span class="muted-text input-field__hint">
                                        Looks wrong? Remove the file and paste the text instead.
                                    </span>
                                }
                                else
                                {
                                    @* Bound to the field object's own property: Blazor's
                                       expression formatter cannot parse an indexer whose
                                       argument is a property access. *@
                                    <FluentTextArea @bind-Value="field.Value"
                                                    Placeholder="@field.Placeholder"
                                                    Rows="@(inputFields.Count == 1 ? 16 : 6)" />
                                    @* No accept filter and no extension list: the
                                       parser is the only thing that knows what a
                                       format is, and a second opinion here could
                                       disagree with it (docs/DOCUMENT_INPUT.md § 1). *@
                                    <span class="input-field__file" @onclick:stopPropagation="true">
                                        <InputFile OnChange="args => LoadFileAsync(field, args)" />
                                        @if (field.IsReading)
                                        {
                                            <FluentProgressRing style="width: 16px; height: 16px;" />
                                            <span class="muted-text">Reading&hellip;</span>
                                        }
                                    </span>
                                }
                                @if (field.FileError != null)
                                {
                                    <span class="input-field__file-error">@field.FileError</span>
                                }
                            </label>
                        }

                        @if (isBlocksLoading)
                        {
                            <div class="loading-state">
                                <FluentProgressRing />
                                <span>Loading section standards...</span>
                            </div>
                        }
                        else if (!string.IsNullOrEmpty(blocksLoadError))
                        {
                            <FluentMessageBar Intent="MessageIntent.Error">@blocksLoadError</FluentMessageBar>
                            @* Escape hatch: a pin to an unloadable package must stay
                               correctable from here — the picker loads independently. *@
                            <div class="setup-context">
                                <span class="setup-context__line">
                                    Switch to another package:
                                    <WorkflowPackagePicker OnPinned="OnPackagePinnedAsync" />
                                </span>
                            </div>
                        }
                        else if (packageBlocks.Count > 0)
                        {
                            <div class="setup-context">
                                <span class="setup-context__line">
                                    Runs
                                    <WorkflowPackagePicker @key="workflowPackageRef"
                                                           Disabled="@isAiRequestLoading"
                                                           OnPinned="OnPackagePinnedAsync" />
                                    <span class="muted-text">· @SectionSummary</span>
                                </span>
                                <details class="setup-sections">
                                    <summary>Sections it will generate</summary>
                                    @if (IsMultiDeliverable)
                                    {
                                        @* Each section is generated once per deliverable, so
                                           the roster groups under the authored document labels
                                           rather than repeating names in one flat list. *@
                                        @foreach (var deliverable in declaredResults!)
                                        {
                                            <div class="setup-sections__group">
                                                <span class="setup-sections__group-label">@deliverable.Label</span>
                                                <ul>
                                                    @foreach (var standard in BlocksFor(deliverable.Id))
                                                    {
                                                        <li>@standard.Name</li>
                                                    }
                                                </ul>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <ul>
                                            @foreach (var standard in packageBlocks)
                                            {
                                                <li>@standard.Name</li>
                                            }
                                        </ul>
                                    }
                                </details>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(aiRequestError))
                        {
                            <FluentMessageBar Intent="MessageIntent.Error">@aiRequestError</FluentMessageBar>
                        }

                        @if (!string.IsNullOrEmpty(scheduleConfirmation))
                        {
                            <FluentMessageBar Intent="MessageIntent.Success">@scheduleConfirmation</FluentMessageBar>
                        }

                        <div class="action-row">
                            <FluentSwitch @bind-Value="runOvernight"
                                          Label="Run overnight (starts ~2:00 AM)"
                                          Disabled="@(isAiRequestLoading || isSchedulingRequest)" />
                            @if (totalBlockCount > 0)
                            {
                                <FluentButton Appearance="Appearance.Neutral" @onclick="BackToRun">
                                    Back to consult
                                </FluentButton>
                            }
                            <FluentButton Appearance="Appearance.Accent"
                                          @onclick="CreateConsultAsync"
                                          Disabled="@(isBlocksLoading || isAiRequestLoading || isSchedulingRequest || !HasEveryRequiredInput || packageBlocks.Count == 0)">
                                @(runOvernight ? "Schedule consult" : "Create consult")
                            </FluentButton>
                        </div>
                    </div>
                </section>
            </div>
        }
        else
        {
            <div class="consult-run">
                <details class="draft-bar">
                    <summary class="draft-bar__summary">
                        <span class="draft-bar__chevron" aria-hidden="true">&#x203A;</span>
                        <span class="draft-bar__label">@(inputFields.Count == 1 ? "Draft" : "Inputs")</span>
                        <span class="draft-bar__snippet">@DraftSnippet</span>
                        @if (HasAnyInput)
                        {
                            <span @onclick:stopPropagation="true">
                                <FluentButton Appearance="Appearance.Stealth"
                                              @onclick="EditDraft"
                                              Disabled="@isAiRequestLoading">
                                    @(inputFields.Count == 1 ? "Edit draft" : "Edit inputs")
                                </FluentButton>
                            </span>
                        }
                    </summary>
                    <div class="draft-bar__full">
                        @if (inputFields.Count == 1)
                        {
                            @inputFields[0].EffectiveText
                        }
                        else
                        {
                            @* Each supplied input under its authored label; an
                               absent optional input simply does not appear. *@
                            @foreach (var field in inputFields.Where(f => f.IsFilled))
                            {
                                <div class="draft-bar__input" @key="field.Id">
                                    <span class="draft-bar__input-label">@field.Label</span>
                                    <span>@field.EffectiveText</span>
                                </div>
                            }
                        }
                    </div>
                </details>

                <div class="consult-run__grid">
                    <section class="result-panel">
                        @if (assembledDocuments.Count > 0)
                        {
                            @* The deliverables: one server-assembled document in
                               v6 and single-result v7, one tab each when the
                               package declares several. *@
                            <div>
                                <div class="result-header">
                                    <h2 class="panel-title">@(assembledDocuments.Count == 1 ? assembledDocuments[0].Label : "Documents")</h2>
                                    <div class="result-header__actions">
                                        <FluentBadge Appearance="Appearance.Accent">assembled</FluentBadge>
                                        <FluentButton Appearance="Appearance.Accent" @onclick="CopyNoteAsync">
                                            @CopyButtonLabel
                                        </FluentButton>
                                    </div>
                                </div>

                                @if (assembledDocuments.Count == 1)
                                {
                                    <article class="note-preview generated-note generated-note--assembled">
                                        @((MarkupString)MarkdownPreview.Render(assembledDocuments[0].Text))
                                    </article>
                                }
                                else
                                {
                                    @* FluentTabs carries the whole ARIA tab pattern —
                                       roving tabindex, arrow/Home/End keys, overflow
                                       when the labels outgrow the panel. *@
                                    <FluentTabs @bind-ActiveTabId="activeDocumentId" class="document-tabs">
                                        @foreach (var document in assembledDocuments)
                                        {
                                            <FluentTab Id="@document.ResultId"
                                                       Label="@document.Label"
                                                       @key="document.ResultId">
                                                <article class="note-preview generated-note generated-note--assembled">
                                                    @((MarkupString)MarkdownPreview.Render(document.Text))
                                                </article>
                                            </FluentTab>
                                        }
                                    </FluentTabs>
                                }

                                @* #315: the person who just ran the consult is
                                   the one most likely to wonder where the second
                                   document went. Labels and declared values are
                                   authored package content, so this carries no
                                   clinical detail. *@
                                @foreach (var skipped in skippedDocuments)
                                {
                                    <p class="muted-text" data-skipped-result="@skipped.ResultId">
                                        <strong>@skipped.Label</strong> was not produced: it @skipped.Reason.
                                    </p>
                                }
                            </div>
                        }
                        else if (generatedBlocks.Count > 0)
                        {
                            <div>
                                <div class="result-header">
                                    <h2 class="panel-title">Consultation note</h2>
                                    <div class="result-header__actions">
                                        <FluentBadge Appearance="Appearance.Accent">
                                            @generatedBlocks.Count sections
                                        </FluentBadge>
                                        @if (!isAiRequestLoading || runTerminalStatus != null)
                                        {
                                            <FluentButton Appearance="Appearance.Accent" @onclick="CopyNoteAsync">
                                                @CopyButtonLabel
                                            </FluentButton>
                                        }
                                    </div>
                                </div>

                                <article class="note-preview generated-note">
                                    @foreach (var standard in packageBlocks)
                                    {
                                        if (generatedBlocks.TryGetValue(standard.Id, out var prose) && !string.IsNullOrWhiteSpace(prose))
                                        {
                                            <section class="note-section">
                                                <h3>@standard.Name</h3>
                                                <p>@prose</p>
                                            </section>
                                        }
                                    }
                                </article>
                            </div>
                        }
                        else
                        {
                            <div class="empty-note-state">
                                <h2 class="panel-title">Consultation note</h2>
                                <p class="panel-description">
                                    Sections appear here as they are generated.
                                </p>
                                @if (isAiRequestLoading)
                                {
                                    <div class="loading-state">
                                        <FluentProgressRing />
                                        <span>Generating&hellip;</span>
                                    </div>
                                }
                            </div>
                        }
                    </section>

                    <section class="workflow-panel run-rail">
                        <div class="form-stack">
                            <h2 class="panel-title">Run</h2>

                            @{
                                var stageTotal = totalAnalysisStageCount > 0 ? totalAnalysisStageCount : 6;
                                var setupStatus = SetupRowStatus();
                            }
                            <div class="node-grid">
                                <div class="node-row">
                                    <span class="node-row__chevron" aria-hidden="true"></span>
                                    <span class="node-row__status @RunStatusCss(setupStatus)">@RunStatusGlyph(setupStatus)</span>
                                    <span class="node-row__label">Setup</span>
                                </div>

                                @if (workflowNodes is { Count: > 0 })
                                {
                                    @* The manifest node map, loaded at page init: every node named and every
                                       forEach group's sections listed before the first event arrives. *@
                                    for (var i = 0; i < workflowNodes.Count; i++)
                                    {
                                        var node = workflowNodes[i];
                                        var done = completedAnalysisStageCount > i;
                                        var current = !done && completedAnalysisStageCount == i && isAiRequestLoading;
                                        var stageStatus = done ? "Completed" : current ? "Running" : null;

                                        if (node.ForEach != null)
                                        {
                                            var nodeItems = ItemsFor(node);
                                            var doneItems = nodeItems.Count(item => NodeItemStatus(node, done, current, item.Id) == "Completed");
                                            <details class="node-group" open>
                                                <summary class="node-row">
                                                    <span class="node-row__chevron" aria-hidden="true">&#x203A;</span>
                                                    <span class="node-row__status @RunStatusCss(stageStatus)">@RunStatusGlyph(stageStatus)</span>
                                                    <span class="node-row__label">@node.Label</span>
                                                    <span class="node-row__count muted-text">@doneItems/@nodeItems.Count</span>
                                                </summary>
                                                @foreach (var item in nodeItems)
                                                {
                                                    var itemStatus = NodeItemStatus(node, done, current, item.Id);
                                                    <div class="node-row node-row--item">
                                                        <span class="node-row__chevron" aria-hidden="true"></span>
                                                        <span class="node-row__status @RunStatusCss(itemStatus)">@RunStatusGlyph(itemStatus)</span>
                                                        <span class="node-row__label">@item.Name</span>
                                                    </div>
                                                }
                                            </details>
                                        }
                                        else
                                        {
                                            <div class="node-row">
                                                <span class="node-row__chevron" aria-hidden="true"></span>
                                                <span class="node-row__status @RunStatusCss(stageStatus)">@RunStatusGlyph(stageStatus)</span>
                                                <span class="node-row__label">@node.Label</span>
                                            </div>
                                        }

                                        if (current && !string.IsNullOrEmpty(aiProgressNotice))
                                        {
                                            <div class="node-row__caption muted-text">@aiProgressNotice</div>
                                        }
                                    }
                                }
                                else
                                {
                                    @* Fallback when the manifest could not be fetched: event-fed labels,
                                       sections grouped under the final stage only. *@
                                    for (var i = 1; i <= stageTotal; i++)
                                    {
                                        var stepNum = i;
                                        var done = completedAnalysisStageCount >= stepNum;
                                        var current = !done && completedAnalysisStageCount == stepNum - 1 && isAiRequestLoading;
                                        var stageStatus = done ? "Completed" : current ? "Running" : null;
                                        var isSectionStage = stepNum == stageTotal;

                                        if (isSectionStage && (done || current))
                                        {
                                            <details class="node-group" open>
                                                <summary class="node-row">
                                                    <span class="node-row__chevron" aria-hidden="true">&#x203A;</span>
                                                    <span class="node-row__status @RunStatusCss(stageStatus)">@RunStatusGlyph(stageStatus)</span>
                                                    <span class="node-row__label">@GetStageChecklistLabel(stepNum)</span>
                                                    <span class="node-row__count muted-text">@completedBlockCount/@totalBlockCount</span>
                                                </summary>
                                                @foreach (var sec in packageBlocks)
                                                {
                                                    var sectionStatus = generatedBlocks.ContainsKey(sec.Id) ? "Completed"
                                                        : failedBlockErrors.ContainsKey(sec.Id) ? "Failed"
                                                        : current ? "Running" : null;
                                                    <div class="node-row node-row--item">
                                                        <span class="node-row__chevron" aria-hidden="true"></span>
                                                        <span class="node-row__status @RunStatusCss(sectionStatus)">@RunStatusGlyph(sectionStatus)</span>
                                                        <span class="node-row__label">@sec.Name</span>
                                                    </div>
                                                }
                                            </details>
                                        }
                                        else
                                        {
                                            <div class="node-row">
                                                <span class="node-row__chevron" aria-hidden="true"></span>
                                                <span class="node-row__status @RunStatusCss(stageStatus)">@RunStatusGlyph(stageStatus)</span>
                                                <span class="node-row__label">@GetStageChecklistLabel(stepNum)</span>
                                            </div>
                                            @if (current && !string.IsNullOrEmpty(aiProgressNotice))
                                            {
                                                <div class="node-row__caption muted-text">@aiProgressNotice</div>
                                            }
                                        }
                                    }
                                }

                                @{
                                    var doneStatus = DoneRowStatus();
                                }
                                <div class="node-row">
                                    <span class="node-row__chevron" aria-hidden="true"></span>
                                    <span class="node-row__status @RunStatusCss(doneStatus)">@RunStatusGlyph(doneStatus)</span>
                                    <span class="node-row__label">@(doneStatus == "Failed" ? "Failed" : "Done")</span>
                                    @if (doneStatus != null)
                                    {
                                        <span class="node-row__count muted-text">@generatedBlocks.Count/@totalBlockCount sections</span>
                                    }
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(aiRequestError))
                            {
                                <FluentMessageBar Intent="MessageIntent.Error">@aiRequestError</FluentMessageBar>
                            }
                        </div>
                    </section>
                </div>
            </div>
        }
    </Authorized>
</AuthorizeView>

@code {
  private static readonly int MaxSseReconnectAttempts = 1;
  private static readonly JsonSerializerOptions SseJsonOptions = new()
  {
    PropertyNameCaseInsensitive = true
  };

  // One editable field per declared input. v5/v6 packages declare nothing, so
  // the fields fall back to the frozen consult_draft slot and one code path
  // renders both eras. Seeded before the package resolves — the setup form
  // renders once first.
  private List<ConsultInputField> inputFields = LegacyInputs
    .Select(input => new ConsultInputField(input.Id, input.Label, input.Required))
    .ToList();
  private IReadOnlyList<WorkflowPackageResultResponse>? declaredResults;
  private bool editingDraft;
  private bool runEventSeen;
  private string? runTerminalStatus;
  private string? copyFeedback;
  private int copyFeedbackToken;
  private IReadOnlyList<ConsultGenerationResultDocumentResponse> assembledDocuments = Array.Empty<ConsultGenerationResultDocumentResponse>();

  // #315: declared deliverables this job's inputs excluded.
  private IReadOnlyList<ConsultSkippedDocumentResponse> skippedDocuments = Array.Empty<ConsultSkippedDocumentResponse>();
  private string? activeDocumentId;
  private List<PackageBlock> packageBlocks = new();
  private string? workflowPackageRef;
  private IReadOnlyList<WorkflowManifestReader.NodeView>? workflowNodes;
  private IReadOnlyList<WorkflowManifestReader.CollectionView> workflowCollections = Array.Empty<WorkflowManifestReader.CollectionView>();
  private HashSet<string> completedNodeItems = new();
  private Dictionary<string, string> generatedBlocks = new();
  private Dictionary<string, string> failedBlockErrors = new();
  private bool isBlocksLoading;
  private string? blocksLoadError;
  private bool isAiRequestLoading;
  private string? aiRequestError;

  // #157: "run overnight" preset — next 2:00 AM browser-local, sent as UTC.
  private bool runOvernight;
  private bool isSchedulingRequest;
  private string? scheduleConfirmation;
  private string? aiProgressNotice;
  private int completedBlockCount;
  private int totalBlockCount;
  private int completedAnalysisStageCount;
  private int totalAnalysisStageCount;
  private List<string>? nodeLabels;
  private CancellationTokenSource? activeEventStreamCancellationTokenSource;
  private string? activeEventStreamCancellationReason;
  private SseAttemptState? activeSseAttempt;
  private IReadOnlyList<PackageBlock> activeBlockSnapshots = Array.Empty<PackageBlock>();

  [Parameter]
  public string? JobId { get; set; }

  protected override async Task OnInitializedAsync()
  {
    Navigation.LocationChanged += HandleLocationChanged;
    await LoadPackageBlocksAsync();
    await LoadWorkflowNodesAsync();
    await TryReattachAsync();
  }

  // #207: re-attach to an in-flight (or just-finished) job instead of showing
  // a blank setup. The route job id (History's "watch live") wins over the
  // per-tab session; when the session matches, it supplies the draft and the
  // exact block roster the run was submitted with — the job record carries
  // neither, so a route-only entry renders without draft text and with the
  // current pin's roster (the polling fallback's existing limitation).
  private async Task TryReattachAsync()
  {
    var memento = JobSession.Current;
    var targetJobId = !string.IsNullOrWhiteSpace(JobId) ? JobId : memento?.JobId;

    if (targetJobId == null)
    {
      return;
    }

    var sessionMatches = memento != null && memento.JobId == targetJobId;

    if (sessionMatches)
    {
      ApplyInputValues(memento!.Inputs);
      workflowPackageRef = memento.WorkflowPackageRef ?? workflowPackageRef;
    }

    var blockSnapshots = sessionMatches
      ? memento!.Blocks.Select(block => new PackageBlock(block.Id, block.Name)).ToList()
      : packageBlocks.ToList();

    try
    {
      isAiRequestLoading = true;
      editingDraft = false;
      await InvokeAsync(StateHasChanged);

      var snapshot = await AIService.GetConsultGenerationJobAsync(targetJobId);
      ApplyConsultGenerationJobResponse(snapshot, blockSnapshots);

      if (snapshot.Status is "Completed" or "Failed")
      {
        runTerminalStatus = snapshot.Status;
        return;
      }

      await RunAttachedJobAsync(targetJobId, blockSnapshots);
    }
    catch (AccessTokenNotAvailableException exception)
    {
      exception.Redirect();
    }
    catch (Exception ex)
    {
      aiRequestError = $"Unable to attach to job: {ex.Message}";
      runTerminalStatus = null;
      totalBlockCount = 0;
    }
    finally
    {
      isAiRequestLoading = false;
      activeSseAttempt = null;
      activeEventStreamCancellationReason = null;
    }
  }

  // The full node map is display enrichment for the run rail; failures fall
  // back to the event-fed labels. Collections ride along so each forEach
  // group lists its own collection's items — the package's Sections are the
  // deliverable's BLOCKS in v6 (they can include scalar aggregate sources),
  // not any collection's item list.
  private async Task LoadWorkflowNodesAsync()
  {
    try
    {
      var content = await WorkflowService.GetCurrentPackageContentAsync();
      workflowNodes = WorkflowManifestReader.ReadNodes(content.Manifest);
      workflowCollections = WorkflowManifestReader.ReadCollections(content.Manifest, content.Files);
    }
    catch (AccessTokenNotAvailableException exception)
    {
      exception.Redirect();
    }
    catch
    {
      workflowNodes = null;
      workflowCollections = Array.Empty<WorkflowManifestReader.CollectionView>();
    }
  }

  // A forEach node's rail items are its own collection's; the blocks list is
  // the fallback only when the collection cannot be resolved.
  private IReadOnlyList<(string Id, string Name)> ItemsFor(WorkflowManifestReader.NodeView node)
  {
    const string dataPrefix = "data:";
    var collectionId = node.ForEach != null && node.ForEach.StartsWith(dataPrefix, StringComparison.Ordinal)
      ? node.ForEach[dataPrefix.Length..]
      : node.ForEach;
    var collection = workflowCollections.FirstOrDefault(c => c.Id == collectionId);

    return collection != null
      ? collection.Items.Select(item => (item.Id, item.Name)).ToList()
      : packageBlocks.Select(sec => (sec.Id, sec.Name)).ToList();
  }

  private async Task LoadPackageBlocksAsync()
  {
    isBlocksLoading = true;
    blocksLoadError = null;

    try
    {
      // Sections come from the package endpoint — one server-side source for every
      // spec version. The account standards override retired with the v5 input
      // model; customization returns as package forking (the in-app editor).
      var package = await WorkflowService.GetCurrentPackageAsync();
      workflowPackageRef = package.Ref;

      packageBlocks = (package.Blocks ?? Array.Empty<WorkflowPackageBlockResponse>())
        .Select(block => new PackageBlock(block.Id, block.Name))
        .ToList();

      // v7: the declaration the form renders from and the deliverables it
      // groups by. Null on v5/v6 — the fields then fall back to the frozen
      // consult_draft slot.
      declaredResults = package.Results;
      SyncInputFields(package.Inputs);
    }
    catch (AccessTokenNotAvailableException exception)
    {
      exception.Redirect();
    }
    catch (Exception ex)
    {
      packageBlocks = new();
      blocksLoadError = $"Unable to load section standards: {ex.Message}";
    }
    finally
    {
      isBlocksLoading = false;
    }
  }

  private static DateTimeOffset NextOvernightRunUtc()
  {
    var now = DateTime.Now;
    var next = now.Date.AddHours(2);
    if (now >= next)
    {
      next = next.AddDays(1);
    }

    return new DateTimeOffset(next).ToUniversalTime();
  }

  private async Task CreateConsultAsync()
  {
    editingDraft = false;
    runEventSeen = false;
    runTerminalStatus = null;
    assembledDocuments = Array.Empty<ConsultGenerationResultDocumentResponse>();
    activeDocumentId = null;
    completedNodeItems = new();
    aiRequestError = null;
    aiProgressNotice = null;
    scheduleConfirmation = null;
    generatedBlocks = new();
    failedBlockErrors = new();
    completedBlockCount = 0;
    totalBlockCount = 0;
    completedAnalysisStageCount = 0;
    totalAnalysisStageCount = 0;
    nodeLabels = null;

    if (!HasEveryRequiredInput)
    {
      var missing = inputFields
        .Where(field => field.Required && !field.IsFilled)
        .Select(field => field.Label);
      aiRequestError = $"{string.Join(", ", missing)} is required.";
      return;
    }

    if (packageBlocks.Count == 0)
    {
      aiRequestError = "No section standards are available.";
      return;
    }

    // #157: a scheduled submit never enters the run phase — the job sleeps
    // server-side and History (plus the completion email) is its surface.
    if (runOvernight)
    {
      try
      {
        isSchedulingRequest = true;
        var scheduledAtUtc = NextOvernightRunUtc();
        var job = await AIService.StartConsultGenerationJobAsync(
          SuppliedInputs(), workflowPackageRef, scheduledAtUtc, SuppliedFiles());
        scheduleConfirmation =
          $"Consult scheduled for {scheduledAtUtc.ToLocalTime():MMM d, h:mm tt} — it will appear in History, and you'll receive an email when it's ready.";
        runOvernight = false;
        ClearInputs();
      }
      catch (Exception ex)
      {
        aiRequestError = $"Error scheduling consult: {ex.Message}";
      }
      finally
      {
        isSchedulingRequest = false;
      }

      return;
    }

    try
    {
      isAiRequestLoading = true;
      var inputSnapshot = SuppliedInputs();
      var fileSnapshot = SuppliedFiles();
      // What the run displays and what re-attach restores: the text, however
      // the slot was filled. The request itself carries the files.
      var textSnapshot = EffectiveInputTexts();
      var blockSnapshots = packageBlocks.ToList();
      totalBlockCount = blockSnapshots.Count;
      await InvokeAsync(StateHasChanged);

      // Sections are package data resolved server-side; the request carries only
      // the declared inputs (and the resolved package ref).
      var job = await AIService.StartConsultGenerationJobAsync(
        inputSnapshot, workflowPackageRef, files: fileSnapshot);

      // #207: remember the job per-tab so navigating away and back re-attaches.
      JobSession.Current = new ConsultJobMemento(
        job.JobId,
        textSnapshot,
        workflowPackageRef,
        blockSnapshots.Select(block => new ConsultJobBlock(block.Id, block.Name)).ToList());

      await RunAttachedJobAsync(job.JobId, blockSnapshots);
    }
    catch (Exception ex)
    {
      aiRequestError = $"Error calling agent: {ex.Message}";
    }
    finally
    {
      isAiRequestLoading = false;
      activeSseAttempt = null;
      activeEventStreamCancellationReason = null;
    }
  }

  // The live-viewing block shared by submit and re-attach: stream, then fall
  // back to polling if the stream cannot complete.
  private async Task RunAttachedJobAsync(string jobId, IReadOnlyList<PackageBlock> blockSnapshots)
  {
    var streamResult = await StreamConsultGenerationJobAsync(jobId, blockSnapshots);

    if (streamResult == ConsultGenerationStreamResult.FallbackToPolling && isAiRequestLoading)
    {
      Logger.LogWarning(
        "Consult generation falling back to polling. JobId={JobId}, CompletedCount={CompletedCount}, FailedCount={FailedCount}, TotalCount={TotalCount}",
        jobId,
        generatedBlocks.Count,
        failedBlockErrors.Count,
        totalBlockCount);

      aiProgressNotice = "Live updates paused; checking status periodically.";
      MarkPollingFallbackStarted();
      await InvokeAsync(StateHasChanged);
      await PollConsultGenerationJobAsync(jobId, blockSnapshots);
    }
  }

  private async Task<ConsultGenerationStreamResult> StreamConsultGenerationJobAsync(
    string jobId,
    IReadOnlyList<PackageBlock> blockSnapshots)
  {
    activeBlockSnapshots = blockSnapshots;
    var stream = new SseStreamState(jobId);

    try
    {
      for (var reconnectAttempt = 0; reconnectAttempt <= MaxSseReconnectAttempts; reconnectAttempt++)
      {
        var attempt = stream.StartAttempt();
        activeSseAttempt = attempt;
        var lastEventId = reconnectAttempt == 0 ? null : stream.LatestEventId;

        var attemptResult = await StreamOneSseAttemptAsync(
          jobId,
          blockSnapshots,
          stream,
          attempt,
          reconnectAttempt,
          lastEventId);

        if (attemptResult == ConsultGenerationAttemptResult.Completed)
        {
          return ConsultGenerationStreamResult.Completed;
        }

        if (attemptResult == ConsultGenerationAttemptResult.FallbackToPolling
            || !CanReconnectSse(stream, reconnectAttempt))
        {
          return ConsultGenerationStreamResult.FallbackToPolling;
        }

        var reconnectBackoff = GetSseReconnectBackoff(reconnectAttempt);
        Logger.LogInformation(
          "Reconnecting consult generation SSE stream. JobId={JobId}, ReconnectAttempt={ReconnectAttempt}, LastEventId={LastEventId}, BackoffMs={BackoffMs}",
          jobId,
          reconnectAttempt + 1,
          stream.LatestEventId,
          reconnectBackoff.TotalMilliseconds);

        await Task.Delay(reconnectBackoff);

        if (!isAiRequestLoading || activeEventStreamCancellationReason != null)
        {
          return ConsultGenerationStreamResult.FallbackToPolling;
        }
      }

      return ConsultGenerationStreamResult.FallbackToPolling;
    }
    finally
    {
      activeBlockSnapshots = Array.Empty<PackageBlock>();
    }
  }

  private async Task<ConsultGenerationAttemptResult> StreamOneSseAttemptAsync(
    string jobId,
    IReadOnlyList<PackageBlock> blockSnapshots,
    SseStreamState stream,
    SseAttemptState attempt,
    int reconnectAttempt,
    string? lastEventId)
  {
    const int streamTimeoutMinutes = 10;
    using var streamCancellationTokenSource = new CancellationTokenSource();
    using var timeoutCancellationTokenSource = new CancellationTokenSource(TimeSpan.FromMinutes(streamTimeoutMinutes));
    using var linkedCancellationTokenSource = CancellationTokenSource.CreateLinkedTokenSource(
      streamCancellationTokenSource.Token,
      timeoutCancellationTokenSource.Token);
    activeEventStreamCancellationTokenSource = streamCancellationTokenSource;
    activeEventStreamCancellationReason = null;

    try
    {
      Logger.LogInformation(
        "Opening consult generation SSE stream. JobId={JobId}, AttemptId={AttemptId}, SectionCount={SectionCount}, ReconnectAttempt={ReconnectAttempt}, ResumeCursorPresent={ResumeCursorPresent}",
        jobId,
        attempt.AttemptId,
        blockSnapshots.Count,
        reconnectAttempt,
        !string.IsNullOrWhiteSpace(lastEventId));

      await foreach (var jobEvent in AIService.StreamConsultGenerationJobEventsAsync(
        jobId,
        attempt.AttemptId,
        linkedCancellationTokenSource.Token,
        lastEventId))
      {
        attempt.RecordEvent(jobEvent);
        stream.RecordEvent(jobEvent);
        var eventResult = await HandleConsultGenerationJobEventAsync(jobEvent.EventName, jobEvent.Json);

        if (eventResult.ServerErrorEventSeen)
        {
          attempt.ServerErrorEventSeen = true;
          stream.ServerErrorEventSeen = true;
        }

        if (eventResult.Result == ConsultGenerationEventResult.Completed)
        {
          ReportSseExit(attempt, GetCompletedSseExitReason(attempt, eventResult.FinalStatus));
          return ConsultGenerationAttemptResult.Completed;
        }

        if (eventResult.Result == ConsultGenerationEventResult.FallbackToPolling)
        {
          if (eventResult.FallbackDiagnosticReason != null)
          {
            ReportSseExit(attempt, eventResult.FallbackDiagnosticReason);
          }

          return ConsultGenerationAttemptResult.FallbackToPolling;
        }
      }

      Logger.LogWarning(
        "Consult generation SSE stream ended before done. JobId={JobId}, AttemptId={AttemptId}, ReconnectAttempt={ReconnectAttempt}",
        jobId,
        attempt.AttemptId,
        reconnectAttempt);

      if (attempt.ServerErrorEventSeen)
      {
        ReportSseExit(attempt, "server-error-event");
        return ConsultGenerationAttemptResult.Completed;
      }

      ReportSseExit(attempt, "ended-before-done");
      return ConsultGenerationAttemptResult.RetrySse;
    }
    catch (OperationCanceledException) when (timeoutCancellationTokenSource.IsCancellationRequested
                                            && !streamCancellationTokenSource.IsCancellationRequested)
    {
      Logger.LogWarning(
        "Consult generation SSE stream timed out before completion. JobId={JobId}, TimeoutMinutes={TimeoutMinutes}",
        jobId,
        streamTimeoutMinutes);

      ReportSseExit(attempt, "timeout");
      return ConsultGenerationAttemptResult.RetrySse;
    }
    catch (OperationCanceledException)
    {
      var reason = activeEventStreamCancellationReason ?? "manual-cancel";
      Logger.LogWarning(
        "Consult generation SSE stream canceled. JobId={JobId}, AttemptId={AttemptId}, Reason={Reason}",
        jobId,
        attempt.AttemptId,
        reason);

      ReportSseExit(attempt, reason);
      return ConsultGenerationAttemptResult.FallbackToPolling;
    }
    catch (AccessTokenNotAvailableException ex)
    {
      Logger.LogWarning(
        ex,
        "Consult generation SSE stream authorization failed. JobId={JobId}, AttemptId={AttemptId}",
        jobId,
        attempt.AttemptId);

      ReportSseExit(attempt, "exception");
      return ConsultGenerationAttemptResult.FallbackToPolling;
    }
    catch (Exception ex)
    {
      Logger.LogWarning(
        ex,
        "Consult generation SSE stream setup failed. JobId={JobId}",
        jobId);

      ReportSseExit(attempt, "exception");
      return ConsultGenerationAttemptResult.RetrySse;
    }
    finally
    {
      if (ReferenceEquals(activeEventStreamCancellationTokenSource, streamCancellationTokenSource))
      {
        activeEventStreamCancellationTokenSource = null;
      }
    }
  }

  private async Task PollConsultGenerationJobAsync(string jobId, IReadOnlyList<PackageBlock> blockSnapshots)
  {
    try
    {
      while (isAiRequestLoading)
      {
        var response = await AIService.GetConsultGenerationJobAsync(jobId);

        ApplyConsultGenerationJobResponse(response, blockSnapshots);
        await InvokeAsync(StateHasChanged);

        if (response.Status is "Completed" or "Failed")
        {
          runTerminalStatus = response.Status;
          aiProgressNotice = null;
          MarkPollingFallbackCompleted();
          return;
        }

        await Task.Delay(TimeSpan.FromSeconds(2));
      }
    }
    catch (Exception ex)
    {
      aiProgressNotice = null;
      aiRequestError = $"Error checking consult generation status: {ex.Message}";
    }
  }

  private async Task<ConsultGenerationEventHandlingResult> HandleConsultGenerationJobEventAsync(string eventName, string json)
  {
    try
    {
      switch (eventName)
      {
        case "snapshot":
          var snapshot = JsonSerializer.Deserialize<ConsultGenerationJobResponse>(json, SseJsonOptions);
          if (snapshot != null)
          {
            Logger.LogInformation(
              "Consult generation SSE snapshot received. JobId={JobId}, Status={Status}, TotalCount={TotalCount}, CompletedCount={CompletedCount}, FailedCount={FailedCount}",
              snapshot.JobId,
              snapshot.Status,
              snapshot.TotalBlockCount,
              snapshot.CompletedBlockCount,
              snapshot.FailedBlockCount);

            ApplyConsultGenerationJobResponse(snapshot, GetActiveBlockSnapshots());
          }
          break;

        case "block-completed":
          var completed = JsonSerializer.Deserialize<ConsultGenerationBlockCompletedEvent>(json, SseJsonOptions);
          if (completed != null)
          {
            generatedBlocks = new Dictionary<string, string>(generatedBlocks)
            {
              [completed.BlockId] = completed.Text
            };
            var nextFailedSections = new Dictionary<string, string>(failedBlockErrors);
            nextFailedSections.Remove(completed.BlockId);
            failedBlockErrors = nextFailedSections;
            completedBlockCount = generatedBlocks.Count + failedBlockErrors.Count;
          }
          break;

        case "block-failed":
          var failed = JsonSerializer.Deserialize<ConsultGenerationBlockFailedEvent>(json, SseJsonOptions);
          if (failed != null)
          {
            failedBlockErrors = new Dictionary<string, string>(failedBlockErrors)
            {
              [failed.BlockId] = failed.Error
            };
            var nextGeneratedSections = new Dictionary<string, string>(generatedBlocks);
            nextGeneratedSections.Remove(failed.BlockId);
            generatedBlocks = nextGeneratedSections;
            completedBlockCount = generatedBlocks.Count + failedBlockErrors.Count;
            UpdateFailedBlockError(GetActiveBlockSnapshots());
          }
          break;

        case "node-completed":
          var nodeEvent = JsonSerializer.Deserialize<ConsultGenerationNodeCompletedEvent>(json, SseJsonOptions);
          if (nodeEvent != null)
          {
            aiProgressNotice = string.IsNullOrWhiteSpace(nodeEvent.Label) ? "Generating consult" : nodeEvent.Label;
            // Node events are per-key deduped server-side; keep counts monotonic.
            completedAnalysisStageCount = Math.Max(completedAnalysisStageCount, nodeEvent.CompletedNodeCount);
            totalAnalysisStageCount = nodeEvent.TotalNodeCount;
          }
          break;

        case "item-step":
          var sectionStep = JsonSerializer.Deserialize<ConsultGenerationItemStepEvent>(json, SseJsonOptions);
          if (sectionStep != null)
          {
            var stepLabel = string.IsNullOrWhiteSpace(sectionStep.Label) ? "Generating section" : sectionStep.Label;
            aiProgressNotice = $"{stepLabel}: {sectionStep.ItemName}";
            // Step is the forEach node id that just completed for this section
            // (one event per node/section pair) — the run rail's per-group ticks.
            completedNodeItems.Add($"{sectionStep.Step}:{sectionStep.ItemId}");
          }
          break;

        case "done":
          var final = JsonSerializer.Deserialize<ConsultGenerationJobResponse>(json, SseJsonOptions);
          if (final != null)
          {
            Logger.LogInformation(
              "Consult generation SSE done received. JobId={JobId}, Status={Status}, TotalCount={TotalCount}, CompletedCount={CompletedCount}, FailedCount={FailedCount}",
              final.JobId,
              final.Status,
              final.TotalBlockCount,
              final.CompletedBlockCount,
              final.FailedBlockCount);

            ApplyConsultGenerationJobResponse(final, GetActiveBlockSnapshots());
          }

          runTerminalStatus = final?.Status ?? "Completed";
          await InvokeAsync(StateHasChanged);
          return new ConsultGenerationEventHandlingResult(
            ConsultGenerationEventResult.Completed,
            FinalStatus: final?.Status);

        case "error":
          var error = JsonSerializer.Deserialize<ConsultGenerationErrorEvent>(json, SseJsonOptions);
          if (error != null && IsPreprocessingFailureStage(error.Stage))
          {
            aiProgressNotice = null;
            aiRequestError = error.Error;
            runTerminalStatus = "Failed";
            isAiRequestLoading = false;
            await InvokeAsync(StateHasChanged);
            return new ConsultGenerationEventHandlingResult(
              ConsultGenerationEventResult.Continue,
              ServerErrorEventSeen: true);
          }

          Logger.LogWarning(
            "Consult generation SSE error event received. PayloadLength={PayloadLength}",
            json.Length);

          return new ConsultGenerationEventHandlingResult(
            ConsultGenerationEventResult.FallbackToPolling,
            ServerErrorEventSeen: true,
            FallbackDiagnosticReason: "server-error-event");
      }

      await InvokeAsync(StateHasChanged);
      return new ConsultGenerationEventHandlingResult(ConsultGenerationEventResult.Continue);
    }
    catch
    {
      Logger.LogWarning(
        "Consult generation SSE event handling failed. EventName={EventName}, PayloadLength={PayloadLength}",
        eventName,
        json.Length);

      return new ConsultGenerationEventHandlingResult(
        ConsultGenerationEventResult.FallbackToPolling,
        FallbackDiagnosticReason: "exception");
    }
  }

  private void ApplyConsultGenerationJobResponse(
    ConsultGenerationJobResponse response,
    IReadOnlyList<PackageBlock> blockSnapshots)
  {
    // Every payload applied here is snapshot-shaped (the snapshot event, a
    // done payload, or a polled response) — the rail's Setup row completes
    // on it.
    runEventSeen = true;
    generatedBlocks = response.GeneratedBlocks;

    // The deliverables, present on Completed payloads only and kept once seen.
    // v7 sends the set; v6 sends one string, which becomes a one-entry set so
    // the render path is shared.
    if (response.AssembledDocuments is { Count: > 0 })
    {
      assembledDocuments = response.AssembledDocuments;
    }

    // Kept once seen, like the documents: a later poll that omits them must
    // not make the explanation disappear.
    if (response.SkippedDocuments is { Count: > 0 })
    {
      skippedDocuments = response.SkippedDocuments;
    }
    else if (response.AssembledDocument != null)
    {
      assembledDocuments = new[]
      {
        new ConsultGenerationResultDocumentResponse("consult", "Consultation note", response.AssembledDocument)
      };
    }
    failedBlockErrors = response.FailedBlocks;
    totalBlockCount = response.TotalBlockCount == 0 ? blockSnapshots.Count : response.TotalBlockCount;
    completedBlockCount = response.CompletedBlockCount + response.FailedBlockCount;

    if (response.Status != "Failed"
        && response.Nodes is { Count: > 0 }
        && response.CompletedStageCount.HasValue
        && response.CompletedStageCount.Value < response.Nodes.Count)
    {
      // The next in-flight node's package-declared label is the progress notice.
      aiProgressNotice = response.Nodes[response.CompletedStageCount.Value].Label;
    }

    if (response.CompletedStageCount.HasValue)
      completedAnalysisStageCount = response.CompletedStageCount.Value;
    if (response.TotalStageCount.HasValue)
      totalAnalysisStageCount = response.TotalStageCount.Value;
    if (response.Nodes is { Count: > 0 })
      nodeLabels = response.Nodes.Select(node => node.Label).ToList();

    if (response.Status == "Failed" && !string.IsNullOrWhiteSpace(response.AnalysisError))
    {
      aiProgressNotice = null;
      aiRequestError = response.AnalysisError;
      return;
    }

    if (response.Status == "Failed" && !string.IsNullOrWhiteSpace(response.RuntimeFailureError))
    {
      aiProgressNotice = null;
      aiRequestError = response.RuntimeFailureError;
      return;
    }

    UpdateFailedBlockError(blockSnapshots);
  }

  private static bool IsPreprocessingFailureStage(string? stage)
  {
    return !string.IsNullOrWhiteSpace(stage)
      && stage.EndsWith("-failed", StringComparison.Ordinal);
  }

  private bool IsRunPhase => !editingDraft && (isAiRequestLoading || totalBlockCount > 0);

  // The frozen v5/v6 slot, synthesized when a package declares nothing: one
  // required input labelled as the page always labelled it.
  private static readonly IReadOnlyList<WorkflowPackageInputResponse> LegacyInputs =
    new[] { new WorkflowPackageInputResponse("consult_draft", "Consult draft", true) };

  private bool IsMultiDeliverable => declaredResults is { Count: > 1 };

  // v7 block ids carry the deliverable: "{resultId}:{nodeId}[:{itemId}]".
  private IEnumerable<PackageBlock> BlocksFor(string resultId) =>
    packageBlocks.Where(block => block.Id.StartsWith($"{resultId}:", StringComparison.Ordinal));

  private string SectionSummary =>
    IsMultiDeliverable
      ? $"{declaredResults!.Count} documents · {BlocksFor(declaredResults[0].Id).Count()} sections each"
      : $"{packageBlocks.Count} sections";

  // Rebuilds the fields for a package's declaration, carrying whatever was
  // already supplied into an id the new package still declares — switching
  // packages never smuggles a stale input into a run.
  //
  // #236: an attachment carries the same way typed text does. Dropping it
  // would discard an upload the clinician just made without asking, and would
  // leave the two ways of filling a slot behaving differently for no reason
  // they could see.
  private void SyncInputFields(IReadOnlyList<WorkflowPackageInputResponse>? declaration)
  {
    var carried = inputFields.ToDictionary(field => field.Id, field => field, StringComparer.Ordinal);

    inputFields = (declaration is { Count: > 0 } ? declaration : LegacyInputs)
      .Select(input =>
      {
        var field = new ConsultInputField(input.Id, input.Label, input.Required);

        if (carried.TryGetValue(input.Id, out var previous))
        {
          field.Value = previous.Value;
          field.FileName = previous.FileName;
          field.FileContent = previous.FileContent;
          field.FileContentType = previous.FileContentType;
          field.PreviewText = previous.PreviewText;
          field.PageCount = previous.PageCount;
        }

        return field;
      })
      .ToList();
  }

  // Re-attaching to a running job restores what it ran on, which the memento
  // holds as text — so any attachment in the form is stale by definition.
  private void ApplyInputValues(IReadOnlyDictionary<string, string> values)
  {
    foreach (var field in inputFields)
    {
      RemoveFile(field);
      field.Value = values.GetValueOrDefault(field.Id, string.Empty);
    }
  }

  // #236: clears the whole slot, not just its text. Leaving the attachment
  // behind left a scheduled submit showing "loaded referral.txt" over an
  // empty box — a label describing something that was no longer there.
  private void ClearInputs()
  {
    foreach (var field in inputFields)
    {
      field.Value = string.Empty;
      RemoveFile(field);
    }
  }

  // #236: bytes accepted before anything is uploaded, so a huge file is not
  // sent merely to be refused. A size bound, not format knowledge — the
  // parser is the only thing that knows what a format is, and it applies the
  // same bound server-side (ConsultGenerationJobs.MaxInputFileBytes).
  private const int MaxUploadBytes = 10 * 1024 * 1024;

  private async Task LoadFileAsync(ConsultInputField field, InputFileChangeEventArgs args)
  {
    var file = args.FileCount > 0 ? args.File : null;

    if (file == null)
    {
      return;
    }

    // Attaching a file is an edit like any other: a stale confirmation would
    // outlive what it described.
    field.FileError = null;
    scheduleConfirmation = null;

    if (file.Size > MaxUploadBytes)
    {
      field.FileError = $"That file is larger than {MaxUploadBytes / (1024 * 1024)} MB.";
      return;
    }

    field.IsReading = true;
    await InvokeAsync(StateHasChanged);

    try
    {
      using var buffer = new MemoryStream();
      await using (var stream = file.OpenReadStream(MaxUploadBytes))
      {
        await stream.CopyToAsync(buffer);
      }

      var content = buffer.ToArray();
      var outcome = await DocumentService.ExtractAsync(content, file.ContentType);

      if (!outcome.Succeeded)
      {
        // The server's own sentence for this cause, shown verbatim. The slot
        // stays as it was, so a refused file changes nothing.
        field.FileError = outcome.Error;
        return;
      }

      // The file becomes the input. Value is left alone underneath so that
      // removing the file gives back whatever was typed before.
      field.FileName = file.Name;
      field.FileContent = content;
      field.FileContentType = string.IsNullOrWhiteSpace(file.ContentType)
        ? "application/octet-stream"
        : file.ContentType;
      field.PreviewText = outcome.Text!;
      field.PageCount = outcome.PageCount;
    }
    catch (Exception ex)
    {
      field.FileError = $"That file could not be read: {ex.Message}";
    }
    finally
    {
      field.IsReading = false;
    }
  }

  private void RemoveFile(ConsultInputField field)
  {
    field.FileName = null;
    field.FileContent = null;
    field.FileContentType = null;
    field.PreviewText = string.Empty;
    field.PageCount = null;
    field.FileError = null;
    scheduleConfirmation = null;
  }

  // What the request carries: declared ids with text, for slots filled by
  // typing. Blank optional inputs are omitted, not sent empty — the API
  // rejects blank values, and the effective-input hash covers exactly what
  // was supplied.
  private Dictionary<string, string> SuppliedInputs() =>
    inputFields
      .Where(field => !field.HasFile && !string.IsNullOrWhiteSpace(field.Value))
      .ToDictionary(field => field.Id, field => field.Value, StringComparer.Ordinal);

  // #236: the attached documents. The file travels rather than its text, so
  // the server extracts it and the record says what read it.
  private Dictionary<string, InputFilePayload> SuppliedFiles() =>
    inputFields
      .Where(field => field.HasFile)
      .ToDictionary(
        field => field.Id,
        field => new InputFilePayload(field.FileContentType!, field.FileContent!),
        StringComparer.Ordinal);

  // What every display surface and memento shows: the text that ran,
  // whichever way the slot was filled.
  private Dictionary<string, string> EffectiveInputTexts() =>
    inputFields
      .Where(field => field.IsFilled)
      .ToDictionary(field => field.Id, field => field.EffectiveText, StringComparer.Ordinal);

  // NB: 'field' is a contextual keyword inside property accessors (C# 14), so
  // the lambdas below name their parameter 'entry'.
  private bool HasEveryRequiredInput =>
    inputFields.Where(entry => entry.Required).All(entry => entry.IsFilled);

  private bool HasAnyInput => inputFields.Any(entry => entry.IsFilled);

  // The draft bar summarizes the first supplied input — the primary slot in
  // every package shape we ship.
  private string DraftSnippet
  {
    get
    {
      var first = inputFields
        .Select(entry => entry.EffectiveText)
        .FirstOrDefault(value => !string.IsNullOrWhiteSpace(value)) ?? string.Empty;
      var flattened = first.ReplaceLineEndings(" ").Trim();
      // Empty when re-attached from another tab — the record carries no inputs.
      return flattened.Length == 0 ? "—"
        : flattened.Length <= 80 ? flattened
        : flattened[..80] + "…";
    }
  }

  private void EditDraft()
  {
    editingDraft = true;
  }

  private void BackToRun()
  {
    editingDraft = false;
  }

  // The tab in view: the selected deliverable, else the first (result-set order).
  private ConsultGenerationResultDocumentResponse? ActiveDocument =>
    assembledDocuments.FirstOrDefault(document => document.ResultId == activeDocumentId)
      ?? assembledDocuments.FirstOrDefault();

  private string CopyButtonLabel => copyFeedback ?? "Copy note";

  // Copies the finished note as plain text: the document in view verbatim (the
  // active tab when a package declares several), or note-ordered sections —
  // name on its own line, prose below, blank line between (v5).
  private async Task CopyNoteAsync()
  {
    var text = ActiveDocument?.Text ?? string.Join("\n\n", packageBlocks
      .Where(standard => generatedBlocks.TryGetValue(standard.Id, out var prose) && !string.IsNullOrWhiteSpace(prose))
      .Select(standard => $"{standard.Name}\n{generatedBlocks[standard.Id].Trim()}"));

    try
    {
      await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
      copyFeedback = "Copied ✓";
    }
    catch (Exception)
    {
      copyFeedback = "Copy failed";
    }

    var token = ++copyFeedbackToken;
    await Task.Delay(TimeSpan.FromSeconds(2));

    if (token == copyFeedbackToken)
    {
      copyFeedback = null;
      await InvokeAsync(StateHasChanged);
    }
  }

  // A new pin resolves to a different package: reload the sections and the
  // node map from it.
  private async Task OnPackagePinnedAsync()
  {
    await LoadPackageBlocksAsync();
    await LoadWorkflowNodesAsync();
  }

  // Setup covers standards resolution and job submission; the snapshot event
  // marks it done — symmetric with done/error resolving the Done row.
  private string? SetupRowStatus()
  {
    return runEventSeen || !isAiRequestLoading ? "Completed" : "Running";
  }

  // Block ids are composite — "nodeId:itemId" in v6, "resultId:nodeId:itemId"
  // in v7 — while the live prose-step events carry the plain item id. The item
  // is always the last segment, so matching on it covers every spec version
  // (v5's plain ids have no separator at all).
  private static string ItemPart(string sectionId)
  {
    var separator = sectionId.LastIndexOf(':');
    return separator < 0 ? sectionId : sectionId[(separator + 1)..];
  }

  // Per-item status under one forEach node, keyed by the plain item id (the
  // prose-step events' currency). Pair ticks come from those events; a done
  // node covers items whose events were missed (polling fallback), and failed
  // sections — keyed by composite block ids in v6 — skip their remaining steps.
  private string? NodeItemStatus(WorkflowManifestReader.NodeView node, bool nodeDone, bool nodeCurrent, string itemId)
  {
    if (completedNodeItems.Contains($"{node.Id}:{ItemPart(itemId)}")
        || completedNodeItems.Contains($"{node.Id}:{itemId}")
        || (node.IsResult && generatedBlocks.ContainsKey(itemId)))
    {
      return "Completed";
    }

    if (failedBlockErrors.Keys.Any(key => key == itemId || ItemPart(key) == itemId))
    {
      return "Failed";
    }

    if (nodeDone)
    {
      return "Completed";
    }

    if (nodeCurrent)
    {
      return "Running";
    }

    return null;
  }

  // The Done row resolves only on a terminal signal: the done event, an error
  // event, or a terminal polled status. Failed sections downgrade a Completed
  // status, matching the error bars.
  private string? DoneRowStatus()
  {
    if (runTerminalStatus != null)
    {
      return runTerminalStatus == "Failed" || !string.IsNullOrEmpty(aiRequestError)
        ? "Failed"
        : "Completed";
    }

    // The run stopped without a terminal event (e.g., the submit call threw).
    if (!isAiRequestLoading && !string.IsNullOrEmpty(aiRequestError))
    {
      return "Failed";
    }

    return null;
  }

  private static string RunStatusGlyph(string? status) => status switch
  {
    "Completed" => "✓",
    "Failed" => "✗",
    "Running" => "●",
    _ => "○"
  };

  private static string RunStatusCss(string? status) => status switch
  {
    "Completed" => "node-status--success",
    "Failed" => "node-status--failure",
    "Running" => "node-status--current",
    _ => "node-status--muted"
  };

  private string GetStageChecklistLabel(int stepNum)
  {
    // Labels come from the job's package-declared nodes; the generic fallback covers
    // the moments before the first snapshot arrives.
    if (nodeLabels != null && stepNum >= 1 && stepNum <= nodeLabels.Count)
    {
      return nodeLabels[stepNum - 1];
    }

    return $"Stage {stepNum}";
  }

  private void UpdateFailedBlockError(IReadOnlyList<PackageBlock> blockSnapshots)
  {
    if (failedBlockErrors.Count == 0)
    {
      if (aiRequestError?.StartsWith("Unable to generate:", StringComparison.Ordinal) == true)
      {
        aiRequestError = null;
      }

      return;
    }

    var failedSectionNames = blockSnapshots
      .Where(section => failedBlockErrors.ContainsKey(section.Id))
      .Select(section => section.Name);

    aiRequestError = $"Unable to generate: {string.Join(", ", failedSectionNames)}.";
  }

  private void MarkPollingFallbackStarted()
  {
    if (activeSseAttempt == null)
    {
      return;
    }

    activeSseAttempt.PollingFallbackStarted = true;
    ReportSseExit(activeSseAttempt, "polling-fallback-started");
  }

  private void MarkPollingFallbackCompleted()
  {
    if (activeSseAttempt == null)
    {
      return;
    }

    activeSseAttempt.PollingFallbackStarted = true;
    activeSseAttempt.PollingFallbackCompleted = true;
    ReportSseExit(activeSseAttempt, "polling-fallback-completed");
  }

  private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
  {
    CancelActiveEventStream("navigation");
  }

  private void CancelActiveEventStream(string reason)
  {
    activeEventStreamCancellationReason ??= reason;

    if (IsLifecycleSseExitReason(reason))
    {
      isAiRequestLoading = false;
    }

    if (activeSseAttempt != null)
    {
      ReportSseExit(activeSseAttempt, reason);
    }

    try
    {
      activeEventStreamCancellationTokenSource?.Cancel();
    }
    catch (ObjectDisposedException)
    {
    }
  }

  private void ReportSseExit(SseAttemptState attempt, string reason)
  {
    if (IsTerminalSseExitReason(reason))
    {
      if (attempt.TerminalExitReported)
      {
        return;
      }

      attempt.TerminalExitReported = true;
    }

    if (IsLifecycleSseExitReason(reason))
    {
      if (attempt.LifecycleExitReported)
      {
        return;
      }

      attempt.LifecycleExitReported = true;
    }

    _ = SseDiagnostics.ReportSseExitAsync(new SseExitDiagnostic(
      attempt.JobId,
      attempt.AttemptId,
      reason,
      attempt.LatestEventId,
      attempt.LatestEventType,
      attempt.EventCount,
      attempt.ElapsedMs,
      attempt.PollingFallbackStarted,
      attempt.PollingFallbackCompleted));
  }

  private static bool IsLifecycleSseExitReason(string reason)
  {
    return reason is "component-disposed" or "navigation";
  }

  private static bool IsTerminalSseExitReason(string reason)
  {
    return reason is "completed-via-sse"
      or "server-error-event"
      or "ended-before-done"
      or "timeout"
      or "exception"
      or "manual-cancel";
  }

  private static string GetCompletedSseExitReason(SseAttemptState attempt, string? finalStatus)
  {
    return attempt.ServerErrorEventSeen || finalStatus == "Failed"
      ? "server-error-event"
      : "completed-via-sse";
  }

  private static bool CanReconnectSse(SseStreamState stream, int reconnectAttempt)
  {
    if (MaxSseReconnectAttempts <= 0)
    {
      return false;
    }

    return reconnectAttempt < MaxSseReconnectAttempts
      && !stream.TerminalEventSeen
      && (!string.IsNullOrWhiteSpace(stream.LatestEventId) || stream.EventCount == 0);
  }

  private static TimeSpan GetSseReconnectBackoff(int reconnectAttempt)
  {
    return reconnectAttempt switch
    {
      0 => TimeSpan.FromMilliseconds(500),
      1 => TimeSpan.FromMilliseconds(1500),
      _ => TimeSpan.FromSeconds(3)
    };
  }

  private IReadOnlyList<PackageBlock> GetActiveBlockSnapshots()
  {
    return activeBlockSnapshots.Count > 0
      ? activeBlockSnapshots
      : packageBlocks;
  }

  // One deliverable block of the pinned package (v5: a section; v6: the
  // result aggregator's expansion) — the note-stream and tally roster.
  private sealed record PackageBlock(string Id, string Name);

  /// <summary>
  /// One editable setup field. A mutable class, not a record: the text area
  /// binds to Value directly, which is the only shape Blazor's expression
  /// formatter accepts inside a loop (an indexer keyed by a property access
  /// throws at render time).
  /// </summary>
  private sealed class ConsultInputField
  {
    public ConsultInputField(string id, string label, bool required)
    {
      Id = id;
      Label = label;
      Required = required;
    }

    public string Id { get; }
    public string Label { get; }
    public bool Required { get; }
    public string Value { get; set; } = string.Empty;

    // #208: why a load was refused. Per-field so a failed upload names the
    // field the user aimed at.
    public string? FileError { get; set; }

    // #236: the attached document. The bytes are held because the job request
    // carries the file itself — the server extracts it again there, so what
    // runs is what the server read rather than what this client reported. An
    // IBrowserFile's stream does not survive until submit, so it cannot be
    // re-read then.
    public string? FileName { get; set; }
    public byte[]? FileContent { get; set; }
    public string? FileContentType { get; set; }
    public int? PageCount { get; set; }

    // What the server got out of the file. Read-only to the user, and
    // load-bearing beyond display: the run-phase draft bar and the re-attach
    // memento both need the input text, and this is the client's only copy.
    public string PreviewText { get; set; } = string.Empty;

    public bool IsReading { get; set; }

    public bool HasFile => FileContent != null;

    /// <summary>
    /// What this slot contributes, whichever way it was filled — the one
    /// question every gate should be asking.
    /// </summary>
    public bool IsFilled => HasFile || !string.IsNullOrWhiteSpace(Value);

    /// <summary>The text that ran, for display surfaces that show inputs.</summary>
    public string EffectiveText => HasFile ? PreviewText : Value;

    public string Placeholder => Id == "consult_draft"
      ? "Enter referral details, clinical context, and the consult question..."
      : $"Enter {Label.ToLowerInvariant()}...";
  }

