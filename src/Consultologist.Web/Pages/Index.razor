@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation

<PageTitle>Consultologist · Clinical workspace</PageTitle>

@* #766: `/` is the public landing for signed-out visitors — the marketing /
   verifiability story (#685). A signed-in clinician's landing is the Consults
   page, so they are redirected there (see OnInitializedAsync) and never see
   this hero; the account-status nudge that once lived here moved onto Consults. *@
<AuthorizeView>
    <NotAuthorized>
        <section class="landing-hero">
            <div class="landing-hero__copy">
                <span class="section-eyebrow">Clinical workspace</span>
                <h1 class="landing-hero__title">Consult drafting with traceable clinical context.</h1>
                <p class="page-description">
                    Build structured specialist consults from referral details, review the generated note,
                    and keep the physician in control before anything reaches the chart. Every consult
                    resolves to versioned, inspectable artifacts — the workflow, its rules, and each
                    step's provenance.
                </p>
                <div class="action-row">
                    <FluentAnchor Appearance="Appearance.Accent" Href="authentication/login">
                        Log in
                    </FluentAnchor>
                </div>
            </div>
            <figure class="note-artifact" aria-label="Example consult note with provenance annotations">
                @* #776: the mock note is decorative — the figure's aria-label
                   describes it — so hide its subtree, or its <h2>s show up as
                   phantom sections in a screen reader's heading outline. *@
                <div class="note-artifact__paper" aria-hidden="true">
                    <div class="note-artifact__section">
                        <h2 class="note-artifact__heading">History of present illness</h2>
                        <p class="note-artifact__line">
                            62-year-old presenting with progressive exertional dyspnea over three
                            months, now limiting a single flight of stairs…
                        </p>
                    </div>
                    <div class="note-artifact__section">
                        <h2 class="note-artifact__heading">Allergies</h2>
                        <p class="note-artifact__line">No known drug allergies documented in the referral.</p>
                    </div>
                    <div class="note-artifact__section">
                        <h2 class="note-artifact__heading">Assessment</h2>
                        <p class="note-artifact__line">
                            New-onset atrial fibrillation, rate-controlled; outpatient
                            echocardiography arranged.
                        </p>
                    </div>
                </div>
                <figcaption class="note-artifact__annotations">
                    <span class="note-annotation" style="--at: 10%">general@v2026.07.6</span>
                    <span class="note-annotation" style="--at: 46%">text → test-json v47</span>
                    <span class="note-annotation note-annotation--verified" style="--at: 76%">6f52afd0… ✓</span>
                </figcaption>
                <div class="note-pipeline" role="img" aria-label="The seven workflow stages that produce the note, running in sequence">
                    <span class="note-pipeline__dot" style="--i: 0" title="Extracting clinical concepts" aria-hidden="true"></span>
                    <span class="note-pipeline__link" style="--i: 0" aria-hidden="true"></span>
                    <span class="note-pipeline__dot" style="--i: 1" title="Identifying primary problem" aria-hidden="true"></span>
                    <span class="note-pipeline__link" style="--i: 1" aria-hidden="true"></span>
                    <span class="note-pipeline__dot" style="--i: 2" title="Building reference trajectory" aria-hidden="true"></span>
                    <span class="note-pipeline__link" style="--i: 2" aria-hidden="true"></span>
                    <span class="note-pipeline__dot" style="--i: 3" title="Building patient trajectory" aria-hidden="true"></span>
                    <span class="note-pipeline__link" style="--i: 3" aria-hidden="true"></span>
                    <span class="note-pipeline__dot" style="--i: 4" title="Drafting section" aria-hidden="true"></span>
                    <span class="note-pipeline__link" style="--i: 4" aria-hidden="true"></span>
                    <span class="note-pipeline__dot" style="--i: 5" title="Applying patient information" aria-hidden="true"></span>
                    <span class="note-pipeline__link" style="--i: 5" aria-hidden="true"></span>
                    <span class="note-pipeline__dot" style="--i: 6" title="Applying section instructions" aria-hidden="true"></span>
                </div>
            </figure>
        </section>
        <PublicChainStrip />
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // #766: a signed-in clinician's landing is the Consults page. Redirect
        // there (replace, so Back does not trap them on a bouncing `/`) rather
        // than show a second dashboard. Signed-out visitors fall through to the
        // public landing above.
        if (AuthenticationState == null)
        {
            return;
        }

        var state = await AuthenticationState;

        if (state.User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo("consults", replace: true);
        }
    }
}
