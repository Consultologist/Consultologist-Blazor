@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Consultologist.Web.Services.AI
@using Consultologist.Web.Services.Workflow
@inject IAccountEndpointService AccountService
@inject IAIEndpointService AIService
@inject IWorkflowEndpointService WorkflowService
@attribute [Authorize]
@implements IDisposable

@page "/history"
@page "/history/{JobId}"

<PageTitle>History</PageTitle>

<section class="page-header">
    <div class="page-header__content">
        <span class="section-eyebrow">History</span>
        <h1 class="page-title">Consult generation history.</h1>
        <p class="page-description">
            Consult generation jobs started by this account, most recent first.
        </p>
    </div>
</section>

<AuthorizeView>
    <Authorized>
        <section class="content-card">
            <div class="form-stack">
                <h2 class="panel-title">Recent consult jobs</h2>

                @* #202: a refused cancel has to say which state refused, or the
                   button just appears not to work. *@
                @if (!string.IsNullOrWhiteSpace(_cancelError))
                {
                    <FluentMessageBar Intent="MessageIntent.Error">@_cancelError</FluentMessageBar>
                }

                @if (jobsLoading && jobs.Count == 0)
                {
                    <div class="loading-state">
                        <FluentProgressRing />
                        <span>Loading job history...</span>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(jobsErrorMessage))
                {
                    <FluentMessageBar Intent="MessageIntent.Error">@jobsErrorMessage</FluentMessageBar>
                }
                else if (jobs.Count == 0)
                {
                    <p class="muted-text">No consult jobs found.</p>
                }
                else
                {
                    <div class="job-history-list">
                        @foreach (var job in jobs)
                        {
                            <details class="job-item" id="job-@job.JobId" open="@(job.JobId == JobId)">
                                <summary class="job-item__summary" @onclick="async () => await EnsureDetailsLoadedAsync(job.JobId)">
                                    <span class="job-item__chevron" aria-hidden="true">&#x203A;</span>
                                    <div class="job-history-item__status">
                                        <span class="job-status-badge job-status-badge--@job.Status.ToLowerInvariant()">
                                            @job.Status
                                        </span>
                                        @if (job.Source == "email")
                                        {
                                            <span class="job-source-badge" title="Submitted by email">email</span>
                                        }
                                    </div>
                                    <div class="job-history-item__meta">
                                        <span class="muted-text">@FormatDate(job.CreatedAtUtc)</span>
                                        @if (job.Status == "Scheduled" && job.ScheduledAtUtc is { } scheduledAt)
                                        {
                                            <span class="muted-text">runs @scheduledAt.ToLocalTime().ToString("MMM d, h:mm tt")</span>
                                        }
                                        <span class="muted-text">@job.CompletedBlockCount / @job.TotalBlockCount sections</span>
                                        @if (job.FailedBlockCount > 0)
                                        {
                                            <span class="muted-text">@job.FailedBlockCount failed</span>
                                        }
                                        @* #367: the run view is the only place a job's RAIL is drawn —
                                           its nodes, their per-item rows, and the statuses the job itself
                                           reported (#356, #361). The section below lists the nodes that
                                           produced output, which cannot show a node that was skipped or one
                                           that failed before recording anything.

                                           This link used to be guarded on Running or Queued, so that surface
                                           was unreachable for every job a minute after it finished — and for
                                           a Scheduled job (#157), which the guard missed entirely. The route
                                           never had the restriction: TryReattachAsync handles a terminal
                                           snapshot deliberately. *@
                                        @* stopPropagation is load-bearing: the row is the summary of an
                                           expandable panel, so without it the click toggles the panel
                                           instead of navigating. *@
                                        <a class="run-view-link" href="/consults/@job.JobId"
                                           @onclick:stopPropagation="true"
                                           title="@(IsTerminal(job.Status) ? "Open this run's steps in Consults" : "Open the live run view in Consults")">@(IsTerminal(job.Status) ? "view run" : "watch live")</a>
                                        @* #202: only a run that has not started. stopPropagation for the
                                           same reason as the link above — the row is a summary. *@
                                        @if (job.Status == "Scheduled")
                                        {
                                            @* #390: editing the time cancels and re-creates, so the row
                                               the user is looking at will be replaced by a new one. Say so
                                               here rather than letting them find out in the list. *@
                                            @if (_editing == job.JobId)
                                            {
                                                <span @onclick:stopPropagation="true">
                                                    <input type="datetime-local"
                                                           class="node-field__input"
                                                           value="@_editValue"
                                                           max="@MaxScheduleLocal"
                                                           disabled="@(_rescheduling == job.JobId)"
                                                           @onchange="args => _editValue = args.Value?.ToString() ?? string.Empty"
                                                           aria-label="New time for this consult" />
                                                </span>
                                                <button type="button" class="cancel-run-button"
                                                        disabled="@(_rescheduling == job.JobId)"
                                                        @onclick:stopPropagation="true"
                                                        @onclick="() => RescheduleAsync(job)">
                                                    @(_rescheduling == job.JobId ? "moving…" : "move")
                                                </button>
                                                @* The reset: an edit field prefilled from a record is a
                                                   field you can lose the record in. *@
                                                <button type="button" class="cancel-run-button"
                                                        disabled="@(_rescheduling == job.JobId)"
                                                        @onclick:stopPropagation="true"
                                                        @onclick="() => ResetEdit(job)">
                                                    reset
                                                </button>
                                                <button type="button" class="cancel-run-button"
                                                        disabled="@(_rescheduling == job.JobId)"
                                                        @onclick:stopPropagation="true"
                                                        @onclick="() => _editing = null">
                                                    done
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="cancel-run-button"
                                                        @onclick:stopPropagation="true"
                                                        @onclick="() => BeginEdit(job)">
                                                    change time
                                                </button>
                                            }
                                            <button type="button" class="cancel-run-button"
                                                    disabled="@(_cancelling == job.JobId)"
                                                    @onclick:stopPropagation="true"
                                                    @onclick="() => CancelScheduledRunAsync(job.JobId)">
                                                @(_cancelling == job.JobId ? "cancelling…" : "cancel")
                                            </button>
                                        }
                                    </div>
                                    <div class="job-history-item__id">
                                        <span class="muted-text">@job.JobId[..8]&hellip;</span>
                                    </div>
                                </summary>
                                <div class="job-item__detail">
                                    @{
                                        var hasStartedLoad = _jobDetails.TryGetValue(job.JobId, out var detail);
                                        _jobDetailErrors.TryGetValue(job.JobId, out var detailError);
                                    }
                                    @if (!hasStartedLoad)
                                    {
                                        @* Rendered but empty until first expand *@
                                    }
                                    else if (!string.IsNullOrWhiteSpace(detailError))
                                    {
                                        <FluentMessageBar Intent="MessageIntent.Error">@detailError</FluentMessageBar>
                                    }
                                    else if (detail == null)
                                    {
                                        <div class="loading-state">
                                            <FluentProgressRing />
                                            <span>Loading job events&hellip;</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="provenance-chips">
                                            <span class="provenance-chip @(WorkflowPackageNames.IsAccountPackage(detail.WorkflowPackage) ? "provenance-chip--fork" : "")"
                                                  title="Workflow package this job ran">
                                                @(detail.WorkflowPackage ?? "—")
                                            </span>
                                            <span class="provenance-chip" title="Output-contract catalog version this job ran under">
                                                @(detail.CatalogRef ?? "catalog —")
                                            </span>
                                            @* #373: the package's own format version, which is what an
                                               outside reader can act on. This chip used to show the job
                                               RECORD's storage version and call it a schema — an internal
                                               counter that is stamped 6 or 7 and never 8, so every v8 job
                                               read as v7. The storage version moved into the Provenance
                                               list below, where the other record-level versions live.

                                               Not the word "schema": it already means a node's output
                                               contract in this system. Omitted entirely when the job did
                                               not record one — a job from before this knows nothing about
                                               its format, and a dash would read as "no format". *@
                                            @if (detail.PackageSpecVersion is { } packageFormat)
                                            {
                                                <span class="provenance-chip" title="Package format (specVersion) this job's manifest was written against">
                                                    @* Parenthesised: Razor reads a bare v@name as an email
                                                       address and emits it verbatim. *@
                                                    format v@(packageFormat)
                                                </span>
                                            }
                                            @if (detail.Source == "email")
                                            {
                                                <span class="provenance-chip" title="This job was submitted by email intake">
                                                    source: email
                                                </span>
                                            }
                                        </div>

                                        <details class="job-detail-section">
                                            <summary class="muted-text">Provenance</summary>
                                            <dl class="provenance-list">
                                                @* #373: this record's own storage shape — which fields
                                                   below a reader should trust. It belongs here with the
                                                   other record-level versions rather than on the summary
                                                   row beside two registry-resolvable refs, and it is not
                                                   called a schema: nothing declares it, the engine stamps
                                                   it, and it is unrelated to the package's format.

                                                   Top-level dt, not provenance-list__nested — the nested
                                                   rows are per-input and per-deliverable, and a test pins
                                                   their exact sequence. *@
                                                <dt>Record storage version</dt>
                                                <dd>v@(detail.SchemaVersion?.ToString() ?? "—")</dd>
                                                <dt>Input hash (v@(detail.EffectiveInputHashVersion?.ToString() ?? "—"))</dt>
                                                <dd class="hash-text">@(detail.EffectiveInputHash ?? "—")</dd>
                                                @* #238: beside the hash, never inside it. Only slots
                                                   the server read from a document appear — an absent
                                                   entry means nothing was recorded, not that the
                                                   input was typed. *@
                                                @foreach (var origin in detail.InputOrigins ?? new Dictionary<string, IReadOnlyList<ConsultInputOrigin>>())
                                                {
                                                    <dt class="provenance-list__nested">@origin.Key</dt>
                                                    <dd>
                                                        @if (origin.Value.Count == 1)
                                                        {
                                                            @DescribeOrigin(origin.Value[0])
                                                        }
                                                        else
                                                        {
                                                            @* #428: one row per document, positionally — a
                                                               four-document referral is four readings, not one
                                                               reading with the pages summed. *@
                                                            <ol class="provenance-documents">
                                                                @foreach (var document in origin.Value)
                                                                {
                                                                    <li>@DescribeOrigin(document)</li>
                                                                }
                                                            </ol>
                                                        }
                                                    </dd>
                                                }
                                                @if (detail.WorkflowOutputHash != null)
                                                {
                                                    <dt>Output hash (v@(detail.WorkflowOutputHashVersion?.ToString() ?? "—"))</dt>
                                                    <dd class="hash-text">@detail.WorkflowOutputHash</dd>
                                                }
                                                @* v7: the per-deliverable digests the v3 output hash
                                                   above is computed over — the aggregate and its
                                                   constituents, both verifiable. *@
                                                @foreach (var document in detail.AssembledDocuments ?? Array.Empty<ConsultGenerationResultDocumentResponse>())
                                                {
                                                    <dt class="provenance-list__nested">@document.Label</dt>
                                                    <dd class="hash-text">@(document.DocumentHash ?? "—")</dd>
                                                }
                                                @* #315: a deliverable the package
                                                   declared and this job's inputs
                                                   excluded. It belongs beside the
                                                   evidence for the ones that exist —
                                                   a shorter list with no explanation
                                                   reads as a document that failed. *@
                                                @foreach (var skipped in detail.SkippedDocuments ?? Array.Empty<ConsultSkippedDocumentResponse>())
                                                {
                                                    <dt class="provenance-list__nested">@skipped.Label</dt>
                                                    <dd>not produced — it @skipped.Reason</dd>
                                                }
                                                @if (LineageFor(detail.WorkflowPackage) is { Count: > 1 } lineage)
                                                {
                                                    <dt>Lineage</dt>
                                                    <dd class="hash-text">@string.Join(" → ", lineage)</dd>
                                                }
                                                @if (AgentContracts(detail).Any())
                                                {
                                                    <dt>Agents</dt>
                                                    <dd>
                                                        @string.Join(" · ", AgentContracts(detail).Select(contract => AgentLine(contract, detail)))
                                                    </dd>
                                                }
                                            </dl>
                                        </details>

                                        var nodeGroups = BuildNodeGroups(detail);
                                            var setupBadge = detail.StartedAtUtc != null
                                                ? ("✓", "node-status--success")
                                                : ("·", "node-status--muted");
                                            var doneBadge = detail.Status switch
                                            {
                                                "Completed" => ("✓", "Done", "node-status--success"),
                                                "Failed" => ("✗", "Failed", "node-status--failure"),
                                                _ => ("●", detail.Status, "node-status--muted")
                                            };
                                        <details class="job-detail-section" open>
                                            <summary class="muted-text">Workflow (@nodeGroups.Count nodes)</summary>
                                            <div class="node-grid">
                                                <div class="node-row">
                                                    <span class="node-row__chevron" aria-hidden="true"></span>
                                                    <span class="node-row__status @setupBadge.Item2">@setupBadge.Item1</span>
                                                    <span class="node-row__label">Setup</span>
                                                    <span class="node-row__contract muted-text">
                                                        created @FormatDate(detail.CreatedAtUtc ?? default)@(detail.StartedAtUtc != null ? $" · started {FormatDate(detail.StartedAtUtc.Value)}" : "")
                                                    </span>
                                                    <span class="node-row__hashes hash-text">
                                                        <span title="@detail.EffectiveInputHash">in @HashPrefix(detail.EffectiveInputHash)</span>
                                                    </span>
                                                </div>
                                                @foreach (var group in nodeGroups)
                                                {
                                                        @if (group.Items.Count == 0)
                                                        {
                                                            <div class="node-row">
                                                                <span class="node-row__chevron" aria-hidden="true"></span>
                                                                <span class="node-row__status @StatusCss(group.NodeLevel?.Status)">@StatusGlyph(group.NodeLevel?.Status)</span>
                                                                <span class="node-row__label">@group.Descriptor.Label</span>
                                                                <span class="node-row__contract muted-text">@ContractLabel(group.Descriptor, detail)</span>
                                                                <span class="node-row__hashes hash-text">
                                                                    <span title="@group.NodeLevel?.InputHash">in @HashPrefix(group.NodeLevel?.InputHash)</span>
                                                                    <span title="@group.NodeLevel?.OutputHash">out @HashPrefix(group.NodeLevel?.OutputHash)</span>
                                                                </span>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <details class="node-group">
                                                                <summary class="node-row">
                                                                    <span class="node-row__chevron" aria-hidden="true">&#x203A;</span>
                                                                    <span class="node-row__status @StatusCss(group.NodeLevel?.Status)">@StatusGlyph(group.NodeLevel?.Status)</span>
                                                                    <span class="node-row__label">@group.Descriptor.Label</span>
                                                                    <span class="node-row__contract muted-text">
                                                                        @ContractLabel(group.Descriptor, detail) · per @group.Descriptor.ForEach item (@group.Items.Count)
                                                                    </span>
                                                                </summary>
                                                                @foreach (var (itemId, entry) in group.Items)
                                                                {
                                                                    <div class="node-row node-row--item">
                                                                        <span class="node-row__chevron" aria-hidden="true"></span>
                                                                        <span class="node-row__status @StatusCss(entry.Status)">@StatusGlyph(entry.Status)</span>
                                                                        <span class="node-row__label">@itemId</span>
                                                                        <span class="node-row__hashes hash-text">
                                                                            <span title="@entry.InputHash">in @HashPrefix(entry.InputHash)</span>
                                                                            <span title="@entry.OutputHash">out @HashPrefix(entry.OutputHash)</span>
                                                                            @if (entry.OutputHash != null && group.ConvergedOutputs.Contains(entry.OutputHash))
                                                                            {
                                                                                <span class="muted-text" title="Another item in this node produced the byte-identical output">= same output</span>
                                                                            }
                                                                        </span>
                                                                    </div>
                                                                }
                                                            </details>
                                                        }
                                                }
                                                <div class="node-row">
                                                    <span class="node-row__chevron" aria-hidden="true"></span>
                                                    <span class="node-row__status @doneBadge.Item3">@doneBadge.Item1</span>
                                                    <span class="node-row__label">@doneBadge.Item2</span>
                                                    <span class="node-row__contract muted-text">
                                                        @(detail.CompletedAtUtc != null ? FormatDate(detail.CompletedAtUtc.Value) : "")
                                                        @(detail.RuntimeFailureError != null ? $" · {detail.RuntimeFailureError}" : "")
                                                    </span>
                                                    @if (detail.WorkflowOutputHash != null)
                                                    {
                                                        <span class="node-row__hashes hash-text">
                                                            <span title="@detail.WorkflowOutputHash">out @HashPrefix(detail.WorkflowOutputHash)</span>
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                        </details>
                                    }
                                </div>
                            </details>
                        }
                    </div>

                    @if (jobsContinuationToken != null)
                    {
                        <FluentButton
                            Appearance="Appearance.Outline"
                            Disabled="@jobsLoading"
                            OnClick="LoadMoreJobsAsync">
                            @if (jobsLoading)
                            {
                                <FluentProgressRing style="width: 16px; height: 16px;" />
                                <span>Loading&hellip;</span>
                            }
                            else
                            {
                                <span>Load more</span>
                            }
                        </FluentButton>
                    }
                }
            </div>
        </section>
    </Authorized>
</AuthorizeView>

@code {
    /// <summary>
    /// #238's sentence, one document at a time: what read it, how many pages,
    /// whether a revision layer was resolved. The words are the record's.
    /// </summary>
    private static string DescribeOrigin(ConsultInputOrigin origin) =>
        $"read from a document by {origin.Extractor ?? "—"}"
        + (origin.PageCount is { } pages ? $" · {pages} page{(pages == 1 ? "" : "s")}" : "")
        + (origin.TrackedChangesResolved ? " · tracked changes resolved to the accepted view" : "");

    private List<AccountJobSummaryResponse> jobs = new();
    private string? jobsContinuationToken;
    private bool jobsLoading;
    private string? jobsErrorMessage;

    private Dictionary<string, ConsultGenerationJobResponse?> _jobDetails = new();
    private Dictionary<string, string?> _jobDetailErrors = new();

    // Contract id → agent name, decorated from the anonymous Public/Chain view
    // (the job record stores contract → version only; names are catalog metadata).
    private Dictionary<string, string> _agentNames = new(StringComparer.Ordinal);

    [Parameter]
    public string? JobId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadJobsAsync();
        await ApplyDeepLinkAsync();
        EnsurePollingStarted();
        await LoadAgentNamesAsync();
    }

    /// <summary>
    /// /history/{jobId} (the email reply's deep link, #158): surface that job
    /// first, expanded, with its detail eager-loaded — synthesizing a summary
    /// row from the detail when the job is outside the loaded page.
    /// </summary>
    private async Task ApplyDeepLinkAsync()
    {
        if (string.IsNullOrWhiteSpace(JobId))
        {
            return;
        }

        var existing = jobs.FindIndex(job => job.JobId == JobId);

        if (existing > 0)
        {
            var job = jobs[existing];
            jobs.RemoveAt(existing);
            jobs.Insert(0, job);
        }

        await EnsureDetailsLoadedAsync(JobId);

        if (existing < 0
            && _jobDetails.TryGetValue(JobId, out var detail)
            && detail != null)
        {
            jobs.Insert(0, SummaryFromDetail(detail));
        }
    }

    private static AccountJobSummaryResponse SummaryFromDetail(ConsultGenerationJobResponse detail) =>
        new(
            detail.JobId,
            detail.Status,
            detail.CreatedAtUtc ?? default,
            detail.StartedAtUtc,
            detail.CompletedAtUtc,
            detail.TotalBlockCount,
            detail.CompletedBlockCount,
            detail.FailedBlockCount,
            detail.Source,
            detail.ScheduledAtUtc);

    // #202: Cancelled belongs here or the poll loop never stops on a cancelled
    // row, and #367's link keeps offering to "watch live" a run that will not
    // happen.
    private static bool IsTerminal(string status) => status is "Completed" or "Failed" or "Cancelled";

    private string? _cancelling;
    private string? _cancelError;

    // #390: which row is being edited, and the datetime-local value it holds.
    private string? _editing;
    private string? _rescheduling;
    private string _editValue = string.Empty;

    // The client refuses what the server would (MaxScheduleHorizonDays).
    private static string MaxScheduleLocal =>
        ScheduleDefault.LocalInputValueIn(TimeSpan.FromDays(7));

    private void BeginEdit(AccountJobSummaryResponse job)
    {
        _editing = job.JobId;
        _cancelError = null;
        ResetEdit(job);
    }

    /// <summary>
    /// #390: back to the time actually on the job. The button exists because an
    /// edit field prefilled from a record is a field you can lose the record in
    /// — once it is typed over, nothing else on the page still shows it.
    /// </summary>
    private void ResetEdit(AccountJobSummaryResponse job)
    {
        _editValue = job.ScheduledAtUtc is { } scheduledAt
            ? ScheduleDefault.ToLocalInputValue(scheduledAt)
            : string.Empty;
    }

    /// <summary>
    /// #390: move it. The row cannot be patched in place the way a cancel is —
    /// rescheduling produces a NEW job id — so the original stays as Cancelled
    /// (#202's rule: a consult that was submitted and stopped is a fact worth
    /// keeping) and the new job is fetched and prepended.
    /// </summary>
    private async Task RescheduleAsync(AccountJobSummaryResponse job)
    {
        if (_rescheduling != null)
        {
            return;
        }

        if (ScheduleDefault.FromLocalInputValue(_editValue) is not { } newTime)
        {
            _cancelError = "Enter a date and time for this consult to run.";
            return;
        }

        _rescheduling = job.JobId;
        _cancelError = null;

        try
        {
            var newJobId = await AIService.RescheduleConsultGenerationJobAsync(job.JobId, newTime);

            var index = jobs.FindIndex(row => row.JobId == job.JobId);

            if (index >= 0)
            {
                jobs[index] = jobs[index] with { Status = "Cancelled" };
            }

            var detail = await AIService.GetConsultGenerationJobAsync(newJobId);
            jobs.Insert(0, SummaryFromDetail(detail));

            _editing = null;
            EnsurePollingStarted();
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            _cancelError = ex.Message;
        }
        finally
        {
            _rescheduling = null;
        }
    }

    /// <summary>
    /// #202: call off a scheduled run. The row stays — a consult that was
    /// submitted and stopped is a fact worth keeping — and updates in place the
    /// way the poll loop updates it, so the list does not jump.
    /// </summary>
    private async Task CancelScheduledRunAsync(string jobId)
    {
        if (_cancelling != null)
        {
            return;
        }

        _cancelling = jobId;
        _cancelError = null;

        try
        {
            await AIService.CancelConsultGenerationJobAsync(jobId);

            var index = jobs.FindIndex(job => job.JobId == jobId);

            if (index >= 0)
            {
                jobs[index] = jobs[index] with { Status = "Cancelled" };
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            // The server's sentence when it sent one — a 409 says which state
            // refused, which is the whole reason it is a 409.
            _cancelError = ex.Message;
        }
        finally
        {
            _cancelling = null;
        }
    }

    // #206: while any loaded row is non-terminal, refresh those jobs from the
    // snapshot endpoint so status/counts tick without a reload. One fetch per
    // non-terminal job also refreshes an expanded detail panel — a list-level
    // re-fetch could not. Two-tier cadence: Scheduled-only pages poll slowly
    // (those rows change at their fire time, not by the second).
    private CancellationTokenSource? _pollingCts;

    private void EnsurePollingStarted()
    {
        if (_pollingCts != null || !jobs.Any(job => !IsTerminal(job.Status)))
        {
            return;
        }

        var cts = new CancellationTokenSource();
        _pollingCts = cts;
        _ = PollInFlightJobsAsync(cts);
    }

    private async Task PollInFlightJobsAsync(CancellationTokenSource cts)
    {
        try
        {
            while (!cts.IsCancellationRequested)
            {
                var active = jobs.Where(job => !IsTerminal(job.Status)).ToList();

                if (active.Count == 0)
                {
                    return;
                }

                var fastCadence = active.Any(job => job.Status is "Queued" or "Running");
                await Task.Delay(TimeSpan.FromSeconds(fastCadence ? 5 : 60), cts.Token);

                if (jobsLoading)
                {
                    continue;
                }

                foreach (var job in active)
                {
                    try
                    {
                        var detail = await AIService.GetConsultGenerationJobAsync(job.JobId);
                        var index = jobs.FindIndex(row => row.JobId == job.JobId);

                        if (index >= 0)
                        {
                            jobs[index] = SummaryFromDetail(detail);
                        }

                        if (_jobDetails.ContainsKey(job.JobId))
                        {
                            _jobDetails[job.JobId] = detail;
                        }
                    }
                    catch (AccessTokenNotAvailableException exception)
                    {
                        exception.Redirect();
                        return;
                    }
                    catch
                    {
                        // Transient — the next tick retries.
                    }
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            if (ReferenceEquals(_pollingCts, cts))
            {
                _pollingCts = null;
            }

            cts.Dispose();
        }
    }

    public void Dispose()
    {
        try
        {
            _pollingCts?.Cancel();
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private async Task LoadAgentNamesAsync()
    {
        var chain = await WorkflowService.GetPublicChainAsync();
        var contracts = chain?.OutputContracts?.Contracts;

        if (contracts == null)
        {
            return;
        }

        _agentNames = contracts
            .Where(pair => !string.IsNullOrWhiteSpace(pair.Value.AgentName))
            .ToDictionary(pair => pair.Key, pair => pair.Value.AgentName!, StringComparer.Ordinal);
        await InvokeAsync(StateHasChanged);
    }

    // Lineage chains per package ref, from the authorized lineage endpoint;
    // fetched lazily when a detail expands, cached for the page's lifetime.
    private readonly Dictionary<string, IReadOnlyList<string>?> _lineageCache = new(StringComparer.Ordinal);

    private IReadOnlyList<string>? LineageFor(string? packageRef) =>
        packageRef != null && _lineageCache.TryGetValue(packageRef, out var chain) ? chain : null;

    private async Task EnsureLineageLoadedAsync(string? packageRef)
    {
        if (packageRef == null || _lineageCache.ContainsKey(packageRef))
        {
            return;
        }

        _lineageCache[packageRef] = await WorkflowService.GetLineageAsync(packageRef);
        await InvokeAsync(StateHasChanged);
    }

    // Per-version catalog documents, fetched from the public registry — the
    // job's own catalogRef resolves to historically exact agent identities
    // (#105: purified records carry no agentVersions map).
    private readonly Dictionary<string, Dictionary<string, PublicCatalogEntry>?> _catalogCache = new(StringComparer.Ordinal);

    private const string CatalogRefPrefix = "output-contracts@";

    private async Task EnsureCatalogLoadedAsync(string? catalogRef)
    {
        if (catalogRef == null || !catalogRef.StartsWith(CatalogRefPrefix, StringComparison.Ordinal))
        {
            return;
        }

        var version = catalogRef[CatalogRefPrefix.Length..];

        if (_catalogCache.ContainsKey(version))
        {
            return;
        }

        // Only cache success: a failed fetch (transient, or blocked before #122's
        // CSP fix) retries on the next expansion instead of poisoning the session.
        var document = await WorkflowService.GetCatalogAsync(version);

        if (document != null)
        {
            _catalogCache[version] = document;
        }

        await InvokeAsync(StateHasChanged);
    }

    private Dictionary<string, PublicCatalogEntry>? JobCatalog(ConsultGenerationJobResponse detail) =>
        detail.CatalogRef != null
            && detail.CatalogRef.StartsWith(CatalogRefPrefix, StringComparison.Ordinal)
            && _catalogCache.TryGetValue(detail.CatalogRef[CatalogRefPrefix.Length..], out var doc)
            ? doc
            : null;

    private IEnumerable<string> AgentContracts(ConsultGenerationJobResponse detail)
    {
        var contracts = JobCatalog(detail)?.Keys ?? detail.AgentVersions?.Keys as IEnumerable<string>;
        return (contracts ?? Enumerable.Empty<string>()).OrderBy(c => c, StringComparer.Ordinal);
    }

    // Resolution order: the job's own catalog document (historically exact) →
    // the legacy stored map decorated with current-chain names → nothing.
    private (string? Name, string? Version) ResolveAgent(string contract, ConsultGenerationJobResponse detail)
    {
        if (JobCatalog(detail) is { } doc && doc.TryGetValue(contract, out var entry))
        {
            return (entry.AgentName, entry.AgentVersion);
        }

        if (detail.AgentVersions != null && detail.AgentVersions.TryGetValue(contract, out var version))
        {
            return (_agentNames.GetValueOrDefault(contract), version);
        }

        return (null, null);
    }

    private string AgentLine(string contract, ConsultGenerationJobResponse detail) => ResolveAgent(contract, detail) switch
    {
        (string name, string version) => $"{contract} → {name} v{version}",
        (null, string version) => $"{contract} → v{version}",
        _ => contract
    };

    private async Task LoadJobsAsync()
    {
        jobsLoading = true;
        jobsErrorMessage = null;

        try
        {
            var result = await AccountService.GetJobsAsync(limit: 20);
            jobs.AddRange(result.Jobs);
            jobsContinuationToken = result.ContinuationToken;
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            jobsErrorMessage = $"Unable to load job history: {ex.Message}";
        }
        finally
        {
            jobsLoading = false;
        }
    }

    private async Task LoadMoreJobsAsync()
    {
        if (jobsLoading || jobsContinuationToken == null)
        {
            return;
        }

        jobsLoading = true;
        StateHasChanged();

        try
        {
            var result = await AccountService.GetJobsAsync(limit: 20, continuationToken: jobsContinuationToken);
            jobs.AddRange(result.Jobs);
            jobsContinuationToken = result.ContinuationToken;
        }
        catch (Exception ex)
        {
            jobsErrorMessage = $"Unable to load more jobs: {ex.Message}";
        }
        finally
        {
            jobsLoading = false;
            StateHasChanged();
        }

        // An older page can surface a non-terminal row (e.g. a Scheduled job)
        // after the loop already stopped.
        EnsurePollingStarted();
    }

    private async Task EnsureDetailsLoadedAsync(string jobId)
    {
        if (_jobDetails.ContainsKey(jobId))
        {
            return;
        }

        _jobDetails[jobId] = null;
        _jobDetailErrors.Remove(jobId);

        try
        {
            var detail = await AIService.GetConsultGenerationJobAsync(jobId);
            _jobDetails[jobId] = detail;
            await EnsureCatalogLoadedAsync(detail?.CatalogRef);
            await EnsureLineageLoadedAsync(detail?.WorkflowPackage);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            _jobDetailErrors[jobId] = $"Unable to load job events: {ex.Message}";
        }

        await InvokeAsync(StateHasChanged);
    }


    private static string FormatDate(DateTimeOffset date)
    {
        var ago = DateTimeOffset.UtcNow - date;

        return ago.TotalMinutes < 1 ? "just now"
            : ago.TotalHours < 1 ? $"{(int)ago.TotalMinutes}m ago"
            : ago.TotalDays < 1 ? $"{(int)ago.TotalHours}h ago"
            : ago.TotalDays < 7 ? $"{(int)ago.TotalDays}d ago"
            : date.ToLocalTime().ToString("MMM d, yyyy");
    }

    private static string? HashPrefix(string? hash) =>
        string.IsNullOrEmpty(hash) ? "—" : hash[..Math.Min(12, hash.Length)] + "…";

    private static string StatusCss(string? status) => status switch
    {
        "Completed" => "node-status--success",
        "Failed" => "node-status--failure",
        _ => "node-status--muted"
    };

    private static string StatusGlyph(string? status) => status switch
    {
        "Completed" => "✓",
        "Failed" => "✗",
        "Skipped" => "○",
        null => "·",
        _ => "●"
    };

    private string ContractLabel(ConsultGenerationNodeDescriptor descriptor, ConsultGenerationJobResponse detail)
    {
        var contract = descriptor.OutputContract ?? "text";

        return ResolveAgent(contract, detail) switch
        {
            (string name, string version) => $"{contract} · {name} v{version}",
            (null, string version) => $"{contract} · agent v{version}",
            _ => contract
        };
    }

    private sealed record NodeGroup(
        ConsultGenerationNodeDescriptor Descriptor,
        ConsultGenerationNodeStatus? NodeLevel,
        IReadOnlyList<(string ItemId, ConsultGenerationNodeStatus Entry)> Items,
        IReadOnlySet<string> ConvergedOutputs);

    // The chain map keys are "nodeId" (node level) and "nodeId:itemId" (per item);
    // groups follow the Nodes descriptor order — manifest order. Identical
    // OutputHashes within a node's items are the convergence signal.
    private static IReadOnlyList<NodeGroup> BuildNodeGroups(ConsultGenerationJobResponse detail)
    {
        if (detail.Nodes is not { Count: > 0 } || detail.NodeOutputs is not { Count: > 0 })
        {
            return Array.Empty<NodeGroup>();
        }

        var groups = new List<NodeGroup>();

        foreach (var descriptor in detail.Nodes)
        {
            detail.NodeOutputs.TryGetValue(descriptor.Id, out var nodeLevel);

            var items = detail.NodeOutputs
                .Where(pair => pair.Key.StartsWith(descriptor.Id + ":", StringComparison.Ordinal))
                .Select(pair => (ItemId: pair.Key[(descriptor.Id.Length + 1)..], Entry: pair.Value))
                .OrderBy(pair => pair.ItemId, StringComparer.Ordinal)
                .ToList();

            if (nodeLevel is null && items.Count == 0)
            {
                continue;
            }

            var converged = items
                .Where(pair => pair.Entry.OutputHash != null)
                .GroupBy(pair => pair.Entry.OutputHash!)
                .Where(g => g.Count() > 1)
                .Select(g => g.Key)
                .ToHashSet(StringComparer.Ordinal);

            groups.Add(new NodeGroup(descriptor, nodeLevel, items, converged));
        }

        return groups;
    }




