    // #548: the retention clocks. null = not chosen (the deployment default
    // governs); saved values are what is stored, the inputs are what the
    // controls hold. Writes are ordered so the server's cross-key check never
    // trips on a save the client already validated.
    private int? savedRetentionOutputDays;
    private int? savedRetentionInputDays;
    private string retentionOutputInput = string.Empty;
    private string retentionInputInput = string.Empty;
    private bool retentionRequestInProgress;
    private string? retentionMessage;
    private MessageIntent retentionMessageIntent = MessageIntent.Info;

    private async Task LoadRetentionAsync()
    {
        try
        {
            var output = await AccountService.GetSettingAsync(RetentionPreference.OutputDaysKey);
            var input = await AccountService.GetSettingAsync(RetentionPreference.InputDaysKey);
            savedRetentionOutputDays = RetentionPreference.Parse(output?.Value);
            savedRetentionInputDays = RetentionPreference.Parse(input?.Value);
            retentionOutputInput = savedRetentionOutputDays?.ToString() ?? string.Empty;
            retentionInputInput = savedRetentionInputDays?.ToString() ?? string.Empty;
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch
        {
            savedRetentionOutputDays = null;
            savedRetentionInputDays = null;
        }
    }

    private async Task SaveRetentionAsync()
    {
        var outputChosen = !string.IsNullOrWhiteSpace(retentionOutputInput);
        var inputChosen = !string.IsNullOrWhiteSpace(retentionInputInput);

        int? newOutput = outputChosen ? RetentionPreference.Parse(retentionOutputInput) : null;
        int? newInput = inputChosen ? RetentionPreference.Parse(retentionInputInput) : null;

        if (outputChosen && (newOutput == null || !RetentionPreference.InRange(newOutput.Value)))
        {
            retentionMessage = $"Outputs must be a whole number of days between {RetentionPreference.MinDays} and {RetentionPreference.MaxDays}.";
            retentionMessageIntent = MessageIntent.Error;
            return;
        }

        if (inputChosen && (newInput == null || !RetentionPreference.InRange(newInput.Value)))
        {
            retentionMessage = $"Inputs must be a whole number of days between {RetentionPreference.MinDays} and {RetentionPreference.MaxDays}.";
            retentionMessageIntent = MessageIntent.Error;
            return;
        }

        // The cross-key rule against what will be stored — a blank input
        // leaves that clock as it is. Same test the server runs.
        var crossOutput = newOutput ?? savedRetentionOutputDays;
        var crossInput = newInput ?? savedRetentionInputDays;
        if (crossOutput != null && crossInput != null && crossInput > crossOutput)
        {
            retentionMessage = $"Inputs ({crossInput}) cannot be kept longer than outputs ({crossOutput}).";
            retentionMessageIntent = MessageIntent.Error;
            return;
        }

        retentionRequestInProgress = true;

        try
        {
            // Inputs first unless the new inputs value would exceed the
            // outputs value still stored — then outputs must widen first.
            var inputsFirst = newInput == null
                || savedRetentionOutputDays == null
                || newInput <= savedRetentionOutputDays;

            if (inputsFirst)
            {
                if (newInput != null) await SaveRetentionValueAsync(RetentionPreference.InputDaysKey, newInput.Value);
                if (newOutput != null) await SaveRetentionValueAsync(RetentionPreference.OutputDaysKey, newOutput.Value);
            }
            else
            {
                if (newOutput != null) await SaveRetentionValueAsync(RetentionPreference.OutputDaysKey, newOutput.Value);
                if (newInput != null) await SaveRetentionValueAsync(RetentionPreference.InputDaysKey, newInput.Value);
            }

            savedRetentionOutputDays = newOutput ?? savedRetentionOutputDays;
            savedRetentionInputDays = newInput ?? savedRetentionInputDays;
            retentionMessage = "Retention saved. Runs already held follow the new setting at the next nightly sweep.";
            retentionMessageIntent = MessageIntent.Success;
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            retentionMessage = ex.Message;
            retentionMessageIntent = MessageIntent.Error;
        }
        finally
        {
            retentionRequestInProgress = false;
        }
    }

    private Task SaveRetentionValueAsync(string key, int days) =>
        AccountService.SaveSettingAsync(key, RetentionPreference.Store(days), RetentionPreference.ContentType);

    private async Task ClearRetentionAsync(string key)
    {
        retentionRequestInProgress = true;

        try
        {
            await AccountService.DeleteSettingAsync(key);
            if (key == RetentionPreference.OutputDaysKey)
            {
                savedRetentionOutputDays = null;
                retentionOutputInput = string.Empty;
            }
            else
            {
                savedRetentionInputDays = null;
                retentionInputInput = string.Empty;
            }

            retentionMessage = $"Back to not chosen: kept {RetentionPreference.DefaultDays} days, as before.";
            retentionMessageIntent = MessageIntent.Success;
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            retentionMessage = ex.Message;
            retentionMessageIntent = MessageIntent.Error;
        }
        finally
        {
            retentionRequestInProgress = false;
        }
    }

    // #552: the usage window. The store serves rows; the page summarizes over
    // the window length. A card that cannot load names the error; before the
    // first row exists the empty sentence renders, never zeros.
    private AccountUsageResponse? usage;
    private string usageWindow = "30";
    private string usageFromInput = string.Empty;
    private string usageToInput = string.Empty;
    private string? usageError;

    private async Task LoadUsageAsync()
    {
        usageError = null;

        string from, to;
        if (usageWindow == "custom")
        {
            if (string.IsNullOrWhiteSpace(usageFromInput) || string.IsNullOrWhiteSpace(usageToInput))
            {
                return;
            }

            from = usageFromInput;
            to = usageToInput;
        }
        else
        {
            var windowDays = int.Parse(usageWindow, System.Globalization.CultureInfo.InvariantCulture);
            var today = DateOnly.FromDateTime(DateTime.UtcNow);
            to = today.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
            from = today.AddDays(-(windowDays - 1)).ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
        }

        try
        {
            usage = await AccountService.GetUsageAsync(from, to);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            usageError = ex.Message;
        }
    }

    private async Task OnUsageWindowChangedAsync(ChangeEventArgs args)
    {
        usageWindow = args.Value?.ToString() ?? "30";

        if (usageWindow != "custom")
        {
            await LoadUsageAsync();
        }
    }

    // #516: the profile's signature blocks. Explicit initialisation — empty
    // until a block exists and is chosen; every mutation is one write of the
    // one row (or its deletion when the last block goes). Removing the block
    // in use clears the choice in the same save; the state line names what
    // that means.
    private SignatureBlocks.SignatureBlockSet signatureSet = SignatureBlocks.Empty();
    private bool signatureRequestInProgress;
    private string? signatureMessage;
    private MessageIntent signatureMessageIntent = MessageIntent.Info;
    private string? signatureRemoveArmedId;
    private string? editingSignatureId;
    private string? signatureNameInput;
    private string? signatureTextInput;

    private bool SignatureFormValid =>
        !string.IsNullOrWhiteSpace(signatureNameInput)
        && !string.IsNullOrWhiteSpace(signatureTextInput)
        && signatureNameInput!.Trim().Length <= SignatureBlocks.MaxNameLength
        && signatureTextInput!.Trim().Length <= SignatureBlocks.MaxTextLength;

    private static string Preview(string text) =>
        text.Length <= 160 ? text : text[..160] + "…";

    private async Task LoadSignaturesAsync()
    {
        try
        {
            var setting = await AccountService.GetSettingAsync(SignatureBlocks.SettingKey);
            signatureSet = SignatureBlocks.Parse(setting?.Value);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch
        {
            signatureSet = SignatureBlocks.Empty();
        }
    }

    private async Task SaveSignatureSetAsync(SignatureBlocks.SignatureBlockSet next, string message)
    {
        signatureRequestInProgress = true;

        try
        {
            if (next.Blocks.Count == 0)
            {
                await AccountService.DeleteSettingAsync(SignatureBlocks.SettingKey);
            }
            else
            {
                await AccountService.SaveSettingAsync(
                    SignatureBlocks.SettingKey, SignatureBlocks.Serialize(next), SignatureBlocks.ContentType);
            }

            signatureSet = next;
            signatureMessage = message;
            signatureMessageIntent = MessageIntent.Success;
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            signatureMessage = ex.Message;
            signatureMessageIntent = MessageIntent.Error;
        }
        finally
        {
            signatureRequestInProgress = false;
        }
    }

    private async Task SaveSignatureAsync()
    {
        if (!SignatureFormValid)
        {
            return;
        }

        var name = signatureNameInput!.Trim();
        var text = signatureTextInput!.Trim();
        var blocks = new List<SignatureBlocks.SignatureBlock>(signatureSet.Blocks);
        string message;

        var editIndex = editingSignatureId == null ? -1 : blocks.FindIndex(b => b.Id == editingSignatureId);
        if (editIndex >= 0)
        {
            blocks[editIndex] = blocks[editIndex] with { Name = name, Text = text, UpdatedAtUtc = DateTimeOffset.UtcNow };
            message = $"Signature block '{name}' updated.";
        }
        else
        {
            if (blocks.Count >= SignatureBlocks.MaxBlocks)
            {
                return;
            }

            var id = SignatureBlocks.SlugFor(name, blocks.Select(b => b.Id));
            blocks.Add(new SignatureBlocks.SignatureBlock(id, name, text, DateTimeOffset.UtcNow));
            message = $"Signature block '{name}' added. Choose Use to append it to signed deliverables.";
        }

        await SaveSignatureSetAsync(signatureSet with { Blocks = blocks }, message);
        editingSignatureId = null;
        signatureNameInput = null;
        signatureTextInput = null;
    }

    private void EditSignature(string id)
    {
        var block = signatureSet.Blocks.FirstOrDefault(b => b.Id == id);
        if (block == null)
        {
            return;
        }

        editingSignatureId = id;
        signatureNameInput = block.Name;
        signatureTextInput = block.Text;
        signatureRemoveArmedId = null;
    }

    private void CancelSignatureEdit()
    {
        editingSignatureId = null;
        signatureNameInput = null;
        signatureTextInput = null;
    }

    private async Task UseSignatureAsync(string id)
    {
        var block = signatureSet.Blocks.FirstOrDefault(b => b.Id == id);
        if (block == null)
        {
            return;
        }

        await SaveSignatureSetAsync(
            signatureSet with { ChosenId = id },
            $"'{block.Name}' is now appended to deliverables a package marks signed.");
    }

    private async Task ClearChosenSignatureAsync()
    {
        await SaveSignatureSetAsync(
            signatureSet with { ChosenId = null },
            "Back to none chosen — deliverables a package marks signed are produced unsigned.");
    }

    /// <summary>
    /// #516: remove, in two clicks — the #195 arming pattern; no dialogs in
    /// this app. Removing the block in use clears the choice in the same
    /// save, and the state line immediately says what that means.
    /// </summary>
    private async Task RemoveSignatureAsync(string id)
    {
        if (signatureRemoveArmedId != id)
        {
            signatureRemoveArmedId = id;
            signatureMessage = "Removing a signature block cannot be undone. Click Confirm remove to proceed.";
            signatureMessageIntent = MessageIntent.Warning;
            return;
        }

        signatureRemoveArmedId = null;
        var blocks = signatureSet.Blocks.Where(b => b.Id != id).ToList();
        var chosenId = signatureSet.ChosenId == id ? null : signatureSet.ChosenId;
        await SaveSignatureSetAsync(
            new SignatureBlocks.SignatureBlockSet(blocks, chosenId),
            blocks.Count == 0 ? "Signature block removed. No blocks remain." : "Signature block removed.");
    }

    // #561: the snippet library — the SignatureBlocks shape without a
    // chosen one: a snippet acts only in the moment the setup form inserts
    // it. Every mutation is one write of the one row (or its deletion when
    // the last snippet goes).
    private Snippets.SnippetSet snippetSet = Snippets.Empty();
    private bool snippetRequestInProgress;
    private string? snippetMessage;
    private MessageIntent snippetMessageIntent = MessageIntent.Info;
    private string? snippetRemoveArmedId;
    private string? editingSnippetId;
    private string? snippetNameInput;
    private string? snippetTextInput;

    private bool SnippetFormValid =>
        !string.IsNullOrWhiteSpace(snippetNameInput)
