@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Consultologist.Web.Services.AppUpdate
@using Consultologist.Web.Services.Locations
@inject IApiLocations Locations
@inject IAccountEndpointService AccountService
@inject IWorkflowEndpointService WorkflowService
@inject IConfiguration Configuration
@inject NavigationManager Navigation
@attribute [Authorize]

@page "/profile"

<PageTitle>Profile</PageTitle>

<section class="page-header">
    <div class="page-header__content">
        <span class="section-eyebrow">Profile</span>
        <h1 class="page-title">Workspace identity.</h1>
        <p class="page-description">
            Confirm the signed-in account used for protected Consultologist workflows and Microsoft identity access.
        </p>
    </div>
</section>

<AuthorizeView>
    <Authorized>
        @if (account != null)
        {
            <section class="content-card">
                <div class="form-stack">
                    <h2 class="panel-title">
                        Signed-in account details
                    </h2>

                    <p class="panel-description">
                        These details come from the Consultologist account service for the current clinician session.
                    </p>

                    <div class="state-panel">
                        <span class="muted-text">Display name</span>
                        <strong>@account.DisplayName</strong>
                    </div>

                    <div class="state-panel">
                        <span class="muted-text">Email</span>
                        <strong>@(account.Email ?? "Not provided")</strong>
                    </div>

                    <div class="state-panel">
                        <span class="muted-text">App user ID</span>
                        <strong>@account.AppUserId</strong>
                    </div>

                    <div class="state-panel">
                        <span class="muted-text">Current identity</span>
                        <strong>@account.CurrentIdentity.Provider</strong>
                    </div>

                    <div class="state-panel">
                        <span class="muted-text">Account kind</span>
                        <strong class="account-kind">@(account.AccountKind ?? "—")</strong>
                    </div>

                    <FluentMessageBar Intent="MessageIntent.Info">
                        Protected API requests use this account identity for server-side authorization and job ownership.
                    </FluentMessageBar>
                </div>
            </section>

            @* #561: the snippet library — the personal, dot-phrase sense of
               "macro", beside #516's signature blocks and outside the package
               grammar. A snippet acts only when inserted on the setup form,
               where it becomes ordinary typed text. *@
            <section class="content-card snippet-card">
                <div class="form-stack">
                    <h2 class="panel-title">
                        Snippets
                    </h2>

                    <p class="panel-description">
                        Canned text that belongs to you, not to a package: create a snippet
                        here and the setup form's text inputs offer it for insertion. Inserted
                        text is your own typing from that moment — editable, hashed and
                        recorded like anything you type.
                    </p>

                    @if (snippetMessage != null)
                    {
                        <FluentMessageBar Intent="@snippetMessageIntent" AllowDismiss="false" Class="snippet-message">
                            @snippetMessage
                        </FluentMessageBar>
                    }

                    <div class="state-panel">
                        <span class="muted-text">Snippets</span>
                        <strong class="snippet-state">@Snippets.Describe(snippetSet)</strong>
                    </div>

                    @foreach (var snippet in snippetSet.Items)
                    {
                        <div class="state-panel snippet-item" @key="snippet.Id">
                            <span class="muted-text">@snippet.Name</span>
                            <span class="snippet-preview">@Preview(snippet.Text)</span>
                            <div class="action-row">
                                <FluentButton Appearance="Appearance.Neutral"
                                              Class="snippet-edit"
                                              Disabled="@snippetRequestInProgress"
                                              @onclick="() => EditSnippet(snippet.Id)">
                                    Edit
                                </FluentButton>
                                <FluentButton Appearance="Appearance.Neutral"
                                              Class="snippet-remove"
                                              Disabled="@snippetRequestInProgress"
                                              @onclick="() => RemoveSnippetAsync(snippet.Id)">
                                    @(snippetRemoveArmedId == snippet.Id ? "Confirm remove" : "Remove")
                                </FluentButton>
                            </div>
                        </div>
                    }

                    @if (editingSnippetId != null || snippetSet.Items.Count < Snippets.MaxSnippets)
                    {
                        <div class="form-stack snippet-form">
                            <input class="node-field__input snippet-name-input"
                                   value="@snippetNameInput"
                                   @onchange="args => snippetNameInput = args.Value?.ToString()"
                                   maxlength="@Snippets.MaxNameLength"
                                   placeholder="Snippet name (e.g. Normal exam)"
                                   aria-label="Snippet name" />
                            <textarea class="node-field__input snippet-text-input"
                                      rows="5"
                                      value="@snippetTextInput"
                                      @onchange="args => snippetTextInput = args.Value?.ToString()"
                                      maxlength="@Snippets.MaxTextLength"
                                      placeholder="The text, exactly as it should be inserted"
                                      aria-label="Snippet text"></textarea>
                            <div class="action-row">
                                <FluentButton Appearance="Appearance.Accent"
                                              Class="snippet-save"
                                              Disabled="@(snippetRequestInProgress || !SnippetFormValid)"
                                              @onclick="SaveSnippetAsync">
                                    @(editingSnippetId == null ? "Add snippet" : "Save changes")
                                </FluentButton>
                                @if (editingSnippetId != null)
                                {
                                    <FluentButton Appearance="Appearance.Neutral"
                                                  Class="snippet-cancel-edit"
                                                  Disabled="@snippetRequestInProgress"
                                                  @onclick="CancelSnippetEdit">
                                        Cancel
                                    </FluentButton>
                                }
                            </div>
                        </div>
                    }
                </div>
            </section>

            <section class="content-card">
                <div class="form-stack">
                    <h2 class="panel-title">
                        Build
                    </h2>

                    <p class="panel-description">
                        The client this tab is running and the engine it talks to, as git commits.
                        A new client build is announced at the top of the page when it is ready; the
                        engine's commit is what its provenance records cite.
                    </p>

                    <div class="state-panel">
                        <span class="muted-text">Client</span>
                        <strong class="build-client">@BuildLabel.Describe(Configuration)</strong>
                    </div>

                    <div class="state-panel">
                        <span class="muted-text">Engine</span>
                        <strong class="build-engine">@(engineCommit ?? "Unavailable")</strong>
                    </div>
                </div>
            </section>

            <section class="content-card">
                <div class="form-stack">
                    <h2 class="panel-title">
                        LinkedIn verification
                    </h2>

                    <p class="panel-description">
                        Connecting your LinkedIn profile proves this account belongs to a real clinician.
                        It supports the account activation decision — LinkedIn is never used to sign in.
                    </p>

                    @if (linkedInMessage != null)
                    {
                        <FluentMessageBar Intent="@linkedInMessageIntent">@linkedInMessage</FluentMessageBar>
                    }

                    @if (LinkedInIdentity != null)
                    {
                        <div class="state-panel">
                            <span class="muted-text">Connected LinkedIn profile</span>
                            <strong>@(LinkedInIdentity.DisplayName ?? "LinkedIn account")</strong>
                            @if (LinkedInIdentity.Email != null)
                            {
                                <span class="muted-text">@LinkedInIdentity.Email</span>
                            }
                            @if (VerifiedCategoryLabels.Length > 0)
                            {
                                <strong>Verified on LinkedIn: @string.Join(", ", VerifiedCategoryLabels)</strong>
                            }
                            <span class="muted-text">Connected @LinkedInIdentity.LinkedAt.ToString("yyyy-MM-dd")</span>
                        </div>
                    }

                    @* #195: an account that may read but not submit has to be
                       told which it is, and how to get back. *@
                    @if (account?.Status == "Unverified")
                    {
                        <FluentMessageBar Intent="MessageIntent.Warning">
                            This account can open its existing consults but cannot start new ones.
                            Reconnect LinkedIn to restore it.
                        </FluentMessageBar>
                    }

                    <div class="action-row">
                        <FluentButton Appearance="Appearance.Accent"
                                      IconStart="@(new Icons.Regular.Size20.LinkMultiple())"
                                      Disabled="@linkedInStartInProgress"
                                      @onclick="ConnectLinkedInAsync">
                            @(LinkedInIdentity == null ? "Connect LinkedIn" : "Reconnect LinkedIn")
                        </FluentButton>

                        @* Two clicks rather than a dialog: no FluentDialogProvider is
                           rendered anywhere in this app, so a real dialog would be new
                           infrastructure for one button. The label carries the warning
                           that the second click is the destructive one. *@
                        @if (LinkedInIdentity != null)
                        {
                            <FluentButton Appearance="Appearance.Neutral"
                                          Disabled="@linkedInDisconnectInProgress"
                                          @onclick="DisconnectLinkedInAsync">
                                @(disconnectArmed ? "Confirm disconnect" : "Disconnect")
                            </FluentButton>
                        }
                    </div>
                </div>
            </section>

            @* #515: the location — where the app sends data and reads the
               account. Kept on this device; empty until chosen, and the
               unchosen line says which location is used meanwhile. *@
            <section class="content-card location-card">
                <div class="form-stack">
                    <h2 class="panel-title">
                        Location
                    </h2>

                    <p class="panel-description">
                        Where the app sends your data and reads your account, packages and History.
                        The choice is kept on this device. Each location holds its own accounts,
                        packages and History, so changing it shows you that location's, not a copy.
                        Every run records the host it ran on.
                    </p>

                    @if (locationMessage != null)
                    {
                        <FluentMessageBar Intent="@locationMessageIntent" AllowDismiss="false" Class="location-message">
                            @locationMessage
                        </FluentMessageBar>
                    }

                    <div class="state-panel">
                        <span class="muted-text">Location</span>
                        <strong class="location-state">@LocationState()</strong>
                        @if (engineHost != null)
                        {
                            <span class="muted-text location-answers">Answers as @engineHost</span>
                        }
                    </div>

                    <div class="action-row">
                        @foreach (var location in Locations.All)
                        {
                            @if (Locations.Chosen?.Id != location.Id)
                            {
                                <FluentButton Appearance="Appearance.Accent"
                                              Class="location-choose"
                                              data-location="@location.Id"
                                              Disabled="@locationRequestInProgress"
                                              @onclick="() => ChooseLocationAsync(location)">
                                    Use @location.Name
                                </FluentButton>
                            }
                        }
                        @if (Locations.Chosen != null)
                        {
                            <FluentButton Appearance="Appearance.Neutral"
                                          Class="location-clear"
                                          Disabled="@locationRequestInProgress"
                                          @onclick="ClearLocationAsync">
                                Back to not chosen
                            </FluentButton>
                        }
                    </div>
                </div>
            </section>

            <section class="content-card">
                <div class="form-stack">
                    <h2 class="panel-title">
                        Scheduled consults
                    </h2>

                    <p class="panel-description">
                        The time of day a scheduled consult runs, unless you choose otherwise
                        when scheduling it. Your local time. Without one, scheduled consults
                        run at 2:00 AM.
                    </p>

                    @if (scheduleMessage != null)
                    {
                        <FluentMessageBar Intent="@scheduleMessageIntent">@scheduleMessage</FluentMessageBar>
                    }

                    <div class="state-panel">
                        <span class="muted-text">Default time</span>
                        <strong>@(savedScheduleTime ?? "Not set — 2:00 AM")</strong>
                    </div>

                    <div class="action-row">
                        @* #390: native input, matching the v8 date field in Consults. Empty until
                           chosen — this is a preference, and one nobody set is not 2:00 AM, it is
                           absent. *@
                        <input type="time"
                               class="node-field__input"
                               value="@scheduleTimeInput"
                               @onchange="args => scheduleTimeInput = args.Value?.ToString() ?? string.Empty"
                               disabled="@scheduleRequestInProgress"
                               aria-label="Default time for scheduled consults" />
                        <FluentButton Appearance="Appearance.Accent"
                                      Disabled="@(scheduleRequestInProgress || string.IsNullOrWhiteSpace(scheduleTimeInput))"
                                      @onclick="SaveScheduleTimeAsync">
                            @(savedScheduleTime == null ? "Set default" : "Change default")
                        </FluentButton>
                        @if (savedScheduleTime != null)
                        {
                            <FluentButton Appearance="Appearance.Neutral"
                                          Disabled="@scheduleRequestInProgress"
                                          @onclick="ClearScheduleTimeAsync">
                                Clear
                            </FluentButton>
                        }
                    </div>
                </div>
            </section>

            <section class="content-card delivery-address-card">
                <div class="form-stack">
                    <h2 class="panel-title">
                        Delivery address
                    </h2>

                    <p class="panel-description">
                        Every consult you submit is emailed here when it completes — and only here.
                        The address is confirmed with a code before anything is sent to it; the
                        email carries no clinical content unless a delivery password is set below.
                    </p>

                    @if (addressMessage != null)
                    {
                        <FluentMessageBar Intent="@addressMessageIntent">@addressMessage</FluentMessageBar>
                    }

                    <div class="state-panel">
                        <span class="muted-text">Delivery address</span>
                        <strong class="delivery-address-state">
                            @if (account.DeliveryAddress != null)
                            {
                                @* #517: which trust the address rests on. *@
                                <text>@(account.DeliveryAddressVerifiedBy == "tenant" ? "Verified by your organisation: " : "Verified: ")@account.DeliveryAddress</text>
                            }
                            else if (account.DeliveryAddressPending != null)
                            {
                                <text>Code sent to @account.DeliveryAddressPending — enter it below</text>
                            }
                            else
                            {
                                <text>Not set — consults are not emailed</text>
                            }
                        </strong>
                        @if (account.DeliveryAddress != null && account.DeliveryAddressPending != null)
                        {
                            <span class="muted-text">A code is out to @account.DeliveryAddressPending; confirming it replaces the verified address.</span>
                        }
                    </div>

                    @if (account.DeliveryAddressPending != null)
                    {
                        <div class="action-row">
                            <FluentTextField @bind-Value="deliveryCodeInput"
                                             Placeholder="6-digit code"
                                             Disabled="@addressRequestInProgress"
                                             aria-label="Confirmation code" />
                            <FluentButton Appearance="Appearance.Accent"
                                          Class="confirm-address-button"
                                          Disabled="@(addressRequestInProgress || (deliveryCodeInput?.Trim().Length ?? 0) != 6)"
                                          @onclick="ConfirmDeliveryAddressAsync">
                                Confirm
                            </FluentButton>
                            <FluentButton Appearance="Appearance.Neutral"
                                          Class="resend-code-button"
                                          Disabled="@addressRequestInProgress"
                                          @onclick="ResendDeliveryCodeAsync">
                                Send a new code
                            </FluentButton>
                        </div>
                    }

                    <div class="action-row">
                        <FluentTextField @bind-Value="deliveryAddressInput"
                                         TextFieldType="TextFieldType.Email"
                                         Placeholder="you@clinic.example"
                                         Disabled="@addressRequestInProgress"
                                         aria-label="Delivery address" />
                        <FluentButton Appearance="Appearance.Accent"
                                      Class="send-code-button"
                                      Disabled="@(addressRequestInProgress || string.IsNullOrWhiteSpace(deliveryAddressInput))"
                                      @onclick="StartDeliveryAddressAsync">
                            @(account.DeliveryAddress == null ? "Send code" : "Change address")
                        </FluentButton>
                        @* #517: an organisation's sign-in already verified this
                           mailbox is yours — one click, no code. Offered on an
                           organisation's token only, and not once it is the
                           verified address; a personal account keeps the code. *@
                        @if (account.SignInKind == "organisation" && account.SignInEmail is { Length: > 0 } signInEmail
                            && !string.Equals(account.DeliveryAddress, signInEmail, StringComparison.OrdinalIgnoreCase))
                        {
                            <FluentButton Appearance="Appearance.Neutral"
                                          Class="use-signed-in-button"
                                          Disabled="@addressRequestInProgress"
                                          @onclick="UseSignedInDeliveryAddressAsync">
                                Use @signInEmail
                            </FluentButton>
                        }
                        @if (account.DeliveryAddress != null || account.DeliveryAddressPending != null)
                        {
                            <FluentButton Appearance="Appearance.Neutral"
                                          Class="remove-address-button"
                                          Disabled="@addressRequestInProgress"
                                          @onclick="ClearDeliveryAddressAsync">
                                Remove
                            </FluentButton>
                        }
                    </div>
                </div>
            </section>

            @* #518: whether runs started from the app are emailed at all.
               Empty until chosen; the unset line says what unset means, so
               nothing changes silently for an account that never chose. *@
            <section class="content-card email-pdf-card">
                <div class="form-stack">
                    <h2 class="panel-title">
                        Email each run's PDF
                    </h2>

                    <p class="panel-description">
                        Whether a consult you start from the app — now or scheduled — is emailed
                        to your delivery address when it completes. Consults sent in by email
                        always reply to their sender. Either way, every run appears in History.
                    </p>

                    @if (emailPdfMessage != null)
                    {
                        <FluentMessageBar Intent="@emailPdfMessageIntent" AllowDismiss="false" Class="email-pdf-message">
                            @emailPdfMessage
                        </FluentMessageBar>
                    }

                    <div class="state-panel">
                        <span class="muted-text">Email each run's PDF</span>
                        <strong class="email-pdf-state">@EmailPdfPreference.Describe(emailPdfChoice)</strong>
                    </div>

                    <div class="action-row">
                        @if (emailPdfChoice != true)
                        {
                            <FluentButton Appearance="Appearance.Accent"
                                          Class="email-pdf-yes"
                                          Disabled="@emailPdfRequestInProgress"
                                          @onclick="() => SaveEmailPdfAsync(true)">
                                Yes, email each run
                            </FluentButton>
                        }
                        @if (emailPdfChoice != false)
                        {
                            <FluentButton Appearance="Appearance.Neutral"
                                          Class="email-pdf-no"
                                          Disabled="@emailPdfRequestInProgress"
                                          @onclick="() => SaveEmailPdfAsync(false)">
                                No, do not email
                            </FluentButton>
                        }
                        @if (emailPdfChoice != null)
                        {
                            <FluentButton Appearance="Appearance.Neutral"
                                          Class="email-pdf-clear"
                                          Disabled="@emailPdfRequestInProgress"
                                          @onclick="ClearEmailPdfAsync">
                                Back to not chosen
                            </FluentButton>
                        }
                    </div>
                </div>
            </section>

            @* #543: how a pushed form response becomes a consult — empty until
               chosen, the unset line saying what unset means (the #518 rule). *@
            <section class="content-card forms-mode-card">
                <div class="form-stack">
                    <h2 class="panel-title">
                        Form responses
                    </h2>

                    <p class="panel-description">
                        What happens when your Power Automate flow pushes a form response.
                        Held responses wait for the setup form's <em>Load from a form
                        response…</em> picker; with <em>run at once</em> each response starts
                        a consult on your pinned package immediately — an answer that does
                        not fit its input is refused by name, and the response stays held
                        for the picker either way.
                    </p>

                    @if (formsModeMessage != null)
                    {
                        <FluentMessageBar Intent="@formsModeMessageIntent" AllowDismiss="false" Class="forms-mode-message">
                            @formsModeMessage
                        </FluentMessageBar>
                    }

                    <div class="state-panel">
                        <span class="muted-text">Form responses</span>
                        <strong class="forms-mode-state">@FormResponsePreference.Describe(formsModeChoice)</strong>
                    </div>

                    <div class="action-row">
                        @if (formsModeChoice != FormResponsePreference.RunAtOnce)
                        {
                            <FluentButton Appearance="Appearance.Accent"
                                          Class="forms-mode-run"
                                          Disabled="@formsModeRequestInProgress"
                                          @onclick="() => SaveFormsModeAsync(FormResponsePreference.RunAtOnce)">
                                Run each response at once
                            </FluentButton>
                        }
                        @if (formsModeChoice != FormResponsePreference.Hold)
                        {
                            <FluentButton Appearance="Appearance.Neutral"
                                          Class="forms-mode-hold"
                                          Disabled="@formsModeRequestInProgress"
                                          @onclick="() => SaveFormsModeAsync(FormResponsePreference.Hold)">
                                Hold for review
                            </FluentButton>
                        }
                        @if (formsModeChoice != null)
                        {
                            <FluentButton Appearance="Appearance.Neutral"
                                          Class="forms-mode-clear"
                                          Disabled="@formsModeRequestInProgress"
                                          @onclick="ClearFormsModeAsync">
                                Back to not chosen
                            </FluentButton>
                        }
                    </div>
                </div>
            </section>

            @* #548: how long a run's text is kept. Empty until chosen; each
               unset line says what unset means, and a change is refused by
               name rather than silently reordered. *@
            <section class="content-card retention-card">
                <div class="form-stack">
                    <h2 class="panel-title">
                        Retention
                    </h2>

                    <p class="panel-description">
                        How many days a completed run's text is kept — the produced documents
                        (outputs) and, separately, the referral text held for a rerun (inputs).
                        Inputs never outlive outputs, and 30 days is the ceiling. Hashes and
                        history are never deleted. A shortened setting applies to runs already
                        held at the next nightly sweep.
                    </p>

                    @if (retentionMessage != null)
                    {
                        <FluentMessageBar Intent="@retentionMessageIntent" AllowDismiss="false" Class="retention-message">
                            @retentionMessage
                        </FluentMessageBar>
                    }

                    <div class="state-panel">
                        <span class="muted-text">Outputs</span>
                        <strong class="retention-output-state">@RetentionPreference.Describe(savedRetentionOutputDays)</strong>
                        <span class="muted-text">Inputs</span>
                        <strong class="retention-input-state">@RetentionPreference.Describe(savedRetentionInputDays)</strong>
                    </div>

                    <div class="action-row">
                        <input type="number"
                               min="@RetentionPreference.MinDays"
                               max="@RetentionPreference.MaxDays"
                               class="node-field__input retention-output-input"
                               value="@retentionOutputInput"
                               @onchange="args => retentionOutputInput = args.Value?.ToString() ?? string.Empty"
                               disabled="@retentionRequestInProgress"
                               placeholder="Outputs"
                               aria-label="Days outputs are kept" />
                        <input type="number"
                               min="@RetentionPreference.MinDays"
                               max="@RetentionPreference.MaxDays"
                               class="node-field__input retention-input-input"
                               value="@retentionInputInput"
                               @onchange="args => retentionInputInput = args.Value?.ToString() ?? string.Empty"
                               disabled="@retentionRequestInProgress"
                               placeholder="Inputs"
                               aria-label="Days inputs are kept" />
                        <FluentButton Appearance="Appearance.Accent"
                                      Class="retention-save"
                                      Disabled="@(retentionRequestInProgress || (string.IsNullOrWhiteSpace(retentionOutputInput) && string.IsNullOrWhiteSpace(retentionInputInput)))"
                                      @onclick="SaveRetentionAsync">
                            Save
                        </FluentButton>
                        @if (savedRetentionOutputDays != null)
                        {
                            <FluentButton Appearance="Appearance.Neutral"
                                          Class="retention-output-clear"
                                          Disabled="@retentionRequestInProgress"
                                          @onclick="() => ClearRetentionAsync(RetentionPreference.OutputDaysKey)">
                                Clear outputs
                            </FluentButton>
                        }
                        @if (savedRetentionInputDays != null)
                        {
                            <FluentButton Appearance="Appearance.Neutral"
                                          Class="retention-input-clear"
                                          Disabled="@retentionRequestInProgress"
                                          @onclick="() => ClearRetentionAsync(RetentionPreference.InputDaysKey)">
                                Clear inputs
                            </FluentButton>
                        }
                    </div>
                </div>
            </section>

            @* #552: what the account has spent — the derived usage store,
               numbers only. Empty until the first completed run after it
               shipped, and says so; per-consult figures live in History. *@
            <section class="content-card usage-card">
                <div class="form-stack">
                    <h2 class="panel-title">
                        Usage
                    </h2>

                    <p class="panel-description">
                        Consults and tokens per day, from a store written once at each run's
                        completion. Numbers only — nothing here names a consult's content.
                    </p>

                    @if (usageError != null)
                    {
                        <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false" Class="usage-message">@usageError</FluentMessageBar>
                    }

                    <div class="action-row">
                        <select class="node-field__input usage-window"
                                value="@usageWindow"
                                @onchange="OnUsageWindowChangedAsync"
                                aria-label="Usage window">
                            <option value="7">Last 7 days</option>
                            <option value="30">Last 30 days</option>
                            <option value="90">Last 90 days</option>
                            <option value="custom">Custom range</option>
                        </select>
                        @if (usageWindow == "custom")
                        {
                            <input type="date"
                                   class="node-field__input usage-from"
                                   value="@usageFromInput"
                                   @onchange="args => usageFromInput = args.Value?.ToString() ?? string.Empty"
                                   aria-label="Usage from" />
                            <input type="date"
                                   class="node-field__input usage-to"
                                   value="@usageToInput"
                                   @onchange="args => usageToInput = args.Value?.ToString() ?? string.Empty"
                                   aria-label="Usage to" />
                            <FluentButton Appearance="Appearance.Accent"
                                          Class="usage-apply"
                                          Disabled="@(string.IsNullOrWhiteSpace(usageFromInput) || string.IsNullOrWhiteSpace(usageToInput))"
                                          @onclick="LoadUsageAsync">
                                Apply
                            </FluentButton>
                        }
                    </div>

                    @if (usage is { } usageData)
                    {
                        @if (usageData.Days.Count == 0)
                        {
                            <p class="usage-empty muted-text">No usage yet — counts begin with the first completed run after 2026-08-31; older runs have no counts.</p>
                        }
                        else
                        {
                            var usageFigures = UsageSummary.Of(usageData.Days, UsageSummary.WindowDaysOf(usageData.From, usageData.To));
                            <div class="state-panel usage-figures">
                                <span class="muted-text">Consults</span>
                                <strong class="usage-consults">@usageFigures.Consults.ToString("N0")</strong>
                                <span class="muted-text">Tokens</span>
                                <strong class="usage-tokens">@($"{usageFigures.TokensIn:N0} in · {usageFigures.TokensOut:N0} out · {usageFigures.TokensTotal:N0} total")</strong>
                                <span class="muted-text">Per day</span>
                                <strong class="usage-per-day">@($"{usageFigures.ConsultsPerDay:0.##} consults · {usageFigures.TokensPerDay:N0} tokens")</strong>
                                <span class="muted-text">Average tokens per consult</span>
                                <strong class="usage-average">@UsageSummary.DescribeAverage(usageFigures.AverageTokensPerConsult)</strong>
                            </div>
                            <div class="usage__scroll">
                                <table class="usage__table">
                                    <thead>
                                        <tr><th>Day</th><th>Consults</th><th>Tokens in</th><th>Tokens out</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var usageDay in usageData.Days)
                                        {
                                            <tr class="usage__row">
                                                <td>@usageDay.Day</td>
                                                <td>@usageDay.ConsultsCompleted.ToString("N0")</td>
                                                <td>@usageDay.TokensIn.ToString("N0")</td>
                                                <td>@usageDay.TokensOut.ToString("N0")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <p class="usage-history-line muted-text">Per-consult figures are on each run in <a href="/history">History</a>.</p>
