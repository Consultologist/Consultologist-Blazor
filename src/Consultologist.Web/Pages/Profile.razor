    private async Task SaveSnippetSetAsync(Snippets.SnippetSet next, string message)
    {
        snippetRequestInProgress = true;

        try
        {
            if (next.Items.Count == 0)
            {
                await AccountService.DeleteSettingAsync(Snippets.SettingKey);
            }
            else
            {
                await AccountService.SaveSettingAsync(
                    Snippets.SettingKey, Snippets.Serialize(next), Snippets.ContentType);
            }

            snippetSet = next;
            snippetMessage = message;
            snippetMessageIntent = MessageIntent.Success;
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
