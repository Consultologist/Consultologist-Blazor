@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Consultologist.Web.Services.AppUpdate
@using Consultologist.Web.Services.Locations
@inject IApiLocations Locations
@inject IAccountEndpointService AccountService
@inject IWorkflowEndpointService WorkflowService
@inject IConfiguration Configuration
@inject NavigationManager Navigation
@attribute [Authorize]

@page "/profile"

<PageTitle>Profile</PageTitle>

<section class="page-header">
    <div class="page-header__content">
        <span class="section-eyebrow">Profile</span>
        <h1 class="page-title">Workspace identity.</h1>
        <p class="page-description">
            Confirm the signed-in account used for protected Consultologist workflows and Microsoft identity access.
        </p>
    </div>
</section>

<AuthorizeView>
    <Authorized>
        @if (account != null)
        {
            <section class="content-card">
                <div class="form-stack">
                    <h2 class="panel-title">
                        Signed-in account details
                    </h2>

                    <p class="panel-description">
                        These details come from the Consultologist account service for the current clinician session.
                    </p>

                    <div class="state-panel">
                        <span class="muted-text">Display name</span>
                        <strong>@account.DisplayName</strong>
                    </div>

                    <div class="state-panel">
                        <span class="muted-text">Email</span>
                        <strong>@(account.Email ?? "Not provided")</strong>
                    </div>

                    <div class="state-panel">
                        <span class="muted-text">App user ID</span>
                        <strong>@account.AppUserId</strong>
                    </div>

                    <div class="state-panel">
                        <span class="muted-text">Current identity</span>
                        <strong>@account.CurrentIdentity.Provider</strong>
                    </div>

                    <FluentMessageBar Intent="MessageIntent.Info">
                        Protected API requests use this account identity for server-side authorization and job ownership.
                    </FluentMessageBar>
                </div>
            </section>

            <section class="content-card">
                <div class="form-stack">
                    <h2 class="panel-title">
                        Build
                    </h2>

                    <p class="panel-description">
                        The client this tab is running and the engine it talks to, as git commits.
                        A new client build is announced at the top of the page when it is ready; the
                        engine's commit is what its provenance records cite.
                    </p>

                    <div class="state-panel">
                        <span class="muted-text">Client</span>
                        <strong class="build-client">@BuildLabel.Describe(Configuration)</strong>
                    </div>

                    <div class="state-panel">
                        <span class="muted-text">Engine</span>
                        <strong class="build-engine">@(engineCommit ?? "Unavailable")</strong>
                    </div>
                </div>
            </section>

            <section class="content-card">
                <div class="form-stack">
                    <h2 class="panel-title">
                        LinkedIn verification
                    </h2>

                    <p class="panel-description">
                        Connecting your LinkedIn profile proves this account belongs to a real clinician.
                        It supports the account activation decision — LinkedIn is never used to sign in.
                    </p>

                    @if (linkedInMessage != null)
                    {
                        <FluentMessageBar Intent="@linkedInMessageIntent">@linkedInMessage</FluentMessageBar>
                    }

                    @if (LinkedInIdentity != null)
                    {
                        <div class="state-panel">
                            <span class="muted-text">Connected LinkedIn profile</span>
                            <strong>@(LinkedInIdentity.DisplayName ?? "LinkedIn account")</strong>
                            @if (LinkedInIdentity.Email != null)
                            {
                                <span class="muted-text">@LinkedInIdentity.Email</span>
                            }
                            @if (VerifiedCategoryLabels.Length > 0)
                            {
                                <strong>Verified on LinkedIn: @string.Join(", ", VerifiedCategoryLabels)</strong>
                            }
                            <span class="muted-text">Connected @LinkedInIdentity.LinkedAt.ToString("yyyy-MM-dd")</span>
                        </div>
                    }

                    @* #195: an account that may read but not submit has to be
                       told which it is, and how to get back. *@
                    @if (account?.Status == "Unverified")
                    {
                        <FluentMessageBar Intent="MessageIntent.Warning">
                            This account can open its existing consults but cannot start new ones.
                            Reconnect LinkedIn to restore it.
                        </FluentMessageBar>
                    }

                    <div class="action-row">
                        <FluentButton Appearance="Appearance.Accent"
                                      IconStart="@(new Icons.Regular.Size20.LinkMultiple())"
                                      Disabled="@linkedInStartInProgress"
                                      @onclick="ConnectLinkedInAsync">
                            @(LinkedInIdentity == null ? "Connect LinkedIn" : "Reconnect LinkedIn")
                        </FluentButton>

                        @* Two clicks rather than a dialog: no FluentDialogProvider is
                           rendered anywhere in this app, so a real dialog would be new
                           infrastructure for one button. The label carries the warning
                           that the second click is the destructive one. *@
                        @if (LinkedInIdentity != null)
                        {
                            <FluentButton Appearance="Appearance.Neutral"
                                          Disabled="@linkedInDisconnectInProgress"
                                          @onclick="DisconnectLinkedInAsync">
                                @(disconnectArmed ? "Confirm disconnect" : "Disconnect")
                            </FluentButton>
                        }
                    </div>
                </div>
            </section>

            @* #515: the location — where the app sends data and reads the
               account. Kept on this device; empty until chosen, and the
               unchosen line says which location is used meanwhile. *@
            <section class="content-card location-card">
                <div class="form-stack">
                    <h2 class="panel-title">
                        Location
                    </h2>

                    <p class="panel-description">
                        Where the app sends your data and reads your account, packages and History.
                        The choice is kept on this device. Each location holds its own accounts,
                        packages and History, so changing it shows you that location's, not a copy.
                        Every run records the host it ran on.
                    </p>

                    @if (locationMessage != null)
                    {
                        <FluentMessageBar Intent="@locationMessageIntent" AllowDismiss="false" Class="location-message">
                            @locationMessage
                        </FluentMessageBar>
                    }

                    <div class="state-panel">
                        <span class="muted-text">Location</span>
                        <strong class="location-state">@LocationState()</strong>
                        @if (engineHost != null)
                        {
                            <span class="muted-text location-answers">Answers as @engineHost</span>
                        }
                    </div>

                    <div class="action-row">
                        @foreach (var location in Locations.All)
                        {
                            @if (Locations.Chosen?.Id != location.Id)
                            {
                                <FluentButton Appearance="Appearance.Accent"
                                              Class="location-choose"
                                              data-location="@location.Id"
                                              Disabled="@locationRequestInProgress"
                                              @onclick="() => ChooseLocationAsync(location)">
                                    Use @location.Name
                                </FluentButton>
                            }
                        }
                        @if (Locations.Chosen != null)
                        {
                            <FluentButton Appearance="Appearance.Neutral"
                                          Class="location-clear"
                                          Disabled="@locationRequestInProgress"
                                          @onclick="ClearLocationAsync">
                                Back to not chosen
                            </FluentButton>
                        }
                    </div>
                </div>
            </section>

            <section class="content-card">
                <div class="form-stack">
                    <h2 class="panel-title">
                        Scheduled consults
                    </h2>

                    <p class="panel-description">
                        The time of day a scheduled consult runs, unless you choose otherwise
                        when scheduling it. Your local time. Without one, scheduled consults
                        run at 2:00 AM.
                    </p>

                    @if (scheduleMessage != null)
                    {
                        <FluentMessageBar Intent="@scheduleMessageIntent">@scheduleMessage</FluentMessageBar>
                    }

                    <div class="state-panel">
                        <span class="muted-text">Default time</span>
                        <strong>@(savedScheduleTime ?? "Not set — 2:00 AM")</strong>
                    </div>

                    <div class="action-row">
                        @* #390: native input, matching the v8 date field in Consults. Empty until
                           chosen — this is a preference, and one nobody set is not 2:00 AM, it is
                           absent. *@
                        <input type="time"
                               class="node-field__input"
                               value="@scheduleTimeInput"
                               @onchange="args => scheduleTimeInput = args.Value?.ToString() ?? string.Empty"
                               disabled="@scheduleRequestInProgress"
                               aria-label="Default time for scheduled consults" />
                        <FluentButton Appearance="Appearance.Accent"
                                      Disabled="@(scheduleRequestInProgress || string.IsNullOrWhiteSpace(scheduleTimeInput))"
                                      @onclick="SaveScheduleTimeAsync">
                            @(savedScheduleTime == null ? "Set default" : "Change default")
                        </FluentButton>
                        @if (savedScheduleTime != null)
                        {
                            <FluentButton Appearance="Appearance.Neutral"
                                          Disabled="@scheduleRequestInProgress"
                                          @onclick="ClearScheduleTimeAsync">
                                Clear
                            </FluentButton>
                        }
                    </div>
                </div>
            </section>

            <section class="content-card delivery-address-card">
                <div class="form-stack">
                    <h2 class="panel-title">
                        Delivery address
                    </h2>

                    <p class="panel-description">
                        Every consult you submit is emailed here when it completes — and only here.
                        The address is confirmed with a code before anything is sent to it; the
                        email carries no clinical content unless a delivery password is set below.
                    </p>

                    @if (addressMessage != null)
                    {
                        <FluentMessageBar Intent="@addressMessageIntent">@addressMessage</FluentMessageBar>
                    }

                    <div class="state-panel">
                        <span class="muted-text">Delivery address</span>
                        <strong class="delivery-address-state">
                            @if (account.DeliveryAddress != null)
                            {
                                @* #517: which trust the address rests on. *@
                                <text>@(account.DeliveryAddressVerifiedBy == "tenant" ? "Verified by your organisation: " : "Verified: ")@account.DeliveryAddress</text>
                            }
                            else if (account.DeliveryAddressPending != null)
                            {
                                <text>Code sent to @account.DeliveryAddressPending — enter it below</text>
                            }
                            else
                            {
                                <text>Not set — consults are not emailed</text>
                            }
                        </strong>
                        @if (account.DeliveryAddress != null && account.DeliveryAddressPending != null)
                        {
                            <span class="muted-text">A code is out to @account.DeliveryAddressPending; confirming it replaces the verified address.</span>
                        }
                    </div>

                    @if (account.DeliveryAddressPending != null)
                    {
                        <div class="action-row">
                            <FluentTextField @bind-Value="deliveryCodeInput"
                                             Placeholder="6-digit code"
                                             Disabled="@addressRequestInProgress"
                                             aria-label="Confirmation code" />
                            <FluentButton Appearance="Appearance.Accent"
                                          Class="confirm-address-button"
                                          Disabled="@(addressRequestInProgress || (deliveryCodeInput?.Trim().Length ?? 0) != 6)"
                                          @onclick="ConfirmDeliveryAddressAsync">
                                Confirm
                            </FluentButton>
                            <FluentButton Appearance="Appearance.Neutral"
                                          Class="resend-code-button"
                                          Disabled="@addressRequestInProgress"
                                          @onclick="ResendDeliveryCodeAsync">
                                Send a new code
                            </FluentButton>
                        </div>
                    }

                    <div class="action-row">
                        <FluentTextField @bind-Value="deliveryAddressInput"
                                         TextFieldType="TextFieldType.Email"
                                         Placeholder="you@clinic.example"
                                         Disabled="@addressRequestInProgress"
                                         aria-label="Delivery address" />
                        <FluentButton Appearance="Appearance.Accent"
                                      Class="send-code-button"
                                      Disabled="@(addressRequestInProgress || string.IsNullOrWhiteSpace(deliveryAddressInput))"
                                      @onclick="StartDeliveryAddressAsync">
                            @(account.DeliveryAddress == null ? "Send code" : "Change address")
                        </FluentButton>
                        @* #517: an organisation's sign-in already verified this
                           mailbox is yours — one click, no code. Offered on an
                           organisation's token only, and not once it is the
                           verified address; a personal account keeps the code. *@
                        @if (account.SignInKind == "organisation" && account.SignInEmail is { Length: > 0 } signInEmail
                            && !string.Equals(account.DeliveryAddress, signInEmail, StringComparison.OrdinalIgnoreCase))
                        {
                            <FluentButton Appearance="Appearance.Neutral"
                                          Class="use-signed-in-button"
                                          Disabled="@addressRequestInProgress"
                                          @onclick="UseSignedInDeliveryAddressAsync">
                                Use @signInEmail
                            </FluentButton>
                        }
                        @if (account.DeliveryAddress != null || account.DeliveryAddressPending != null)
                        {
                            <FluentButton Appearance="Appearance.Neutral"
                                          Class="remove-address-button"
                                          Disabled="@addressRequestInProgress"
                                          @onclick="ClearDeliveryAddressAsync">
                                Remove
                            </FluentButton>
                        }
                    </div>
                </div>
            </section>

            @* #518: whether runs started from the app are emailed at all.
               Empty until chosen; the unset line says what unset means, so
               nothing changes silently for an account that never chose. *@
            <section class="content-card email-pdf-card">
                <div class="form-stack">
                    <h2 class="panel-title">
                        Email each run's PDF
                    </h2>

                    <p class="panel-description">
                        Whether a consult you start from the app — now or scheduled — is emailed
                        to your delivery address when it completes. Consults sent in by email
                        always reply to their sender. Either way, every run appears in History.
                    </p>

                    @if (emailPdfMessage != null)
                    {
                        <FluentMessageBar Intent="@emailPdfMessageIntent" AllowDismiss="false" Class="email-pdf-message">
                            @emailPdfMessage
                        </FluentMessageBar>
                    }

                    <div class="state-panel">
                        <span class="muted-text">Email each run's PDF</span>
                        <strong class="email-pdf-state">@EmailPdfPreference.Describe(emailPdfChoice)</strong>
                    </div>

                    <div class="action-row">
                        @if (emailPdfChoice != true)
                        {
                            <FluentButton Appearance="Appearance.Accent"
                                          Class="email-pdf-yes"
                                          Disabled="@emailPdfRequestInProgress"
                                          @onclick="() => SaveEmailPdfAsync(true)">
                                Yes, email each run
                            </FluentButton>
                        }
                        @if (emailPdfChoice != false)
                        {
                            <FluentButton Appearance="Appearance.Neutral"
                                          Class="email-pdf-no"
                                          Disabled="@emailPdfRequestInProgress"
                                          @onclick="() => SaveEmailPdfAsync(false)">
                                No, do not email
                            </FluentButton>
                        }
                        @if (emailPdfChoice != null)
                        {
                            <FluentButton Appearance="Appearance.Neutral"
                                          Class="email-pdf-clear"
                                          Disabled="@emailPdfRequestInProgress"
                                          @onclick="ClearEmailPdfAsync">
                                Back to not chosen
                            </FluentButton>
                        }
                    </div>
                </div>
            </section>

            <section class="content-card">
                <div class="form-stack">
                    <h2 class="panel-title">
                        Encrypted document delivery
                    </h2>

                    <p class="panel-description">
                        With a delivery password set, the email to your delivery address attaches the
                        consult as a password-protected PDF. Without one, it carries only a sign-in link.
                        The password is write-only — it is never shown again, and History always
                        keeps the document if it is forgotten.
                    </p>

                    @if (passwordMessage != null)
                    {
                        <FluentMessageBar Intent="@passwordMessageIntent">@passwordMessage</FluentMessageBar>
                    }

                    <div class="state-panel">
                        <span class="muted-text">Delivery password</span>
                        <strong>@(account.DocumentPasswordSet ? "Set" : "Not set")</strong>
                    </div>

                    <div class="action-row">
                        <FluentTextField @bind-Value="deliveryPasswordInput"
                                         TextFieldType="TextFieldType.Password"
                                         Placeholder="At least 16 characters"
                                         Disabled="@passwordRequestInProgress" />
                        <FluentButton Appearance="Appearance.Accent"
                                      Disabled="@(passwordRequestInProgress || (deliveryPasswordInput?.Length ?? 0) < 16)"
                                      @onclick="SetDeliveryPasswordAsync">
                            @(account.DocumentPasswordSet ? "Replace password" : "Set password")
                        </FluentButton>
                        @if (account.DocumentPasswordSet)
                        {
                            <FluentButton Appearance="Appearance.Neutral"
                                          Disabled="@passwordRequestInProgress"
                                          @onclick="ClearDeliveryPasswordAsync">
                                Clear
                            </FluentButton>
                        }
                    </div>
                </div>
            </section>
        }
        else if (!string.IsNullOrWhiteSpace(accountErrorMessage))
        {
            <section class="state-panel">
                <FluentMessageBar Intent="MessageIntent.Error">@accountErrorMessage</FluentMessageBar>
            </section>
        }
        else
        {
            <section class="state-panel">
                <div class="loading-state">
                    <FluentProgressRing />
                    <span>Loading profile information...</span>
                </div>
            </section>
        }

    </Authorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    [SupplyParameterFromQuery(Name = "linkedin")]
    private string? LinkedInResult { get; set; }

    [SupplyParameterFromQuery(Name = "reason")]
    private string? LinkedInErrorReason { get; set; }

    private AccountMeResponse? account;
    private string? engineCommit;
    private string? accountErrorMessage;
    private string? linkedInMessage;
    private MessageIntent linkedInMessageIntent = MessageIntent.Info;
    private bool linkedInStartInProgress;
    private bool linkedInDisconnectInProgress;
    // #195: the first click arms, the second acts. See the markup for why this
    // is not a dialog.
    private bool disconnectArmed;

    private AccountIdentity? LinkedInIdentity =>
        account?.LinkedIdentities.FirstOrDefault(identity =>
            string.Equals(identity.Provider, "linkedin", StringComparison.Ordinal));

    private string[] VerifiedCategoryLabels =>
        (LinkedInIdentity?.VerifiedCategories ?? string.Empty)
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(category => category switch
            {
                "IDENTITY" => "Identity",
                "WORKPLACE" => "Workplace",
                _ => category
            })
            .ToArray();

    protected override async Task OnInitializedAsync()
    {
        CaptureLinkedInResultFromQuery();

        var authState = await AuthenticationStateTask!;
        var user = authState.User;

        if (user.Identity?.IsAuthenticated != true)
        {
            return;
        }

        await LoadAccountAsync();

        // #412: anonymous attestation; null when unreachable, shown as such.
        var engine = await WorkflowService.GetEngineAsync();
        engineCommit = string.IsNullOrWhiteSpace(engine?.Commit) ? null : engine.Commit;
    }

    private void CaptureLinkedInResultFromQuery()
    {
        if (string.IsNullOrWhiteSpace(LinkedInResult))
        {
            return;
        }

        (linkedInMessage, linkedInMessageIntent) = LinkedInResult switch
        {
            "connected" => ("LinkedIn profile connected.", MessageIntent.Success),
            _ => (LinkedInErrorReason switch
            {
                "denied" => "LinkedIn connection was cancelled or denied.",
                "already-linked" => "That LinkedIn profile is already connected to a different Consultologist account.",
                _ => "LinkedIn connection failed. Please try again."
            }, MessageIntent.Error)
        };

        // Strip the query so a refresh doesn't replay the message.
        Navigation.NavigateTo("/profile", replace: true);
    }

    private async Task LoadAccountAsync()
    {
        try
        {
            account = await AccountService.GetCurrentAccountAsync();
            await LoadScheduleTimeAsync();
        await LoadEmailPdfAsync();
        await LoadEngineHostAsync();
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            accountErrorMessage = $"Unable to load account information: {ex.Message}";
        }
    }

    // #390: the account's default time of day for scheduled consults.
    // savedScheduleTime is what is stored (null = never set); scheduleTimeInput
    // is what the control holds.
    private string? savedScheduleTime;
    private string scheduleTimeInput = string.Empty;
    private bool scheduleRequestInProgress;
    private string? scheduleMessage;
    private MessageIntent scheduleMessageIntent = MessageIntent.Info;

    /// <summary>
    /// #390: read tolerantly, the way the workflow pin is. A setting that is
    /// missing, blank or unreadable leaves the card showing "not set" rather
    /// than reporting an error nobody came here for.
    /// </summary>
    private async Task LoadScheduleTimeAsync()
    {
        try
        {
            var setting = await AccountService.GetSettingAsync(ScheduleDefault.SettingKey);
            savedScheduleTime = ScheduleDefault.Parse(setting?.Value);
            scheduleTimeInput = savedScheduleTime ?? string.Empty;
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch
        {
            savedScheduleTime = null;
        }
    }

    private async Task SaveScheduleTimeAsync()
    {
        var normalized = ScheduleDefault.Parse(scheduleTimeInput);

        if (normalized == null)
        {
            scheduleMessage = "Enter a time as HH:MM.";
            scheduleMessageIntent = MessageIntent.Error;
            return;
        }

        scheduleRequestInProgress = true;

        try
        {
            await AccountService.SaveSettingAsync(
                ScheduleDefault.SettingKey, normalized, ScheduleDefault.ContentType);
            savedScheduleTime = normalized;
            scheduleMessage = $"Scheduled consults will run at {normalized} unless you choose otherwise.";
            scheduleMessageIntent = MessageIntent.Success;
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            scheduleMessage = ex.Message;
            scheduleMessageIntent = MessageIntent.Error;
        }
        finally
        {
            scheduleRequestInProgress = false;
        }
    }

    private async Task ClearScheduleTimeAsync()
    {
        scheduleRequestInProgress = true;

        try
        {
            await AccountService.DeleteSettingAsync(ScheduleDefault.SettingKey);
            savedScheduleTime = null;
            scheduleTimeInput = string.Empty;
            scheduleMessage = "Default cleared. Scheduled consults will run at 2:00 AM.";
            scheduleMessageIntent = MessageIntent.Success;
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            scheduleMessage = ex.Message;
            scheduleMessageIntent = MessageIntent.Error;
        }
        finally
        {
            scheduleRequestInProgress = false;
        }
    }

    // #515: the location. The device's copy is the authority; the account
    // keeps a record in the chosen location.
    private bool locationRequestInProgress;
    private string? locationMessage;
    private MessageIntent locationMessageIntent = MessageIntent.Info;
    private string? engineHost;

    private string LocationState()
    {
        if (Locations.Chosen is { } chosen)
        {
            return $"{chosen.Name} — {chosen.Host}";
        }

        var used = Locations.Current;
        return Locations.All.Count == 1
            ? $"Not chosen — {used.Name}, the only location, is used"
            : $"Not chosen — {used.Name} is used until you choose";
    }

    private async Task LoadEngineHostAsync()
    {
        try
        {
            engineHost = (await WorkflowService.GetEngineAsync())?.ApiHost;
        }
        catch
        {
            engineHost = null;
        }
    }

    private async Task ChooseLocationAsync(ApiLocation location)
    {
        locationRequestInProgress = true;

        try
        {
            await Locations.ChooseAsync(location.Id);
            // The record, in the location just chosen — best effort: the
            // device's copy already decides.
            try
            {
                await AccountService.SaveSettingAsync(LocationPreference.SettingKey, location.Id, LocationPreference.ContentType);
            }
            catch (AccessTokenNotAvailableException exception)
            {
                exception.Redirect();
            }
            catch
            {
            }

            locationMessage = $"Location set to {location.Name} — reloading.";
            locationMessageIntent = MessageIntent.Success;
            // Every session holder (job, editor) belongs to the old location.
            Navigation.NavigateTo("/profile", forceLoad: true);
        }
        catch (Exception ex)
        {
            locationMessage = ex.Message;
            locationMessageIntent = MessageIntent.Error;
        }
        finally
        {
            locationRequestInProgress = false;
        }
    }

    private async Task ClearLocationAsync()
    {
        locationRequestInProgress = true;

        try
        {
            try
            {
                await AccountService.DeleteSettingAsync(LocationPreference.SettingKey);
            }
            catch (AccessTokenNotAvailableException exception)
            {
                exception.Redirect();
            }
            catch
            {
            }

            await Locations.ClearAsync();
            locationMessage = "Back to not chosen — reloading.";
            locationMessageIntent = MessageIntent.Success;
            Navigation.NavigateTo("/profile", forceLoad: true);
        }
        catch (Exception ex)
        {
            locationMessage = ex.Message;
            locationMessageIntent = MessageIntent.Error;
        }
        finally
        {
            locationRequestInProgress = false;
        }
    }

    // #518: whether app-initiated runs are emailed. null = not chosen.
    private bool? emailPdfChoice;
    private bool emailPdfRequestInProgress;
    private string? emailPdfMessage;
    private MessageIntent emailPdfMessageIntent = MessageIntent.Info;

    private async Task LoadEmailPdfAsync()
    {
        try
        {
            var setting = await AccountService.GetSettingAsync(EmailPdfPreference.SettingKey);
            emailPdfChoice = EmailPdfPreference.Parse(setting?.Value);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch
        {
            emailPdfChoice = null;
        }
    }

    private async Task SaveEmailPdfAsync(bool choice)
    {
        emailPdfRequestInProgress = true;

        try
        {
            await AccountService.SaveSettingAsync(
                EmailPdfPreference.SettingKey, choice ? "true" : "false", EmailPdfPreference.ContentType);
            emailPdfChoice = choice;
            emailPdfMessage = choice
                ? "Runs started from the app will be emailed to your delivery address."
                : "Runs started from the app will not be emailed. Each will say so in History.";
            emailPdfMessageIntent = MessageIntent.Success;
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            emailPdfMessage = ex.Message;
            emailPdfMessageIntent = MessageIntent.Error;
        }
        finally
        {
            emailPdfRequestInProgress = false;
        }
    }

    private async Task ClearEmailPdfAsync()
    {
        emailPdfRequestInProgress = true;

        try
        {
            await AccountService.DeleteSettingAsync(EmailPdfPreference.SettingKey);
            emailPdfChoice = null;
            emailPdfMessage = "Back to not chosen: PDFs are sent, as before.";
            emailPdfMessageIntent = MessageIntent.Success;
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            emailPdfMessage = ex.Message;
            emailPdfMessageIntent = MessageIntent.Error;
        }
        finally
        {
            emailPdfRequestInProgress = false;
        }
    }

    // #486: the verified delivery address. Send → Confirm; nothing is ever
    // sent to an address that did not answer its code.
    private string? deliveryAddressInput;
    private string? deliveryCodeInput;
    private bool addressRequestInProgress;
    private string? addressMessage;
    private MessageIntent addressMessageIntent = MessageIntent.Info;

    private async Task StartDeliveryAddressAsync()
    {
        if (string.IsNullOrWhiteSpace(deliveryAddressInput))
        {
            return;
        }

        await RunDeliveryAddressRequestAsync(async () =>
        {
            await AccountService.StartDeliveryAddressAsync(deliveryAddressInput.Trim());
            deliveryAddressInput = null;
            deliveryCodeInput = null;
            return "A confirmation code has been sent. Enter it below within 15 minutes.";
        });
    }

    private async Task ResendDeliveryCodeAsync()
    {
        if (account?.DeliveryAddressPending is not { } pending)
        {
            return;
        }

        await RunDeliveryAddressRequestAsync(async () =>
        {
            await AccountService.StartDeliveryAddressAsync(pending);
            deliveryCodeInput = null;
            return "A new code has been sent. Enter it below within 15 minutes.";
        });
    }

    private async Task ConfirmDeliveryAddressAsync()
    {
        if (string.IsNullOrWhiteSpace(deliveryCodeInput))
        {
            return;
        }

        await RunDeliveryAddressRequestAsync(async () =>
        {
            await AccountService.ConfirmDeliveryAddressAsync(deliveryCodeInput.Trim());
            deliveryCodeInput = null;
            return "Delivery address verified. Completed consults will be emailed there.";
        });
    }

    private async Task ClearDeliveryAddressAsync()
    {
        await RunDeliveryAddressRequestAsync(async () =>
        {
            await AccountService.ClearDeliveryAddressAsync();
            deliveryCodeInput = null;
            return "Delivery address removed. Consults will not be emailed until one is verified.";
        });
    }

    // #517: the signed-in email, on an organisation's token — no code.
    private async Task UseSignedInDeliveryAddressAsync()
    {
        await RunDeliveryAddressRequestAsync(async () =>
        {
            await AccountService.UseSignedInDeliveryAddressAsync();
            deliveryAddressInput = null;
            deliveryCodeInput = null;
            return "Delivery address set to your work email, verified by your organisation. Completed consults will be emailed there.";
        });
    }

    private async Task RunDeliveryAddressRequestAsync(Func<Task<string>> action)
    {
        addressRequestInProgress = true;
        addressMessage = null;

        try
        {
            addressMessage = await action();
            addressMessageIntent = MessageIntent.Success;
            await LoadAccountAsync();
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            addressMessage = ex.Message;
            addressMessageIntent = MessageIntent.Error;
        }
        finally
        {
            addressRequestInProgress = false;
        }
    }

    private string? deliveryPasswordInput;
    private bool passwordRequestInProgress;
    private string? passwordMessage;
    private MessageIntent passwordMessageIntent = MessageIntent.Info;

    private async Task SetDeliveryPasswordAsync()
    {
        if (string.IsNullOrEmpty(deliveryPasswordInput))
        {
            return;
        }

        passwordRequestInProgress = true;
        passwordMessage = null;

        try
        {
            await AccountService.SetDeliveryPasswordAsync(deliveryPasswordInput);
            deliveryPasswordInput = null;
            passwordMessage = "Delivery password set. Completion emails will now attach the encrypted document.";
            passwordMessageIntent = MessageIntent.Success;
            await LoadAccountAsync();
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            passwordMessage = ex.Message;
            passwordMessageIntent = MessageIntent.Error;
        }
        finally
        {
            passwordRequestInProgress = false;
        }
    }

    private async Task ClearDeliveryPasswordAsync()
    {
        passwordRequestInProgress = true;
        passwordMessage = null;

        try
        {
            await AccountService.ClearDeliveryPasswordAsync();
            passwordMessage = "Delivery password cleared. Completion emails will carry only the sign-in link.";
            passwordMessageIntent = MessageIntent.Success;
            await LoadAccountAsync();
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            passwordMessage = ex.Message;
            passwordMessageIntent = MessageIntent.Error;
        }
        finally
        {
            passwordRequestInProgress = false;
        }
    }

    /// <summary>
    /// #195: disconnect, in two clicks. Reloads rather than patching state
    /// locally — the unlink also changes the account STATUS, and showing a
    /// stale one on the page that explains the status would be its own bug.
    /// </summary>
    private async Task DisconnectLinkedInAsync()
    {
        if (!disconnectArmed)
        {
            disconnectArmed = true;
            linkedInMessage = "Disconnecting removes LinkedIn verification, and this account will not be able to start new consults until it is reconnected.";
            linkedInMessageIntent = MessageIntent.Warning;
            return;
        }

        linkedInDisconnectInProgress = true;

        try
        {
            await AccountService.DisconnectLinkedInAsync();
            await LoadAccountAsync();
            linkedInMessage = "LinkedIn disconnected.";
            linkedInMessageIntent = MessageIntent.Success;
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            linkedInMessage = $"Unable to disconnect LinkedIn: {ex.Message}";
            linkedInMessageIntent = MessageIntent.Error;
        }
        finally
        {
            disconnectArmed = false;
            linkedInDisconnectInProgress = false;
        }
    }

    private async Task ConnectLinkedInAsync()
    {
        linkedInStartInProgress = true;

        try
        {
            var authorizationUrl = await AccountService.StartLinkedInLinkAsync();
            Navigation.NavigateTo(authorizationUrl, forceLoad: true);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            linkedInMessage = $"Unable to start the LinkedIn connection: {ex.Message}";
            linkedInMessageIntent = MessageIntent.Error;
            linkedInStartInProgress = false;
        }
    }
}
