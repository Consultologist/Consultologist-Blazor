                    }
                </div>
            </section>

            @* #516: the profile's signature blocks — appended to deliverables a
               v11 package marks signed. Explicit initialisation: a new account
               has none, and nothing is appended until a block exists and is
               chosen; the unchosen line names the consequence. *@
            <section class="content-card signature-card">
                <div class="form-stack">
                    <h2 class="panel-title">
                        Signature
                    </h2>

                    <p class="panel-description">
                        Named signature blocks — name, credentials, contact — that belong to you,
                        not to a package. A package may mark a deliverable as signed; the block
                        chosen here is then appended to that document when it completes, and the
                        record names it. Nothing is appended until a block is chosen.
                    </p>

                    @if (signatureMessage != null)
                    {
                        <FluentMessageBar Intent="@signatureMessageIntent" AllowDismiss="false" Class="signature-message">
                            @signatureMessage
                        </FluentMessageBar>
                    }

                    <div class="state-panel">
                        <span class="muted-text">Signature</span>
                        <strong class="signature-state">@SignatureBlocks.Describe(signatureSet)</strong>
                    </div>

                    @foreach (var block in signatureSet.Blocks)
                    {
                        <div class="state-panel signature-block" @key="block.Id">
                            <span class="muted-text">@block.Name@(signatureSet.ChosenId == block.Id ? " — in use" : "")</span>
                            <span class="signature-block-preview">@Preview(block.Text)</span>
                            <div class="action-row">
                                @if (signatureSet.ChosenId != block.Id)
                                {
                                    <FluentButton Appearance="Appearance.Accent"
                                                  Class="signature-use"
                                                  Disabled="@signatureRequestInProgress"
                                                  @onclick="() => UseSignatureAsync(block.Id)">
                                        Use
                                    </FluentButton>
                                }
                                <FluentButton Appearance="Appearance.Neutral"
                                              Class="signature-edit"
                                              Disabled="@signatureRequestInProgress"
                                              @onclick="() => EditSignature(block.Id)">
                                    Edit
                                </FluentButton>
                                <FluentButton Appearance="Appearance.Neutral"
                                              Class="signature-remove"
                                              Disabled="@signatureRequestInProgress"
                                              @onclick="() => RemoveSignatureAsync(block.Id)">
                                    @(signatureRemoveArmedId == block.Id ? "Confirm remove" : "Remove")
                                </FluentButton>
                            </div>
                        </div>
                    }

                    @if (signatureSet.ChosenId != null)
                    {
                        <div class="action-row">
                            <FluentButton Appearance="Appearance.Neutral"
                                          Class="signature-clear"
                                          Disabled="@signatureRequestInProgress"
                                          @onclick="ClearChosenSignatureAsync">
                                Back to none chosen
                            </FluentButton>
                        </div>
                    }

                    @if (editingSignatureId != null || signatureSet.Blocks.Count < SignatureBlocks.MaxBlocks)
                    {
                        <div class="form-stack signature-form">
                            <input class="node-field__input signature-name-input"
                                   value="@signatureNameInput"
                                   @onchange="args => signatureNameInput = args.Value?.ToString()"
                                   maxlength="@SignatureBlocks.MaxNameLength"
                                   placeholder="Block name (e.g. Clinic letters)"
                                   aria-label="Signature block name" />
                            <textarea class="node-field__input signature-text-input"
                                      rows="5"
                                      value="@signatureTextInput"
                                      @onchange="args => signatureTextInput = args.Value?.ToString()"
                                      maxlength="@SignatureBlocks.MaxTextLength"
                                      placeholder="The signature text, exactly as it should appear"
                                      aria-label="Signature text"></textarea>
                            <div class="action-row">
                                <FluentButton Appearance="Appearance.Accent"
                                              Class="signature-save"
                                              Disabled="@(signatureRequestInProgress || !SignatureFormValid)"
                                              @onclick="SaveSignatureAsync">
                                    @(editingSignatureId == null ? "Add signature block" : "Save changes")
                                </FluentButton>
                                @if (editingSignatureId != null)
                                {
                                    <FluentButton Appearance="Appearance.Neutral"
                                                  Class="signature-cancel-edit"
                                                  Disabled="@signatureRequestInProgress"
                                                  @onclick="CancelSignatureEdit">
                                        Cancel
                                    </FluentButton>
                                }
                            </div>
                        </div>
                    }
                </div>
            </section>

            <section class="content-card">
                <div class="form-stack">
                    <h2 class="panel-title">
                        Encrypted document delivery
                    </h2>

                    <p class="panel-description">
                        With a delivery password set, the email to your delivery address attaches the
                        consult as a password-protected PDF. Without one, it carries only a sign-in link.
                        The password is write-only — it is never shown again, and History always
                        keeps the document if it is forgotten.
                    </p>

                    @if (passwordMessage != null)
                    {
                        <FluentMessageBar Intent="@passwordMessageIntent">@passwordMessage</FluentMessageBar>
                    }

                    <div class="state-panel">
                        <span class="muted-text">Delivery password</span>
                        <strong>@(account.DocumentPasswordSet ? "Set" : "Not set")</strong>
                    </div>

                    <div class="action-row">
                        <FluentTextField @bind-Value="deliveryPasswordInput"
                                         TextFieldType="TextFieldType.Password"
                                         Placeholder="At least 16 characters"
                                         Disabled="@passwordRequestInProgress" />
                        <FluentButton Appearance="Appearance.Accent"
                                      Disabled="@(passwordRequestInProgress || (deliveryPasswordInput?.Length ?? 0) < 16)"
                                      @onclick="SetDeliveryPasswordAsync">
                            @(account.DocumentPasswordSet ? "Replace password" : "Set password")
                        </FluentButton>
                        @if (account.DocumentPasswordSet)
                        {
                            <FluentButton Appearance="Appearance.Neutral"
                                          Disabled="@passwordRequestInProgress"
                                          @onclick="ClearDeliveryPasswordAsync">
                                Clear
                            </FluentButton>
                        }
                    </div>
                </div>
            </section>
        }
        else if (!string.IsNullOrWhiteSpace(accountErrorMessage))
        {
            <section class="state-panel">
                <FluentMessageBar Intent="MessageIntent.Error">@accountErrorMessage</FluentMessageBar>
            </section>
        }
        else
        {
            <section class="state-panel">
                <div class="loading-state">
                    <FluentProgressRing />
                    <span>Loading profile information...</span>
                </div>
            </section>
        }

    </Authorized>
</AuthorizeView>

