@page "/subscription"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IAccountEndpointService AccountService
@inject NavigationManager Navigation
@inject ILogger<Subscription> Logger

@* #669: the Microsoft Marketplace landing page. The offer's landing URL points
   here; Marketplace appends its single-use ?token=. The clinician is signed into
   Entra (the [Authorize] attribute), and this posts the token to the backend to
   resolve + activate the subscription and tie it to the account. The token never
   leaves the backend beyond this hop. *@

<PageTitle>Subscription · Consultologist</PageTitle>

<div class="content-card">
    <div class="form-stack">
        <h1 class="panel-title">Consultologist subscription</h1>

        @if (_stripePaid)
        {
            @* #725: Stripe redirects here after checkout. The tie + activation happen
               webhook-side, so this confirms payment and points at the profile rather
               than asserting an activation that may be a moment behind. *@
            <FluentMessageBar Intent="MessageIntent.Success">Payment received. Your account activates in a moment — check your profile shortly.</FluentMessageBar>
            <p><a href="/profile">Go to your profile</a></p>
        }
        else if (_stripeCanceled)
        {
            <FluentMessageBar Intent="MessageIntent.Info">Checkout canceled — you were not charged. You can subscribe any time from your profile.</FluentMessageBar>
            <p><a href="/profile">Go to your profile</a></p>
        }
        else if (_working)
        {
            <p class="muted-text">Activating your subscription…</p>
        }
        else if (_error != null)
        {
            <FluentMessageBar Intent="MessageIntent.Error">@_error</FluentMessageBar>
            <p><a href="/profile">Go to your profile</a></p>
        }
        else if (_done)
        {
            <FluentMessageBar Intent="MessageIntent.Success">Your subscription is active. You can start generating consults.</FluentMessageBar>
            <p><a href="/profile">Go to your profile</a></p>
        }
        else
        {
            <p class="muted-text">This page completes a Microsoft Marketplace purchase. Open it from your Marketplace subscription's <em>Configure account</em> link.</p>
            <p><a href="/profile">Go to your profile</a></p>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    // #725: Stripe Checkout's return — "success" | "cancel".
    [SupplyParameterFromQuery(Name = "stripe")]
    public string? Stripe { get; set; }

    private bool _working;
    private bool _done;
    private string? _error;
    private bool _stripePaid;
    private bool _stripeCanceled;

    protected override async Task OnInitializedAsync()
    {
        // #725: a Stripe return carries ?stripe=; the webhook does the tie/activation.
        if (string.Equals(Stripe, "success", StringComparison.Ordinal))
        {
            _stripePaid = true;
            return;
        }

        if (string.Equals(Stripe, "cancel", StringComparison.Ordinal))
        {
            _stripeCanceled = true;
            return;
        }

        if (string.IsNullOrWhiteSpace(Token))
        {
            return;
        }

        _working = true;
        try
        {
            await AccountService.ResolveMarketplaceAsync(Token);
            _done = true;
        }
        catch (AccessTokenNotAvailableException ex)
        {
            ex.Redirect();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Marketplace resolve failed.");
            _error = ex.Message;
        }
        finally
        {
            _working = false;
        }
    }
}
