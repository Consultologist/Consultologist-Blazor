<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- #733: the solution's first Razor Class Library — the presentational
       pieces the clinician SPA (Consultologist.Web) and the admin app
       (Consultologist.Admin) both render, so they cannot drift. Scoped to the
       low-tangle bits only (the usage chart + its pure geometry, the loading
       indicator); each app keeps its own shell. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" />
  </ItemGroup>

</Project>
