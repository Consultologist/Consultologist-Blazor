<Project Sdk="Microsoft.NET.Sdk">

  <!-- #707: a real-browser a11y harness (Playwright). It drives the published
       app over HTTP and the shipped dialog-focus.js directly, so it holds NO
       reference to the Web project. It is a separate project the CI `test` job
       does not run (that job names specific csproj); a dedicated `e2e` job runs it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- #1510 (area 13, Task 7): the library's one 31 drawing (PackageDiagram), so a test draws a document of its own, and
       the golden dag.mmd files, linked as content, which the browser renders. Still no reference to the Web project. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Consultologist.PackageFormat\Consultologist.PackageFormat.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\V31Diagram\Golden\*.dag.mmd" Link="Golden\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- #1510 (area 13, Task 10): the functions resolve golden, which the mocked 31 History page answers as the job's
       resolve.json so its run diagram has a call box. -->
  <ItemGroup>
    <None Include="..\V31Resolve\Golden\functions.resolve.json" Link="Golden\V31Resolve\functions.resolve.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
