<Project Sdk="Microsoft.NET.Sdk">

  <!-- #707: a real-browser a11y harness (Playwright). It drives the published
       app over HTTP and the shipped dialog-focus.js directly, so it holds NO
       reference to the Web project. It is a separate project the CI `test` job
       does not run (that job names specific csproj); a dedicated `e2e` job runs it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
