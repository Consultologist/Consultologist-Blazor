{
  "$schema": "urn:consultologist:spec:31:dialect",
  "type": "object",
  "description": "The sections a note should have, each with a title and what it covers.",
  "additionalProperties": false,
  "required": [
    "sections"
  ],
  "properties": {
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "purpose"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          }
        }
      }
    }
  }
}
