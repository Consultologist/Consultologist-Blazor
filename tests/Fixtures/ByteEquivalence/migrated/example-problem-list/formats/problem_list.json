{
  "$schema": "urn:consultologist:spec:31:dialect",
  "type": "object",
  "description": "The problems a consult draft names, each with what the draft says about it, and a one-sentence summary.",
  "additionalProperties": false,
  "required": [
    "summary",
    "problems"
  ],
  "properties": {
    "summary": {
      "type": "string"
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "detail"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    }
  }
}
