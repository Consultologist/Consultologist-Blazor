{
  "$schema": "urn:consultologist:spec:31:dialect",
  "type": "object",
  "description": "The sections a consultation note should have for this consult, each with a short title and what it covers, and a one-sentence summary of the consultation.",
  "additionalProperties": false,
  "required": [
    "summary",
    "sections"
  ],
  "properties": {
    "summary": {
      "type": "string"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "purpose"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          }
        }
      }
    }
  }
}
