<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- This project lives directly in tests/, so its default glob would
         compile any sibling project's sources too. Sibling projects get their
         own folder; each needs excluding here until this one moves into
         tests/Consultologist.Api.Tests/ as well. -->
    <Compile Remove="Consultologist.Web.Tests/**" />
    <Compile Remove="Consultologist.Web.E2E.Tests/**" />
    <Compile Remove="Consultologist.Admin.Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\Consultologist.Api\Consultologist.Api.csproj" />
  </ItemGroup>

</Project>